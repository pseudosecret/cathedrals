    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        index_staged_plan(db, step_id, state)


def index_staged_plan(db, step_id, state):
    revision = sha256_bytes(canonical_json(state))
    db.execute("DELETE FROM staged_items WHERE step_id=?", (step_id,))
    def visit(value, pointer):
        if isinstance(value, dict):
            identity = next((value[key] for key in ("obligation_id", "attractor_id", "arc_id", "node_id", "edge_id", "packet_slot_id") if key in value), None)
            if identity:
                db.execute("INSERT INTO staged_items VALUES (?,?,?,?,?,?)",
                    (step_id, revision, pointer, identity, "TENTATIVE PLAN", canonical_json(value).decode()))
            else:
                for key, child in value.items():
                    visit(child, pointer + "/" + str(key).replace("~", "~0").replace("/", "~1"))
        elif isinstance(value, list):
            for index, child in enumerate(value):
                visit(child, pointer + f"/{index}")
    visit(state.get("payload", {}), "")


def historical_fact_ids(run_dir):
