def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def canonical_json(value) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_")
    slug = slug[:48] or "cathedrals"
    return slug if slug[0].isalpha() else f"cathedrals_{slug}"


def write_atomic(path: Path, data: bytes, *, mode: int = 0o644, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if exclusive and path.exists():
        raise IntegrityError(f"Refusing to overwrite {path}")
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, mode)
    if exclusive and path.exists():
        temporary.unlink()
        raise IntegrityError(f"Refusing to overwrite {path}")
    os.replace(temporary, path)


def write_json(path: Path, value, *, mode: int = 0o644, exclusive: bool = False) -> None:
    write_atomic(path, canonical_json(value), mode=mode, exclusive=exclusive)


def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def make_read_only(path: Path) -> None:
    os.chmod(path, stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)


def _resolve_pointer(document, pointer: str):
    value = document
    for part in pointer.removeprefix("#/").split("/"):
        value = value[part.replace("~1", "/").replace("~0", "~")]
    return value


def _matches_type(value, expected: str) -> bool:
    return {
        "object": isinstance(value, dict),
        "array": isinstance(value, list),
        "string": isinstance(value, str),
        "integer": isinstance(value, int) and not isinstance(value, bool),
        "number": isinstance(value, (int, float)) and not isinstance(value, bool),
        "boolean": isinstance(value, bool),
        "null": value is None,
    }[expected]


def validate_json_schema(value, schema, root=None, path: str = "$") -> None:
    """Validate the JSON-Schema subset used by the repository protocol."""
    root = root or schema
    if "$ref" in schema:
        validate_json_schema(value, _resolve_pointer(root, schema["$ref"]), root, path)
    for branch in schema.get("allOf", []):
        validate_json_schema(value, branch, root, path)
    if "anyOf" in schema:
        if not any(_schema_matches(value, branch, root, path) for branch in schema["anyOf"]):
            raise SchemaError(f"{path} does not match any allowed schema")
    if "oneOf" in schema:
        matches = sum(_schema_matches(value, branch, root, path) for branch in schema["oneOf"])
        if matches != 1:
            raise SchemaError(f"{path} must match exactly one record schema; matched {matches}")
    if "if" in schema:
        branch = schema.get("then") if _schema_matches(value, schema["if"], root, path) else schema.get("else")
        if branch:
            validate_json_schema(value, branch, root, path)
    expected = schema.get("type")
    if expected:
        types = expected if isinstance(expected, list) else [expected]
        if not any(_matches_type(value, item) for item in types):
            raise SchemaError(f"{path} must be {' or '.join(types)}")
    if "const" in schema and value != schema["const"]:
        raise SchemaError(f"{path} must equal {schema['const']!r}")
    if "enum" in schema and value not in schema["enum"]:
        raise SchemaError(f"{path} must be one of {schema['enum']!r}")
    if isinstance(value, dict):
        required = schema.get("required", [])
        missing = [key for key in required if key not in value]
        if missing:
            raise SchemaError(f"{path} is missing required fields: {', '.join(missing)}")
        properties = schema.get("properties", {})
        for key, child in value.items():
            if key in properties:
                validate_json_schema(child, properties[key], root, f"{path}.{key}")
            elif schema.get("additionalProperties") is False:
                raise SchemaError(f"{path}.{key} is not allowed")
            elif isinstance(schema.get("additionalProperties"), dict):
                validate_json_schema(child, schema["additionalProperties"], root, f"{path}.{key}")
        if len(value) < schema.get("minProperties", 0):
            raise SchemaError(f"{path} has too few properties")
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            raise SchemaError(f"{path} has too few items")
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            raise SchemaError(f"{path} has too many items")
        if "items" in schema:
            for index, child in enumerate(value):
                validate_json_schema(child, schema["items"], root, f"{path}[{index}]")
        if schema.get("uniqueItems") and len({json.dumps(item, sort_keys=True) for item in value}) != len(value):
            raise SchemaError(f"{path} contains duplicate items")
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            raise SchemaError(f"{path} is empty")
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            raise SchemaError(f"{path} is too long")
        if "pattern" in schema and not re.search(schema["pattern"], value):
            raise SchemaError(f"{path} does not match {schema['pattern']}")
        if schema.get("format") == "date-time":
            try:
                dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
            except ValueError as error:
                raise SchemaError(f"{path} is not an ISO date-time") from error
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            raise SchemaError(f"{path} is below its minimum")
        if "maximum" in schema and value > schema["maximum"]:
            raise SchemaError(f"{path} is above its maximum")


def _schema_matches(value, schema, root, path: str) -> bool:
    try:
        validate_json_schema(value, schema, root, path)
        return True
    except SchemaError:
        return False


def load_protocol():
    return read_json(PROTOCOL_PATH)


def record_schema(record_type: str, protocol=None):
    protocol = protocol or load_protocol()
    definition_name = RECORD_DEFS[record_type]
    needed = {definition_name}
    queue = [definition_name]
    while queue:
        definition = protocol["$defs"][queue.pop()]
        for node in _walk(definition):
            ref = node.get("$ref") if isinstance(node, dict) else None
            if ref and ref.startswith("#/$defs/"):
                name = ref.split("/")[2]
                if name not in needed:
                    needed.add(name)
                    queue.append(name)
    schema = dict(protocol["$defs"][definition_name])
    schema["$defs"] = {name: protocol["$defs"][name] for name in sorted(needed)}
    return schema


def _walk(value):
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from _walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from _walk(child)


def parse_scene_count(value: str) -> int:
    try:
        count = int(value.strip())
    except ValueError as error:
        raise ValueError("enter a positive whole number") from error
    if count <= 0:
        raise ValueError("enter a positive whole number")
    return count


def normalize_requested_format(value: str) -> str:
    normalized = re.sub(r"\s+", " ", value.strip().lower())
    if normalized not in FORMAT_ALIASES:
        raise ValueError("enter web or visualnovel")
    return FORMAT_ALIASES[normalized]


def collect_inputs(input_fn=input, output_fn=print) -> FrozenInputs:
    output_fn("Cathedrals\n")
    project_name = input_fn('Name of project (default "Cathedrals"):\n').strip() or "Cathedrals"
    genre = input_fn('Genre/flavor of story (default "existential mystery"):\n').strip() or "existential mystery"
    while True:
        raw_count = input_fn('Possible number of scenes (default "150"):\n').strip() or "150"
        try:
            scene_count = parse_scene_count(raw_count)
            break
        except ValueError as error:
            output_fn(f"Invalid scene count: {error}.")
    while True:
        try:
            requested_format = normalize_requested_format(input_fn("Story format (web/visualnovel):\n"))
            break
        except ValueError as error:
            output_fn(f"Invalid story format: {error}.")
    if requested_format == "visualnovel":
        output_fn("Visual-novel output is not active yet; this run will use web.")
    return FrozenInputs(project_name, genre, scene_count, requested_format, "web", False)


def derive_scope(possible_scene_count: int) -> dict:
    count = possible_scene_count
    profile = "pilot" if count <= 18 else "standard" if count <= 50 else "large" if count <= 100 else "cathedral"
    artifact_target = max(5, round(count / 6))
    artifact_max = max(artifact_target, math.ceil(count / 5))
    ending_target = max(5, round(count / 9))
    ending_max = max(ending_target, math.ceil(count / 7))
    formal_target = max(2, round(count / 25))
    packet_target = max(1, math.ceil(count / 6))
    max_creative_steps = 2 + math.ceil(count / 3) + math.ceil(ending_max / 2)
    max_analysis_steps = max(4, math.ceil(count / 3) + math.ceil(ending_max / 2) + 2)
    return {
        "scope": {
            "possible_scene_count": count,
            "scene_floor": min(count, max(8, math.ceil(count * 0.6))),
            "artifact_target": artifact_target,
            "artifact_hard_max": artifact_max,
            "ending_target": ending_target,
            "ending_hard_max": ending_max,
            "formal_composition_target": formal_target,
            "branch_count_pressure": max(3, round(math.sqrt(count))),
            "reconvergence_pressure": max(1, round(count / 20)),
            "literary_packet_target": packet_target,
            "profile_guidance": profile,
        },
        "budgets": {
            "max_prepared_context_tokens": 49152,
            "max_creative_packet_output_tokens": 10900,
            "max_analysis_output_tokens": 4096,
            "context_safety_reserve_tokens": 4096,
            "max_creative_step_count": max_creative_steps,
            "max_analysis_or_index_step_count": max_analysis_steps,
            "max_total_literary_words": count * 600 + artifact_max * 350 + ending_max * 500,
            "max_cumulative_input_tokens": (max_creative_steps + max_analysis_steps) * 49152,
            "max_cumulative_output_tokens": max_creative_steps * 10900 + max_analysis_steps * 4096,
            "max_memory_records": max(1000, count * 45),
            "max_retrieved_source_tokens": 12288,
        },
    }


def configured_lm_studio_url(environ=None) -> str:
    environ = environ or os.environ
    return environ.get("CATHEDRALS_LM_STUDIO_URL", DEFAULT_LM_STUDIO_URL).rstrip("/")


def api_url(base_url: str, path: str) -> str:
    if base_url.endswith("/v1") and path.startswith("/v1/"):
        path = path[3:]
    return base_url.rstrip("/") + path


def http_json(method: str, url: str, payload=None, timeout: float = 30.0):
    body = canonical_json(payload) if payload is not None else None
    request = urllib.request.Request(url, data=body, method=method)
    request.add_header("Accept", "application/json")
    if body is not None:
        request.add_header("Content-Type", "application/json")
    api_key = os.environ.get("CATHEDRALS_LM_STUDIO_API_KEY")
    if api_key:
        request.add_header("Authorization", f"Bearer {api_key}")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace").strip()
        raise CathedralsError("LM Studio API", f"HTTP {error.code}: {detail or error.reason}", "provider_before_creative_output") from error
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as error:
        raise CathedralsError("LM Studio preflight", str(error), "transport_before_response") from error


def usable_model_ids(payload) -> list[str]:
    models = payload.get("data", []) if isinstance(payload, dict) else []
    usable = []
    for model in models:
        identifier = model.get("id") if isinstance(model, dict) else None
        kind = str(model.get("type", "")).lower() if isinstance(model, dict) else ""
        if not identifier or kind in {"embedding", "embeddings"} or "embed" in identifier.lower():
            continue
        usable.append(identifier)
    return sorted(set(usable))


def choose_model(models: list[str], override=None, input_fn=input, output_fn=print) -> str:
    if override:
        if override not in models:
            raise CathedralsError("LM Studio preflight", f"CATHEDRALS_MODEL={override!r} is not visible to LM Studio.")
        return override
    if not models:
        raise CathedralsError("LM Studio preflight", "No usable LLM model is visible. Load one in LM Studio.")
    if len(models) == 1:
        return models[0]
    output_fn("Available LM Studio models:")
    for index, model in enumerate(models, 1):
        output_fn(f"  {index}. {model}")
    while True:
        raw = input_fn(f"Select model [1-{len(models)}]: ").strip()
        if raw.isdigit() and 1 <= int(raw) <= len(models):
            return models[int(raw) - 1]
        output_fn("Invalid model selection.")


def lm_studio_preflight(base_url: str, model_override=None, input_fn=input, output_fn=print, transport=http_json):
    try:
        payload = transport("GET", api_url(base_url, "/v1/models"), timeout=10.0)
    except CathedralsError as error:
        raise CathedralsError(
            "LM Studio preflight",
            f"LM Studio was not reachable at {base_url}.\n\n"
            "Open LM Studio on Windows, load a model, and start the Local Server.\n"
            "Then run ./cathedrals again.",
            error.failure_class,
        ) from error
    return choose_model(usable_model_ids(payload), model_override, input_fn, output_fn)


def run_command(args, *, cwd=ROOT, env=None, capture=True) -> subprocess.CompletedProcess:
    return subprocess.run(
        [str(item) for item in args],
        cwd=cwd,
        env=env,
        text=True,
        capture_output=capture,
        check=False,
    )


def git(*args, check=True) -> str:
    result = run_command(["git", *args])
    if check and result.returncode:
        raise CathedralsError("Git preflight", result.stderr.strip() or result.stdout.strip())
    return result.stdout.strip()


def verify_repo_safe() -> None:
    top = Path(git("rev-parse", "--show-toplevel")).resolve()
    if top != ROOT:
        raise CathedralsError("Git preflight", "Run ./cathedrals from this repository root.")
    if git("status", "--porcelain"):
        raise CathedralsError(
            "Git preflight",
            "The repository has uncommitted changes. Commit or stash them before starting a new generation.",
        )


def ensure_runtime_layout() -> None:
    for path in (
        RUNTIME_ROOT / "toolchains/node",
        RUNTIME_ROOT / "cache/npm",
        RUNTIME_ROOT / "logs",
        RUNS_ROOT,
    ):
        path.mkdir(parents=True, exist_ok=True)


def engine_hashes() -> dict[str, str]:
    paths = [ROOT / relative for relative in git("ls-files", "engine", "cathedrals").splitlines()]
    return {str(path.relative_to(ROOT)): sha256_file(path) for path in sorted(paths)}


def verify_engine_freeze(run_dir: Path) -> None:
    frozen = read_json(run_dir / "run-manifest.json")["engine_snapshot"]
    if git("rev-parse", "HEAD") != frozen["engine_commit_sha"]:
        raise IntegrityError("The generation branch HEAD changed after engine freeze")
    if engine_hashes() != frozen["engine_config_hashes"]:
        raise IntegrityError("Engine canon or the executable changed after generation began")


def generation_id(project_name: str, timestamp: str | None = None) -> str:
    stamp = (timestamp or dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d_%H%M%S")).replace("-", "_")
    return f"{slugify(project_name)}_{stamp}_{secrets.token_hex(3)}"


def create_generation_branch(identifier: str) -> str:
    branch = f"generation/{identifier}"
    if git("show-ref", "--verify", f"refs/heads/{branch}", check=False):
        raise CathedralsError("Git preflight", f"Generation branch already exists: {branch}")
    git("switch", "-c", branch)
    return branch


def current_branch() -> str:
    return git("branch", "--show-current")


