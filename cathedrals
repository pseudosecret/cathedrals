    elif record.get("record_type") == "constraint_event":
        group, required = "selected_constraints", ("constraint_id", "constraint_event_sequence", "data", "sources")
    else:
        raise IntegrityError(f"Unknown retrieval record shape; keys: {', '.join(sorted(record))}")
    missing = [key for key in required if key not in record]
    if missing:
        raise IntegrityError(f"Retrieval {group} record is missing {', '.join(missing)}; keys: {', '.join(sorted(record))}")
    return group, context_item_identity(record)


def pack_packet_context(required, optional, max_tokens, receipt):
    def render(sections, compact, details=None):
        sources, records = {}, {}

        def record_identity(value):
            if {"source_commit_id", "source_hash", "record_pointer", "immutable_source"}.issubset(value):
                return (value["source_commit_id"], value["source_hash"], value["record_pointer"])

        def collect(value):
            if isinstance(value, dict):
                identity = record_identity(value)
                if identity is not None:
                    payload = compact_context_value(value["immutable_source"])
                    if identity in records and records[identity][1] != payload:
                        raise IntegrityError("Conflicting immutable source payloads for the same commit/hash/pointer")
                    entry = records.setdefault(identity, [value["immutable_source"], payload, 0])
                    entry[2] += 1
                if {"artifact_id", "source_commit_id", "source_hash"}.issubset(value):
                    key = canonical_json(value)
                    sources.setdefault(key, [value, 0])[1] += 1
                else:
                    for key, child in value.items():
                        if key != "immutable_source":
                            collect(child)
            elif isinstance(value, list):
                for child in value:
                    collect(child)

        if compact:
            for _label, items in sections:
                collect(items)
        shared = {key: f"source_{index:03d}" for index, key in enumerate(sorted(key for key, (value, count) in sources.items() if count > 1 and len(key) > 128), 1)}
        record_refs = {identity: f"record_{index:03d}" for index, identity in enumerate(sorted(records), 1)}

        def encode(value):
            if isinstance(value, dict):
                if {"artifact_id", "source_commit_id", "source_hash"}.issubset(value):
                    reference = shared.get(canonical_json(value))
                    if reference:
                        return {"$context_ref": reference}
                identity = record_identity(value)
                return {key: ({"$context_ref": record_refs[identity]} if identity is not None else child)
                    if key == "immutable_source" else encode(child) for key, child in value.items()}
            if isinstance(value, list):
                return [encode(child) for child in value]
            return value

        rendered, components, blocks = [], {}, []
        if records:
            blocks.append(("SHARED SOURCE RECORDS", [{record_refs[identity]: entry[0] for identity, entry in sorted(records.items())}],
                "Each $context_ref expands to its complete original source unit below.\n"))
        if shared:
            blocks.append(("SHARED SOURCE METADATA", [{reference: sources[key][0] for key, reference in shared.items()}],
                "Each $context_ref expands to the exact source metadata object below.\n"))
        for label, items in sections:
            if items:
                blocks.append((label, [encode(item) for item in items] if compact else items, ""))
        values, table, saved = shared_context_values([items for _label, items, _note in blocks]) if compact else (
            [items for _label, items, _note in blocks], {}, 0)
        if table:
            block = "===== SHARED CONTEXT VALUES =====\nEach $context_ref expands losslessly; references may occur inside other shared objects.\n" + compact_context_value(table) + "\n"
            rendered.append(block)
            components["SHARED CONTEXT VALUES"] = len(block.encode())
        for (label, _items, note), items in zip(blocks, values):
            block = f"===== {label} =====\n" + note + "\n\n".join(
                compact_context_value(item) if compact else item if isinstance(item, str) else json.dumps(item, ensure_ascii=False, indent=2)
                for item in items) + "\n"
            rendered.append(block)
            components[label] = components.get(label, 0) + len(block.encode())
        if details is not None:
            details.update({"required_components": components,
                "shared_value_bytes_saved": saved, "shared_value_count": len(table),
                "shared_source_count": len(records), "source_reference_count": sum(entry[2] for entry in records.values()),
                "source_payload_bytes_saved": sum(len(entry[1].encode()) * (entry[2] - 1) for entry in records.values()),
                "shared_source_coverage": [{"context_ref": record_refs[identity], "source_commit_id": identity[0],
                    "source_hash": identity[1], "record_pointer": identity[2], "references": entry[2]} for identity, entry in sorted(records.items())]})
        return "\n".join(rendered)

    # Source-bearing objects are deduplicated only by verified identity/containment, never by similar wording.
    original_required = [(label, value if isinstance(value, list) else [value]) for label, value in required]
    seen, filtered = set(), []
    for label, value in required:
        items = value if isinstance(value, list) else [value]
        output = []
        for item in items:
            identity = canonical_json(item) if not isinstance(item, str) else None
            if identity is not None:
                seen.add(identity)
            output.append(item)
        filtered.append((label, output))
    text = render(filtered, True, receipt)
    receipt["required_pretty_bytes"] = len(render(original_required, False).encode())
    receipt["required_compact_bytes"] = len(text.encode())
    maximum = max(0, max_tokens * 3)
    if len(text.encode()) > maximum:
        receipt["capacity_failure"] = True
        receipt["largest_required_units"] = sorted([
            {"section": label, **context_item_identity(item), "bytes_before_sharing": len(canonical_json(item))}
            for label, items in original_required for item in items], key=lambda item: -item["bytes_before_sharing"])[:10]
        raise PausedError("Packet context", f"Required whole-source context needs approximately {estimated_prompt_tokens(text):,} tokens; ceiling {max_tokens:,}. "
            + "Components (UTF-8 bytes; shared records counted once): " + canonical_json(receipt["required_components"]).decode().strip()
            + " Largest required units before sharing: " + canonical_json(receipt["largest_required_units"]).decode().strip(), "budget_exhaustion")
    packed = filtered
    for label, items in optional:
        for item in items:
            identity = canonical_json(item)
            if identity in seen:
                receipt["omissions"].append({"section": label, **context_item_identity(item), "reason": "duplicate_optional_item"})
                continue
            trial = packed + [(label, [item])]
            candidate = render(trial, True)
            if len(candidate.encode()) <= maximum:
                packed = trial
                text = candidate
                seen.add(identity)
            else:
                receipt["omissions"].append({"section": label, **context_item_identity(item), "reason": "prepared_context_budget"})
    packed_details = {}
    text = render(packed, True, packed_details)
    packed_details["context_components"] = packed_details.pop("required_components")
    receipt.update(packed_details)
    receipt["context_bytes"] = len(text.encode())
    receipt["estimated_context_tokens"] = estimated_prompt_tokens(text)
    receipt["context_hash"] = sha256_bytes(text.encode())
    return text


def select_relevant_constraints(
    run_dir: Path, architecture: dict, plan: dict, limit: int = 96, records: list[dict] | None = None, *, query=None, trace=None,
) -> list[dict]:
    ensure_index(run_dir)
    query = search_query(plan) if query is None else query
    hits = search_history(run_dir, query, constraints=True, plan=plan)
    lexical_rank = {hit["event_sequence"]: rank for rank, hit in enumerate(hits)}
    structured = structured_constraint_sequences(run_dir, architecture, plan)
    sequences = set(structured) | set(lexical_rank)
    with index_connection(run_dir) as db:
        recent_sequences = [row[0] for row in db.execute("SELECT sequence FROM events ORDER BY sequence DESC LIMIT 96")]
        sequences.update(recent_sequences)
    total = index_checkpoint(run_dir)["event_sequence"]
    dependencies = records if records is not None else packet_records(run_dir, plan.get("depends_on_packet_slot_ids", []))
    dependency_ids = {identifier for record in dependencies if record.get("packet_slot_id") in plan.get("depends_on_packet_slot_ids", []) for identifier in generated_ids(record)}
    scored = [(relevance_score(event, plan, architecture, dependency_ids, total, lexical=False)
        + (5/(1+lexical_rank[event["constraint_event_sequence"]]) if event["constraint_event_sequence"] in lexical_rank else 0), event)
        for event in events_by_sequence(run_dir, sequences)]
    ranked = [(score,event) for score,event in sorted(scored, key=lambda item: (-item[0],item[1]["constraint_event_sequence"])) if score > 0][:limit]
    if trace is not None:
        trace["constraint_candidate_counts"] = {"fts": len(hits), "structured": len(structured), "recent": len(recent_sequences), "deserialized": len(sequences)}
        trace["selected_constraints"] = [{"constraint_id": event["constraint_id"], "event_sequence": event["constraint_event_sequence"], "score": score,
            "fts_rank": lexical_rank.get(event["constraint_event_sequence"])} for score,event in ranked]
    return [event for score,event in ranked]


def _within_record_budget(records: list[dict], max_tokens: int) -> list[dict]:
    maximum = max_tokens * 4
    output = []
    used = 0
    for record in records:
        size = len(json.dumps(record, ensure_ascii=False, indent=2))
        if used + size <= maximum:
            output.append(record)
            used += size
    return output


def relevant_packet_context(run_dir: Path, architecture: dict, plan: dict, *, receipt=None, step_id=None, prompt_overhead_tokens=0) -> str:
    ensure_index(run_dir)
    manifest = read_json(run_dir / "run-manifest.json")
    genesis = committed_record(run_dir, "genesis")
    root_sources = scoped_root_sources(run_dir, plan)
    law, law_provenance = instruction_profile(run_dir)
    dependencies = packet_records(run_dir, plan.get("depends_on_packet_slot_ids", []), verify=True)
    if {record["packet_slot_id"] for record in dependencies} != set(plan.get("depends_on_packet_slot_ids", [])):
        raise IntegrityError("Required predecessor packet does not resolve")
    query = search_query(plan, genesis)
    receipt = {} if receipt is None else receipt
    selected = select_relevant_constraints(run_dir, architecture, plan, records=dependencies, query=query, trace=receipt)
    past = list(state_subset(run_dir, "canonical-facts.json", [event["data"]["fact_id"] for event in selected if event["constraint_kind"] == "canonical_fact"]).values())
    motifs = list(state_subset(run_dir, "motifs.json", [event["data"]["motif_id"] for event in selected if event["constraint_kind"] == "motif_state"]).values())
    attractors = [item for item in architecture["attractors"] if item["attractor_id"] in plan.get("attractor_ids", [])]
    prerequisite_ids = {identifier for attractor in attractors for identifier in attractor["prerequisite_obligation_ids"]}
    for arc in architecture.get("arcs", []):
        if arc["arc_id"] in plan.get("relevance", {}).get("arc_ids", []):
            prerequisite_ids.update(arc.get("hard_obligation_ids", []))
    assigned_ids = set(plan.get("advance_obligation_ids", []) + plan.get("may_satisfy_obligation_ids", []))
    required_obligations = obligation_closure(run_dir, assigned_ids | prerequisite_ids)
    selected_obligation_ids = {event["data"]["obligation_id"] for event in selected if event["constraint_kind"] in {"obligation", "obligation_update"}}
    obligations = state_subset(run_dir, "obligations.json", selected_obligation_ids) | required_obligations
    hard = [event for event in obligations.values() if event["data"]["hardness"] == "hard" and event["data"]["status"] == "active"]
    soft = [event for event in obligations.values() if event["data"]["hardness"] == "soft" and event["data"]["status"] == "active" and event["data"]["obligation_id"] not in assigned_ids]
    subjects = sorted(set(plan.get("relevance", {}).get("character_ids", []) + plan.get("relevance", {}).get("claimant_ids", [])))
    knowledge = selected_current_knowledge(run_dir, selected, [item["data"]["fact_id"] for item in past], subjects)
    proof_events = []
    for event in required_obligations.values():
        proof_events.append(event)
        if event.get("resolution_event"):
            proof_events.append(event["resolution_event"])
    required_sources = retrieve_original_sources(run_dir, proof_events, limit=None, strict=True) if proof_events else []
    required_ids = {source["source_id"] for source in required_sources}
    mandatory_tags = {key: set(plan.get("relevance", {}).get(key, []))
        for key in ("object_ids", "location_ids", "state_keys", "technical_slot_ids")}
    protected_past = [event for event in past if any(source["artifact_id"] in required_ids for source in event["sources"])
        or any(values.intersection(event["data"].get("relevance", {}).get(key, [])) for key, values in mandatory_tags.items())]
    protected_fact_ids = {event["data"]["fact_id"] for event in protected_past}
    protected_knowledge, optional_knowledge = [], []
    for subject in knowledge:
        required_relations, optional_relations = {}, {}
        for relation, propositions in subject.items():
            if not isinstance(propositions, dict):
                continue
            required_relations[relation], optional_relations[relation] = {}, {}
            for proposition, event in propositions.items():
                target = required_relations if (relation == "explicitly_does_not_know" and subject["subject_id"] in subjects) or proposition in protected_fact_ids or any(source["artifact_id"] in required_ids for source in event["sources"]) else optional_relations
                target[relation][proposition] = event
        if any(required_relations.values()):
            protected_knowledge.append({"subject_id": subject["subject_id"], **required_relations})
        if any(optional_relations.values()):
            optional_knowledge.append({"subject_id": subject["subject_id"], **optional_relations})
    geomancy = ensure_frozen_geomancy(run_dir)
    slots = set(plan["scene_slot_ids"])
    required = [
        ("FROZEN ENGINE LAW", law),
        ("FROZEN GENERATION BRIEF", manifest["generation_brief"]),
        ("IMMUTABLE GENERATED ROOT CANON", root_sources),
        ("CURRENT PACKET STRUCTURAL POSITION", plan),
        ("LOCAL CAUSAL SCAFFOLD CONTRACT", scaffold_packet_context(run_dir, architecture, plan)),
        ("IMMUTABLE PAST CONSTRAINTS", protected_past),
        ("ACTIVE HARD FUTURE OBLIGATIONS", hard),
        ("OBLIGATIONS THIS PACKET SHOULD ADVANCE", [obligations[key] for key in plan.get("advance_obligation_ids", [])]),
        ("OBLIGATIONS THIS PACKET MAY SATISFY", [obligations[key] for key in plan.get("may_satisfy_obligation_ids", [])]),
        ("DIRECT DEPENDENCY SOURCE EVIDENCE", (predecessor_contracts(run_dir, dependencies))),
        ("REQUIRED PREREQUISITE SOURCE EVIDENCE", required_sources),
        ("CHARACTER KNOWLEDGE / BELIEF CONSTRAINTS", protected_knowledge),
        ("ENDING ATTRACTOR" if plan["packet_kind"] == "ending" else "ENDING / BRANCH ATTRACTORS EXERTING PRESSURE", attractors),
        ("FROZEN THRESHOLD GEOMANCY", [item for item in geomancy["assignments"] if item["technical_slot_id"] in slots]),
    ]
    tool_session = run_dir / "raw" / f"{step_id or packet_step_id(plan)}.retrieval-session.json"
    if not tool_session.exists() and step_id and step_id.endswith("_expanded"):
        tool_session = run_dir / "raw" / f"{step_id.removesuffix('_expanded')}.retrieval-session.json"
    tool_records = []
    if tool_session.exists():
        tool_records = read_json(tool_session)["working_set"]
    tool_groups = {"selected_sources": [], "selected_constraints": [], "selected_plan_items": []}
    for record in tool_records:
        group, _metadata = retrieval_record_metadata(record)
        tool_groups[group].append(record)
    if plan["packet_kind"] == "ending":
        chain = [required_obligations[key] for key in sorted(prerequisite_ids)]
        required.extend([
            ("BACKWARD PREREQUISITE CHAIN", chain),
            ("SATISFIED PREREQUISITES WITH SOURCES", [item for item in chain if item["data"]["status"] == "satisfied"]),
            ("RELEVANT UNSATISFIED / AMBIGUOUS PRESSURES", [item for item in obligations.values() if item["data"]["status"] in {"active", "intentionally_unresolved"}]),
            ("CURRENT READER STATE", [item for item in past if "reader" in item["data"]["subject"] or item["data"].get("relevance", {}).get("state_keys")]),
            ("BRANCH RESIDUE", [item for item in obligations.values() if item["data"]["kind"] == "branch_residue"]),
            ("CLAIMANT PRESSURES", [item for item in obligations.values() if item["data"].get("relevance", {}).get("claimant_ids")]),
        ])
    checkpoint = index_checkpoint(run_dir)
    receipt.setdefault("selected_constraints", [{"constraint_id": event["constraint_id"], "event_sequence": event["constraint_event_sequence"]} for event in selected])
    receipt.update({"version": 1, "index_version": INDEX_VERSION, "canonical_state_hash": checkpoint["canonical_hash"],
        "ledger_sequence": checkpoint["ledger_sequence"], "event_sequence": checkpoint["event_sequence"],
        "query": query,
        "instruction_profile": law_provenance,
        "token_estimator": "ceil(utf8_bytes/3)", "prompt_overhead_tokens": prompt_overhead_tokens,
        "selected_sources": [], "omissions": []})
    receipt["selected_sources"].extend({key: source[key] for key in ("source_id", "source_commit_id", "source_hash", "record_pointer")} | {"required": True}
        for source in root_sources)
    dependency_catalog = _source_index(run_dir, [record["commit_id"] for record in dependencies])
    for record in dependencies:
        receipt["selected_sources"].append({"source_id": record["commit_id"], "source_commit_id": record["commit_id"],
            "source_hash": dependency_catalog[record["commit_id"]]["hash"], "record_pointer": "", "required": True})
    receipt["selected_sources"].extend({key: source.get(key) for key in ("source_id", "source_commit_id", "source_hash", "record_pointer")} | {"required": True} for source in required_sources)
    actual_step = step_id or packet_step_id(plan | {"advance_obligation_ids": plan.get("advance_obligation_ids", []), "may_satisfy_obligation_ids": plan.get("may_satisfy_obligation_ids", [])})
    receipt_path = run_dir / ".staging" / f"{actual_step}.retrieval.json"
    ceiling = packet_input_limit(run_dir) - prompt_overhead_tokens
    receipt["prepared_input_ceiling"] = packet_input_limit(run_dir)
    receipt["context_ceiling"] = ceiling
    receipt["mandatory_inclusion_reasons"] = {"obligations": sorted(required_obligations),
        "evidence": [{"source_id": source["source_id"], "record_pointer": source["record_pointer"]} for source in required_sources],
        "continuity_fact_ids": sorted(protected_fact_ids)}
    # Check required inputs before doing optional searches or loading any optional original prose.
    try:
        pack_packet_context(required, [], ceiling, receipt)
        # Optional discovery must leave room for a returned payload in correction feedback.
        normal = manifest["budgets"].get("normal_prepared_context_tokens", manifest["budgets"]["max_prepared_context_tokens"])
        optional_ceiling = max(receipt["estimated_context_tokens"], min(ceiling, normal - prompt_overhead_tokens) - BASE_OUTPUT_TOKENS)
        receipt["correction_headroom_tokens"] = ceiling - optional_ceiling
        receipt["normal_input_target"] = normal
        receipt["using_loaded_headroom"] = receipt["estimated_context_tokens"] + prompt_overhead_tokens > normal
        recent = packet_records(run_dir, recent=2, verify=True)
        covered_commits = {record["commit_id"] for record in dependencies}
        covered_ids = {identifier for record in dependencies for identifier in generated_ids(record)} | {source["source_id"] for source in required_sources}
        covered_commits.update(source["source_commit_id"] for source in required_sources if isinstance(source["immutable_source"], dict) and source["immutable_source"].get("commit_id") == source["source_commit_id"])
        chosen, cache, source_chars = [], {}, len(compact_context_value(tool_records).encode()) if tool_records else 0
        hits = search_history(run_dir, query, plan=plan)
        receipt["source_candidate_count"] = len(hits)
        ranks = {(hit["commit_id"],hit["pointer"]): {key: hit[key] for key in ("document_id", "bm25", "locality")} for hit in hits}
        for hit in hits:
            if hit["commit_id"] in covered_commits or hit["source_id"] in covered_ids:
                receipt["omissions"].append({"source_id": hit["source_id"], "source_commit_id": hit["commit_id"], "record_pointer": hit["pointer"], "reason": "covered_by_required_context"})
                continue
            if len(chosen) + len(tool_records) >= SEARCH_SOURCE_LIMIT:
                receipt["omissions"].append({"source_id": hit["source_id"], "reason": "source_count_limit"})
                continue
            # The catalog holds complete units, so skip oversized results without reading their archives.
            with index_connection(run_dir) as db:
                body_chars = db.execute("SELECT length(body) FROM search_documents WHERE id=?", (hit["document_id"],)).fetchone()[0]
            if source_chars + body_chars > manifest["budgets"]["max_retrieved_source_tokens"] * 3:
                receipt["omissions"].append({"source_id": hit["source_id"], "reason": "retrieval_budget"})
                continue
            source = read_search_source(run_dir, hit, cache)
            size = len(compact_context_value(source).encode())
            if source_chars + size > manifest["budgets"]["max_retrieved_source_tokens"] * 3:
                receipt["omissions"].append({"source_id": hit["source_id"], "reason": "retrieval_budget"})
                continue
            chosen.append(source)
            source_chars += size
            covered_ids.add(hit["source_id"])
        if len(chosen) + len(tool_records) < SEARCH_SOURCE_LIMIT:
            for source in retrieve_original_sources(run_dir, selected):
                if source["source_id"] in covered_ids or source.get("source_commit_id") in covered_commits:
                    continue
                size = len(compact_context_value(source).encode())
                if len(chosen) + len(tool_records) < SEARCH_SOURCE_LIMIT and source_chars + size <= manifest["budgets"]["max_retrieved_source_tokens"] * 3:
                    chosen.append(source)
                    source_chars += size
                    covered_ids.add(source["source_id"])
                else:
                    receipt["omissions"].append({"source_id": source["source_id"], "reason": "retrieval_budget"})
        current_knowledge = {event["constraint_id"] for subject in knowledge for relation, propositions in subject.items() if isinstance(propositions, dict) for event in propositions.values()}
        current_facts = {event["constraint_id"] for event in past}
        historical = []
        for event in selected:
            kind = event["constraint_kind"]
            reason = "superseded" if kind == "canonical_fact" and event["constraint_id"] not in current_facts else "retracted_or_superseded" if kind == "knowledge_state" and event["constraint_id"] not in current_knowledge else None
            if kind in {"obligation", "obligation_update"} and event["data"].get("status") != obligations.get(event["data"]["obligation_id"], {}).get("data", {}).get("status"):
                reason = "historical_obligation_status"
            if reason:
                historical.append({"authority": "CONSTRAINT HISTORY", "current_state_note": reason, "event": event})
        # Source identities are deduplicated before packing; soft continuity may be omitted, never required inputs.
        optional = [("MODEL REQUESTED VERIFIED RECORDS", tool_groups["selected_sources"]),
                    ("MODEL REQUESTED CONSTRAINT HISTORY", tool_groups["selected_constraints"]),
                    ("MODEL REQUESTED TENTATIVE PLAN ITEMS", tool_groups["selected_plan_items"]),
                    ("RETRIEVED ORIGINAL SOURCE EVIDENCE", chosen),
                    ("OTHER RELEVANT PAST CONSTRAINTS", [event for event in past if event["data"]["fact_id"] not in protected_fact_ids]),
                    ("OTHER RELEVANT CHARACTER KNOWLEDGE", optional_knowledge), ("HISTORICAL CONSTRAINT EVENTS", historical),
                    ("RELEVANT MOTIF PRESSURES", motifs), ("RECENT LOCAL SOURCE", [record for record in recent if record["commit_id"] not in covered_commits]),
                    ("SOFT FUTURE PRESSURES", soft)]
        text = pack_packet_context(required, optional, optional_ceiling, receipt)
        for record in tool_records + chosen:
            group, metadata = retrieval_record_metadata(record)
            omitted = any(item.get("reason") == "prepared_context_budget" and all(item.get(key) == value for key, value in metadata.items())
                for item in receipt["omissions"])
            entries = receipt.setdefault(group, [])
            if not omitted and not any(all(entry.get(key) == value for key, value in metadata.items()) for entry in entries):
                entries.append(metadata | ranks.get((record.get("source_commit_id"), record.get("record_pointer")), {}) | {"required": False})
        return text
    finally:
        write_json(receipt_path, receipt)


def evaluate_feasibility(architecture: dict, obligations: dict, foreclosure_candidates: dict) -> list[dict]:
    results = []
    for attractor in architecture["attractors"]:
        prerequisite_ids = set(attractor["prerequisite_obligation_ids"])
        prerequisites = [obligations[item]["data"] for item in prerequisite_ids if item in obligations]
        missing = prerequisite_ids - set(obligations)
        candidates = [
            event
            for event in foreclosure_candidates.values()
            if event["data"]["attractor_id"] == attractor["attractor_id"]
        ]
        universal_impossible = [
            item for item in prerequisites
            if item["hardness"] == "hard" and item["universality"] == "universal" and item["status"] == "impossible"
        ]
        impossible = [item for item in prerequisites if item["hardness"] == "hard" and item["status"] == "impossible"]
        lawful = []
        for candidate in candidates:
            negated = set(candidate["data"]["negated_prerequisite_obligation_ids"])
            if (
                attractor["foreclosable"]
                and negated
                and negated.issubset(prerequisite_ids)
                and all(
                    item in obligations
                    and obligations[item]["data"]["status"] == "impossible"
                    and obligations[item]["data"]["universality"] != "universal"
                    for item in negated
                )
            ):
                lawful.append(candidate)
        if missing or universal_impossible or (impossible and not attractor["foreclosable"]):
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "universally_required_but_impossible",
                "reason": "A required obligation is missing or mechanically impossible and cannot be lawfully foreclosed.",
                "source_ids": [source["artifact_id"] for item in universal_impossible for source in obligations[item["obligation_id"]]["sources"]],
            })
        elif lawful:
            candidate = lawful[-1]
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "foreclosed",
                "reason": candidate["data"]["reason"],
                "source_ids": [source["artifact_id"] for source in candidate["sources"]],
            })
        elif candidates or impossible:
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "endangered",
                "reason": "Committed history threatens this attractor, but lawful foreclosure is not yet established.",
                "source_ids": [source["artifact_id"] for item in candidates for source in item["sources"]],
            })
        else:
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "viable",
                "reason": "No hard prerequisite has been irreversibly negated.",
                "source_ids": [],
            })
    return results


def obligation_assignment_score(obligation: dict, plan: dict, architecture: dict) -> int:
    score = 0
    targets = set(obligation["termination_targets"])
    if plan["packet_slot_id"] in targets or set(plan["attractor_ids"]) & targets:
        score += 12
    obligation_tags = obligation.get("relevance", {})
    plan_tags = plan.get("relevance", {})
    for key, weight in (
        ("arc_ids", 10), ("branch_ids", 10), ("claimant_ids", 8),
        ("character_ids", 8), ("technical_slot_ids", 8), ("object_ids", 6),
        ("location_ids", 6), ("state_keys", 6), ("motif_ids", 5),
    ):
        if set(obligation_tags.get(key, [])) & set(plan_tags.get(key, [])):
            score += weight
    if any(
        obligation["obligation_id"] in attractor["prerequisite_obligation_ids"]
        for attractor in architecture["attractors"]
        if attractor["attractor_id"] in plan["attractor_ids"]
    ):
        score += 8
    words = set(re.findall(r"[a-z0-9_]+", " ".join(plan["soft_guidance"] + plan_tags.get("keywords", [])).lower()))
    obligation_words = set(re.findall(r"[a-z0-9_]+", obligation["description"].lower()))
    return score + min(5, len(words & obligation_words))


def build_prospective_plan(run_dir: Path, architecture: dict, recomputed_after_commit_id: str) -> dict:
    obligations = _read_state_map(run_dir, "obligations.json")
    foreclosures = _read_state_map(run_dir, "foreclosure-candidates.json")
    feasibility = evaluate_feasibility(architecture, obligations, foreclosures)
    feasibility_by_id = {item["attractor_id"]: item["status"] for item in feasibility}
    committed = completed_packet_slots(architecture, all_committed_records(run_dir))
    uncommitted_plans = [plan for plan in architecture["packet_plans"] if plan["packet_slot_id"] not in committed]
    literary_pending = any(plan["packet_kind"] == "literary" for plan in uncommitted_plans)
    live = architecture | {"attractors": [item for item in architecture["attractors"] if feasibility_by_id[item["attractor_id"]] != "foreclosed"]}
    required = ending_prerequisite_ids(live, obligations)
    invalid = sorted(identifier for identifier in required if obligations[identifier]["data"]["status"] not in {"active", "satisfied"})
    if invalid:
        raise CathedralsError("Forward feasibility", "Ending prerequisites were resolved without satisfaction: " + ", ".join(invalid), "continuity_impossibility")
    pending = sorted(identifier for identifier in required if obligations[identifier]["data"]["status"] != "satisfied")
    if pending and not literary_pending:
        raise PausedError("Ending prerequisites", "No remaining literary plan can establish: " + ", ".join(pending))
    obligation_assignments = []
    for obligation_id, event in obligations.items():
        obligation = event["data"]
        if obligation["status"] != "active":
            continue
        candidates = [
            plan for plan in uncommitted_plans
            if plan["packet_kind"] != "ending"
            or (
                obligation["hardness"] == "soft"
                and all(feasibility_by_id[item] == "viable" for item in plan["attractor_ids"])
                and all(
                    obligations[prerequisite]["data"]["status"] == "satisfied"
                    for attractor_id in plan["attractor_ids"]
                    for prerequisite in next(
                        item for item in architecture["attractors"] if item["attractor_id"] == attractor_id
                    )["prerequisite_obligation_ids"]
                )
            )
        ]
        if not candidates:
            continue
        ranked = sorted(
            ((obligation_assignment_score(obligation, plan, architecture), plan) for plan in candidates),
            key=lambda item: (-item[0], item[1]["initial_priority"], item[1]["packet_slot_id"]),
        )
        score, assigned = ranked[0]
        obligation_assignments.append({
            "obligation_id": obligation_id,
            "packet_slot_id": assigned["packet_slot_id"],
            "score": score,
            "reason": "Best current lawful target by declared termination, structural relevance, and lexical pressure.",
        })
    packet_order = []
    for plan in uncommitted_plans:
        if plan["packet_slot_id"] in committed or not set(plan["depends_on_packet_slot_ids"]).issubset(committed):
            continue
        if plan["packet_kind"] == "ending" and literary_pending:
            continue
        statuses = [feasibility_by_id[item] for item in plan["attractor_ids"]]
        if plan["packet_kind"] == "ending":
            prerequisites = [
                prerequisite
                for attractor_id in plan["attractor_ids"]
                for prerequisite in next(
                    item for item in architecture["attractors"] if item["attractor_id"] == attractor_id
                )["prerequisite_obligation_ids"]
            ]
            if any(status != "viable" for status in statuses) or any(
                obligations[item]["data"]["status"] != "satisfied" for item in prerequisites
            ):
                continue
        assigned_ids = [
            item["obligation_id"] for item in obligation_assignments if item["packet_slot_id"] == plan["packet_slot_id"]
        ]
        active = [obligations[item]["data"] for item in assigned_ids]
        score = sum(12 if item["hardness"] == "hard" else 5 for item in active)
        score += max(0, 8 - plan["initial_priority"])
        packet_order.append({
            "packet_slot_id": plan["packet_slot_id"],
            "score": score,
            "reason": "Eligible by committed dependencies; ranked by active constraint pressure and initial priority.",
        })
    packet_order.sort(key=lambda item: (-item["score"], item["packet_slot_id"]))
    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        sequence = db.execute("SELECT COALESCE(MAX(sequence),0)+1 FROM plans").fetchone()[0]
    return {
        "record_type": "prospective_plan",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": run_dir.name,
        "plan_id": f"prospective_plan_{sequence:04d}",
        "based_on_canonical_state_hash": load_state(run_dir)["canonical_state_hash"],
        "recomputed_after_commit_id": recomputed_after_commit_id,
        "created_at": utc_now(),
        "feasibility": feasibility,
        "obligation_assignments": obligation_assignments,
        "packet_order": packet_order,
    }


def recompute_prospective_plan(run_dir: Path, recomputed_after_commit_id: str) -> dict:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        return {}
    step_id = f"prospective_{sha256_bytes(recomputed_after_commit_id.encode())[:16]}"
    if step_is_committed(run_dir, step_id):
        return _read_state_map(run_dir, "prospective-plan.json")
    plan = build_prospective_plan(run_dir, architecture, recomputed_after_commit_id)
    protocol = load_protocol(run_dir)
    validate_json_schema(plan, protocol["$defs"]["prospectivePlan"], protocol)
    history = run_dir / "planning/prospective-plans.jsonl"
    with history.open("ab") as handle:
        handle.write(canonical_json(plan))
        handle.flush()
        os.fsync(handle.fileno())
    plan_hash = sha256_bytes(canonical_json(plan))
    append_deterministic_step(run_dir, step_id, "prospective_plan", plan_hash, prospective_plan_hash=plan_hash, plan=plan)
    return plan


def select_next_packet(run_dir: Path, architecture: dict) -> dict | None:
    prospective = _read_state_map(run_dir, "prospective-plan.json")
    if not prospective:
        prospective = recompute_prospective_plan(run_dir, architecture["commit_id"])
    impossible = [item for item in prospective["feasibility"] if item["status"] == "universally_required_but_impossible"]
    if impossible:
        raise CathedralsError("Forward feasibility", impossible[0]["reason"], "continuity_impossibility")
    plans = {item["packet_slot_id"]: item for item in architecture["packet_plans"]}
    if not prospective["packet_order"]:
        return None
    packet_slot_id = prospective["packet_order"][0]["packet_slot_id"]
    assignments = [
        item["obligation_id"]
        for item in prospective["obligation_assignments"]
        if item["packet_slot_id"] == packet_slot_id
    ]
    obligations = _read_state_map(run_dir, "obligations.json")
    assignments = [identifier for identifier in assignments if obligations[identifier]["data"]["hardness"] == "hard"]
    eligible_assignments = list(assignments)
    completed = completed_packet_slots(architecture, all_committed_records(run_dir))
    remaining = [plan for plan in architecture["packet_plans"] if plan["packet_kind"] == "literary" and plan["packet_slot_id"] not in completed]
    # A long-range payoff is pressure before its deadline, not a demand to close it in the opening.
    assignments = [identifier for identifier in assignments if obligations[identifier]["data"]["range"] != "long_range" or len(remaining) <= 1]
    may_satisfy = [
        item for item in eligible_assignments
        if all(obligations[required]["data"]["status"] == "satisfied" for required in obligations[item]["data"]["requires"])
    ]
    if architecture.get("causal_scaffold"):
        # A scheduling score cannot turn an ending's transformation into an earlier mandatory resolution.
        assignments = []
    return plans[packet_slot_id] | {
        "advance_obligation_ids": assignments,
        "may_satisfy_obligation_ids": may_satisfy,
    }


def step_is_committed(run_dir: Path, step_id: str) -> bool:
    return any(
        entry["planned_step_id"] == step_id and entry["commit_status"] == "COMMITTED"
        for entry in step_entries(run_dir, step_id)
    )


def distribute_counts(total: int, groups: int) -> list[int]:
    quotient, remainder = divmod(total, groups)
    return [quotient + (index < remainder) for index in range(groups)]


def planned_packet_specs(architecture_core: dict) -> list[dict]:
    scope = architecture_core["scope_commitment"]
    scene_groups = grouped_counts(scope["planned_scene_count"], 6, 3, 8)
    ending_groups = ([1] * scope["planned_ending_count"] if architecture_core.get("causal_scaffold")
        else grouped_counts(scope["planned_ending_count"], 2, 2, 6))
    artifact_counts = distribute_counts(scope["planned_artifact_count"], len(scene_groups))
    composition_counts = distribute_counts(scope["planned_formal_composition_count"], len(scene_groups))
    if any(value > 6 for value in artifact_counts) or any(value > 4 for value in composition_counts):
        raise SchemaError("Architecture scope cannot fit bounded packet allocations")
    specs = []
    scene_number = 1
    for index, size in enumerate(scene_groups, 1):
        slots = [f"scene_slot_{number:04d}" for number in range(scene_number, scene_number + size)]
        scene_number += size
        specs.append({
            "packet_slot_id": f"literary_packet_{index:04d}",
            "packet_kind": "literary",
            "scene_slot_ids": slots,
            "ending_slot_ids": [],
            "artifact_count": artifact_counts[index - 1],
            "formal_composition_count": composition_counts[index - 1],
        })
    ending_number = 1
    for index, size in enumerate(ending_groups, 1):
        slots = [f"ending_slot_{number:04d}" for number in range(ending_number, ending_number + size)]
        ending_number += size
        specs.append({
            "packet_slot_id": f"ending_packet_{index:04d}",
            "packet_kind": "ending",
            "scene_slot_ids": [],
            "ending_slot_ids": slots,
            "artifact_count": 0,
            "formal_composition_count": 0,
        })
    return specs


def plan_batches(architecture_core: dict) -> list[list[dict]]:
    specs = planned_packet_specs(architecture_core)
    return [specs[index:index + PLAN_BATCH_SIZE] for index in range(0, len(specs), PLAN_BATCH_SIZE)]


def deterministic_id(prefix: str, *parts) -> str:
    identity = ":".join(str(part) for part in parts)
    return f"{prefix}_{sha256_bytes(identity.encode())[:16]}"


def record_envelope(run_dir: Path, record_type: str, step_id: str) -> dict:
    return {
        "record_type": record_type,
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": run_dir.name,
        "commit_id": deterministic_id("commit", run_dir.name, step_id),
    }


def build_genesis_foundation(run_dir: Path, payload: dict) -> dict:
    anchors = [
        item | {"claimant_id": f"claimant_{index:02d}", "technical_slot_id": f"claimant_slot_{index:02d}"}
        for index, item in enumerate(payload["claimant_anchors"], 1)
    ]
    canon = payload["work_canon"] | {
        "work_id": "cathedrals-v01",
        "chronology": [item | {"event_id": f"chronology_event_{index:03d}"} for index, item in enumerate(payload["work_canon"]["chronology"], 1)],
    }
    return record_envelope(run_dir, "genesis_foundation", "genesis_foundation") | {
        "story_format": "web",
        **(payload | {"claimant_anchors": anchors, "work_canon": canon}),
    }


def build_genesis_cast(run_dir: Path, payload: dict) -> dict:
    foundation = committed_record(run_dir, "genesis_foundation")
    characters = [
        item | {"character_id": f"character_{index:03d}", "technical_slot_id": f"character_slot_{index:03d}"}
        for index, item in enumerate(payload["characters"], 1)
    ]
    return record_envelope(run_dir, "genesis_cast", "genesis_cast") | {
        "foundation_commit_id": foundation["commit_id"],
        "story_format": "web",
        **(payload | {"characters": characters}),
    }


def build_genesis_constraints(run_dir: Path, payload: dict) -> dict:
    cast = committed_record(run_dir, "genesis_cast")
    if payload["new_soft_obligations"] or payload["obligation_updates"]:
        raise SchemaError("Genesis semantic normalization cannot create or update obligations")
    extensions = payload.get("_claimant_extensions", [])
    content_ids = {key: item["source_ref"] for key, item in genesis_source_catalog(run_dir, extensions).items()}
    delta = build_semantic_delta(run_dir, "genesis_constraints", payload, content_ids)
    return record_envelope(run_dir, "genesis_constraints", "genesis_constraints") | {
        "cast_commit_id": cast["commit_id"], "story_format": "web",
        "claimant_extensions": extensions, "constraint_delta": delta,
    }


def architecture_aliases(run_dir: Path) -> dict[str, str]:
    foundation = committed_record(run_dir, "genesis_foundation") or {}
    cast = committed_record(run_dir, "genesis_cast") or {}
    constraints = committed_record(run_dir, "genesis_constraints") or {}
    genesis = committed_record(run_dir, "genesis") or {}
    aliases = {
        item["technical_slot_id"]: item["claimant_id"]
        for item in genesis.get("claimants", [])
    }
    for alias, record in (
        ("genesis", genesis),
        ("genesis_commit", genesis),
        ("genesis_foundation", foundation),
        ("genesis_work_canon", foundation),
        ("genesis_cast", cast),
        ("genesis_constraints", constraints),
    ):
        if record.get("commit_id"):
            aliases[alias] = record["commit_id"]
    return aliases


def normalize_architecture_core_payload(payload: dict, run_dir: Path) -> dict:
    value = copy.deepcopy(payload)
    aliases = architecture_aliases(run_dir)

    def remap(values):
        return [aliases.get(item, item) for item in values]

    for arc in value["arcs"]:
        arc["claimant_pressures"] = remap(arc["claimant_pressures"])
        if "claimant_ids" in arc.get("relevance", {}):
            arc["relevance"]["claimant_ids"] = remap(arc["relevance"]["claimant_ids"])
    for item in value["obligation_graph"]:
        item["status"] = "active"
        item["created_by_ids"] = remap(item["created_by_ids"])
        for source in item["sources"]:
            source["artifact_id"] = aliases.get(source["artifact_id"], source["artifact_id"])
        if "claimant_ids" in item.get("relevance", {}):
            item["relevance"]["claimant_ids"] = remap(item["relevance"]["claimant_ids"])
    for item in value["attractors"]:
        if "claimant_ids" in item.get("relevance", {}):
            item["relevance"]["claimant_ids"] = remap(item["relevance"]["claimant_ids"])

    obligations = {item["obligation_id"]: item for item in value["obligation_graph"]}
    for attractor in value["attractors"]:
        for obligation_id in attractor["prerequisite_obligation_ids"]:
            if obligation_id in obligations:
                obligation = obligations[obligation_id]
                obligation["hardness"] = "hard"
                if attractor["attractor_id"] not in obligation["termination_targets"]:
                    obligation["termination_targets"].append(attractor["attractor_id"])

    topology = value["topology"]
    introductions = [item["node_id"] for item in topology["nodes"] if item.get("node_type") == "introduction"]
    if len(introductions) == 1:
        topology["entry_segment_id"] = introductions[0]
    topology["reconvergence_node_ids"] = [
        item["node_id"] for item in topology["nodes"] if item.get("node_type") == "reconvergence"
    ]
    outgoing = {}
    for edge in topology["edges"]:
        if edge["relation"] == "branch":
            outgoing[edge["from_node_id"]] = outgoing.get(edge["from_node_id"], 0) + 1
    opening = [node_id for node_id, count in outgoing.items() if count == 3]
    if len(opening) == 1:
        topology["opening_branch_node_id"] = opening[0]
    return value


def genesis_reference_catalog(run_dir: Path) -> dict[str, str]:
    genesis = committed_record(run_dir, "genesis")
    catalog = {identifier: identifier for identifier in _source_index(run_dir)}
    for record_type in ("genesis_foundation", "genesis_cast", "genesis_constraints"):
        record = committed_record(run_dir, record_type)
        if record and record.get("commit_id"):
            catalog[record["commit_id"]] = f"{record['commit_id']} — committed {record_type.replace('_', ' ')}"
    for claimant in genesis["claimants"]:
        details = [
            claimant.get(key) for key in ("occupation", "setting_relationship", "epistemic_regime")
            if claimant.get(key)
        ]
        catalog[claimant["claimant_id"]] = " — ".join(
            [claimant["claimant_id"], "; ".join(details)] if details else [claimant["claimant_id"]]
        )
    for character in genesis.get("characters", []):
        catalog[character["character_id"]] = (
            f"{character['character_id']} — {character['name']}, {character['role']}; "
            f"{character['dramatic_function']}"
        )
    for event in genesis.get("work_canon", {}).get("chronology", []):
        catalog[event["event_id"]] = f"{event['event_id']} — {event['event']}"
    delta = genesis.get("constraint_delta", {})
    for fact in delta.get("canonical_facts", []):
        catalog[fact["fact_id"]] = (
            f"{fact['fact_id']} — {fact['subject']} {fact['predicate']} {fact['value']}"
        )
    for knowledge in delta.get("knowledge_changes", []):
        catalog[knowledge["knowledge_id"]] = (
            f"{knowledge['knowledge_id']} — {knowledge['subject_id']} {knowledge['relation']} "
            f"{knowledge['proposition_id']}"
        )
    for motif in delta.get("motif_events", []):
        catalog[motif["motif_event_id"]] = (
            f"{motif['motif_event_id']} — motif {motif['motif_id']}: {motif['current_function']}"
        )
    return catalog


def architecture_id_catalog(payload: dict, run_dir: Path) -> dict[str, str]:
    catalog = genesis_reference_catalog(run_dir)
    for item in payload["obligation_graph"]:
        catalog[item["obligation_id"]] = f"{item['obligation_id']} — {item['kind']}; {item['description']}"
    for item in payload["attractors"]:
        catalog[item["attractor_id"]] = f"{item['attractor_id']} — {item['kind']}; {item['terminal_transformation']}"
    for item in payload["arcs"]:
        catalog[item["arc_id"]] = f"{item['arc_id']} — {item['branch_role']}; {item['purpose']}"
    for item in payload["topology"]["nodes"]:
        catalog[item["node_id"]] = f"{item['node_id']} — {item['node_type']}; {item['purpose']}"
    for item in payload["topology"]["edges"]:
        catalog[item["edge_id"]] = (
            f"{item['edge_id']} — {item['relation']} from {item['from_node_id']} to {item['to_node_id']}"
        )
    return catalog


def validate_architecture_draft(payload: dict, schema: dict, run_dir: Path) -> None:
    errors = _collect_schema_errors(payload, schema, schema, "$")
    if not errors:
        return
    if any(error[1] not in {"enum", "const", "pattern"} for error in errors):
        validate_json_schema(payload, schema)
    paths = {reference_path(issue["path"]) for issue in named_reference_issues(run_dir, payload, "architectureCorePayload")}
    if any(error[0] not in paths for error in errors):
        validate_json_schema(payload, schema)


def architecture_reference_issues(payload: dict, run_dir: Path) -> list[dict]:
    genesis = committed_record(run_dir, "genesis")
    claimant_ids = {item["claimant_id"] for item in genesis["claimants"]}
    committed_ids = set(_source_index(run_dir))
    obligation_ids = {item["obligation_id"] for item in payload["obligation_graph"]}
    attractor_ids = {item["attractor_id"] for item in payload["attractors"]}
    arc_ids = {item["arc_id"] for item in payload["arcs"]}
    node_ids = {item["node_id"] for item in payload["topology"]["nodes"]}
    edge_ids = {item["edge_id"] for item in payload["topology"]["edges"]}
    local_ids = obligation_ids | attractor_ids | arc_ids | node_ids | edge_ids
    issues = []

    def add(path, invalid, allowed, label, context, mode="replace"):
        candidates = sorted(set(allowed))
        if invalid not in candidates:
            issues.append({
                "path": path, "invalid": invalid, "candidates": candidates,
                "label": label, "context": context, "mode": mode,
            })

    for arc_index, arc in enumerate(payload["arcs"]):
        for value_index, value in enumerate(arc["claimant_pressures"]):
            add(("arcs", arc_index, "claimant_pressures", value_index), value, claimant_ids,
                "unknown claimant pressure", arc["purpose"])
        for value_index, value in enumerate(arc["hard_obligation_ids"]):
            add(("arcs", arc_index, "hard_obligation_ids", value_index), value, obligation_ids,
                "unknown arc obligation", arc["purpose"])
    for obligation_index, obligation in enumerate(payload["obligation_graph"]):
        context = obligation["description"]
        for field, allowed, label in (
            ("created_by_ids", committed_ids | attractor_ids | arc_ids | node_ids | edge_ids, "unknown obligation origin"),
            ("requires", obligation_ids, "unknown obligation prerequisite"),
            ("termination_targets", obligation_ids | attractor_ids, "unknown obligation termination target"),
        ):
            for value_index, value in enumerate(obligation[field]):
                add(("obligation_graph", obligation_index, field, value_index), value, allowed, label, context)
        if obligation["range"] == "long_range" and not obligation["termination_targets"]:
            add(("obligation_graph", obligation_index, "termination_targets"), None,
                obligation_ids | attractor_ids, "long-range obligation needs a termination target", context, "set_list")
        for source_index, source in enumerate(obligation["sources"]):
            add(("obligation_graph", obligation_index, "sources", source_index, "artifact_id"),
                source["artifact_id"], committed_ids | local_ids, "unresolved obligation source", context)
    for attractor_index, attractor in enumerate(payload["attractors"]):
        for value_index, value in enumerate(attractor["prerequisite_obligation_ids"]):
            add(("attractors", attractor_index, "prerequisite_obligation_ids", value_index), value,
                obligation_ids, "unknown attractor prerequisite", attractor["terminal_transformation"])
    for group in ("nodes", "edges"):
        for item_index, item in enumerate(payload["topology"][group]):
            for value_index, value in enumerate(item["hard_obligation_ids"]):
                add(("topology", group, item_index, "hard_obligation_ids", value_index), value,
                    obligation_ids, "unknown topology obligation", item["purpose"] if group == "nodes" else item["relation"])
    relevance_catalogs = {
        "claimant_ids": claimant_ids, "arc_ids": arc_ids,
        "character_ids": {item["character_id"] for item in genesis.get("characters", [])},
        "motif_ids": set(_read_state_map(run_dir, "motifs.json")),
        "technical_slot_ids": {item["technical_slot_id"] for item in genesis["claimants"] + genesis.get("characters", [])},
        "state_keys": set(load_protocol(run_dir)["$defs"]["stateKey"]["enum"]),
    }
    for group in ("obligation_graph", "attractors"):
        for item_index, item in enumerate(payload[group]):
            for field, allowed in relevance_catalogs.items():
                for value_index, value in enumerate(item.get("relevance", {}).get(field, [])):
                    add((group, item_index, "relevance", field, value_index), value, allowed,
                        f"unknown relevance {field}", item)
    for index, issue in enumerate(issues, 1):
        issue["issue_id"] = f"repair_{index:03d}"
    return issues


def validate_architecture_core_payload(payload: dict, run_dir: Path) -> None:
    genesis = committed_record(run_dir, "genesis")
    claimant_ids = {item["claimant_id"] for item in genesis["claimants"]}
    committed_ids = set(_source_index(run_dir))
    obligations = {item["obligation_id"]: item for item in payload["obligation_graph"]}
    attractor_ids = {item["attractor_id"] for item in payload["attractors"]}
    arc_ids = {item["arc_id"] for item in payload["arcs"]}
    topology = payload["topology"]
    node_ids = {item["node_id"] for item in topology["nodes"]}
    edge_ids = {item["edge_id"] for item in topology["edges"]}
    local_ids = set(obligations) | attractor_ids | arc_ids | node_ids | edge_ids
    problems = []

    def reject_unknown(values, allowed, label):
        unknown = sorted(set(values) - set(allowed))
        if unknown:
            problems.append(f"{label}: {', '.join(unknown)}")

    node_references = [topology["entry_segment_id"], topology["opening_branch_node_id"], *topology["reconvergence_node_ids"]]
    node_references += [item[key] for item in topology["edges"] for key in ("from_node_id", "to_node_id")]
    reject_unknown(node_references, node_ids, "undeclared topology nodes")
    reject_unknown(
        [value for item in payload["arcs"] for value in item["claimant_pressures"]],
        claimant_ids,
        "unknown claimant pressures",
    )
    reject_unknown(
        [value for item in obligations.values() for value in item["created_by_ids"]],
        committed_ids | attractor_ids | arc_ids | node_ids | edge_ids,
        "unknown obligation origins",
    )
    obligation_references = [value for item in obligations.values() for value in item["requires"]]
    obligation_references += [value for item in payload["attractors"] for value in item["prerequisite_obligation_ids"]]
    obligation_references += [value for item in payload["arcs"] for value in item["hard_obligation_ids"]]
    obligation_references += [value for item in topology["nodes"] for value in item["hard_obligation_ids"]]
    obligation_references += [value for item in topology["edges"] for value in item["hard_obligation_ids"]]
    reject_unknown(obligation_references, obligations, "unknown obligation references")
    reject_unknown(
        [value for item in obligations.values() for value in item["termination_targets"]],
        set(obligations) | attractor_ids,
        "unknown obligation termination targets",
    )
    soft_prerequisites = sorted({
        value
        for item in payload["attractors"]
        for value in item["prerequisite_obligation_ids"]
        if value in obligations and obligations[value]["hardness"] != "hard"
    })
    if soft_prerequisites:
        problems.append(f"attractor prerequisites are not hard obligations: {', '.join(soft_prerequisites)}")
    reject_unknown(
        [source["artifact_id"] for item in obligations.values() for source in item["sources"]],
        committed_ids | local_ids,
        "unresolved obligation sources",
    )
    if problems:
        raise SchemaError("Architecture core has unresolved semantics: " + "; ".join(problems))


def build_architecture_core(run_dir: Path, payload: dict) -> dict:
    payload = normalize_architecture_core_payload(payload, run_dir)
    validate_architecture_core_payload(payload, run_dir)
    manifest = read_json(run_dir / "run-manifest.json")
    scope = manifest["scope"]
    commitment = {
        "possible_scene_count": scope["possible_scene_count"],
        "planned_scene_count": scope["possible_scene_count"],
        "planned_artifact_count": scope["artifact_target"],
        "planned_ending_count": scope["ending_target"],
        "planned_formal_composition_count": scope["formal_composition_target"],
        "saturation_rationale": payload["saturation_rationale"],
    }
    artistic = dict(payload)
    artistic.pop("saturation_rationale")
    obligation_ids = {item["obligation_id"]: f"obligation_{index:03d}" for index, item in enumerate(artistic["obligation_graph"], 1)}
    attractor_ids = {item["attractor_id"]: f"attractor_{index:03d}" for index, item in enumerate(artistic["attractors"], 1)}
    arc_ids = {item["arc_id"]: f"arc_{index:03d}" for index, item in enumerate(artistic["arcs"], 1)}
    node_ids = {item["node_id"]: f"architecture_node_{index:03d}" for index, item in enumerate(artistic["topology"]["nodes"], 1)}
    edge_ids = {item["edge_id"]: f"architecture_edge_{index:03d}" for index, item in enumerate(artistic["topology"]["edges"], 1)}
    topology = artistic["topology"]
    termination_ids = obligation_ids | attractor_ids
    committed_ids = {identifier: identifier for identifier in _source_index(run_dir)}
    origin_ids = attractor_ids | arc_ids | node_ids | edge_ids | committed_ids
    source_ids = obligation_ids | origin_ids

    def ids(values, mapping):
        return [mapping.get(value, value) for value in values]

    def relevance(value):
        return value | {
            "arc_ids": ids(value.get("arc_ids", []), arc_ids),
            "branch_ids": ids(value.get("branch_ids", []), source_ids),
        }

    artistic["obligation_graph"] = [item | {
        "obligation_id": obligation_ids[item["obligation_id"]], "created_by_ids": ids(item["created_by_ids"], origin_ids),
        "requires": ids(item["requires"], obligation_ids), "termination_targets": ids(item["termination_targets"], termination_ids),
        "sources": [source if source["artifact_id"] in committed_ids else source | {
            "artifact_id": source_ids[source["artifact_id"]], "artifact_type": "architecture",
        } for source in item["sources"]],
        "relevance": relevance(item["relevance"]),
    } for item in artistic["obligation_graph"]]
    artistic["attractors"] = [item | {
        "attractor_id": attractor_ids[item["attractor_id"]],
        "prerequisite_obligation_ids": ids(item["prerequisite_obligation_ids"], obligation_ids),
        "relevance": relevance(item["relevance"]),
    } for item in artistic["attractors"]]
    artistic["arcs"] = [item | {"arc_id": arc_ids[item["arc_id"]], "hard_obligation_ids": ids(item["hard_obligation_ids"], obligation_ids)} for item in artistic["arcs"]]
    artistic["topology"] = topology | {
        "entry_segment_id": node_ids[topology["entry_segment_id"]],
        "opening_branch_node_id": node_ids[topology["opening_branch_node_id"]],
        "reconvergence_node_ids": [node_ids[value] for value in topology["reconvergence_node_ids"]],
        "nodes": [item | {"node_id": node_ids[item["node_id"]], "hard_obligation_ids": ids(item["hard_obligation_ids"], obligation_ids)} for item in topology["nodes"]],
        "edges": [item | {"edge_id": edge_ids[item["edge_id"]], "from_node_id": node_ids[item["from_node_id"]], "to_node_id": node_ids[item["to_node_id"]], "hard_obligation_ids": ids(item["hard_obligation_ids"], obligation_ids)} for item in topology["edges"]],
    }
    artistic["constraint_delta"] = {"canonical_facts": [], "knowledge_changes": [], "new_obligations": [], "obligation_updates": [], "motif_events": [], "potential_foreclosures": []}
    return record_envelope(run_dir, "architecture_core", "architecture_core") | {
        "genesis_commit_id": committed_record(run_dir, "genesis")["commit_id"],
        "story_format": "web", "scope_commitment": commitment, **artistic,
    }


def preserve_artistic_payload(run_dir: Path, step_id: str, payload: dict, content: str, response: dict) -> None:
    base = run_dir / ".staging" / step_id
    if not base.with_suffix(".artistic.json").exists():
        write_json(base.with_suffix(".artistic.json"), payload, mode=0o444, exclusive=True)
        write_atomic(base.with_suffix(".artistic.txt"), content.encode(), mode=0o444, exclusive=True)
        write_json(base.with_suffix(".artistic.api.json"), response, mode=0o444, exclusive=True)


def planning_string_value(content: str, schema: dict, path=None):
    if content.strip() in schema.get("enum", []):
        return content.strip()

    def unique_object(pairs):
        value = {}
        for key, child in pairs:
            if key in value:
                raise SchemaError(f"Planning value response repeats the JSON key {key!r}")
            value[key] = child
        return value

    framed = re.fullmatch(r"\s*```(?:json)?\s*\n([\s\S]*)\n```\s*", content)
    try:
        value = json.loads(framed.group(1) if framed else content, object_pairs_hook=unique_object)
    except json.JSONDecodeError:
        return content
    if isinstance(value, str):
        return value
    if isinstance(value, dict) and set(value) == {"value"}:
        return value["value"]
    if isinstance(value, (dict, list)):
        candidate = value
        for part in path or []:
            if isinstance(candidate, dict) and set(candidate) == {part}:
                candidate = candidate[part]
            elif isinstance(candidate, list) and part == 0 and len(candidate) == 1:
                candidate = candidate[0]
            else:
                break
        else:
            if path:
                return candidate
        raise SchemaError('Return exactly {"value": "the requested string"}; do not return a containing record, graph patch, or alternatives.')
    return content


def request_architecture_analysis(
    run_dir: Path, step_id: str, prompt: str, schema: dict, transport, validator=None,
    *, phase="architecture", system_prompt="Repair only the identified uncommitted Architecture fields. Return JSON only.",
    response_name="architectureRepair", pause_stage="Architecture repair",
    value_mode=False, value_path=None, initial_draft=False, temperature=0.0, max_tokens=None,
    planning_mode=False, context_purpose="planning", retrieval_task=None, result_normalizer=None,
):
    brief = read_json(run_dir / "generation-brief.json")
    seed = step_seed(brief["generation_seed"], step_id)
    maximum = max_tokens or read_json(run_dir / "run-manifest.json")["budgets"]["max_analysis_output_tokens"]
    parameters = {"temperature": temperature, "max_tokens": maximum, "seed": seed, "stream": True, "stream_options": {"include_usage": True}}
    string_value = value_mode and schema.get("type") == "string"
    response_schema = schema
    if string_value:
        response_schema = {"type": "object", "additionalProperties": False, "required": ["value"],
            "properties": {"value": {key: value for key, value in schema.items() if key != "$defs"}}}
        if "$defs" in schema:
            response_schema["$defs"] = schema["$defs"]
    response_schema = copy.deepcopy(response_schema)
    for name in ("sourceRef", "hashedSourceRef"):
        if name in response_schema.get("$defs", {}):
            response_schema["$defs"][name]["properties"].pop("record_pointer", None)
    if planning_mode and context_purpose == "planning" and retrieval_task is not None:
        extra = retrieval_working_set(run_dir, step_id, retrieval_task["task"], transport,
            scope_id=retrieval_task["scope_id"], scope_step=retrieval_task["step_id"])
        if extra:
            prompt += "\nOPTIONAL VERIFIED RETRIEVAL\n" + compact_context_value(extra)
    feedback = ""
    for correction in range(3):
        current_prompt = prompt + feedback
        if planning_mode:
            parameters["max_tokens"] = planning_output_limit(run_dir, current_prompt, schema, maximum, pause_stage, purpose=context_purpose)
        entries = step_entries(run_dir, step_id)
        attempts = [entry["attempt"] for entry in entries]
        attempt = max(attempts, default=0) + 1
        if planning_mode:
            accepted = [entry["attempt"] for entry in entries if entry["step_type"] == "analysis" and entry["commit_status"] == "COMMITTED"]
            if accepted:
                attempt = max(accepted)
        response_path = run_dir / "raw" / f"{step_id}-attempt{attempt}.api.json"
        started = utc_now()
        response = read_json(response_path) if response_path.exists() else None
        request_meta = {"step_id": step_id, "attempt": attempt, "parameters": parameters,
                        "prompt_hash": sha256_bytes(current_prompt.encode()), "context_hash": sha256_bytes(prompt.encode())}
        try:
            if response is None:
                budgets = read_json(run_dir / "run-manifest.json")["budgets"]
                prompt_tokens = math.ceil(len(current_prompt.encode()) / 3)
                window = min(budgets.get("model_context_window_tokens", float("inf")),
                             load_state(run_dir).get("model_context_window_tokens", float("inf")))
                if prompt_tokens > min(prepared_context_limit(budgets, planning=planning_mode and context_purpose == "planning"),
                                       window - parameters["max_tokens"]
                                       - budgets.get("context_safety_reserve_tokens", 4096)):
                    raise CathedralsError(pause_stage, "Repair exceeds the frozen context budget", "budget_exhaustion")
                if load_state(run_dir).get("analysis_step_count", 0) + successful_structural_repair_count(run_dir) >= budgets.get("max_analysis_step_count", float("inf")):
                    raise CathedralsError(pause_stage, "Repair exceeds max_analysis_step_count", "budget_exhaustion")
                usage = [(read_json(path).get("usage") or {}) for path in (run_dir / "raw").glob("*.api.json")]
                for key, ceiling, reserve in (("prompt_tokens", "max_cumulative_input_tokens", prompt_tokens),
                                               ("completion_tokens", "max_cumulative_output_tokens", parameters["max_tokens"])):
                    if sum(item.get(key) or 0 for item in usage) + reserve > budgets.get(ceiling, float("inf")):
                        raise CathedralsError(pause_stage, f"Repair exceeds {ceiling}", "budget_exhaustion")
                request = {
                    "model": load_state(run_dir)["model"],
                    "messages": [
                        {"role": "system", "content": system_prompt},
                        {"role": "user", "content": current_prompt},
                    ],
                    **parameters,
                    "response_format": {"type": "json_schema", "json_schema": {"name": response_name, "strict": True, "schema": response_schema}},
                }
                response, content = provider_response(
                    transport, api_url(brief["lm_studio_base_url"], "/v1/chat/completions"), request,
                    float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")), started_at=started,
                    preserve=lambda value: write_json(response_path, value | {"_cathedrals_request": request_meta}, mode=0o444, exclusive=True),
                    stream_path=response_path.with_suffix(".sse"),
                    plain_answers=set(schema["enum"]) if value_mode and schema.get("type") == "string" and "enum" in schema else None,
                )
            else:
                content = normalize_provider_response(response,
                    plain_answers=set(schema["enum"]) if value_mode and schema.get("type") == "string" and "enum" in schema else None)
            if string_value:
                authored = planning_string_value(content, schema, value_path)
            else:
                authored = parse_structured_content(content)
            if result_normalizer:
                authored = result_normalizer(authored)
            validate_json_schema(authored, schema)
            if validator:
                validator(authored)
            return authored, response | {"_cathedrals_request": response.get("_cathedrals_request", request_meta)}
        except CathedralsError as error:
            if isinstance(error, (TruncationError, IncompleteResponseError)):
                response = error.response
            append_failed_attempt(
                run_dir, step_id=step_id, attempt=attempt, phase=phase, prompt=current_prompt,
                context=prompt, parameters=parameters, started_at=started, failure_class=error.failure_class,
                step_type="analysis", output_hash=sha256_file(response_path) if response_path.exists() else None,
                usage=response.get("usage", {}) if isinstance(response, dict) else {},
            )
            if isinstance(error, IncompleteResponseError):
                raise PausedError(pause_stage, error.reason, error.failure_class) from error
            if initial_draft and isinstance(error, (SchemaError, TruncationError)):
                raise PausedError("Planning draft", error.reason) from error
            if error.failure_class not in RETRYABLE_PROVIDER_FAILURES and not isinstance(error, (SchemaError, TruncationError)):
                raise
            if correction < 2:
                if error.failure_class not in RETRYABLE_PROVIDER_FAILURES:
                    shape = ('Return exactly {"value": "the requested string"}, using the supplied value schema. '
                        'Do not return the surrounding record or a field-path patch.') if string_value else "Return only a corrected repair response."
                    feedback += f"\n\nCORRECTION REQUIRED\n{error.reason}\n{shape}"
                continue
            raise PausedError(
                pause_stage, f"{step_id} exhausted 3 focused repair attempts. Last problem: {error.reason}"
            ) from error
    raise PausedError(pause_stage, f"{step_id} exhausted its focused repair attempts")


def validate_genesis_constraints_payload(payload: dict) -> None:
    if payload["new_soft_obligations"] or payload["obligation_updates"]:
        raise SchemaError("Genesis semantic normalization cannot create or update obligations")
    identities = {
        canonical_json({key: item[key] for key in ("subject", "predicate", "value", "status")})
        for item in payload["canonical_facts"]
    }
    if len(identities) > 12:
        raise SchemaError("Genesis constraints exceed twelve unique canonical facts")
    if any(
        item.get("relevance", {}).get(key)
        for item in payload["canonical_facts"] + payload["knowledge_changes"] + payload["motif_events"]
        for key in ("arc_ids", "branch_ids")
    ):
        raise SchemaError("Genesis constraints cannot reference Architecture IDs")


def genesis_source_catalog(run_dir: Path, extensions=()) -> dict:
    foundation = committed_record(run_dir, "genesis_foundation")
    cast = committed_record(run_dir, "genesis_cast")
    sources = {}

    def add(handle, record, pointer, description, artifact_id=None):
        sources[handle] = {"technical_slot_id": handle, "description": description,
            "artifact_id": artifact_id or record["commit_id"],
            "source_ref": {"artifact_type": "genesis", "artifact_id": artifact_id or record["commit_id"],
                "source_locator": pointer, "record_pointer": pointer}}

    canon = foundation.get("work_canon", {})
    if canon:
        add("genesis_work_canon", foundation, "/work_canon", "Complete global world canon")
        for field in canon:
            if re.fullmatch(r"[a-z][a-z0-9_]*", field):
                add(field, foundation, f"/work_canon/{field}", f"Global canon: {field}")
        for index, event in enumerate(canon.get("chronology", [])):
            add(event["event_id"], foundation, f"/work_canon/chronology/{index}", event["event"], event["event_id"])
    if "format_composition_law" in foundation:
        add("genesis_format_composition_law", foundation, "/format_composition_law", "Format composition law")
    for index, anchor in enumerate(foundation.get("claimant_anchors", [])):
        add(anchor["technical_slot_id"], foundation, f"/claimant_anchors/{index}",
            f"Claimant anchor: {anchor.get('name', anchor['claimant_id'])}", anchor["claimant_id"])
    for index, profile in enumerate(cast.get("claimants", [])):
        handle = profile["claimant_id"].replace("claimant_", "claimant_profile_slot_", 1)
        add(handle, cast, f"/claimants/{index}", f"Complete profile: {profile['claimant_id']}")
    for index, character in enumerate(cast.get("characters", [])):
        add(character["technical_slot_id"], cast, f"/characters/{index}",
            f"Character: {character['name']}", character["character_id"])
    for extension in extensions:
        anchor = extension["anchor"]
        sources[anchor["technical_slot_id"]] = {"technical_slot_id": anchor["technical_slot_id"],
            "description": f"Claimant extension: {anchor['name']}", "artifact_id": anchor["claimant_id"],
            "source_ref": {"artifact_type": "genesis", "artifact_id": anchor["claimant_id"],
                "source_locator": f"Authored extension at {anchor['technical_slot_id']}"}}
    return sources


def genesis_constraint_catalog(run_dir: Path, extensions: list[dict]) -> dict:
    foundation = committed_record(run_dir, "genesis_foundation")
    cast = committed_record(run_dir, "genesis_cast")
    claimants = [
        expansion | anchor
        for anchor in foundation["claimant_anchors"]
        for expansion in cast["claimants"]
        if expansion["claimant_id"] == anchor["claimant_id"]
    ] + [extension["profile"] | extension["anchor"] for extension in extensions]
    return {
        "claimants": {item["claimant_id"]: item for item in claimants},
        "characters": {item["character_id"]: item for item in cast["characters"]},
        "sources": genesis_source_catalog(run_dir, extensions),
    }


def fact_position_aliases(index: int) -> tuple[str, ...]:
    return (
        f"fact_{index:02d}", f"prop_{index:02d}", f"proposition_{index:02d}",
        f"p{index:02d}", f"p{index:03d}", f"p_{index:03d}",
    )


def normalize_genesis_reference_aliases(payload: dict, run_dir: Path, extensions: list[dict]) -> dict:
    value = copy.deepcopy(payload)
    catalog = genesis_constraint_catalog(run_dir, extensions)
    identity_aliases = {item["technical_slot_id"]: key for group in ("claimants", "characters")
        for key, item in catalog[group].items()}
    aliases = {alias: f"fact_{index:02d}" for index in range(1, len(value["canonical_facts"]) + 1)
        for alias in fact_position_aliases(index)}
    for knowledge in value["knowledge_changes"]:
        knowledge["subject_id"] = identity_aliases.get(knowledge["subject_id"], knowledge["subject_id"])
        knowledge["proposition_id"] = aliases.get(knowledge["proposition_id"], knowledge["proposition_id"])
    for group in ("canonical_facts", "knowledge_changes", "motif_events"):
        for item in value[group]:
            tags = item.setdefault("relevance", {})
            tags["technical_slot_ids"] = list(dict.fromkeys([item["source"]["technical_slot_id"]] + tags.get("technical_slot_ids", [])))
    return value


def prepare_genesis_metadata(run_dir, payload, schema):
    # Check record shape before normalizing fields; only typed reference errors enter focused repair.
    loose = copy.deepcopy(schema)
    for node in _walk(loose):
        if isinstance(node, dict):
            node.pop("enum", None)
    validate_json_schema(payload, loose)
    value = normalize_genesis_reference_aliases(payload, run_dir, [])
    issues = genesis_reference_issues(value, run_dir, [])
    reference_paths = {reference_path(path) for issue in issues for path in issue["paths"]}
    errors = _collect_schema_errors(value, schema, schema, "$")
    if any(error[1] not in {"enum", "pattern", "const"} or error[0] not in reference_paths for error in errors):
        validate_json_schema(value, schema)
    return value


def genesis_reference_issues(payload: dict, run_dir: Path, extensions: list[dict]) -> list[dict]:
    catalog = genesis_constraint_catalog(run_dir, extensions)
    declared_motifs = {item["motif_id"] for item in payload["motif_events"]}
    allowed = {
        "source": set(catalog["sources"]),
        "claimant": set(catalog["claimants"]),
        "character": set(catalog["characters"]),
        "identity": set(catalog["claimants"]) | set(catalog["characters"]),
        "motif": declared_motifs,
        "proposition": {f"fact_{index:02d}" for index in range(1, len(payload["canonical_facts"]) + 1)},
    }
    fact_aliases = set()
    for index in range(1, len(payload["canonical_facts"]) + 1):
        fact_aliases.update(fact_position_aliases(index))
    grouped = {}

    def add(kind, path, invalid, context):
        if invalid in (fact_aliases if kind == "proposition" else allowed[kind]):
            return
        meaning = sha256_bytes(canonical_json(context))
        issue = grouped.setdefault((kind, invalid, meaning), {
            "kind": kind, "invalid": invalid, "paths": [], "contexts": [],
        })
        issue["paths"].append(path)
        if context not in issue["contexts"]:
            issue["contexts"].append(context)

    groups = ("canonical_facts", "knowledge_changes", "new_soft_obligations", "obligation_updates", "motif_events")
    for group in groups:
        for item_index, item in enumerate(payload[group]):
            if "source" in item:
                add("source", (group, item_index, "source", "technical_slot_id"),
                    item["source"]["technical_slot_id"], item)
            relevance = item.get("relevance", {})
            for field, kind in (
                ("claimant_ids", "claimant"), ("character_ids", "character"),
                ("motif_ids", "motif"), ("technical_slot_ids", "source"),
            ):
                for value_index, value in enumerate(relevance.get(field, [])):
                    add(kind, (group, item_index, "relevance", field, value_index), value, item)
    for index, item in enumerate(payload["knowledge_changes"]):
        add("identity", ("knowledge_changes", index, "subject_id"), item["subject_id"], item)
        add("proposition", ("knowledge_changes", index, "proposition_id"), item["proposition_id"], item)
    issues = list(grouped.values())
    for index, issue in enumerate(issues, 1):
        issue["issue_id"] = "genesis_reference_" + sha256_bytes(canonical_json({key: issue[key]
            for key in ("kind", "invalid", "contexts")}))[:12]
        issue["candidates"] = sorted(allowed[issue["kind"]])
    return issues


def claimant_resolution_request(issue: dict, run_dir: Path, extensions: list[dict]) -> tuple[str, dict]:
    catalog = genesis_constraint_catalog(run_dir, extensions)
    protocol = load_protocol(run_dir)
    profile = copy.deepcopy(protocol["$defs"]["claimant"])
    profile["required"].remove("claimant_id")
    profile["properties"].pop("claimant_id")
    characters = sorted(catalog["characters"])
    draft = {
        "type": "object", "additionalProperties": False,
        "required": ["name", "incident_role", "origin_character_id", "profile", "relationships_to_existing"],
        "properties": {
            "name": {"$ref": "#/$defs/nonEmptyString"},
            "incident_role": {"$ref": "#/$defs/nonEmptyString"},
            "origin_character_id": {
                "anyOf": ([{"enum": characters}] if characters else []) + [{"type": "null"}]
            },
            "profile": profile,
            "relationships_to_existing": {
                "type": "array", "minItems": 1, "maxItems": 4,
                "items": {
                    "type": "object", "additionalProperties": False,
                    "required": ["claimant_id", "relationship", "dramatic_pressure"],
                    "properties": {
                        "claimant_id": {"enum": sorted(catalog["claimants"])},
                        "relationship": {"$ref": "#/$defs/nonEmptyString"},
                        "dramatic_pressure": {"$ref": "#/$defs/nonEmptyString"},
                    },
                },
            },
        },
    }
    can_expand = issue["kind"] in {"source", "claimant", "identity"} and len(catalog["claimants"]) < MAX_CLAIMANTS
    schema = {
        "type": "object", "additionalProperties": False,
        "required": ["action", "replacement", "claimant_extension", "reason"],
        "properties": {
            "action": {"enum": ["resolve", "expand"] if can_expand else ["resolve"]},
            "replacement": {"anyOf": [{"enum": issue["candidates"]}, {"type": "null"}]},
            "claimant_extension": {"anyOf": [draft, {"type": "null"}]},
            "reason": {"$ref": "#/$defs/nonEmptyString"},
        },
        "$defs": definition_schema("claimant", protocol)["$defs"],
    }
    prompt = bounded_context([
        ("INVALID REFERENCE", {
            "kind": issue["kind"], "value": issue["invalid"], "uses": issue["contexts"],
        }),
        ("EXISTING CLAIMANTS", list(catalog["claimants"].values())),
        ("EXISTING CHARACTERS", list(catalog["characters"].values())),
        ("VALID SOURCE SLOTS", list(catalog["sources"].values())),
        ("ALLOWED REPLACEMENTS", issue["candidates"]),
        ("INSTRUCTION", (
            "Resolve the invalid reference to one listed candidate whenever plausible. A supporting witness, technician, "
            "administrator, or other character can source a fact without becoming a claimant. Expand only when the uses "
            "clearly require a genuinely distinct world-logic that no existing claimant represents. Prefer promotion of "
            "an existing character over a new identity. On expansion, return a complete differentiated profile, an incident "
            "role, and at least one relationship to an existing claimant. Return only this reference decision; preserve all fiction."
        )),
    ], 36000)
    if not can_expand:
        schema["properties"]["replacement"] = {"enum": issue["candidates"]}
        schema["properties"]["claimant_extension"] = {"type": "null"}
        schema["properties"]["reason"] = {"type": "string", "minLength": 1, "maxLength": 12000}
        schema.pop("$defs")
    return prompt, schema


def genesis_proposition_resolution_request(payload: dict, issues: list[dict]) -> tuple[str, dict]:
    facts = [
        {"fact_alias": f"fact_{index:02d}", **{
            key: fact[key] for key in ("subject", "predicate", "value", "status")
        }}
        for index, fact in enumerate(payload["canonical_facts"], 1)
    ]
    prompt = bounded_context([
        ("CANONICAL FACT CANDIDATES", facts),
        ("UNRESOLVED KNOWLEDGE REFERENCES", [
            {
                "issue_id": issue["issue_id"], "invalid_value": issue["invalid"],
                "uses": issue["contexts"],
            }
            for issue in issues
        ]),
        ("INSTRUCTION", (
            "Map every unresolved knowledge reference to exactly one listed canonical fact. "
            "Choose by the knowledge subject, relation, provenance, and relevance context. "
            "Do not add, remove, or rewrite facts or knowledge entries."
        )),
    ], 36000)
    properties = {
        issue["issue_id"]: {"enum": issue["candidates"]}
        for issue in issues
    }
    return prompt, {
        "type": "object", "additionalProperties": False,
        "required": ["resolutions"],
        "properties": {
            "resolutions": {
                "type": "object", "additionalProperties": False,
                "required": list(properties), "properties": properties,
            }
        },
    }


def apply_genesis_resolution(payload: dict, issue: dict, replacement: str) -> dict:
    value = copy.deepcopy(payload)
    for path in issue["paths"]:
        cursor = value
        for part in path[:-1]:
            cursor = cursor[part]
        cursor[path[-1]] = replacement
    return value


def materialize_claimant_extension(draft: dict, run_dir: Path, extensions: list[dict]) -> dict:
    foundation = committed_record(run_dir, "genesis_foundation")
    cast = committed_record(run_dir, "genesis_cast")
    index = len(foundation["claimant_anchors"]) + len(extensions) + 1
    claimant_id = f"claimant_{index:02d}"
    origin = draft["origin_character_id"]
    if origin is not None:
        character = next((item for item in cast["characters"] if item["character_id"] == origin), None)
        if not character or any(item["origin_character_id"] == origin for item in extensions):
            raise SchemaError("Claimant expansion references an unavailable character")
        if draft["name"] != character["name"]:
            raise SchemaError("Promoted claimant must retain the committed character name")
    related = [item["claimant_id"] for item in draft["relationships_to_existing"]]
    if len(related) != len(set(related)):
        raise SchemaError("Claimant expansion repeats an existing claimant relationship")
    return {
        "anchor": {
            "claimant_id": claimant_id, "technical_slot_id": f"claimant_slot_{index:02d}",
            "name": draft["name"], "incident_role": draft["incident_role"],
        },
        "profile": {"claimant_id": claimant_id, **draft["profile"]},
        "origin_character_id": origin,
        "claimant_relationships": [
            {
                "claimant_ids": [claimant_id, item["claimant_id"]],
                "relationship": item["relationship"], "dramatic_pressure": item["dramatic_pressure"],
            }
            for item in draft["relationships_to_existing"]
        ],
    }


def repair_genesis_constraints_payload(
    run_dir: Path, step_id: str, payload: dict, content: str, response: dict, transport
) -> dict:
    repair_path = run_dir / ".staging" / f"{step_id}.repair.json"
    state = read_json(repair_path) if repair_path.exists() else {
        "payload": payload, "claimant_extensions": [], "history": [],
    }

    def persist(kind, repair_step, result, api_response, **details):
        if not any(item["step_id"] == repair_step for item in state["history"]):
            state["history"].append({
                "kind": kind, **details, "step_id": repair_step,
                "result": result, "api_response": api_response,
            })
        write_json(repair_path, state)

    def resolve_proposition_batch(issues):
        signature = sha256_bytes(canonical_json([
            {key: issue[key] for key in ("invalid", "paths", "candidates")}
            for issue in issues
        ]))[:12]
        repair_step = f"{step_id}_proposition_repair_{signature}"
        prompt, schema = genesis_proposition_resolution_request(state["payload"], issues)
        try:
            result, api_response = request_architecture_analysis(
                run_dir, repair_step, prompt, schema, transport,
                phase="genesis", system_prompt="Resolve Genesis knowledge references. Return JSON only.",
                response_name="genesisPropositionResolutions", pause_stage="Genesis reference resolution",
            )
        except PausedError:
            if len(issues) == 1:
                raise
            midpoint = len(issues) // 2
            resolve_proposition_batch(issues[:midpoint])
            resolve_proposition_batch(issues[midpoint:])
            return
        for issue in issues:
            state["payload"] = apply_genesis_resolution(
                state["payload"], issue, result["resolutions"][issue["issue_id"]]
            )
        persist("proposition", repair_step, result, api_response)

    def resolve_reference_batch(issues):
        catalog = genesis_constraint_catalog(run_dir, state["claimant_extensions"])
        properties = {issue["issue_id"]: {"enum": issue["candidates"] + ["UNRESOLVED"]} for issue in issues}
        schema = {"type": "object", "additionalProperties": False, "required": ["resolutions"],
            "properties": {"resolutions": {"type": "object", "additionalProperties": False,
                "required": list(properties), "properties": properties}}}
        prompt = complete_context([
            ("REFERENCE USES", [{key: issue[key] for key in ("issue_id", "kind", "invalid", "contexts", "candidates")} for issue in issues]),
            ("SOURCE CATALOG", list(catalog["sources"].values())),
            ("IDENTITIES", {key: list(catalog[key].values()) for key in ("claimants", "characters")}),
            ("INSTRUCTION", "Resolve each use to its actual evidence or identity. Choose UNRESOLVED when unsupported. "
                "The same invalid string can mean different things in different records. Do not invent facts or promote characters.")])
        signature = sha256_bytes(canonical_json({"issues": issues, "catalog": catalog}))[:16]
        query = f"{step_id}_reference_batch_{signature}"
        result, response = request_architecture_analysis(run_dir, query, prompt, schema, transport,
            phase="genesis", response_name="genesisReferenceBatch", pause_stage="Genesis reference resolution", max_tokens=8192)
        resolved = set()
        for issue in issues:
            replacement = result["resolutions"][issue["issue_id"]]
            if replacement != "UNRESOLVED":
                state["payload"] = apply_genesis_resolution(state["payload"], issue, replacement)
                resolved.add(issue["issue_id"])
        persist("reference_batch", query, result, response)
        return resolved

    deferred = set(state.get("deferred_reference_batches", []))
    for _ in range(64):
        state["payload"] = normalize_genesis_reference_aliases(
            state["payload"], run_dir, state["claimant_extensions"]
        )
        issues = genesis_reference_issues(state["payload"], run_dir, state["claimant_extensions"])
        if not issues:
            enriched = state["payload"] | {"_claimant_extensions": state["claimant_extensions"]}
            build_genesis_constraints(run_dir, enriched)
            return enriched
        preserve_artistic_payload(run_dir, step_id, payload, content, response)
        pending = [issue for issue in issues if issue["kind"] != "proposition" and issue["candidates"]
            and sha256_bytes(canonical_json({key: issue[key] for key in ("kind", "invalid", "contexts", "candidates")})) not in deferred]
        if len(pending) > 1:
            batch = pending[:4]
            resolved = resolve_reference_batch(batch)
            for issue in batch:
                if issue["issue_id"] not in resolved:
                    deferred.add(sha256_bytes(canonical_json({key: issue[key] for key in ("kind", "invalid", "contexts", "candidates")})))
            state["deferred_reference_batches"] = sorted(deferred)
            write_json(repair_path, state)
            continue
        proposition_issues = [issue for issue in issues if issue["kind"] == "proposition"]
        if proposition_issues and len(proposition_issues) == len(issues):
            if any(not issue["candidates"] for issue in proposition_issues):
                problem = next(issue for issue in proposition_issues if not issue["candidates"])
                raise PausedError(
                    "Genesis reference resolution",
                    f"No canonical fact can replace proposition reference {problem['invalid']}",
                )
            resolve_proposition_batch(proposition_issues[:4])
            continue
        issue = next(issue for issue in issues if issue["kind"] != "proposition")
        can_expand = (
            issue["kind"] in {"source", "claimant", "identity"}
            and len(genesis_constraint_catalog(run_dir, state["claimant_extensions"])["claimants"]) < MAX_CLAIMANTS
        )
        if not issue["candidates"] and not can_expand:
            raise PausedError(
                "Genesis reference resolution",
                f"No valid Genesis candidate can replace {issue['kind']} reference {issue['invalid']}",
            )
        signature = sha256_bytes(canonical_json({
            "kind": issue["kind"], "invalid": issue["invalid"], "paths": issue["paths"],
        }))[:12]
        repair_step = f"{step_id}_resolve_{signature}"
        prompt, schema = claimant_resolution_request(issue, run_dir, state["claimant_extensions"])

        def validate_resolution(result):
            if result["action"] == "resolve":
                if result["replacement"] not in issue["candidates"]:
                    raise SchemaError("Reference resolution must choose one allowed candidate")
                result["claimant_extension"] = None
            elif result["claimant_extension"] is None:
                raise SchemaError("Claimant expansion must return exactly one complete extension")
            elif len(genesis_constraint_catalog(run_dir, state["claimant_extensions"])["claimants"]) >= MAX_CLAIMANTS:
                raise SchemaError("Claimant expansion exceeds the twelve-claimant maximum")
            else:
                result["replacement"] = None
                materialize_claimant_extension(
                    result["claimant_extension"], run_dir, state["claimant_extensions"]
                )

        result, api_response = request_architecture_analysis(
            run_dir, repair_step, prompt, schema, transport, validate_resolution,
            phase="genesis", system_prompt="Resolve one uncommitted Genesis reference. Return JSON only.",
            response_name="genesisReferenceResolution", pause_stage="Genesis reference resolution",
        )
        if result["action"] == "expand":
            extension = materialize_claimant_extension(
                result["claimant_extension"], run_dir, state["claimant_extensions"]
            )
            state["claimant_extensions"].append(extension)
            replacement = (
                extension["anchor"]["technical_slot_id"]
                if issue["kind"] == "source" else extension["anchor"]["claimant_id"]
            )
        else:
            replacement = result["replacement"]
        state["payload"] = apply_genesis_resolution(state["payload"], issue, replacement)
        persist(
            issue["kind"], repair_step, result, api_response,
            invalid=issue["invalid"], replacement=replacement,
        )
    raise PausedError("Genesis reference resolution", "Genesis reference repairs did not converge")


def architecture_obligation_cycle(payload: dict) -> list[str]:
    graph = {item["obligation_id"]: item["requires"] for item in payload["obligation_graph"]}
    visiting = []
    visited = set()

    def visit(node):
        if node in visiting:
            return visiting[visiting.index(node):]
        if node in visited:
            return []
        visiting.append(node)
        for dependency in graph[node]:
            if dependency in graph:
                cycle = visit(dependency)
                if cycle:
                    return cycle
        visiting.pop()
        visited.add(node)
        return []

    for node in graph:
        cycle = visit(node)
        if cycle:
            return cycle
    return []


def validate_packet_payload(payload: dict, plan: dict) -> None:
    content = payload["scenes"] if plan["packet_kind"] == "literary" else payload["endings"]
    other = payload["endings"] if plan["packet_kind"] == "literary" else payload["scenes"]
    expected = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
    actual = [item["technical_slot_id"] for item in content]
    problems = []
    if other:
        problems.append(f"expected no {'endings' if plan['packet_kind'] == 'literary' else 'scenes'}")
    if set(actual) != expected or len(actual) != len(set(actual)):
        problems.append("technical slots must match the assigned slots exactly once")
    artifact_count = sum(len(item["artifacts"]) for item in content)
    composition_count = sum(len(item["formal_compositions"]) for item in content)
    if artifact_count != plan["artifact_count"]:
        problems.append(f"expected {plan['artifact_count']} nested artifacts, received {artifact_count}")
    if composition_count != plan["formal_composition_count"]:
        problems.append(f"expected {plan['formal_composition_count']} nested formal compositions, received {composition_count}")
    for item in content:
        try:
            validate_markdown_source(item["prose_mdx"], item["technical_slot_id"])
            for artifact in item["artifacts"]:
                validate_markdown_source(artifact["body_mdx"], f"artifact under {item['technical_slot_id']}")
        except SchemaError as error:
            problems.append(error.reason)
    if problems:
        raise SchemaError("Packet payload does not match its frozen allocation: " + "; ".join(problems))
    validate_packet_word_allowance(payload, plan)


def validate_packet_payload_for_run(payload: dict, run_dir: Path, plan: dict) -> None:
    validate_packet_payload(payload, plan)
    architecture = committed_record(run_dir, "architecture")
    genesis = committed_record(run_dir, "genesis")
    arcs = {item["arc_id"] for item in architecture["arcs"]}
    claimants = {item["claimant_id"] for item in genesis["claimants"]}
    slots = {slot for item in architecture["packet_plans"] for slot in item["scene_slot_ids"] + item["ending_slot_ids"]}
    committed_content = {
        content_id for record in committed_records(run_dir, "creative_packet")
        for content_id in [item["scene_id"] for item in record["scenes"]] + [item["ending_id"] for item in record["endings"]]
    }
    problems = []
    for scene in payload["scenes"]:
        if scene["arc_id"] not in arcs:
            problems.append(f"{scene['technical_slot_id']} references unknown arc {scene['arc_id']}")
        unknown = set(scene["claimant_focus_ids"]) - claimants
        if unknown:
            problems.append(f"{scene['technical_slot_id']} references unknown claimants: {', '.join(sorted(unknown))}")
    for item in payload["scenes"] + payload["endings"]:
        unknown = set(item.get("claimant_pressure_ids", [])) - claimants
        if unknown:
            problems.append(f"{item['technical_slot_id']} references unknown claimants: {', '.join(sorted(unknown))}")
        for choice in item["choices"]:
            destination = choice["destination"]
            if destination["kind"] == "technical_slot" and destination["id"] not in slots:
                problems.append(f"unknown technical destination {destination['id']}")
            if destination["kind"] == "content" and destination["id"] not in committed_content:
                problems.append(f"unknown committed content destination {destination['id']}")
    if problems:
        raise SchemaError("Packet payload contains unresolved join keys: " + "; ".join(problems))
    validate_navigation_payload(run_dir, architecture, plan, payload)


def semantic_source_ref(slot: str, content_ids: dict) -> dict:
    if slot not in content_ids:
        raise SchemaError(f"Semantic normalization references unknown technical slot {slot}")
    if isinstance(content_ids[slot], dict):
        return copy.deepcopy(content_ids[slot])
    artifact_type, artifact_id = content_ids[slot]
    return {"artifact_type": artifact_type, "artifact_id": artifact_id, "source_locator": f"Authored content at {slot}"}


def build_semantic_delta(run_dir: Path, step_id: str, payload: dict, content_ids: dict[str, tuple[str, str] | dict]) -> dict:
    def source(item):
        return [semantic_source_ref(item["source"]["technical_slot_id"], content_ids)]

    facts = []
    fact_aliases = {}
    facts_by_identity = {}
    for index, item in enumerate(payload["canonical_facts"], 1):
        identifier = deterministic_id("fact", run_dir.name, step_id, index)
        identity = canonical_json({key: item[key] for key in ("subject", "predicate", "value", "status")})
        fact = facts_by_identity.get(identity)
        if fact is None:
            fact = {key: value for key, value in item.items() if key not in {"source", "relevance"}} | {
                "fact_id": identifier, "sources": source(item),
                "relevance": {key: list(values) for key, values in item["relevance"].items()},
            }
            facts_by_identity[identity] = fact
            facts.append(fact)
        else:
            for fact_source in source(item):
                if fact_source not in fact["sources"]:
                    fact["sources"].append(fact_source)
            for key, values in item["relevance"].items():
                fact["relevance"][key] = list(dict.fromkeys(fact["relevance"].get(key, []) + values))
        for alias in fact_position_aliases(index):
            fact_aliases[alias] = fact["fact_id"]
    known_facts = historical_fact_ids(run_dir)
    knowledge = []
    for index, item in enumerate(payload["knowledge_changes"], 1):
        proposition = fact_aliases.get(item["proposition_id"], item["proposition_id"])
        if proposition not in known_facts | {fact["fact_id"] for fact in facts}:
            raise SchemaError(f"Semantic knowledge references unknown proposition {item['proposition_id']}")
        knowledge.append({key: value for key, value in item.items() if key != "source"} | {
            "knowledge_id": deterministic_id("knowledge", run_dir.name, step_id, index),
            "proposition_id": proposition, "sources": source(item),
        })
    obligations = []
    for index, item in enumerate(payload["new_soft_obligations"], 1):
        source_id = source(item)[0]["artifact_id"]
        obligations.append({key: value for key, value in item.items() if key != "source"} | {
            "obligation_id": deterministic_id("obligation", run_dir.name, step_id, index),
            "status": "active", "created_by_ids": [source_id], "hardness": "soft", "sources": source(item),
        })
    updates = [
        {key: value for key, value in item.items() if key != "source"} | {
            "update_id": deterministic_id("obligation_update", run_dir.name, step_id, index),
            "evidence_sources": source(item),
        }
        for index, item in enumerate(payload["obligation_updates"], 1)
    ]
    motifs = [
        {key: value for key, value in item.items() if key != "source"} | {
            "motif_event_id": deterministic_id("motif_event", run_dir.name, step_id, index), "sources": source(item),
        }
        for index, item in enumerate(payload["motif_events"], 1)
    ]
    return {
        "canonical_facts": facts, "knowledge_changes": knowledge, "new_obligations": obligations,
        "obligation_updates": updates, "motif_events": motifs, "potential_foreclosures": [],
    }


SEMANTIC_CATEGORIES = ("canonical_facts", "knowledge_changes", "new_soft_obligations", "obligation_updates", "motif_events")
