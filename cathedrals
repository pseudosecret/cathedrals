def retrieval_record_metadata(record):
    if not isinstance(record, dict):
        raise IntegrityError(f"Retrieval record must be an object; received {type(record).__name__}")
    if record.get("authority") == "TENTATIVE PLAN":
        group, required = "selected_plan_items", ("step_id", "revision", "record_pointer", "item")
    elif "immutable_source" in record:
