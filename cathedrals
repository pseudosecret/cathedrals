def read_chat_stream(response, *, archive=None, label="LM Studio", report=True):
    started = last_report = time.monotonic()
    result = {"object": "chat.completion", "choices": [{
        "index": 0, "message": {"role": "assistant", "content": ""}, "finish_reason": None,
    }], "_cathedrals_stream_complete": False}
    choice = result["choices"][0]
    received = 0
    pending = b""
    lines = []
    done = False
    tool_calls = {}

    def event():
        nonlocal received, done
        if not lines:
            return
        data = "\n".join(lines)
        lines.clear()
        if data.strip() == "[DONE]":
            done = True
            return
        chunk = json.loads(data)
        if isinstance(chunk, dict) and chunk.get("error"):
            result["_cathedrals_provider_error"] = chunk["error"]
            raise ValueError("LM Studio rejected the request")
        if not isinstance(chunk, dict):
            raise ValueError(f"Invalid stream event: {_json_value(chunk)}")
        for field in ("id", "created", "model", "system_fingerprint"):
            if field in chunk:
                result[field] = chunk[field]
        if isinstance(chunk.get("usage"), dict):
            result["usage"] = chunk["usage"]
        for part in chunk.get("choices", []):
            if part.get("index", 0) != 0:
                continue
            delta = part.get("delta", {})
            for fragment in delta.get("tool_calls", []):
                if fragment.get("type", "function") != "function":
                    raise ValueError("Unsupported tool call type")
                index = fragment.get("index")
                if not isinstance(index, int) or index < 0 or index >= 8:
                    raise ValueError("Invalid tool call index")
                call = tool_calls.setdefault(index, {"id": "", "type": "function", "function": {"name": "", "arguments": ""}})
                for key in ("id",):
                    if key in fragment:
                        if not isinstance(fragment[key], str):
                            raise ValueError("Invalid tool call ID fragment")
                        call[key] += fragment[key]
                for key in ("name", "arguments"):
                    if key in fragment.get("function", {}):
                        value = fragment["function"][key]
                        if not isinstance(value, str):
                            raise ValueError("Invalid tool function fragment")
                        call["function"][key] += value
                        received += len(value)
            for field in ("content", "reasoning", "reasoning_content"):
                value = delta.get(field)
                if value is not None:
                    if not isinstance(value, str):
                        raise ValueError(f"Stream delta.{field} is not text")
                    choice["message"][field] = choice["message"].get(field, "") + value
                    received += len(value)
            if part.get("finish_reason") is not None:
                choice["finish_reason"] = part["finish_reason"]

    def line(raw):
        value = raw.decode("utf-8").removeprefix("\ufeff").rstrip("\r")
        if not value:
            event()
        elif value.startswith("data:"):
            lines.append(value[5:].removeprefix(" "))

    try:
        while not done:
            data = response.read1(65536)
            if not data:
                if pending:
                    line(pending)
                event()
                break
            if archive:
                archive.write(data)
                archive.flush()
            pending += data
            while b"\n" in pending and not done:
                raw, pending = pending.split(b"\n", 1)
                line(raw)
            now = time.monotonic()
            if report and now - last_report >= 15:
                print(f"{label}: {now - started:.0f}s elapsed, {received:,} characters received", file=sys.stderr, flush=True)
                last_report = now
        if not done or not choice["finish_reason"]:
            raise ValueError("Stream ended without [DONE] and a finish reason")
        result["_cathedrals_stream_complete"] = True
        if tool_calls:
            choice["message"]["tool_calls"] = [tool_calls[index] for index in sorted(tool_calls)]
        return result
    except (OSError, http.client.HTTPException, ValueError, TypeError, AttributeError, KeyboardInterrupt) as error:
        reason = str(error) or type(error).__name__
        raise IncompleteResponseError(
            f"{label}: incomplete response after {time.monotonic() - started:.0f}s, "
            f"{received:,} characters received ({reason}). Resume explicitly to retry.", result,
        ) from error


def http_json(method: str, url: str, payload=None, timeout: float = 30.0, *, stream_path: Path | None = None):
    streaming = isinstance(payload, dict) and payload.get("stream", False)
    started = time.monotonic()
    label = stream_path.name if stream_path else "LM Studio"
    body = canonical_json(payload) if payload is not None else None
    request = urllib.request.Request(url, data=body, method=method)
    request.add_header("Accept", "text/event-stream, application/json" if streaming else "application/json")
    if body is not None:
        request.add_header("Content-Type", "application/json")
    api_key = os.environ.get("CATHEDRALS_LM_STUDIO_API_KEY")
    if api_key:
        request.add_header("Authorization", f"Bearer {api_key}")
    if streaming:
        print(f"{label}: waiting for LM Studio (inactivity timeout {timeout:g}s)", file=sys.stderr, flush=True)
    responded = False
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            responded = True
            if streaming and "text/event-stream" in response.headers.get("Content-Type", "").lower():
                if stream_path:
                    stream_path.parent.mkdir(parents=True, exist_ok=True)
                    with stream_path.open("xb") as archive:
                        try:
                            return read_chat_stream(response, archive=archive, label=label)
                        finally:
                            make_read_only(stream_path)
                return read_chat_stream(response, label=label)
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace").strip()
        if error.code == 400 and "failed to parse grammar" in detail.lower():
            raise CathedralsError(
                "LM Studio structured output",
                "LM Studio could not compile the structured-output grammar before sampling. "
                "Update LM Studio before resuming this unchanged run. "
                f"Provider detail: {detail}",
                "provider_schema_incompatibility",
            ) from error
        raise CathedralsError("LM Studio API", f"HTTP {error.code}: {detail or error.reason}", "provider_before_creative_output") from error
    except (urllib.error.URLError, TimeoutError, OSError, http.client.HTTPException, ValueError, KeyboardInterrupt) as error:
        if isinstance(error, KeyboardInterrupt) and not streaming:
            raise
        if streaming and (responded or isinstance(error, (TimeoutError, ConnectionResetError, BrokenPipeError, http.client.HTTPException, ValueError, KeyboardInterrupt))
                          or isinstance(getattr(error, "reason", None), (TimeoutError, ConnectionResetError))):
            raise IncompleteResponseError(
                f"{label}: no complete response after {time.monotonic() - started:.0f}s "
                f"(inactivity allowance {timeout:g}s; {error}). Resume explicitly to retry."
            ) from error
        raise CathedralsError("LM Studio preflight", str(error), "transport_before_response") from error


def usable_model_ids(payload) -> list[str]:
    models = payload.get("data", []) if isinstance(payload, dict) else []
    usable = []
    for model in models:
        identifier = model.get("id") if isinstance(model, dict) else None
        kind = str(model.get("type", "")).lower() if isinstance(model, dict) else ""
        if not identifier or kind in {"embedding", "embeddings"} or "embed" in identifier.lower():
            continue
        usable.append(identifier)
    return sorted(set(usable))


def choose_model(models: list[str], override=None, input_fn=input, output_fn=print) -> str:
    if override:
        if override not in models:
            raise CathedralsError("LM Studio preflight", f"CATHEDRALS_MODEL={override!r} is not visible to LM Studio.")
        return override
    if not models:
        raise CathedralsError("LM Studio preflight", "No usable LLM model is visible. Load one in LM Studio.")
    if len(models) == 1:
        return models[0]
    output_fn("Available LM Studio models:")
    for index, model in enumerate(models, 1):
        output_fn(f"  {index}. {model}")
    while True:
        raw = input_fn(f"Select model [1-{len(models)}]: ").strip()
        if raw.isdigit() and 1 <= int(raw) <= len(models):
            return models[int(raw) - 1]
        output_fn("Invalid model selection.")


def lm_studio_preflight(base_url: str, model_override=None, input_fn=input, output_fn=print, transport=http_json):
    try:
        payload = transport("GET", api_url(base_url, "/v1/models"), timeout=10.0)
    except CathedralsError as error:
        raise CathedralsError(
            "LM Studio preflight",
            f"LM Studio was not reachable at {base_url}.\n\n"
            "Open LM Studio on Windows, load a model, and start the Local Server.\n"
            "Then run ./cathedrals again.",
            error.failure_class,
        ) from error
    return choose_model(usable_model_ids(payload), model_override, input_fn, output_fn)


