def _tag_set(value: dict, key: str) -> set[str]:
    return set(value.get("relevance", {}).get(key, []))


def relevance_score(event: dict, plan: dict, architecture: dict, dependency_source_ids: set[str], total_events: int, *, lexical=True) -> int:
    data = event["data"]
    score = 0
    obligation_ids = set(plan.get("advance_obligation_ids", [])) | set(plan.get("may_satisfy_obligation_ids", []))
    plan_tags = plan.get("relevance", {})
    sources = {source["artifact_id"] for source in event.get("sources", [])}
    if sources & dependency_source_ids:
        score += 12
    if event["constraint_kind"] in {"obligation", "obligation_update"}:
        obligation_id = data.get("obligation_id")
        original = next((item for item in architecture["obligation_graph"] if item["obligation_id"] == obligation_id), data)
        if obligation_id in obligation_ids:
            score += 12 if original.get("hardness") == "hard" else 6
        if original.get("kind") == "causal_debt" and obligation_id in obligation_ids:
            score += 8
        prerequisites = {
            item
            for attractor in architecture["attractors"]
            if attractor["attractor_id"] in plan["attractor_ids"]
            for item in attractor["prerequisite_obligation_ids"]
        }
        if obligation_id in prerequisites:
            score += 8
    for key, weight in (
        ("arc_ids", 10),
        ("branch_ids", 10),
        ("claimant_ids", 8),
        ("technical_slot_ids", 8),
        ("object_ids", 6),
        ("location_ids", 6),
        ("state_keys", 6),
        ("motif_ids", 5),
    ):
        if _tag_set(data, key) & set(plan_tags.get(key, [])):
            score += weight
    if event["constraint_kind"] == "knowledge_state" and (
        data.get("subject_id") in set(plan_tags.get("character_ids", []))
        or _tag_set(data, "character_ids") & set(plan_tags.get("character_ids", []))
    ):
        score += 9
    if lexical:
        words = set(re.findall(r"[a-z0-9_]+", " ".join(plan["soft_guidance"] + plan_tags.get("keywords", [])).lower()))
        event_words = set(re.findall(r"[a-z0-9_]+", json.dumps(data, ensure_ascii=False).lower()))
        score += min(5, len(words & event_words))
    if total_events:
        score += min(2, 2 * event["constraint_event_sequence"] // total_events)
    return score


def structured_constraint_sequences(run_dir, architecture, plan):
    wanted = []
    weights = {"arc_ids": 10, "branch_ids": 10, "claimant_ids": 8, "technical_slot_ids": 8,
               "object_ids": 6, "location_ids": 6, "state_keys": 6, "motif_ids": 5}
    for key, weight in weights.items():
        wanted.extend((key, value, weight, key) for value in plan.get("relevance", {}).get(key, []))
    wanted.extend(("_knowledge_character", value, 9, "knowledge") for value in plan.get("relevance", {}).get("character_ids", []))
    obligations = {item["obligation_id"]: item for item in architecture.get("obligation_graph", [])}
    for identifier in set(plan.get("advance_obligation_ids", []) + plan.get("may_satisfy_obligation_ids", [])):
        original = obligations.get(identifier, {})
        wanted.append(("_obligation", identifier, 12 if original.get("hardness") == "hard" else 6, "assigned"))
        if original.get("kind") == "causal_debt":
            wanted.append(("_obligation", identifier, 8, "causal"))
    for attractor in architecture.get("attractors", []):
        if attractor["attractor_id"] in plan.get("attractor_ids", []):
            wanted.extend(("_obligation", identifier, 8, "prerequisite") for identifier in attractor["prerequisite_obligation_ids"])
    with index_connection(run_dir) as db:
        matches = []
        parameters = []
        if wanted:
            values = ",".join("(?,?,?,?)" for _ in wanted)
            parameters.extend(value for row in wanted for value in row)
            matches.append(f"""SELECT r.event_sequence,w.column4 AS bucket,MAX(w.column3) AS weight
                FROM event_relevance r JOIN (VALUES {values}) w ON r.key=w.column1 AND r.value=w.column2
                GROUP BY r.event_sequence,w.column4""")
        dependencies = plan.get("depends_on_packet_slot_ids", [])
        if dependencies:
            parameters.extend(dependencies)
            matches.append("""SELECT es.event_sequence,'dependency' AS bucket,12 AS weight FROM records r
                JOIN sources s ON s.commit_id=r.commit_id JOIN event_sources es ON es.source_id=s.id
                WHERE r.record_type='creative_packet' AND r.packet_slot_id IN (""" + ",".join("?" for _ in dependencies) + ") GROUP BY es.event_sequence")
        if not matches:
            return []
        query = "SELECT event_sequence,SUM(weight) AS score FROM (" + " UNION ALL ".join(matches) + ") GROUP BY event_sequence ORDER BY score DESC,event_sequence LIMIT ?"
        return [row[0] for row in db.execute(query, (*parameters, SEARCH_CANDIDATES))]


