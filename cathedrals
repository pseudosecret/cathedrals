def packet_prompt(run_dir: Path, architecture: dict, plan: dict, *, step_id=None) -> tuple[str, str]:
    actual_step = step_id or packet_step_id(plan)
    receipt = {}
    with index_connection(run_dir) as db:
        packet_sequence = 1 + db.execute("SELECT COUNT(*) FROM records WHERE record_type='creative_packet'").fetchone()[0]
    batch = plan_batch_for(run_dir, plan["packet_slot_id"])
    obligations = json.dumps(
        {
            "packet_plan_location": "CURRENT PACKET STRUCTURAL POSITION in the context above",
            "packet_sequence": packet_sequence,
            "architecture_core_commit_id": architecture["architecture_core_commit_id"],
            "packet_plan_commit_id": batch["commit_id"],
            "logical_packet_literary_word_target": PACKET_LITERARY_WORD_TARGET,
        },
        ensure_ascii=False,
        separators=(",", ":"),
    ) + "\n\nAuthor only the assigned scenes or endings. Nest each artifact, choice, and formal composition under its owning content. Fill every listed technical slot exactly once and meet the allocated artifact/composition totals. The engine supplies IDs, envelopes, sequences, parent commits, geomancy, reverse references, provenance, and semantic constraint metadata."
    if plan["packet_kind"] == "literary":
        name = "generation-packet.md"
        replacements = {
            "PACKET_CONTEXT": "",
            "PACKET_OBLIGATIONS": obligations,
            "PACKET_PROTOCOL_DEFINITIONS": json.dumps(
                packet_payload_schema(run_dir, plan), ensure_ascii=False, separators=(",", ":")
            ),
        }
    else:
        name = "generation-ending-packet.md"
        replacements = {
            "ENDING_PACKET_CONTEXT": "",
            "ENDING_PACKET_OBLIGATIONS": obligations,
            "ENDING_PROTOCOL_DEFINITIONS": json.dumps(
                packet_payload_schema(run_dir, plan), ensure_ascii=False, separators=(",", ":")
            ),
        }
    envelope = render_prompt(run_dir, name, replacements)
    overhead = estimated_prompt_tokens(RECORD_SYSTEM_PROMPT + envelope)
    overhead = provider_input_tokens({"messages": [{"role": "system", "content": RECORD_SYSTEM_PROMPT}, {"role": "user", "content": envelope}],
        "response_format": {"type": "json_schema", "json_schema": {"name": "creativePacketPayload", "strict": True,
            "schema": packet_payload_schema(run_dir, plan)}}}) + 128
    context = relevant_packet_context(run_dir, architecture, plan, receipt=receipt, step_id=actual_step, prompt_overhead_tokens=overhead)
    replacements["PACKET_CONTEXT" if plan["packet_kind"] == "literary" else "ENDING_PACKET_CONTEXT"] = context
    prompt = render_prompt(run_dir, name, replacements)
    receipt["prepared_prompt_bytes"] = len(prompt.encode())
    receipt["estimated_prompt_tokens"] = estimated_prompt_tokens(RECORD_SYSTEM_PROMPT + prompt)
    _semantic_law, semantic_provenance = instruction_profile(run_dir, "semantic")
    receipt["normalization_instruction_profile"] = semantic_provenance
    receipt["estimated_normalization_context_tokens"] = estimated_prompt_tokens(compact_semantic_context(context, run_dir))
    receipt["prompt_hash"] = sha256_bytes(prompt.encode())
    write_json(run_dir / ".staging" / f"{actual_step}.retrieval.json", receipt)
    return prompt, context


def step_was_truncated(run_dir: Path, step_id: str) -> bool:
    return any(
        entry["planned_step_id"] == step_id and entry["failure_class"] == "provider_truncation"
        for entry in step_entries(run_dir, step_id)
    )


def packet_step_id(plan: dict, expanded: bool = False) -> str:
    slots = plan["scene_slot_ids"] or plan["ending_slot_ids"]
    identity = canonical_json({
        "packet": plan["packet_slot_id"],
        "slots": slots,
        "artifacts": plan["artifact_count"],
        "compositions": plan["formal_composition_count"],
        "obligations": plan["advance_obligation_ids"],
        "may_satisfy": plan["may_satisfy_obligation_ids"],
        "words": plan.get("literary_word_allowance", CHUNK_LITERARY_WORDS),
    })
    return f"packet_{plan['packet_slot_id']}_{sha256_bytes(identity)[:12]}{'_expanded' if expanded else ''}"


def expanded_output_limit(run_dir: Path, prompt: str, base_step_id: str, schema=None) -> int:
    manifest = read_json(run_dir / "run-manifest.json")
    state = load_state(run_dir)
    observed = max(
        (
            entry["token_accounting"]["input_tokens"] or 0
            for entry in step_entries(run_dir, base_step_id)
        ),
        default=0,
    )
    prompt_tokens = max(observed, math.ceil(len(prompt.encode("utf-8")) / 3))
    prompt_tokens = max(prompt_tokens, provider_input_tokens({"messages": [
        {"role": "system", "content": RECORD_SYSTEM_PROMPT}, {"role": "user", "content": prompt}],
        "response_format": {"type": "json_schema", "json_schema": {"schema": schema or {}}}}) + 128)
    available = (
        min(
            manifest["budgets"]["model_context_window_tokens"],
            state.get("model_context_window_tokens", manifest["budgets"]["model_context_window_tokens"]),
        )
        - prompt_tokens
        - manifest["budgets"]["context_safety_reserve_tokens"]
    )
    return min(manifest["budgets"]["max_expanded_output_tokens"], available)


def request_bounded_record(run_dir: Path, **arguments) -> dict:
    step_id = arguments["step_id"]
    if not step_was_truncated(run_dir, step_id):
        try:
            return request_record(run_dir, **arguments)
        except TruncationError:
            pass
    expanded_id = f"{step_id}_expanded"
    if step_was_truncated(run_dir, expanded_id):
        raise TruncationError(f"Bounded step {step_id} was truncated after its context-safe expanded retry")
    maximum = expanded_output_limit(run_dir, arguments["prompt"], step_id, arguments.get("response_schema"))
    if maximum <= BASE_OUTPUT_TOKENS:
        raise TruncationError(f"Bounded step {step_id} was truncated and the model context has no safe expansion headroom")
    return request_record(run_dir, **(arguments | {"step_id": expanded_id, "max_tokens": maximum}))


def single_content_packet_plans(plan: dict) -> list[dict]:
    key = "scene_slot_ids" if plan["packet_kind"] == "literary" else "ending_slot_ids"
    slots = plan[key]
    if not slots:
        return []
    artifact_counts = distribute_counts(plan["artifact_count"], len(slots))
    composition_counts = distribute_counts(plan["formal_composition_count"], len(slots))
    return [
        plan | {
            "scene_slot_ids": [slot] if plan["packet_kind"] == "literary" else [],
            "ending_slot_ids": [slot] if plan["packet_kind"] == "ending" else [],
            "artifact_count": artifact_counts[index],
            "formal_composition_count": composition_counts[index],
            "logical_content_slot_ids": slots,
            "literary_word_allowance": CHUNK_LITERARY_WORDS,
        }
        for index, slot in enumerate(slots)
    ]


def packet_payload_schema(run_dir: Path, plan: dict) -> dict:
    slots = plan["scene_slot_ids"] or plan["ending_slot_ids"]
    if len(slots) != 1:
        raise IntegrityError("Creative packet requests must contain exactly one scene or ending")
    schema = copy.deepcopy(definition_schema("creativePacketPayload", load_protocol(run_dir)))
    content_key = "scenes" if plan["packet_kind"] == "literary" else "endings"
    other_key = "endings" if plan["packet_kind"] == "literary" else "scenes"
    definition = "scenePayload" if plan["packet_kind"] == "literary" else "endingPayload"
    schema["properties"][content_key] |= {"minItems": 1, "maxItems": 1}
    schema["properties"][other_key] |= {"minItems": 0, "maxItems": 0}
    properties = schema["$defs"][definition]["properties"]
    properties["technical_slot_id"] = {"const": slots[0]}
    if definition == "scenePayload":
        architecture = committed_record(run_dir, "architecture")
        if not architecture:
            raise IntegrityError("Creative packet schema requires committed Architecture")
        properties["arc_id"] = {"enum": [item["arc_id"] for item in architecture["arcs"]]}
        targets = plan.get("required_navigation", {}).get(slots[0], [])
        if not targets:
            raise IntegrityError(f"Frozen navigation targets are absent for {slots[0]}")
        properties["choices"]["minItems"] = len(targets)
        local_node = scaffold_local_contract(architecture, plan)["nodes"][0]
        properties["arc_id"] = {"const": local_node["arc_id"]}
        properties["choices"]["maxItems"] = len(targets)
        choice_properties = schema["$defs"]["choicePayload"]["properties"]
        choice_properties["availability"] = {"const": "playable"}
        choice_properties["kind"] = {"enum": ["progression", "decision", "ending"]}
        if len(targets) == 1:
            properties["major_decision"] = {"const": False}
            choice_properties["major_decision"] = {"const": False}
            choice_properties["kind"] = {"enum": ["progression", "ending"]}
        schema["$defs"]["choicePayload"]["properties"]["destination"] = {"type": "object", "additionalProperties": False,
            "required": ["kind", "id"], "properties": {"kind": {"const": "technical_slot"}, "id": {"enum": targets}}}
    if definition == "endingPayload":
        properties["choices"] = {"type": "array", "maxItems": 0}
        properties["redirect_destination"] = {"type": "null"}
        properties["ending_type"] = {"enum": ["commitment", "foreclosure", "contamination", "release", "other"]}
    properties["artifacts"] |= {
        "minItems": plan["artifact_count"], "maxItems": plan["artifact_count"]
    }
    properties["formal_compositions"] |= {
        "minItems": plan["formal_composition_count"],
        "maxItems": plan["formal_composition_count"],
    }
    return schema


def request_packet_slice(run_dir: Path, architecture: dict, plan: dict, transport=http_json) -> None:
    slots = plan["scene_slot_ids"] or plan["ending_slot_ids"]
    if len(slots) != 1:
        raise IntegrityError("Creative packet slices must contain exactly one scene or ending")
    step_id = packet_step_id(plan)
    retrieval_working_set(run_dir, step_id, {"packet_slot_id": plan["packet_slot_id"], "packet_kind": plan["packet_kind"],
        "slots": slots, "keywords": search_query(plan)["terms"],
        "entities": plan.get("relevance", {}).get("claimant_ids", []) + plan.get("relevance", {}).get("character_ids", [])}, transport)
    if step_was_truncated(run_dir, step_id):
        expanded_id = packet_step_id(plan, expanded=True)
        if step_was_truncated(run_dir, expanded_id):
            raise TruncationError("A single-content packet was truncated after its context-safe expanded retry")
        prompt, context = packet_prompt(run_dir, architecture, plan, step_id=expanded_id)
        maximum = expanded_output_limit(run_dir, prompt, step_id, packet_payload_schema(run_dir, plan))
        if maximum <= BASE_OUTPUT_TOKENS:
            raise TruncationError("A single-content packet was truncated and the model context has no safe expansion headroom")
        request_record(
            run_dir,
            expected_record_type="creative_packet",
            step_id=expanded_id,
            phase="literary_packet" if plan["packet_kind"] == "literary" else "ending_packet",
            prompt=prompt,
            context=context,
            branch_relation=plan["branch_path_relation"],
            temperature=0.85 if plan["packet_kind"] == "literary" else 0.75,
            max_tokens=maximum,
            transport=transport,
            response_definition="creativePacketPayload",
            response_schema=packet_payload_schema(run_dir, plan),
            reference_context={"plan": plan},
            payload_validator=lambda payload: validate_packet_payload_for_run(payload, run_dir, plan),
            payload_preserver=lambda payload, content, response: preserve_artistic_payload(run_dir, expanded_id, payload, content, response),
            record_builder=lambda payload: build_creative_packet(
                run_dir, expanded_id, plan, payload,
                request_semantic_normalization(run_dir, expanded_id, payload, context, transport, plan=plan),
            ),
            precommit_validator=lambda record: validate_packet_for_run(record, run_dir, plan),
        )
        return
    prompt, context = packet_prompt(run_dir, architecture, plan)
    try:
        request_record(
            run_dir,
            expected_record_type="creative_packet",
            step_id=step_id,
            phase="literary_packet" if plan["packet_kind"] == "literary" else "ending_packet",
            prompt=prompt,
            context=context,
            branch_relation=plan["branch_path_relation"],
            temperature=0.85 if plan["packet_kind"] == "literary" else 0.75,
            transport=transport,
            response_definition="creativePacketPayload",
            response_schema=packet_payload_schema(run_dir, plan),
            reference_context={"plan": plan},
            payload_validator=lambda payload: validate_packet_payload_for_run(payload, run_dir, plan),
            payload_preserver=lambda payload, content, response: preserve_artistic_payload(run_dir, step_id, payload, content, response),
            record_builder=lambda payload: build_creative_packet(
                run_dir, step_id, plan, payload,
                request_semantic_normalization(run_dir, step_id, payload, context, transport, plan=plan),
            ),
            precommit_validator=lambda record: validate_packet_for_run(record, run_dir, plan),
        )
    except TruncationError:
        request_packet_slice(run_dir, architecture, plan, transport)


def execute_packet_plan(run_dir: Path, architecture: dict, plan: dict, transport=http_json) -> dict:
    content_key = "scenes" if plan["packet_kind"] == "literary" else "endings"
    slices = single_content_packet_plans(plan)
    for index, packet_slice in enumerate(slices):
        chunks = packet_chunks(run_dir, plan["packet_slot_id"])
        filled = {
            item["technical_slot_id"] for chunk in chunks for item in chunk[content_key]
        }
        slot = (packet_slice["scene_slot_ids"] or packet_slice["ending_slot_ids"])[0]
        if slot in filled:
            continue
        obligations_done = {
            item for chunk in chunks for item in chunk["obligations_advanced"]
        }
        remaining_obligations = [
            item for item in plan["advance_obligation_ids"] if item not in obligations_done
        ]
        later_unfilled = any(
            (later["scene_slot_ids"] or later["ending_slot_ids"])[0] not in filled
            for later in slices[index + 1:]
        )
        packet_slice = packet_slice | {
            "advance_obligation_ids": [] if later_unfilled else remaining_obligations,
            "may_satisfy_obligation_ids": list(dict.fromkeys(
                item
                for item in plan["may_satisfy_obligation_ids"] + remaining_obligations
                if item not in obligations_done
            )),
        }
        request_packet_slice(run_dir, architecture, packet_slice, transport)
    packet = assembled_packet(run_dir, plan["packet_slot_id"])
    if not packet:
        raise IntegrityError(f"Packet {plan['packet_slot_id']} did not complete after its final chunk")
    return packet


def save_planning_draft(run_dir: Path, step_id: str, state: dict) -> None:
