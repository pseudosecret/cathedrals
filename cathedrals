def baseline_markdown(value: str) -> str:
    blocks = []
    for block in re.split(r"\n\s*\n", value.strip()):
        escaped = html.escape(block.strip())
        if escaped.startswith("### "):
            blocks.append(f"<h3>{escaped[4:]}</h3>")
        elif escaped.startswith("## "):
            blocks.append(f"<h2>{escaped[3:]}</h2>")
        elif escaped.startswith("# "):
            blocks.append(f"<h1>{escaped[2:]}</h1>")
        else:
            blocks.append(f"<p>{escaped.replace(chr(10), '<br>')}</p>")
    return "\n".join(blocks)


def build_static_baseline(project: Path) -> None:
    work = read_json(project / "public/work.json")
    destination = project / "dist"
    if destination.exists():
        shutil.rmtree(destination)
    destination.mkdir(parents=True)
    for name in ("work.json", "style.css", "state.js", "theme.js"):
        shutil.copy2(project / "public" / name, destination / name)
    if (project / "public/source").exists():
        shutil.copytree(project / "public/source", destination / "source")

    def page(title: str, body: str, *, current=None, effects=None) -> str:
        attributes = ""
        scripts = '<script src="/theme.js"></script>'
        if current:
            attributes = f' data-generation="{html.escape(work["generation_id"])}" data-current="{html.escape(current)}" data-effects="{html.escape(json.dumps(effects or []), quote=True)}"'
            scripts += '<script src="/state.js"></script>'
        return f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="stylesheet" href="/style.css"><title>{html.escape(title)}</title></head><body{attributes}><button class="theme-toggle" aria-label="Switch day or night theme">◐</button><main>{body}</main>{scripts}</body></html>'

    entry = work["entry_content_id"]
    index = f'<div class="kicker">{html.escape(work["project_name"])}</div><h1>{html.escape(work["generated_title"])}</h1><p>A complete static Cathedrals work.</p><a class="begin" href="/scenes/{html.escape(entry)}/">Enter the work</a>'
    write_atomic(destination / "index.html", page(work["generated_title"], index).encode())
    scene_ids = {item["scene_id"] for item in work["scenes"]}
    artifacts = {item["artifact_id"]: item for item in work["artifacts"]}
    edges = {}
    for edge in work["decision_edges"]:
        if edge["availability"] == "playable":
            edges.setdefault(edge["from_content_id"], []).append(edge)

    def link_for(identifier: str) -> str:
        return f"/scenes/{identifier}/" if identifier in scene_ids else f"/endings/{identifier}/"

    for scene in work["scenes"]:
        body = f'<header><div class="kicker">{html.escape(work["generated_title"])}</div><h1>{html.escape(scene["title"])}</h1><div class="trace" aria-live="polite"></div></header><article><div class="prose">{baseline_markdown(scene["prose_mdx"])}</div>'
        for identifier in scene["artifact_ids"]:
            artifact = artifacts.get(identifier)
            if artifact:
                body += f'<details><summary>{html.escape(artifact["title"])}</summary><div class="artifact-body">{baseline_markdown(artifact["body_mdx"])}</div><a href="/artifacts/{identifier}/">Open as evidence</a></details>'
        body += '<nav class="choices" aria-label="Story choices">'
        for edge in edges.get(scene["scene_id"], []):
            body += f'<a class="choice" href="{link_for(edge["resolved_content_id"])}" data-conditions="{html.escape(json.dumps(edge["state_conditions"]), quote=True)}" data-effects="{html.escape(json.dumps(edge["state_effects"]), quote=True)}">{html.escape(edge["label"])}</a>'
        body += "</nav></article>"
        target = destination / "scenes" / scene["scene_id"] / "index.html"
        write_atomic(target, page(f'{scene["title"]} · {work["generated_title"]}', body, current=scene["scene_id"], effects=scene["state_effects"]).encode())
    for ending in work["endings"]:
        body = f'<header><div class="kicker">Ending · {html.escape(work["generated_title"])}</div><h1>{html.escape(ending["title"])}</h1><div class="trace" aria-live="polite"></div></header><div class="prose">{baseline_markdown(ending["prose_mdx"])}</div><button class="reset">Start over</button>'
        target = destination / "endings" / ending["ending_id"] / "index.html"
        write_atomic(target, page(f'{ending["title"]} · {work["generated_title"]}', body, current=ending["ending_id"], effects=ending["state_effects"]).encode())
    for artifact in work["artifacts"]:
        body = f'<header><div class="kicker">Evidence · {html.escape(work["generated_title"])}</div><h1>{html.escape(artifact["title"])}</h1></header><div class="artifact-body">{baseline_markdown(artifact["body_mdx"])}</div><a class="begin" href="/">Return to work</a>'
        target = destination / "artifacts" / artifact["artifact_id"] / "index.html"
        write_atomic(target, page(f'{artifact["title"]} · {work["generated_title"]}', body).encode())


class RenderedProse(HTMLParser):
    def __init__(self, css_class):
        super().__init__(convert_charrefs=True)
        self.css_class, self.depth, self.text, self.links = css_class, 0, [], []

    def handle_starttag(self, tag, attributes):
        attributes = dict(attributes)
        if tag == "a" and attributes.get("href"):
            self.links.append(attributes["href"])
        if tag in {"br", "hr", "img", "input", "meta", "link", "source", "wbr"}:
            return
        if self.depth:
            self.depth += 1
        elif self.css_class in (attributes.get("class") or "").split():
            self.depth = 1

    def handle_endtag(self, tag):
        if self.depth and tag not in {"br", "hr", "img", "input", "meta", "link", "source", "wbr"}:
            self.depth -= 1

    def handle_data(self, data):
        if self.depth:
            self.text.append(data)


def static_build_problems(project, work):
    dist, reasons = project / "dist", []
    for name in ("index.html", "work.json", "style.css", "state.js", "theme.js"):
        if not (dist / name).is_file():
            reasons.append(f"Missing static build output: {name}")
    for name in ("style.css", "state.js", "theme.js"):
        if (dist / name).is_file() and (dist / name).read_bytes() != (project / "public" / name).read_bytes():
            reasons.append(f"Published reader asset changed: {name}")
    if (dist / "work.json").exists() and (dist / "work.json").read_bytes() != (project / "public/work.json").read_bytes():
        reasons.append("Published work.json changed the immutable projected work")
    pages = [(dist / "index.html", None, None)]
    for group, identifier, field, css in (("scenes", "scene_id", "prose_mdx", "prose"),
            ("endings", "ending_id", "prose_mdx", "prose"), ("artifacts", "artifact_id", "body_mdx", "artifact-body")):
        for item in work[group]:
            path = dist / group / item[identifier] / "index.html"
            pages.append((path, item[field], css))
            source = dist / "source" / f"{item[identifier]}.md"
            if not source.exists() or source.read_bytes() != item[field].encode():
                reasons.append(f"Published source changed or disappeared: {item[identifier]}")
    for path, original, css in pages:
        if not path.exists():
            reasons.append(f"Missing static build output: {path.relative_to(dist)}")
            continue
        parsed = RenderedProse(css)
        parsed.feed(path.read_text(encoding="utf-8"))
        if original is not None:
            expected = RenderedProse(css)
            expected.feed(f'<div class="{css}">{baseline_markdown(original)}</div>')
            if not parsed.text or re.findall(r"\w+", " ".join(parsed.text)) != re.findall(r"\w+", " ".join(expected.text)):
                reasons.append(f"Rendered prose is missing or changed: {path.relative_to(dist)}")
        for link in parsed.links:
            target = urlsplit(link)
            if target.scheme or target.netloc or not target.path.startswith("/"):
                continue
            destination = dist / unquote(target.path).lstrip("/")
            if not destination.resolve().is_relative_to(dist.resolve()):
                reasons.append(f"Published link escapes the site: {link}")
                continue
            if destination.is_dir():
                destination = destination / "index.html"
            if not destination.is_file():
                reasons.append(f"Published link has no target: {link}")
    return reasons


def build_web(run_dir: Path, project: Path, output_fn=print) -> dict:
    build_static_baseline(project)
    reasons = static_build_problems(project, read_json(project / "public/work.json"))
    verdict = {"result": "FAIL" if reasons else "PASS", "reasons": reasons or ["Static pages, prose, links, assets, and immutable sources are complete."]}
    write_json(run_dir / "validation/build.json", verdict)
    if reasons:
        raise CathedralsError("Static build validation", reasons[0], "build_failure")
    append_deterministic_step(run_dir, "static_baseline_build", "build_validation", sha256_bytes(canonical_json(verdict)))
    return verdict


def preflight_model_capacity(base_url: str, model: str, output_fn=print, transport=http_json) -> int:
    required = 49152 + BASE_OUTPUT_TOKENS + 4096
    try:
        payload = transport("GET", api_url(base_url, "/api/v1/models"), timeout=10.0)
    except CathedralsError as error:
        raise CathedralsError(
            "LM Studio preflight",
            "LM Studio model capacity could not be read from /api/v1/models. Update LM Studio, keep the Local Server running, and try again.",
            error.failure_class,
        ) from error
    matches, exact = [], []
    for candidate in payload.get("models", []) if isinstance(payload, dict) else []:
        if candidate.get("type") != "llm":
            continue
        for instance in candidate.get("loaded_instances", []):
            if model == instance.get("id"):
                exact.append(instance)
            if model == candidate.get("key"):
                matches.append(instance)
    instances = exact or matches
    if len(instances) != 1:
        problem = "is not loaded" if not instances else "has multiple loaded instances; select its exact instance ID"
        raise PausedError("LM Studio preflight", f"Selected model {model!r} {problem}. "
            f"Load the intended model with at least {required:,} context tokens before starting or resuming.", "budget_exhaustion")
    config = instances[0].get("config")
    limit = config.get("context_length") if isinstance(config, dict) else None
    if not isinstance(limit, int) or isinstance(limit, bool) or limit <= 0:
        raise PausedError("LM Studio preflight", f"The loaded context limit for {model!r} is unavailable. "
            "Reload that model with an explicit context length; its theoretical maximum cannot establish available capacity.", "budget_exhaustion")
    if limit < required:
        raise PausedError(
            "LM Studio preflight",
            f"Selected model {model!r} is loaded with a {limit:,}-token context; Cathedrals requires at least {required:,} "
            "for a prepared packet, output, and safety reserve. Reload that model with a larger context, then resume.",
            "budget_exhaustion",
        )
    output_fn(f"Model context: {model} — {limit:,} loaded tokens")
    return limit


def committed_hashes(run_dir: Path) -> dict[str, str]:
    values = {"run_manifest": sha256_file(run_dir / "run-manifest.json")}
    for directory in committed_directories(run_dir):
        record = read_json(directory / "record.json")
        identifier = record.get("commit_id", directory.name)
        values[identifier] = sha256_file(directory / "record.json")
    return values


def make_finalization(run_dir: Path, status: str, failure_class: str, reason: str | None = None) -> dict:
    state = load_state(run_dir)
    entries = ledger_entries(run_dir)
    mechanical = read_json(run_dir / "validation/mechanical.json") if (run_dir / "validation/mechanical.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    artistic = read_json(run_dir / "validation/artistic.json") if (run_dir / "validation/artistic.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    build = read_json(run_dir / "validation/build.json") if (run_dir / "validation/build.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    warnings = read_json(run_dir / "validation/warnings.json") if (run_dir / "validation/warnings.json").exists() else []
    ready = status == "READY_TO_PLAY"
    if not ready and reason:
        target = mechanical if mechanical["result"] == "NOT_RUN" else build if build["result"] == "NOT_RUN" else None
        if target:
            target["reasons"] = [reason]
    constraint_path = run_dir / "constraints/constraint-events.jsonl"
    prospective_history = run_dir / "planning/prospective-plans.jsonl"
    finalization = {
        "record_type": "finalization",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": run_dir.name,
        "run_status": status,
        "run_manifest_hash": state["manifest_hash"],
        "generation_brief_hash": state["brief_hash"],
        "completed_at": utc_now(),
        "creative_step_count": state["creative_step_count"],
        "analysis_step_count": state["analysis_step_count"],
        "human_intervention_count": state["human_intervention_count"],
        "committed_rewrite_count": state["committed_rewrite_count"],
        "committed_regeneration_count": state["committed_regeneration_count"],
        "backtrack_count": state["backtrack_count"],
        "ledger_head_hash": entries[-1]["entry_hash"],
        "committed_record_hashes": committed_hashes(run_dir),
        "constraint_event_stream_hash": sha256_file(constraint_path) if constraint_path.exists() else sha256_bytes(b""),
        "prospective_plan_history_hash": sha256_file(prospective_history) if prospective_history.exists() else sha256_bytes(b""),
        "token_accounting": {"input_tokens": state["input_tokens"], "output_tokens": state["output_tokens"], "cost": state["cost"], "currency": None},
        "mechanical_validation": mechanical,
        "artistic_acceptance": artistic,
        "static_build_validation": build,
        "warnings": warnings,
        "npm_enhancement": {"result": "NOT_RUN", "reasons": ["The static publisher has no npm enhancement step."]},
        "complete_work_barrier_satisfied": ready,
        "playable": ready,
        "failure_class": failure_class,
    }
    protocol = load_protocol(run_dir)
    validate_json_schema(finalization, protocol["$defs"]["finalization"], protocol)
    return finalization


def copy_provenance(run_dir: Path, destination: Path) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    for name in ("generation-brief.json", "run-manifest.json", "ledger.jsonl", "finalization.json"):
        source = run_dir / name
        if source.exists():
            shutil.copy2(source, destination / ("run-ledger.jsonl" if name == "ledger.jsonl" else name))
    for name in ("raw", "committed", "constraints", "planning", "validation"):
        source = run_dir / name
        if source.exists():
            shutil.copytree(source, destination / name, dirs_exist_ok=True)


def publish_success(run_dir: Path, project: Path, finalization: dict) -> Path:
    parent = ROOT / "generated-work"
    destination = parent / run_dir.name
    if destination.exists():
        raise IntegrityError(f"Refusing to overwrite published generation {destination}")
    staging = run_dir / "publish-staging"
    if staging.exists():
        shutil.rmtree(staging)
    shutil.copytree(project, staging / "web")
    copy_provenance(run_dir, staging / "provenance")
    write_json(staging / "provenance/finalization.json", finalization)
    parent.mkdir(parents=True, exist_ok=True)
    os.replace(staging, destination)
    return destination


def finalize_success(run_dir: Path, project: Path) -> tuple[Path, dict]:
    reconcile_run(run_dir)
    finalization = make_finalization(run_dir, "READY_TO_PLAY", "none")
    destination = publish_success(run_dir, project, finalization)
    write_json(run_dir / "finalization.json", finalization, mode=0o444, exclusive=True)
    build_path = destination / "web/dist"
    state = load_state(run_dir)
    state["status"] = "READY_TO_PLAY"
    state["stage"] = "READY_TO_PLAY"
    state["completed_at"] = finalization["completed_at"]
    state["build_path"] = str(build_path)
    save_state(run_dir, state)
    return build_path, finalization


def finalize_failure(run_dir: Path, error: CathedralsError) -> dict:
    existing = run_dir / "finalization.json"
    if existing.exists():
        finalization = read_json(existing)
        if finalization["run_status"] == "READY_TO_PLAY":
            return finalization
        return finalization
    finalization = make_finalization(run_dir, "FAILED_GENERATION", error.failure_class, error.reason)
    write_json(existing, finalization, mode=0o444, exclusive=True)
    state = load_state(run_dir)
    state["status"] = "FAILED_GENERATION"
    state["stage"] = error.stage
    state["failure_reason"] = error.reason
    state["completed_at"] = finalization["completed_at"]
    save_state(run_dir, state)
    return finalization


def ensure_resume_ready(run_dir: Path, output_fn=print, transport=http_json, input_fn=input) -> None:
    reconcile_run(run_dir)
    state = load_state(run_dir)
    brief = read_json(run_dir / "generation-brief.json")
    payload = transport("GET", api_url(brief["lm_studio_base_url"], "/v1/models"), timeout=10.0)
    models = usable_model_ids(payload)
    override = os.environ.get("CATHEDRALS_MODEL")
    if override or state["model"] not in models:
        state["model"] = choose_model(models, override, input_fn, output_fn)
    context_limit = preflight_model_capacity(brief["lm_studio_base_url"], state["model"], output_fn, transport)
    if isinstance(context_limit, int):
        state["model_context_window_tokens"] = context_limit
        save_state(run_dir, state)


def run_snapshot_launcher(run_dir: Path, argv, input_fn, output_fn, transport) -> int:
    launcher = snapshot_root(run_dir) / "cathedrals"
    name = f"cathedrals_snapshot_{sha256_bytes(str(launcher).encode())[:12]}"
    loader = importlib.machinery.SourceFileLoader(name, str(launcher))
    spec = importlib.util.spec_from_loader(name, loader)
    if not spec or not spec.loader:
        raise IntegrityError("The run-local launcher cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    previous_bytecode_setting = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        spec.loader.exec_module(module)
    finally:
        sys.dont_write_bytecode = previous_bytecode_setting
    module.ROOT = ROOT
    module.RUNTIME_ROOT = RUNTIME_ROOT
    module.RUNS_ROOT = RUNS_ROOT
    module.choose_resume = lambda input_fn=input_fn, output_fn=output_fn: run_dir
    # Keep transport exceptions and stream archiving in the same frozen runtime.
    snapshot_transport = module.http_json if transport is http_json else transport
    return module.main(argv, input_fn=input_fn, output_fn=output_fn, transport=snapshot_transport)


def pause_run(run_dir: Path, error: PausedError) -> None:
    state = load_state(run_dir)
    state["status"] = "PAUSED_GENERATION"
    state["stage"] = error.stage
    state["pause_reason"] = error.reason
    state.pop("completed_at", None)
    save_state(run_dir, state)


def print_pause(run_dir: Path, error: PausedError, output_fn=print) -> None:
    output_fn("\nPAUSED_GENERATION\n")
    output_fn(f"Generation:\n{run_dir.name}\n")
    output_fn(f"Pause stage:\n{error.stage}\n")
    output_fn(f"Reason:\n{error.reason}\n")
    output_fn("Committed work and any schema-valid staged artistic payload were preserved.\nRun ./cathedrals to resume.")


def execute_run(run_dir: Path, output_fn=print, transport=http_json) -> tuple[Path, dict, dict]:
    execute_creative_phases(run_dir, output_fn, transport)
    output_fn("[05] Complete web projection        …")
    project, counts = project_web(run_dir)
    output_fn("[05] Complete web projection        ✓")
    output_fn("[06] Mechanical validation          …")
    mechanical = validate_complete_work(run_dir)
    if mechanical["result"] != "PASS":
        raise CathedralsError("Mechanical validation", mechanical["reasons"][0], "mechanical_validation")
    output_fn("[06] Mechanical validation          ✓")
    output_fn("[07] Static baseline build          …")
    build_web(run_dir, project, output_fn)
    output_fn("[07] Static baseline build          ✓")
    artistic = {"result": "NOT_RUN", "reasons": ["Artistic review is advisory and is not part of the publication gate."]}
    write_json(run_dir / "validation/artistic.json", artistic)
    build_path, _ = finalize_success(run_dir, project)
    return build_path, counts, read_json(run_dir / "generation-brief.json")


def unexpected_generator_error(run_dir: Path | None, error: Exception) -> CathedralsError:
    frames = traceback.extract_tb(error.__traceback__)
    origin = frames[-1] if frames else None
    stage = f"Generator: {origin.name}" if origin else "Generator"
    reason = f"{type(error).__name__}: {error}"
    if origin:
        reason += f"\nLocation: {origin.filename}:{origin.lineno} in {origin.name}"
    if run_dir is not None:
        path = run_dir / "logs" / f"generator-error-{secrets.token_hex(4)}.json"
        try:
            write_json(path, {"generation_id": run_dir.name, "timestamp": utc_now(), "stage": stage,
                "exception_type": type(error).__name__, "message": str(error),
                "traceback": "".join(traceback.format_exception(error)),
                "frames": [{"file": frame.filename, "line": frame.lineno, "function": frame.name} for frame in frames]},
                exclusive=True)
            reason += f"\nDiagnostic: {path}"
        except (OSError, CathedralsError) as diagnostic_error:
            reason += f"\nDiagnostic could not be saved: {type(diagnostic_error).__name__}: {diagnostic_error}"
    return CathedralsError(stage, reason)


def print_failure(run_dir: Path | None, error: CathedralsError, output_fn=print) -> None:
    output_fn("\nFAILED_GENERATION\n")
    output_fn(f"Generation:\n{run_dir.name if run_dir else 'not created'}\n")
    output_fn(f"Failure stage:\n{error.stage}\n")
    output_fn(f"Reason:\n{error.reason}\n")
    diagnostic = run_dir / "projection/web/dist" if run_dir else None
    if diagnostic and (diagnostic / "index.html").exists():
        output_fn(f"A diagnostic static build was preserved at:\n{diagnostic}\n")
    output_fn("Committed work was not rewritten.\nNo partial game is playable.")


def print_success(run_dir: Path, build_path: Path, counts: dict, brief: dict, output_fn=print) -> None:
    output_fn("\nREADY_TO_PLAY\n")
    output_fn(f"Project: {brief['project_name']}")
    output_fn(f"Generation: {run_dir.name}")
    output_fn("Format: web")
    output_fn(f"Scenes: {counts['scenes']}")
    output_fn(f"Artifacts: {counts['artifacts']}")
    output_fn(f"Endings: {counts['endings']}\n")
    output_fn(f"Build:\n{build_path}\n")
    finalization_path = run_dir / "finalization.json"
    warnings = read_json(finalization_path).get("warnings", []) if finalization_path.exists() else []
    if warnings:
        output_fn("Warnings:")
        for warning in warnings:
            output_fn(f"- {warning['message']}")
        output_fn("")
    output_fn(f"Run:\npython3 -m http.server 4321 --directory {build_path}")


def probe_execution_policy(base_url, model, transport, output_fn=print):
    artifacts = []
    tool = next(item for item in retrieval_tools() if item["function"]["name"] == "get_records")
    request = {"model": model, "messages": [{"role": "user", "content":
        "Synthetic transport check, no fiction. Call get_records with ids [synthetic_token]."}],
        "tools": [tool], "tool_choice": "required",
        "temperature": 0.0, "max_tokens": 8192, "seed": step_seed("synthetic_preflight", "capability_probe"), "stream": True, "stream_options": {"include_usage": True}}
    mode = "automatic"
    def dispatch(label, payload, allow_tools=False):
        artifact = {"step_id": label, "request": copy.deepcopy(payload), "started_at": utc_now()}
        artifacts.append(artifact)
        try:
            response, content = provider_response(transport, api_url(base_url, "/v1/chat/completions"), payload,
                float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")), allow_tools=allow_tools,
                preserve=lambda value: artifact.update({"response": value}))
            return response, content
        except CathedralsError as error:
            artifact["error"] = error.reason
            raise
    messages = [{"role": "user", "content": "Synthetic extraction check: synthetic_reader knows that the synthetic token is blue."}]
    try:
        response, _ = dispatch("preflight_tools", request, True)
        calls = completed_tool_calls(response)
        if len(calls) == 1 and calls[0]["function"].get("name") == "get_records":
            arguments = parse_structured_content(calls[0]["function"].get("arguments", ""))
            validate_json_schema(arguments, tool["function"]["parameters"])
            if arguments == {"ids": ["synthetic_token"]}:
                mode = "tools"
                messages = request["messages"] + [{"role": "assistant", "content": "", "tool_calls": calls},
                    {"role": "tool", "tool_call_id": calls[0]["id"], "content":
                        '{"id":"synthetic_token","proposition":"The synthetic token is blue.","subject":"synthetic_reader","relation":"knows"}'}]
    except (CathedralsError, ValueError, TypeError):
        pass
    schema = {"type": "object", "additionalProperties": False, "required": ["proposition", "subject", "relation"],
        "properties": {"proposition": {"const": "The synthetic token is blue."},
            "subject": {"const": "synthetic_reader"}, "relation": {"const": "knows"}}}
    structured = {key: value for key, value in request.items() if key not in {"tools", "tool_choice"}}
    structured["messages"] = messages + [{"role": "user", "content": "Extract exactly the stated proposition, subject and knowledge relation as JSON. No fiction."}]
    structured["response_format"] = {"type": "json_schema", "json_schema": {"name": "syntheticMetadata", "strict": True, "schema": schema}}
    _response, content = dispatch("preflight_metadata", structured)
    validate_json_schema(parse_structured_content(content), schema)
    output_fn(f"Retrieval mode: {mode} (synthetic structured metadata check passed).")
    return {"bounded_planning": True, "scoped_sources": True, "retrieval_mode": mode,
        "max_tool_rounds": 2, "max_tool_calls": 8, "completion_contract_version": 1, "scaffold_planning_version": 3}, artifacts


def archive_preflight_probes(run_dir, artifacts):
    for artifact in artifacts:
        step = artifact["step_id"]
        response = artifact.get("response", {})
        parameters = {key: artifact["request"][key] for key in ("temperature", "max_tokens", "stream", "stream_options", "seed")}
        meta = {"attempt": 1, "parameters": parameters,
            "prompt_hash": sha256_bytes(canonical_json(artifact["request"])),
            "context_hash": sha256_bytes(canonical_json(artifact["request"]["messages"]))}
        write_json(run_dir / "raw" / f"{step}-attempt1.api.json", response | {"_cathedrals_request": meta}, mode=0o444, exclusive=True)
        write_json(run_dir / "raw" / f"{step}.probe.json", artifact, mode=0o444, exclusive=True)
        preserve_planning_result(run_dir, step, step, {"synthetic": True, "error": artifact.get("error")},
            response | {"_cathedrals_request": meta, "_cathedrals_started_at": artifact["started_at"]}, kind="capability_probe", phase="preflight")


def main(argv=None, *, input_fn=input, output_fn=print, transport=http_json) -> int:
    parser = argparse.ArgumentParser(description="Generate one complete static Cathedrals work through LM Studio.")
    parser.parse_args(argv)
    run_dir = None
    try:
        ensure_runtime_layout()
        run_dir = choose_resume(input_fn, output_fn)
        if run_dir:
            launcher = snapshot_root(run_dir) / "cathedrals"
            if not launcher.is_file() or not (snapshot_root(run_dir) / "engine").is_dir():
                print_failure(run_dir, IntegrityError("The saved engine snapshot is incomplete. Restore this run's engine-snapshot/cathedrals and engine/ before resuming."), output_fn)
                return 1
            if Path(__file__).resolve() != launcher.resolve():
                if sha256_file(launcher) != sha256_file(Path(__file__)):
                    output_fn("This run uses a different frozen engine snapshot. Installation updates do not apply when resuming.\n"
                        "Start a new generation to use the installed engine.\n")
                return run_snapshot_launcher(run_dir, argv, input_fn, output_fn, transport)
            ensure_resume_ready(run_dir, output_fn, transport, input_fn)
            brief = read_json(run_dir / "generation-brief.json")
            output_fn(f"Generation: {run_dir.name}\nFormat: web\nModel: {load_state(run_dir)['model']}\nRequested scope: up to {brief['possible_scene_count']} scenes\n")
            output_fn("[01] Preflight                     ✓ resumed")
            output_fn("[02] Engine snapshot              ✓ verified")
        else:
            frozen = collect_inputs(input_fn, output_fn)
            base_url = configured_lm_studio_url()
            model = lm_studio_preflight(base_url, os.environ.get("CATHEDRALS_MODEL"), input_fn, output_fn, transport)
            model_context_window_tokens = preflight_model_capacity(base_url, model, output_fn, transport)
            policy, probes = probe_execution_policy(base_url, model, transport, output_fn)
            run_dir = create_run(
                frozen,
                base_url,
                model,
                output_fn,
                model_context_window_tokens=model_context_window_tokens,
                execution_policy=policy,
            )
            archive_preflight_probes(run_dir, probes)
            output_fn("[01] Preflight                     ✓")
            output_fn("[02] Engine snapshot              ✓")
        build_path, counts, brief = execute_run(run_dir, output_fn, transport)
        print_success(run_dir, build_path, counts, brief, output_fn)
        return 0
    except KeyboardInterrupt:
        if run_dir:
            output_fn(f"\nGeneration interrupted before its next commit.\nRun ./cathedrals again to resume {run_dir.name}.")
        else:
            output_fn("\nCancelled before generation state was created.")
        return 130
    except PausedError as error:
        if run_dir and state_path(run_dir).exists():
            pause_run(run_dir, error)
            print_pause(run_dir, error, output_fn)
        else:
            output_fn(f"\nPAUSED_GENERATION\n{error.reason}")
        return 2
    except CathedralsError as error:
        if run_dir and state_path(run_dir).exists() and error.failure_class in PAUSABLE_FAILURES:
            paused = PausedError(error.stage, error.reason, error.failure_class)
            pause_run(run_dir, paused)
            print_pause(run_dir, paused, output_fn)
            return 2
        if run_dir and state_path(run_dir).exists():
            try:
                finalize_failure(run_dir, error)
            except Exception as finalization_error:
                error = CathedralsError(error.stage, f"{error.reason} (failure finalization also failed: {finalization_error})", error.failure_class)
        print_failure(run_dir, error, output_fn)
        return 1
    except Exception as error:
        wrapped = unexpected_generator_error(run_dir, error)
        if run_dir and state_path(run_dir).exists():
            try:
                finalize_failure(run_dir, wrapped)
            except Exception as finalization_error:
                wrapped = CathedralsError(wrapped.stage, f"{wrapped.reason}\nFailure finalization also failed: "
                    f"{type(finalization_error).__name__}: {finalization_error}", wrapped.failure_class)
        print_failure(run_dir, wrapped, output_fn)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
