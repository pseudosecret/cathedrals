def create_run(
    frozen: FrozenInputs,
    base_url: str,
    model: str,
    output_fn=print,
    model_context_window_tokens: int = 64148,
    execution_policy: dict | None = None,
) -> Path:
    policy = CURRENT_EXECUTION_POLICY | (execution_policy or {})
    for key in ("bounded_planning", "scoped_sources", "completion_contract_version", "scaffold_planning_version"):
        if type(policy[key]) is not type(CURRENT_EXECUTION_POLICY[key]) or policy[key] != CURRENT_EXECUTION_POLICY[key]:
            raise CathedralsError("Execution policy", f"The current engine requires {key}={CURRENT_EXECUTION_POLICY[key]!r}.")
    identifier = generation_id(frozen.project_name)
    ensure_runtime_layout()
    run_dir = RUNS_ROOT / identifier
    for child in ("raw", "committed", "constraints", "planning", "state", "logs", "validation", ".staging"):
        (run_dir / child).mkdir(parents=True, exist_ok=False)
    copy_engine_snapshot(run_dir)
    timestamp = utc_now()
    seed = secrets.token_hex(16)
    brief = dataclasses.asdict(frozen) | {
        "generation_id": identifier,
        "generation_timestamp": timestamp,
        "lm_studio_base_url": base_url,
        "model": model,
        "generation_seed": seed,
    }
    brief_hash = sha256_bytes(canonical_json(brief))
    derived = derive_scope(frozen.possible_scene_count)
    derived["budgets"]["model_context_window_tokens"] = model_context_window_tokens
    budgets = derived["budgets"]
    budgets["max_creative_step_count"] += math.ceil(derived["scope"]["ending_hard_max"] / PLAN_BATCH_SIZE)
    scaffold_allowance = 30
    budgets["max_analysis_step_count"] += scaffold_allowance * (frozen.possible_scene_count + derived["scope"]["ending_hard_max"]) + 6
    budgets["max_cumulative_output_tokens"] = (budgets["max_creative_step_count"] * (BASE_OUTPUT_TOKENS + EXPANDED_OUTPUT_TOKENS)
        + budgets["max_analysis_step_count"] * ANALYSIS_OUTPUT_TOKENS)
    budgets["normal_prepared_context_tokens"] = 49152
    budgets["max_prepared_context_tokens"] = model_context_window_tokens - budgets["context_safety_reserve_tokens"]
    budgets["max_planning_context_tokens"] = model_context_window_tokens - budgets["context_safety_reserve_tokens"] - MIN_PLANNING_OUTPUT_TOKENS
    budgets["max_cumulative_input_tokens"] = (2 * budgets["max_creative_step_count"] + budgets["max_analysis_step_count"]) * max(
        budgets["max_prepared_context_tokens"], budgets["max_planning_context_tokens"])
    manifest = {
        "record_type": "run_manifest",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": identifier,
        "created_at": timestamp,
        "generation_brief": brief,
        "generation_brief_hash": brief_hash,
        "engine_snapshot": {
            "work_id": "cathedrals-v01",
            "path": "engine-snapshot",
            "work_seed": seed,
            "structural_seed": sha256_bytes(f"structure:{seed}".encode()),
            "geomancy_seed": sha256_bytes(f"geomancy:{seed}".encode()),
        },
        "generation_run": {
            "human_creative_interventions_required": 0,
            "committed_creative_rewrites_allowed": False,
            "committed_creative_regeneration_allowed": False,
            "backward_canon_mutation_allowed": False,
            "candidate_cherry_picking_allowed": False,
            "append_only": True,
            "creative_authorship_forward_only": True,
            "planning_may_reason_backward": True,
        },
        "scope": derived["scope"],
        "budgets": derived["budgets"],
        "traversal": {
            "strategy": "constraint_relevance",
            "seed": sha256_bytes(f"traversal:{seed}".encode()),
            "prospective_plan_mutable": True,
        },
        "models": [
            {"purpose": purpose, "provider": "LM Studio", "model": model, "parameters": {"structured_output": True}}
            for purpose in ("creative", "analysis")
        ],
        "retention_policy": "preserve_failed",
        "complete_work_barrier": {
            "partial_play_allowed": False,
            "runtime_generation_allowed": False,
            "playable_status": "READY_TO_PLAY",
        },
    }
    manifest["execution_policy"] = policy
    protocol = load_protocol(run_dir)
    validate_json_schema(manifest, protocol["$defs"]["runManifest"], protocol)
    manifest_hash = sha256_bytes(canonical_json(manifest))
    write_json(run_dir / "generation-brief.json", brief, mode=0o444, exclusive=True)
    write_json(run_dir / "run-manifest.json", manifest, mode=0o444, exclusive=True)
    frozen_context = run_dir / "state/frozen-engine-context.txt"
    write_atomic(frozen_context, engine_context(run_dir).encode(), mode=0o444, exclusive=True)
    run_state = initial_run_state(identifier, brief_hash, manifest_hash, model)
    run_state["model_context_window_tokens"] = model_context_window_tokens
    save_state(run_dir, run_state)
    append_deterministic_step(run_dir, "preflight", "preflight", brief_hash)
    append_deterministic_step(run_dir, "engine_snapshot", "engine_snapshot", manifest_hash)
    output_fn(f"Generation: {identifier}")
    output_fn("Format: web")
    output_fn(f"Model: {model}")
    output_fn(f"Requested scope: up to {frozen.possible_scene_count} scenes\n")
    output_fn(
        f"Derived safeguards: up to {derived['budgets']['max_creative_step_count']} creative steps, "
        f"{derived['budgets']['max_total_literary_words']:,} literary words, and "
        f"{derived['budgets']['max_cumulative_output_tokens']:,} cumulative output tokens.\n"
    )
    return run_dir


def incomplete_runs() -> list[Path]:
    if not RUNS_ROOT.exists():
        return []
    candidates = []
    for run_dir in RUNS_ROOT.iterdir():
        path = state_path(run_dir)
        manifest_path = run_dir / "run-manifest.json"
        if not path.exists() or not manifest_path.exists():
            continue
        state = read_json(path)
        if (
            read_json(manifest_path).get("protocol_version") == PROTOCOL_VERSION
            and state.get("status") not in TERMINAL_STATES
            and not state.get("resume_declined")
        ):
            candidates.append(run_dir)
    return sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)


def choose_resume(input_fn=input, output_fn=print) -> Path | None:
    candidates = incomplete_runs()
    if not candidates:
        return None
    run_dir = candidates[0]
    output_fn(f"Incomplete generation detected:\n{run_dir.name}\n")
    answer = input_fn("Resume it? [Y/n] ").strip().lower()
    if answer in {"", "y", "yes"}:
        return run_dir
    state = load_state(run_dir)
    state["resume_declined"] = True
    save_state(run_dir, state)
    return None


def generated_ids(record: dict) -> list[str]:
    ids = [record.get("commit_id")]
    if record.get("record_type") == "genesis_foundation":
        ids += [item["event_id"] for item in record["work_canon"]["chronology"]]
        ids += [item["claimant_id"] for item in record["claimant_anchors"]]
    if record.get("record_type") == "genesis_cast":
        ids += [item["character_id"] for item in record["characters"]]
    if record.get("record_type") == "genesis_constraints":
        ids += [item["anchor"]["claimant_id"] for item in record.get("claimant_extensions", [])]
    if record.get("record_type") == "architecture_core":
        ids += [item["arc_id"] for item in record["arcs"]]
        ids += [item["node_id"] for item in record["topology"]["nodes"]]
        ids += [item["edge_id"] for item in record["topology"]["edges"]]
        ids += [item["obligation_id"] for item in record["obligation_graph"]]
        ids += [item["attractor_id"] for item in record["attractors"]]
    if record.get("record_type") == "architecture_plan_batch":
        ids += [item["packet_slot_id"] for item in record["packet_plans"]]
    if record.get("record_type") == "creative_packet":
        ids += [item["scene_id"] for item in record["scenes"]]
        ids += [item["artifact_id"] for item in record["artifacts"]]
        ids += [item["ending_id"] for item in record["endings"]]
        ids += [item["composition_id"] for item in record["formal_compositions"]]
        ids += [item["edge_id"] for item in record["decision_edges"]]
    delta = record.get("constraint_delta", {})
    ids += [item["fact_id"] for item in delta.get("canonical_facts", [])]
    ids += [item["knowledge_id"] for item in delta.get("knowledge_changes", [])]
    ids += [item["obligation_id"] for item in delta.get("new_obligations", [])]
    ids += [item["update_id"] for item in delta.get("obligation_updates", [])]
    ids += [item["motif_event_id"] for item in delta.get("motif_events", [])]
    ids += [item["foreclosure_id"] for item in delta.get("potential_foreclosures", [])]
    return sorted({item for item in ids if item})


def reused_generated_ids(run_dir: Path, record: dict) -> set[str]:
    return set(generated_ids(record)) & set(_source_index(run_dir, generated_ids(record)))


def constraint_deltas(record: dict) -> tuple[dict, list[str], list[str], list[str]]:
    delta = record.get("constraint_delta", {})
    groups = {
        "canonical_facts": list(delta.get("canonical_facts", [])),
        "knowledge_changes": list(delta.get("knowledge_changes", [])),
        "new_obligations": list(delta.get("new_obligations", [])),
        "obligation_updates": list(delta.get("obligation_updates", [])),
        "motif_events": list(delta.get("motif_events", [])),
        "potential_foreclosures": list(delta.get("potential_foreclosures", [])),
    }
    if record.get("record_type") == "architecture_core":
        groups["new_obligations"] = list(record["obligation_graph"]) + groups["new_obligations"]
    past = [item["fact_id"] for item in groups["canonical_facts"]]
    past += [item["knowledge_id"] for item in groups["knowledge_changes"]]
    future = [item["obligation_id"] for item in groups["new_obligations"]]
    future += [item["update_id"] for item in groups["obligation_updates"]]
    future += [item["foreclosure_id"] for item in groups["potential_foreclosures"]]
    motifs = [item["motif_event_id"] for item in groups["motif_events"]]
    return groups, past, future, motifs


def _source_index(run_dir: Path, identifiers=None) -> dict:
    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        if identifiers is None:
            rows = db.execute("SELECT id,commit_id,hash FROM sources ORDER BY id").fetchall()
        else:
            rows = []
            identifiers = sorted(set(identifiers))
            for offset in range(0, len(identifiers), 500):
                batch = identifiers[offset:offset + 500]
                rows.extend(db.execute("SELECT id,commit_id,hash FROM sources WHERE id IN (" + ",".join("?" for _ in batch) + ")", batch))
        return {identifier: {"commit_id": commit_id, "hash": digest} for identifier, commit_id, digest in rows}


def make_constraint_events(run_dir: Path, record: dict, commit_id: str, record_hash: str, step_id: str) -> list[dict]:
    groups, _, _, _ = constraint_deltas(record)
    source_ids = {source["artifact_id"] for items in groups.values() for item in items
                  for source in item.get("sources", item.get("evidence_sources", []))}
    source_index = _source_index(run_dir, source_ids)
    for identifier in generated_ids(record):
        source_index[identifier] = {"commit_id": commit_id, "hash": record_hash}
    sequence = index_checkpoint(run_dir)["event_sequence"]
    protocol = load_protocol(run_dir)
    events = []
    definitions = (
        ("canonical_facts", "past_constraint", "canonical_fact", "fact_id", "sources"),
        ("knowledge_changes", "past_constraint", "knowledge_state", "knowledge_id", "sources"),
        ("new_obligations", "future_obligation", "obligation", "obligation_id", "sources"),
        ("obligation_updates", "future_obligation", "obligation_update", "update_id", "evidence_sources"),
        ("motif_events", "motif_pressure", "motif_state", "motif_event_id", "sources"),
        ("potential_foreclosures", "prospective_foreclosure", "foreclosure_candidate", "foreclosure_id", "sources"),
    )
    for group, constraint_class, constraint_kind, id_key, source_key in definitions:
      for item in groups[group]:
        sources = []
        for source in item[source_key]:
            resolved = source_index.get(source["artifact_id"])
            if not resolved:
                raise SchemaError(f"Constraint source does not resolve: {source['artifact_id']}")
            sources.append(
                source
                | {
                    "source_commit_id": resolved["commit_id"],
                    "source_hash": resolved["hash"],
                }
            )
        action = item.get("action", "establish")
        if constraint_kind == "obligation_update":
            action = {
                "satisfied": "satisfy",
                "foreclosed": "foreclose",
                "impossible": "mark_impossible",
                "intentionally_unresolved": "resolve_ambiguously",
            }[item["status"]]
        elif constraint_kind == "motif_state":
            action = "establish" if item["action"] == "establish" else "update"
        event = {
            "record_type": "constraint_event",
            "protocol_version": PROTOCOL_VERSION,
            "generation_id": record["generation_id"],
            "constraint_event_sequence": sequence + len(events) + 1,
            "origin_step_id": step_id,
            "constraint_id": item[id_key],
            "constraint_class": constraint_class,
            "constraint_kind": constraint_kind,
            "action": action,
            "data": {key: value for key, value in item.items() if key != source_key},
            "sources": sources,
        }
        validate_json_schema(event, protocol["$defs"]["constraintEvent"], protocol)
        events.append(event)
    return events


def project_constraint_state(events: list[dict]) -> tuple[dict, dict, dict, dict, dict]:
    facts = {}
    knowledge = {}
    obligations = {}
    motifs = {}
    foreclosures = {}
    for event in events:
        data = event["data"]
        kind = event["constraint_kind"]
        if kind == "canonical_fact":
            if data.get("supersedes_fact_id"):
                facts.pop(data["supersedes_fact_id"], None)
            facts[data["fact_id"]] = event
        elif kind == "knowledge_state":
            subject = knowledge.setdefault(data["subject_id"], {name: {} for name in ("knows", "believes", "suspects", "explicitly_does_not_know", "claims")})
            target = subject[data["relation"]]
            if data["action"] == "retract":
                target.pop(data["proposition_id"], None)
            else:
                target[data["proposition_id"]] = event
        elif kind == "obligation":
            obligations[data["obligation_id"]] = event
        elif kind == "obligation_update":
            obligation = obligations.get(data["obligation_id"])
            if not obligation:
                raise IntegrityError(f"Obligation update references unknown obligation: {data['obligation_id']}")
            obligation = json.loads(json.dumps(obligation))
            obligation["data"]["status"] = data["status"]
            obligation["resolution_event"] = event
            obligations[data["obligation_id"]] = obligation
        elif kind == "motif_state":
            motif = motifs.setdefault(data["motif_id"], {"motif_id": data["motif_id"], "appearances": [], "provenance": []})
            motif["appearances"].extend(source["artifact_id"] for source in event["sources"])
            motif["current_function"] = data["current_function"]
            motif["pressure"] = data["pressure"]
            motif["overuse_risk"] = data["overuse_risk"]
            motif["provenance"].append(event["constraint_id"])
        elif kind == "foreclosure_candidate":
            foreclosures[event["constraint_id"]] = event
    return facts, knowledge, obligations, motifs, foreclosures


def committed_directories(run_dir: Path) -> list[Path]:
    root = run_dir / "committed"
    return sorted((path for path in root.iterdir() if path.is_dir()), key=lambda path: int(path.name.split("-", 1)[0])) if root.exists() else []


def verify_immutable_file(path: Path, expected_hash: str) -> None:
    if not path.exists() or sha256_file(path) != expected_hash:
        raise IntegrityError(f"Committed file changed or disappeared: {path}")


def reconcile_run(run_dir: Path) -> None:
    _REPLAYING.add(run_dir)
    try:
        _reconcile_archive(run_dir)
    except (ValueError, KeyError) as error:
        raise IntegrityError(f"Malformed archived history: {error}") from error
    finally:
        _REPLAYING.discard(run_dir)
    # A crash may preserve a creative commit before its prospective plan is recorded.
    records = indexed_records(run_dir)
    if records and records[-1]["record_type"] in {"creative_packet", "architecture_plan_batch"}:
        recompute_prospective_plan(run_dir, records[-1]["commit_id"])


def recover_ledger_tail(run_dir: Path) -> None:
    path = run_dir / "ledger.jsonl"
    data = path.read_bytes() if path.exists() else b""
    if not data or data.endswith(b"\n"):
        return
    prefix, _, tail = data.rpartition(b"\n")
    entries = [json.loads(line) for line in prefix.splitlines() if line.strip()]
    previous = entries[-1] if entries else None
    candidates = []
    for directory in committed_directories(run_dir):
        meta = read_json(directory / "commit-meta.json")
        entry = meta["ledger_entry"]
        if entry["ledger_sequence"] == len(entries) + 1 and entry["previous_entry_hash"] == (previous["entry_hash"] if previous else None):
            if canonical_json(entry).startswith(tail) and compute_entry_hash(entry) == entry["entry_hash"]:
                candidates.append((directory, meta))
    if len(candidates) != 1:
        raise IntegrityError("Incomplete ledger tail has no exact immutable commit metadata")
    directory, meta = candidates[0]
    for name, digest in (("record.json", meta["record_hash"]), ("raw-response.txt", meta["raw_response_hash"]),
                         ("api-response.json", meta["api_response_hash"]), *meta.get("supplemental_hashes", {}).items()):
        verify_immutable_file(directory / name, digest)
    with path.open("ab") as handle:
        handle.write(canonical_json(meta["ledger_entry"])[len(tail):])
        handle.flush()
        os.fsync(handle.fileno())


def _reconcile_archive(run_dir: Path) -> None:
    state = load_state(run_dir)
    verify_engine_snapshot(run_dir)
    verify_immutable_file(run_dir / "generation-brief.json", state["brief_hash"])
    verify_immutable_file(run_dir / "run-manifest.json", state["manifest_hash"])
    recover_ledger_tail(run_dir)
    entries = ledger_entries(run_dir)
    previous = None
    canonical_state = state["manifest_hash"]
    for index, entry in enumerate(entries, 1):
        if entry["ledger_sequence"] != index or entry["previous_entry_hash"] != previous:
            raise IntegrityError("Ledger order or hash chain was changed")
        if compute_entry_hash(entry) != entry["entry_hash"]:
            raise IntegrityError(f"Ledger entry {index} was changed")
        if entry["parent_canonical_state_hash"] != canonical_state:
            raise IntegrityError("Ledger canonical-state chain was changed")
        canonical_state = entry["canonical_state_hash_after"]
        previous = entry["entry_hash"]
    prospective_history = run_dir / "planning/prospective-plans.jsonl"
    prospective_plans = [
        json.loads(line) for line in prospective_history.read_text(encoding="utf-8").splitlines()
    ] if prospective_history.exists() else []
    matches = {entry["planned_step_id"]: entry for entry in entries if entry["commit_status"] == "COMMITTED"}
    protocol = load_protocol(run_dir)
    for index, plan in enumerate(prospective_plans, 1):
        validate_json_schema(plan, protocol["$defs"]["prospectivePlan"], protocol)
        if plan["plan_id"] != f"prospective_plan_{index:04d}":
            raise IntegrityError("Prospective plan history was reordered or truncated")
        step_id = f"prospective_{sha256_bytes(plan['recomputed_after_commit_id'].encode())[:16]}"
        plan_hash = sha256_bytes(canonical_json(plan))
        match = matches.get(step_id)
        if not match:
            append_deterministic_step(
                run_dir,
                step_id,
                "prospective_plan",
                plan_hash,
                prospective_plan_hash=plan_hash,
            )
            entries = ledger_entries(run_dir)
            match = entries[-1]
            matches[step_id] = match
        if match["output_hash"] != plan_hash or match["prospective_plan_hash_after"] != plan_hash:
            raise IntegrityError(f"Prospective plan audit hash changed: {plan['plan_id']}")
    committed_steps = {}
    expected_constraints = []
    source_index = {}
    commits = []
    for directory in committed_directories(run_dir):
        meta = read_json(directory / "commit-meta.json")
        verify_immutable_file(directory / "record.json", meta["record_hash"])
        verify_immutable_file(directory / "raw-response.txt", meta["raw_response_hash"])
        verify_immutable_file(directory / "api-response.json", meta["api_response_hash"])
        for name, expected_hash in meta.get("supplemental_hashes", {}).items():
            verify_immutable_file(directory / name, expected_hash)
        step_id = meta["ledger_entry"]["planned_step_id"]
        if step_id in committed_steps:
            raise IntegrityError(f"Creative step committed more than once: {step_id}")
        committed_steps[step_id] = directory
        match = matches.get(step_id)
        if match is None:
            if meta["ledger_entry"]["previous_entry_hash"] != (entries[-1]["entry_hash"] if entries else None):
                raise IntegrityError(f"Cannot reconcile ledger for {step_id}")
            append_ledger_entry(run_dir, meta["ledger_entry"])
            entries.append(meta["ledger_entry"])
            matches[step_id] = meta["ledger_entry"]
        elif match != meta["ledger_entry"]:
            raise IntegrityError(f"Ledger metadata differs from immutable commit {step_id}")
        record = read_json(directory / "record.json")
        constraint_hash = sha256_bytes(b"".join(canonical_json(event) for event in meta["constraint_events"]))
        entry = meta["ledger_entry"]
        expected_hash = sha256_bytes(f"{entry['parent_canonical_state_hash']}:{meta['record_hash']}:{constraint_hash}".encode())
        if expected_hash != entry["canonical_state_hash_after"] or entry["output_hash"] != meta["record_hash"]:
            raise IntegrityError(f"Commit state hash changed: {step_id}")
        if record["generation_id"] != state["generation_id"]:
            raise IntegrityError("Committed record belongs to a different generation")
        validate_declared_id_uniqueness(record)
        commits.append((str(directory.relative_to(run_dir)), meta, record))
        for identifier in generated_ids(record):
            if identifier in source_index:
                raise IntegrityError(f"Generated ID was reused: {identifier}")
            source_index[identifier] = {"commit_id": record["commit_id"], "hash": meta["record_hash"]}
        expected_constraints.extend(meta["constraint_events"])
    inflight_path = run_dir / "state/inflight.json"
    if inflight_path.exists() and read_json(inflight_path).get("step_id") in committed_steps:
        inflight_path.unlink()
    for entry in entries:
        if entry["step_type"] == "creative" and entry["commit_status"] == "COMMITTED" and entry["planned_step_id"] not in committed_steps:
            raise IntegrityError(f"Committed archive disappeared: {entry['planned_step_id']}")
    if sum(entry["step_phase"] == "prospective_plan" and entry["commit_status"] == "COMMITTED" for entry in entries) != len(prospective_plans):
        raise IntegrityError("Prospective plan history was truncated")
    for sequence, event in enumerate(expected_constraints, 1):
        if event["constraint_event_sequence"] != sequence:
            raise IntegrityError("Constraint event order was changed")
        for source in event["sources"]:
            resolved = source_index.get(source["artifact_id"])
            if not resolved or resolved != {"commit_id": source["source_commit_id"], "hash": source["source_hash"]}:
                raise IntegrityError(f"Constraint source provenance changed: {source['artifact_id']}")
    if state["ledger_sequence"] > len(entries):
        raise IntegrityError("Durable ledger history was truncated")
    constraint_bytes = b"".join(canonical_json(event) for event in expected_constraints)
    constraint_path = run_dir / "constraints/constraint-events.jsonl"
    existing = constraint_path.read_bytes() if constraint_path.exists() else b""
    if not constraint_bytes.startswith(existing):
        raise IntegrityError("Constraint event history was changed")
    constraint_path.parent.mkdir(parents=True, exist_ok=True)
    if len(existing) < len(constraint_bytes):
        with constraint_path.open("ab") as handle:
            handle.write(constraint_bytes[len(existing):])
            handle.flush()
            os.fsync(handle.fileno())
    expected_maps = project_constraint_state(expected_constraints)
    if not index_matches(run_dir, entries, commits, prospective_plans, expected_maps, source_index, expected_constraints):
        rebuild_index(run_dir, entries, commits, prospective_plans)
    refresh_run_counters(run_dir)


def commit_record(
    run_dir: Path,
    record: dict,
    raw_response: str,
    api_response: dict,
    *,
    planned_step_id: str,
    attempt: int,
    step_phase: str,
    prompt: str,
    context: str,
    parameters: dict,
    branch_relation: str,
    usage_already_ledgered: bool = False,
) -> Path:
    ensure_index(run_dir)
    state = load_state(run_dir)
    protocol = load_protocol(run_dir)
    definition = protocol["$defs"][RECORD_DEFS[record["record_type"]]]
    validate_json_schema(record, definition, protocol)
    if record["generation_id"] != state["generation_id"]:
        raise SchemaError("Record generation_id does not match the frozen run")
    if step_is_committed(run_dir, planned_step_id):
        raise IntegrityError(f"Refusing to regenerate committed step {planned_step_id}")
    validate_declared_id_uniqueness(record)
    duplicate_ids = reused_generated_ids(run_dir, record)
    if duplicate_ids:
        raise SchemaError(f"Record reuses previously committed IDs: {', '.join(sorted(duplicate_ids))}")
    validate_record_evidence(run_dir, record)
    record_bytes = canonical_json(record)
    record_hash = sha256_bytes(record_bytes)
    raw_bytes = raw_response.encode("utf-8")
    api_bytes = canonical_json(api_response)
    _, past_ids, future_ids, motif_ids = constraint_deltas(record)
    commit_id = record["commit_id"]
    constraint_events = make_constraint_events(run_dir, record, commit_id, record_hash, planned_step_id)
    constraint_hash = sha256_bytes(b"".join(canonical_json(item) for item in constraint_events))
    state_after = sha256_bytes(f"{state['canonical_state_hash']}:{record_hash}:{constraint_hash}".encode())
    usage = copy.deepcopy(api_response.get("usage", {}) or {}) if isinstance(api_response, dict) and not usage_already_ledgered else {}

    def add_usage(extra):
        for key in ("prompt_tokens", "completion_tokens"):
            usage[key] = (usage.get(key) or 0) + (extra.get(key) or 0)
        reasoning = (extra.get("completion_tokens_details") or {}).get("reasoning_tokens")
        if reasoning is not None:
            details = usage.get("completion_tokens_details") or {}
            usage["completion_tokens_details"] = details
            details["reasoning_tokens"] = (details.get("reasoning_tokens") or 0) + reasoning

    semantic_api_path = run_dir / ".staging" / f"{planned_step_id}.semantic.api.json"
    if semantic_api_path.exists():
        semantic_usage = read_json(semantic_api_path).get("usage", {})
        add_usage(semantic_usage)
    repair_path = run_dir / ".staging" / f"{planned_step_id}.repair.json"
    if repair_path.exists():
        for repair in read_json(repair_path)["history"]:
            repair_usage = {} if repair.get("usage_ledgered") else (repair["api_response"].get("usage") or {})
            add_usage(repair_usage)
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=planned_step_id,
        attempt=attempt,
        step_type="creative",
        step_phase=step_phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=sha256_bytes(prompt.encode()),
        context_hash=sha256_bytes(context.encode()),
        provider="LM Studio",
        model=state["model"],
        parameters=parameters,
        seed=parameters["seed"],
        started_at=api_response.get("_cathedrals_started_at", utc_now()),
        output_hash=record_hash,
        generated_ids=generated_ids(record),
        past_constraint_ids=past_ids,
        future_obligation_ids=future_ids,
        motif_ids=motif_ids,
        branch_relation=branch_relation,
        commit_status="COMMITTED",
        state_hash_after=state_after,
        failure_class="none",
        usage=usage,
    )
    sequence = entry["ledger_sequence"]
    destination = run_dir / "committed" / f"{sequence:04d}-{planned_step_id}"
    if destination.exists():
        raise IntegrityError(f"Commit directory already exists: {destination}")
    staging = Path(tempfile.mkdtemp(prefix=f"{planned_step_id}-", dir=run_dir / ".staging"))
    write_atomic(staging / "record.json", record_bytes)
    write_atomic(staging / "raw-response.txt", raw_bytes)
    write_atomic(staging / "api-response.json", api_bytes)
    supplemental = []
    for suffix, target in (
        (".planning.json", "planning-draft.json"),
        (".artistic.json", "artistic-payload.json"),
        (".artistic.txt", "artistic-response.txt"),
        (".artistic.api.json", "artistic-api-response.json"),
        (".semantic.json", "semantic-normalization.json"),
        (".semantic.api.json", "semantic-api-response.json"),
        (".semantic-recovery.json", "semantic-recovery.json"),
        (".scaffold-evidence.json", "scaffold-evidence.json"),
        (".epistemic-repair.json", "epistemic-repair.json"),
        (".repair.json", "reference-repair.json"),
        (".references.json", "named-reference-repair.json"),
        (".retrieval.json", "retrieval-receipt.json"),
        (".retrieval-session.json", "retrieval-session.json"),
    ):
        source = run_dir / ".staging" / f"{planned_step_id}{suffix}"
        if source.exists():
            shutil.copy2(source, staging / target)
            supplemental.append(target)
    meta = {
        "record_hash": record_hash,
        "raw_response_hash": sha256_bytes(raw_bytes),
        "api_response_hash": sha256_bytes(api_bytes),
        "constraint_events": constraint_events,
        "supplemental_hashes": {name: sha256_file(staging / name) for name in supplemental},
        "ledger_entry": entry,
    }
    write_json(staging / "commit-meta.json", meta)
    for path in staging.iterdir():
        make_read_only(path)
    os.replace(staging, destination)
    os.chmod(destination, 0o555)
    append_ledger_entry(run_dir, entry, commit=(destination, meta, record))
    raw_view = run_dir / "raw" / f"{sequence:04d}-{planned_step_id}.txt"
    if not raw_view.exists():
        try:
            os.link(destination / "raw-response.txt", raw_view)
        except OSError:
            shutil.copyfile(destination / "raw-response.txt", raw_view)
            make_read_only(raw_view)
    state["canonical_state_hash"] = state_after
    state["stage"] = step_phase.upper()
    refresh_run_counters(run_dir, state)
    inflight_path = run_dir / "state/inflight.json"
    if inflight_path.exists() and read_json(inflight_path).get("step_id") == planned_step_id:
        inflight_path.unlink()
    for suffix in (".artistic.json", ".artistic.txt", ".artistic.api.json", ".semantic.json", ".semantic.api.json", ".semantic-recovery.json", ".repair.json", ".references.json", ".retrieval.json"):
        (run_dir / ".staging" / f"{planned_step_id}{suffix}").unlink(missing_ok=True)
    if record["record_type"] == "creative_packet" or (
        record["record_type"] == "architecture_plan_batch" and assembled_architecture(run_dir)
    ):
        recompute_prospective_plan(run_dir, record["commit_id"])
    return destination


def append_failed_attempt(
    run_dir: Path,
    *,
    step_id: str,
    attempt: int,
    phase: str,
    prompt: str,
    context: str,
    parameters: dict,
    started_at: str,
    failure_class: str,
    output_hash: str | None = None,
    step_type: str = "creative",
    usage: dict | None = None,
) -> None:
    state = load_state(run_dir)
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=step_id,
        attempt=attempt,
        step_type=step_type,
        step_phase=phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=sha256_bytes(prompt.encode()),
        context_hash=sha256_bytes(context.encode()),
        provider="LM Studio",
        model=state["model"],
        parameters=parameters,
        seed=parameters["seed"],
        started_at=started_at,
        output_hash=output_hash,
        generated_ids=[],
        past_constraint_ids=[],
        future_obligation_ids=[],
        motif_ids=[],
        branch_relation=None,
        commit_status="FAILED_BEFORE_COMMIT",
        state_hash_after=state["canonical_state_hash"],
        failure_class=failure_class,
        usage=usage,
    )
    append_ledger_entry(run_dir, entry)
    state["ledger_sequence"] = entry["ledger_sequence"]
    refresh_run_counters(run_dir, state)


def committed_record(run_dir: Path, record_type: str, packet_slot_id: str | None = None):
    if record_type == "genesis":
        return assembled_genesis(run_dir)
    if record_type == "architecture":
        return assembled_architecture(run_dir)
    if record_type == "creative_packet" and packet_slot_id is not None:
        return assembled_packet(run_dir, packet_slot_id)
    records = indexed_records(run_dir, record_type, packet_slot_id)
    return records[0] if records else None


def all_committed_records(run_dir: Path) -> list[dict]:
    return indexed_records(run_dir)


def committed_records(run_dir: Path, record_type: str) -> list[dict]:
    return indexed_records(run_dir, record_type)


def assembled_genesis(run_dir: Path) -> dict | None:
    foundation = committed_record(run_dir, "genesis_foundation")
    cast = committed_record(run_dir, "genesis_cast")
    constraints = committed_record(run_dir, "genesis_constraints")
    if not foundation or not cast or not constraints:
        return None
    expansions = {item["claimant_id"]: item for item in cast["claimants"]}
    extensions = constraints.get("claimant_extensions", [])
    work_canon = copy.deepcopy(foundation["work_canon"])
    for extension in extensions:
        claimant_id = extension["anchor"]["claimant_id"]
        if claimant_id not in work_canon["central_incident"]["subjects"]:
            work_canon["central_incident"]["subjects"].append(claimant_id)
        work_canon["claimant_relationships"].extend(extension["claimant_relationships"])
    return {
        "record_type": "genesis",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": foundation["generation_id"],
        "commit_id": constraints["commit_id"],
        "story_format": "web",
        "format_composition_law": foundation["format_composition_law"],
        "work_canon": work_canon,
        "web_art_direction": foundation["web_art_direction"],
        "claimants": [
            expansions[anchor["claimant_id"]] | anchor
            for anchor in foundation["claimant_anchors"]
        ] + [extension["profile"] | extension["anchor"] for extension in extensions],
        "characters": cast["characters"],
        "constraint_delta": constraints["constraint_delta"],
    }


def assembled_architecture(run_dir: Path) -> dict | None:
    core = committed_record(run_dir, "architecture_core")
    if not core:
        return None
    batches = sorted(committed_records(run_dir, "architecture_plan_batch"), key=lambda item: item["batch_sequence"])
    if not batches or len(batches) != batches[0]["batch_count"]:
        return None
    return architecture_from_parts(core, batches)


def planning_core(run_dir: Path) -> dict | None:
    record = committed_record(run_dir, "architecture_core")
    path = run_dir / ".staging/architecture_core.planning.json"
    return record or (read_json(path).get("record") if path.exists() else None)


def planning_batches_view(run_dir: Path) -> list[dict]:
    records = {item["batch_sequence"]: item for item in committed_records(run_dir, "architecture_plan_batch")}
    for path in sorted((run_dir / ".staging").glob("architecture_plan_batch_*.planning.json")):
        record = read_json(path).get("record")
        if record:
            records.setdefault(record["batch_sequence"], record)
    return [records[key] for key in sorted(records)]


def architecture_from_parts(core: dict, batches: list[dict]) -> dict:
    plans = [plan for batch in batches for plan in batch["packet_plans"]]
    attractor_slots = {
        attractor["attractor_id"]: [
            slot
            for plan in plans
            if plan["packet_kind"] == "ending" and attractor["attractor_id"] in plan["attractor_ids"]
            for slot in plan["ending_slot_ids"]
        ]
        for attractor in core["attractors"]
    }
    return core | {
        "record_type": "architecture",
        "commit_id": batches[-1]["commit_id"],
        "architecture_core_commit_id": core["commit_id"],
        "packet_plan_commit_ids": [item["commit_id"] for item in batches],
        "attractors": [item | {"ending_slot_ids": attractor_slots[item["attractor_id"]]} for item in core["attractors"]],
        "packet_plans": plans,
    }


def plan_batch_for(run_dir: Path, packet_slot_id: str) -> dict | None:
    return next(
        (
            batch
            for batch in committed_records(run_dir, "architecture_plan_batch")
            if any(plan["packet_slot_id"] == packet_slot_id for plan in batch["packet_plans"])
        ),
        None,
    )


def packet_chunks(run_dir: Path, packet_slot_id: str) -> list[dict]:
    return [
        record for record in committed_records(run_dir, "creative_packet")
        if record["packet_slot_id"] == packet_slot_id
    ]


def completed_packet_slots(architecture: dict, records: list[dict]) -> set[str]:
    complete = set()
    for plan in architecture["packet_plans"]:
        chunks = [record for record in records if record.get("record_type") == "creative_packet" and record.get("packet_slot_id") == plan["packet_slot_id"]]
        if not chunks:
            continue
        key = "scenes" if plan["packet_kind"] == "literary" else "endings"
        items = [item for chunk in chunks for item in chunk[key]]
        if items and "technical_slot_id" not in items[0]:
            complete.add(plan["packet_slot_id"])
            continue
        expected = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
        actual = {item["technical_slot_id"] for item in items}
        if (
            actual == expected
            and sum(len(chunk["artifacts"]) for chunk in chunks) == plan["artifact_count"]
            and sum(len(chunk["formal_compositions"]) for chunk in chunks) == plan["formal_composition_count"]
        ):
            complete.add(plan["packet_slot_id"])
    return complete


def assembled_packet(run_dir: Path, packet_slot_id: str) -> dict | None:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        return None
    plan = next((item for item in architecture["packet_plans"] if item["packet_slot_id"] == packet_slot_id), None)
    chunks = packet_chunks(run_dir, packet_slot_id)
    return packet_from_chunks(plan, chunks)


def packet_from_chunks(plan: dict | None, chunks: list[dict]) -> dict | None:
    if not plan or not chunks:
        return None
    content_key = "scenes" if plan["packet_kind"] == "literary" else "endings"
    expected_slots = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
    actual_slots = {
        item["technical_slot_id"] for chunk in chunks for item in chunk[content_key]
    }
    if actual_slots != expected_slots:
        return None
    if sum(len(chunk["artifacts"]) for chunk in chunks) != plan["artifact_count"]:
        return None
    if sum(len(chunk["formal_compositions"]) for chunk in chunks) != plan["formal_composition_count"]:
        return None
    delta = {
        key: [item for chunk in chunks for item in chunk["constraint_delta"][key]]
        for key in ("canonical_facts", "knowledge_changes", "new_obligations", "obligation_updates", "motif_events", "potential_foreclosures")
    }
    first, last = chunks[0], chunks[-1]
    return first | {
        "commit_id": last["commit_id"],
        "packet_sequence": last["packet_sequence"],
        "obligations_advanced": sorted({item for chunk in chunks for item in chunk["obligations_advanced"]}),
        "scenes": [item for chunk in chunks for item in chunk["scenes"]],
        "artifacts": [item for chunk in chunks for item in chunk["artifacts"]],
        "endings": [item for chunk in chunks for item in chunk["endings"]],
        "decision_edges": [item for chunk in chunks for item in chunk["decision_edges"]],
        "formal_compositions": [item for chunk in chunks for item in chunk["formal_compositions"]],
        "constraint_delta": delta,
    }


def record_source_pointers(record):
    pointers = {record["commit_id"]: ""} if record.get("commit_id") else {}
    def group(parent, field, identity, prefix=""):
        for index, unit in enumerate(parent.get(field, [])):
            if unit.get(identity):
                pointers[unit[identity]] = f"{prefix}/{field}/{index}"
    kind = record.get("record_type")
    if kind == "genesis_foundation":
        group(record.get("work_canon", {}), "chronology", "event_id", "/work_canon")
        group(record, "claimant_anchors", "claimant_id")
    elif kind == "genesis_cast":
        group(record, "characters", "character_id")
    elif kind == "genesis_constraints":
        for index, unit in enumerate(record.get("claimant_extensions", [])):
            pointers[unit["anchor"]["claimant_id"]] = f"/claimant_extensions/{index}"
    elif kind == "architecture_core":
        for field, identity in (("arcs", "arc_id"), ("attractors", "attractor_id"), ("obligation_graph", "obligation_id")):
            group(record, field, identity)
        for field, identity in (("nodes", "node_id"), ("edges", "edge_id")):
            group(record.get("topology", {}), field, identity, "/topology")
    elif kind == "architecture_plan_batch":
        group(record, "packet_plans", "packet_slot_id")
    elif kind == "creative_packet":
        for field, identity in (("scenes", "scene_id"), ("artifacts", "artifact_id"), ("endings", "ending_id"),
                ("formal_compositions", "composition_id"), ("decision_edges", "edge_id")):
            group(record, field, identity)
    for field, identity in (("canonical_facts", "fact_id"), ("knowledge_changes", "knowledge_id"),
            ("new_obligations", "obligation_id"), ("obligation_updates", "update_id"),
            ("motif_events", "motif_event_id"), ("potential_foreclosures", "foreclosure_id")):
        group(record.get("constraint_delta", {}), field, identity, "/constraint_delta")
    return pointers


def read_evidence_pointer(record, pointer, *, source_id, archive="in-memory record"):
    value, traversed = record, ""
    try:
        if not isinstance(pointer, str) or pointer and not pointer.startswith("/") or re.search(r"~(?![01])", pointer):
            raise ValueError("Expected an RFC 6901 JSON Pointer")
        for raw in pointer[1:].split("/") if pointer else []:
            part = raw.replace("~1", "/").replace("~0", "~")
            if isinstance(value, list):
                if not re.fullmatch(r"0|[1-9][0-9]*", part):
                    raise ValueError("Array indices must be zero-based integers without leading zeroes")
                value = value[int(part)]
            elif isinstance(value, dict):
                value = value[part]
            else:
                raise TypeError("Pointer continues past a scalar value")
            traversed += "/" + raw
    except (KeyError, IndexError, TypeError, ValueError) as error:
        raise IntegrityError(
            f"Evidence pointer does not resolve. Source ID: {source_id!r}; owner commit: {record.get('commit_id')!r}; "
            f"record type: {record.get('record_type')!r}; pointer: {pointer!r}; resolved prefix: {traversed!r}; "
            f"archive: {archive}; detail: {error}") from error
    return value


def record_evidence_references(record):
    references = []
    for identifier, pointer in record_source_pointers(record).items():
        unit = read_evidence_pointer(record, pointer, source_id=identifier)
        if isinstance(unit, dict) and (unit.get("sources") or unit.get("evidence_sources")):
            references.append({"constraint_id": identifier, "sources": unit.get("sources", []) + unit.get("evidence_sources", [])})
    return references


def retrieve_original_sources(
    run_dir: Path,
    constraints: list[dict],
    limit: int = 24,
    records: list[dict] | None = None,
    *, strict: bool = False, local_record=None, follow_sources=True,
) -> list[dict]:
    archives, owners, units = {}, {}, {}
    supplied = records is not None
    for record in (records or []) + ([local_record] if local_record is not None else []):
        digest = sha256_bytes(canonical_json(record)) if record is local_record else None
        entry = (record, digest, "uncommitted record" if record is local_record else "supplied record")
        for identifier, pointer in record_source_pointers(record).items():
            owners[identifier] = (entry, pointer)

    def resolve(reference):
        identifier = reference["artifact_id"]
        if identifier not in owners:
            if supplied:
                return None
            catalog = _source_index(run_dir, [identifier])
            if identifier not in catalog:
                return None
            commit_id = catalog[identifier]["commit_id"]
            if commit_id not in archives:
                with index_connection(run_dir) as db:
                    row = db.execute("SELECT path,record_hash FROM records WHERE commit_id=?", (commit_id,)).fetchone()
                if row is None:
                    raise IntegrityError(f"Evidence owner disappeared: {identifier!r}, commit {commit_id!r}")
                path = run_dir / row[0] / "record.json"
                verify_immutable_file(path, row[1])
                record = read_json(path)
                archives[commit_id] = (record, row[1], str(path))
                for owned_id, pointer in record_source_pointers(record).items():
                    owners[owned_id] = (archives[commit_id], pointer)
            if identifier not in owners:
                raise IntegrityError(f"Registered evidence ID {identifier!r} has no source unit in commit {commit_id!r}")
        (record, digest, archive), canonical_pointer = owners[identifier]
        for key, actual in (("source_commit_id", record.get("commit_id")), ("source_hash", digest)):
            if actual is not None and reference.get(key) is not None and reference[key] != actual:
                raise IntegrityError(f"Evidence {key} mismatch for {identifier!r}: supplied {reference[key]!r}, actual {actual!r}; archive: {archive}")
        locator = reference.get("source_locator", "")
        pointer = reference.get("record_pointer", canonical_pointer)
        # Older engine-generated Genesis references used canonical record paths in source_locator.
        if "record_pointer" not in reference and identifier == record.get("commit_id") and record.get("record_type", "").startswith("genesis_") and isinstance(locator, str) and locator.startswith(("/work_canon", "/format_composition_law", "/claimant_anchors/", "/claimants/", "/characters/")):
            pointer = locator
        if canonical_pointer and pointer != canonical_pointer and not (isinstance(pointer, str) and pointer.startswith(canonical_pointer + "/")):
            raise IntegrityError(f"Evidence pointer targets a different source unit. Source ID: {identifier!r}; pointer: {pointer!r}; "
                f"expected unit: {canonical_pointer!r}; owner commit: {record.get('commit_id')!r}; archive: {archive}")
        value = read_evidence_pointer(record, pointer, source_id=identifier, archive=archive)
        return {"source_id": identifier, "source_locator": locator,
            "source_commit_id": record.get("commit_id"), "source_hash": digest, "record_pointer": pointer,
            "source_record_type": record.get("record_type"), "authority": "COMMITTED SOURCE EVIDENCE", "immutable_source": value}

    stack = [("enter", source, constraint.get("constraint_id", "requested evidence"))
        for constraint in reversed(constraints) for source in reversed(constraint.get("sources", []))]
    retrieved, active, complete = [], set(), set()
    while stack:
        action, reference, origin = stack.pop()
        if action == "exit":
            active.remove(reference)
            complete.add(reference)
            continue
        try:
            source = resolve(reference)
        except IntegrityError as error:
            raise IntegrityError(f"{error.reason}\nSource locator: {reference.get('source_locator')!r}; referenced by: {origin}") from error
        if source is None:
            if strict:
                raise IntegrityError(f"Required evidence source does not resolve: {reference['artifact_id']!r}; locator: {reference.get('source_locator')!r}; referenced by: {origin}")
            continue
        key = (source["source_id"], source["source_commit_id"], source["record_pointer"])
        if key in active:
            raise IntegrityError(f"Cyclic evidence provenance: {reference['artifact_id']!r}; referenced by: {origin}")
        if key in units:
            entry = units[key]
            locators = entry.setdefault("source_locators", [entry["source_locator"]])
            if source["source_locator"] not in locators:
                locators.append(source["source_locator"])
        else:
            if limit is not None and len(retrieved) >= limit:
                if strict:
                    raise PausedError("Evidence retrieval", f"Required provenance exceeds {limit} complete units; no prerequisite evidence was dropped", "budget_exhaustion")
                break
            units[key] = source
            retrieved.append(source)
        if key in complete:
            continue
        active.add(key)
        stack.append(("exit", key, origin))
        value = source["immutable_source"]
        if follow_sources and isinstance(value, dict):
            parents = value.get("sources", []) + value.get("evidence_sources", [])
            stack.extend(("enter", parent, source["source_id"]) for parent in reversed(parents))
    return retrieved


def validate_committed_evidence(run_dir):
    return retrieve_original_sources(run_dir, constraint_events(run_dir), limit=None, strict=True)


def validate_record_evidence(run_dir, record):
    try:
        retrieve_original_sources(run_dir, record_evidence_references(record), limit=None, strict=True, local_record=record)
    except IntegrityError as error:
        raise SchemaError(f"Uncommitted evidence reference failed validation: {error.reason}") from error


def geomancy_figures(run_dir: Path | None = None) -> list[dict]:
    figures = []
    current = None
    for line in (engine_root(run_dir) / "data/threshold-geomancy.yaml").read_text(encoding="utf-8").splitlines():
        match = re.match(r"  - id: ([123]-[123]-[123]-[123])$", line)
        if match:
            if current:
                figures.append(current)
            current = {"figure": match.group(1)}
            continue
        if current:
            field = re.match(r"    (name|summary|scene_motion|pressure_type): (.+)$", line)
            if field:
                current[field.group(1)] = field.group(2)
    if current:
        figures.append(current)
    if len(figures) != 81:
        raise CathedralsError("Engine freeze", f"Expected 81 threshold figures; found {len(figures)}")
    return figures


def precompute_geomancy(seed: str, possible_scene_count: int, run_dir: Path | None = None) -> dict:
    figures = geomancy_figures(run_dir)
    assignments = []
    for number in range(1, possible_scene_count + 1):
        slot = f"scene_slot_{number:04d}"
        digest = hashlib.sha256(f"{seed}:{slot}".encode()).digest()
        figure = figures[int.from_bytes(digest[:4], "big") % len(figures)]
        assignments.append({"technical_slot_id": slot} | figure)
    for index, assignment in enumerate(assignments):
        if index + 1 == len(assignments):
            assignment["resultant"] = None
            continue
        left = [int(value) for value in assignment["figure"].split("-")]
        right = [int(value) for value in assignments[index + 1]["figure"].split("-")]
        assignment["resultant"] = "-".join(str(((a + b - 2) % 3) + 1) for a, b in zip(left, right))
    return {"seed": seed, "assignments": assignments}


def ensure_frozen_geomancy(run_dir: Path) -> dict:
    path = run_dir / "state/frozen-geomancy.json"
    if path.exists():
        value = read_json(path)
        expected = load_state(run_dir).get("geomancy_hash")
        if expected and sha256_file(path) != expected:
            raise IntegrityError("Frozen threshold geomancy changed")
        return value
    manifest = read_json(run_dir / "run-manifest.json")
    value = precompute_geomancy(
        manifest["engine_snapshot"]["geomancy_seed"],
        manifest["scope"]["possible_scene_count"],
        run_dir,
    )
    write_json(path, value, mode=0o444, exclusive=True)
    state = load_state(run_dir)
    state["geomancy_hash"] = sha256_file(path)
    save_state(run_dir, state)
    return value


def engine_context(run_dir: Path | None = None, files=ENGINE_CONTEXT_FILES) -> str:
    sections = []
    for relative in files:
        path = engine_root(run_dir) / relative
        sections.append(f"===== engine/{relative} =====\n{path.read_text(encoding='utf-8')}")
    return "\n\n".join(sections)


def instruction_profile(run_dir: Path, purpose="packet") -> tuple[str, dict]:
    semantic = purpose == "semantic"
    files = ("llm-instructions.md", "canon/ontology.md", "data/state-model.yaml") if semantic else tuple(
        name for name in ENGINE_CONTEXT_FILES if name not in {"data/work-instance.yaml", "docs/generation-workflow-contract.md"})
    sections, provenance = [], {"purpose": purpose, "sources": {}}
    for name in (*files, "data/work-instance.yaml", *(("docs/generation-workflow-contract.md",) if not semantic else ())):
        path = engine_root(run_dir) / name
        text = path.read_text(encoding="utf-8")
        source = {"hash": sha256_file(path)}
        if name == "data/work-instance.yaml":
            selected = SEMANTIC_WORK_SECTIONS if semantic else PACKET_WORK_SECTIONS
            matches = list(re.finditer(r"(?m)^([a-z_][a-z_0-9]*):", text))
        elif name == "docs/generation-workflow-contract.md":
            selected = PACKET_WORKFLOW_SECTIONS
            matches = list(re.finditer(r"(?m)^## (.+)$", text))
        else:
            selected, matches = None, []
        if selected is not None:
            found = {match[1]: text[match.start():matches[index + 1].start() if index + 1 < len(matches) else len(text)]
                for index, match in enumerate(matches)}
            if set(selected) - found.keys():
                raise IntegrityError(f"Instruction profile sections are missing from {name}: " + ", ".join(sorted(set(selected) - found.keys())))
            text = "\n".join(found[key] for key in selected)
            source["sections"] = list(selected)
        sections.append(f"===== engine/{name} =====\n{text}")
        provenance["sources"][name] = source
    text = "\n\n".join(sections)
    provenance["hash"] = sha256_bytes(text.encode())
    return text, provenance


def estimated_prompt_tokens(text: str) -> int:
    return math.ceil(len(text.encode("utf-8")) / 3)


def packet_input_limit(run_dir: Path, output_tokens=BASE_OUTPUT_TOKENS) -> int:
    budgets = read_json(run_dir / "run-manifest.json")["budgets"]
    window = min(budgets.get("model_context_window_tokens", float("inf")),
        load_state(run_dir).get("model_context_window_tokens", float("inf")))
    return int(min(budgets["max_prepared_context_tokens"], window - output_tokens - budgets.get("context_safety_reserve_tokens", 4096)))


def provider_input_tokens(payload):
    # Count content without JSON transport escaping, plus schema/tool/message envelopes.
    parts = [canonical_json({key: value for key, value in payload.items() if key != "messages"}).decode()]
    for message in payload.get("messages", []):
        content = message.get("content", "")
        parts.append(content if isinstance(content, str) else canonical_json(content).decode())
        parts.append(canonical_json({key: value for key, value in message.items() if key != "content"}).decode())
    return estimated_prompt_tokens("\n".join(parts)) + 32 * len(payload.get("messages", []))


def render_prompt(run_dir: Path, name: str, replacements: dict[str, str]) -> str:
    value = (engine_root(run_dir) / "prompts" / name).read_text(encoding="utf-8")
    for key, replacement in replacements.items():
        value = value.replace("{{" + key + "}}", replacement)
    if re.search(r"\{\{[A-Z0-9_]+\}\}", value):
        raise CathedralsError("Prompt assembly", f"Unresolved prompt placeholder in {name}")
    return value


def bounded_context(sections: list[tuple[str, object]], max_tokens: int) -> str:
    maximum = max_tokens * 4
    output = []
    used = 0
    for label, value in sections:
        header = f"===== {label} =====\n"
        separator_size = 1 if output else 0
        values = value if isinstance(value, list) else [value]
        packed = []
        for item in values:
            text = item if isinstance(item, str) else json.dumps(item, ensure_ascii=False, indent=2)
            candidate = header + "\n\n".join(packed + [text]) + "\n"
            if used + separator_size + len(candidate) <= maximum:
                packed.append(text)
        if packed:
            section = header + "\n\n".join(packed) + "\n"
            output.append(section)
            used += separator_size + len(section)
    return "\n".join(output)


def complete_context(sections: list[tuple[str, object]]) -> str:
    """Required planning inputs are never filtered; the rendered request is budgeted later."""
    return "\n".join(
        f"===== {label} =====\n" + (value if isinstance(value, str) else canonical_json(value).decode()) + "\n"
        for label, value in sections
    )


def parse_structured_content(content: str):
    def unique_properties(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise SchemaError(f"LM Studio returned duplicate JSON property {key!r}")
            result[key] = value
        return result
    try:
        return json.loads(content, object_pairs_hook=unique_properties)
    except json.JSONDecodeError:
        match = re.fullmatch(r"\s*```(?:json)?\s*\n([\s\S]*)\n```\s*", content)
        if not match:
            raise SchemaError("LM Studio returned malformed JSON")
        try:
            return json.loads(match.group(1), object_pairs_hook=unique_properties)
        except json.JSONDecodeError as error:
            raise SchemaError("LM Studio returned malformed JSON inside deterministic code-fence framing") from error


def normalize_provider_response(response, *, plain_answers=None) -> str:
    if isinstance(response, dict) and response.get("_cathedrals_stream_complete") is False:
        raise IncompleteResponseError(response.get("_cathedrals_error", "Saved LM Studio stream is incomplete"), response)
    if response is None:
        raise CathedralsError(
            "LM Studio response",
            "LM Studio request completed without a provider response",
            "provider_before_creative_output",
        )
    try:
        choice = response["choices"][0]
        message = choice["message"]
    except (KeyError, IndexError, TypeError) as error:
        raise CathedralsError(
            "LM Studio response",
            "LM Studio returned no usable response message",
            "provider_before_creative_output",
        ) from error
    if not isinstance(choice, dict) or not isinstance(message, dict):
        raise CathedralsError(
            "LM Studio response",
            "LM Studio returned no usable response message",
            "provider_before_creative_output",
        )
    if choice.get("finish_reason") in {"length", "max_tokens"}:
        raise TruncationError(f"LM Studio response was truncated ({choice['finish_reason']})", response)
    content = message.get("content")
    reasoning = message.get("reasoning")
    reasoning_content = message.get("reasoning_content")
    if isinstance(content, str) and content.strip():
        return content
    if content is not None and not isinstance(content, str):
        raise SchemaError("LM Studio message.content is not text")
    if any(value is not None and not isinstance(value, str) for value in (reasoning, reasoning_content)):
        raise SchemaError("LM Studio reasoning fields are not text")
    populated_reasoning = [
        value for value in (reasoning, reasoning_content)
        if isinstance(value, str) and value.strip()
    ]
    if populated_reasoning:
        if plain_answers is not None and all(value.strip() in plain_answers for value in populated_reasoning):
            if len({value.strip() for value in populated_reasoning}) != 1:
                raise SchemaError("LM Studio returned conflicting reference answers in reasoning fields")
            return populated_reasoning[0].strip()
        try:
            parsed_reasoning = [json.loads(value) for value in populated_reasoning]
        except json.JSONDecodeError as error:
            raise SchemaError("LM Studio reasoning fallback is not a complete JSON value") from error
        if len(parsed_reasoning) == 2 and parsed_reasoning[0] != parsed_reasoning[1]:
            raise SchemaError("LM Studio returned conflicting reasoning and reasoning_content fields")
        return populated_reasoning[0]
    raise CathedralsError(
        "LM Studio response",
        "LM Studio returned a truly empty provider response",
        "provider_before_creative_output",
    )


def provider_response(transport, url: str, payload: dict, timeout: float, *, started_at=None, preserve=None, plain_answers=None, stream_path=None, allow_tools=False):
    try:
        if stream_path and stream_path.exists():
            with stream_path.open("rb") as saved:
                response = read_chat_stream(saved, label=str(stream_path), report=False)
        elif transport is http_json:
            response = transport("POST", url, payload, timeout=timeout, stream_path=stream_path)
        else:
            response = transport("POST", url, payload, timeout=timeout)
    except IncompleteResponseError as error:
        if stream_path and preserve:
            error.reason += f" Diagnostic: {stream_path.with_suffix('.json')}"
        response = (error.response or {}) | {"_cathedrals_stream_complete": False, "_cathedrals_error": error.reason}
        if started_at:
            response["_cathedrals_started_at"] = started_at
        if preserve:
            preserve(response)
        error.response = response
        raise
    if isinstance(response, dict) and started_at:
        response = response | {"_cathedrals_started_at": started_at}
    if response is not None and preserve:
        preserve(response)
    if allow_tools and completed_tool_calls(response):
        return response, ""
    return response, normalize_provider_response(response, plain_answers=plain_answers)


def completed_tool_calls(response):
    if not isinstance(response, dict) or response.get("_cathedrals_stream_complete") is False:
        return []
    choice = (response.get("choices") or [{}])[0]
    if choice.get("finish_reason") != "tool_calls":
        return []
    calls = choice.get("message", {}).get("tool_calls", [])
    if not isinstance(calls, list) or not 1 <= len(calls) <= 8:
        raise SchemaError("Tool response must contain between one and eight calls")
    if any(not isinstance(call, dict) or not isinstance(call.get("id"), str) or not call["id"]
           or call.get("type") != "function" or not isinstance(call.get("function"), dict) for call in calls):
        raise SchemaError("Malformed completed tool call")
    if len({call["id"] for call in calls}) != len(calls):
        raise SchemaError("Duplicate tool call IDs")
    return calls


def step_seed(generation_seed: str, step_id: str) -> str:
    return str(int.from_bytes(hashlib.sha256(f"{generation_seed}:{step_id}".encode()).digest()[:4], "big"))


def request_record(
    run_dir: Path,
    *,
    expected_record_type: str,
    step_id: str,
    phase: str,
    prompt: str,
    context: str,
    branch_relation: str,
    temperature: float,
    max_tokens: int = BASE_OUTPUT_TOKENS,
    transport=http_json,
    precommit_validator=None,
    response_definition: str | None = None,
    response_schema: dict | None = None,
    record_builder=None,
    payload_preserver=None,
    payload_validator=None,
    payload_repairer=None,
    reference_context=None,
    schema_failure_limit: int | None = None,
) -> dict:
    state = load_state(run_dir)
    brief = read_json(run_dir / "generation-brief.json")
    seed = step_seed(brief["generation_seed"], step_id)
    protocol = load_protocol(run_dir)
    response_definition = response_definition or RECORD_DEFS[expected_record_type]
    schema = response_schema or definition_schema(response_definition, protocol)
    wire_schema = copy.deepcopy(schema)
    for name in ("sourceRef", "hashedSourceRef"):
        if name in wire_schema.get("$defs", {}):
            wire_schema["$defs"][name]["properties"].pop("record_pointer", None)
    if expected_record_type == "genesis_constraints":
        wire_schema["$defs"]["relevanceTags"]["properties"]["technical_slot_ids"] = {"type": "array", "maxItems": 0}
    parameters = {"temperature": temperature, "max_tokens": max_tokens, "seed": seed,
                  "stream": True, "stream_options": {"include_usage": True}}
    feedback = ""
    for correction in range(3):
        content = None
        current_prompt = prompt + feedback
        prompt_tokens = estimated_prompt_tokens(RECORD_SYSTEM_PROMPT + current_prompt)
        capacity = packet_input_limit(run_dir, max_tokens)
        if prompt_tokens > capacity:
            raise PausedError("Context assembly", f"Prepared request for {step_id} needs approximately {prompt_tokens:,} input tokens; "
                f"ceiling {capacity:,} after output and safety reserves. No request was sent.", "budget_exhaustion")
        payload = {
            "model": load_state(run_dir)["model"],
            "messages": [
                {"role": "system", "content": RECORD_SYSTEM_PROMPT},
                {"role": "user", "content": current_prompt},
            ],
            **parameters,
            "response_format": {"type": "json_schema", "json_schema": {"name": response_definition, "strict": True, "schema": wire_schema}},
        }
        prompt_tokens = provider_input_tokens(payload)
        if prompt_tokens > capacity:
            raise PausedError("Context assembly", f"Complete provider envelope for {step_id} needs approximately {prompt_tokens:,} input tokens; "
                f"ceiling {capacity:,} after output and safety reserves. No request was sent.", "budget_exhaustion")
        request_hash = sha256_bytes(canonical_json(payload))
        attempts = [entry["attempt"] for entry in step_entries(run_dir, step_id)]
        attempt = max(attempts, default=0) + 1
        inflight_path = run_dir / "state/inflight.json"
        if inflight_path.exists():
            inflight = read_json(inflight_path)
            if inflight["step_id"] != step_id:
                raise IntegrityError("Resume found a different in-flight creative request")
            attempt = inflight["attempt"]
        else:
            inflight = {"step_id": step_id, "attempt": attempt, "request_hash": request_hash, "started_at": utc_now()}
            write_json(inflight_path, inflight, exclusive=True)
        response_path = run_dir / "raw" / f"{step_id}-attempt{attempt}.api.json"
        response = read_json(response_path) if response_path.exists() else None
        retrieval_path = run_dir / ".staging" / f"{step_id}.retrieval.json"
        if retrieval_path.exists():
            receipt = read_json(retrieval_path)
            attempt_receipt = run_dir / "raw" / f"{step_id}-attempt{attempt}.retrieval.json"
            if attempt_receipt.exists():
                saved = read_json(attempt_receipt)
                if saved["context_hash"] != receipt["context_hash"] or saved["canonical_state_hash"] != receipt["canonical_state_hash"]:
                    raise IntegrityError("Saved writing attempt has different retrieval context")
                receipt = saved
            else:
                receipt = receipt | {"attempt": attempt, "prompt_hash": sha256_bytes(current_prompt.encode()),
                    "prepared_prompt_bytes": len(current_prompt.encode()), "estimated_prompt_tokens": prompt_tokens}
                write_json(attempt_receipt, receipt, mode=0o444, exclusive=True)
            write_json(retrieval_path, receipt)
        try:
            preserved_payload = run_dir / ".staging" / f"{step_id}.artistic.json"
            if preserved_payload.exists():
                authored = read_json(preserved_payload)
                content = (run_dir / ".staging" / f"{step_id}.artistic.txt").read_text(encoding="utf-8")
                response = read_json(run_dir / ".staging" / f"{step_id}.artistic.api.json")
            elif response is None:
                response, content = provider_response(
                    transport,
                    api_url(brief["lm_studio_base_url"], "/v1/chat/completions"),
                    payload,
                    float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")),
                    started_at=inflight["started_at"],
                    preserve=lambda value: write_json(response_path, value, mode=0o444, exclusive=True),
                    stream_path=response_path.with_suffix(".sse"),
                )
            else:
                content = normalize_provider_response(response)
            if not preserved_payload.exists():
                authored = parse_structured_content(content)
                if reference_context is not None and expected_record_type != "genesis_constraints":
                    authored = repair_named_references(
                        run_dir, step_id, authored, response_definition, schema, transport,
                        **reference_context,
                    )
            if expected_record_type == "genesis_constraints":
                authored = prepare_genesis_metadata(run_dir, authored, schema)
                preserve_artistic_payload(run_dir, step_id, authored, content, response)
                if payload_repairer:
                    authored = payload_repairer(step_id, authored, content, response)
                final_schema = genesis_constraints_schema(run_dir, authored.get("_claimant_extensions", []))
                validate_json_schema({key: value for key, value in authored.items() if key != "_claimant_extensions"}, final_schema)
            elif expected_record_type == "architecture_core" and payload_repairer:
                validate_architecture_draft(authored, schema, run_dir)
            else:
                validate_json_schema(authored, schema)
            if payload_validator:
                payload_validator(authored)
            if payload_preserver:
                payload_preserver(authored, content, response)
            if payload_repairer and expected_record_type != "genesis_constraints":
                authored = payload_repairer(step_id, authored, content, response)
            record = record_builder(authored) if record_builder else authored
            validate_json_schema(record, protocol["$defs"][RECORD_DEFS[expected_record_type]], protocol)
            validate_declared_id_uniqueness(record)
            duplicate_ids = reused_generated_ids(run_dir, record)
            if duplicate_ids:
                raise SchemaError(f"Record reuses previously committed IDs: {', '.join(sorted(duplicate_ids))}")
            validate_record_evidence(run_dir, record)
            if precommit_validator:
                precommit_validator(record)
            break
        except TruncationError as error:
            failed_response = error.response
            append_failed_attempt(run_dir, step_id=step_id, attempt=attempt, phase=phase, prompt=current_prompt,
                context=context, parameters=parameters, started_at=inflight["started_at"], failure_class=error.failure_class,
                output_hash=sha256_bytes(canonical_json(failed_response)) if failed_response else None,
                usage=failed_response.get("usage", {}) if isinstance(failed_response, dict) else {})
            inflight_path.unlink(missing_ok=True)
            raise
        except PausedError:
            inflight_path.unlink(missing_ok=True)
            raise
        except CathedralsError as error:
            if isinstance(error, IncompleteResponseError):
                response = error.response
            staged_artistic = run_dir / ".staging" / f"{step_id}.artistic.json"
            if expected_record_type == "architecture_core" and staged_artistic.exists() and isinstance(error, SchemaError):
                inflight_path.unlink(missing_ok=True)
                raise PausedError("Architecture repair", error.reason) from error
            if expected_record_type == "genesis_constraints" and staged_artistic.exists() and isinstance(error, SchemaError):
                inflight_path.unlink(missing_ok=True)
                raise PausedError("Genesis metadata validation", error.reason +
                    " Accepted metadata and reference checkpoints were preserved; the complete payload was not requested again.") from error
            staged_semantic = run_dir / ".staging" / f"{step_id}.semantic.json"
            if isinstance(error, SchemaError) and staged_artistic.exists() and staged_semantic.exists():
                write_atomic(run_dir / "state" / f"{step_id}.semantic-feedback.txt", error.reason.encode())
                staged_semantic.unlink(missing_ok=True)
                (run_dir / ".staging" / f"{step_id}.semantic.api.json").unlink(missing_ok=True)
            append_failed_attempt(run_dir, step_id=step_id, attempt=attempt, phase=phase, prompt=current_prompt,
                context=context, parameters=parameters, started_at=inflight["started_at"], failure_class=error.failure_class,
                output_hash=sha256_file(response_path) if response_path.exists() else None,
                usage=response.get("usage", {}) if isinstance(response, dict) else {})
            inflight_path.unlink(missing_ok=True)
            schema_failures = sum(
                entry["planned_step_id"] == step_id and entry["failure_class"] == "malformed_response"
                for entry in step_entries(run_dir, step_id)
            )
            if isinstance(error, SchemaError) and schema_failure_limit is not None and schema_failures >= schema_failure_limit:
                raise PausedError(
                    "Structured record correction",
                    f"{step_id} reached its {schema_failure_limit}-response schema fallback threshold. Last problem: {error.reason}",
                ) from error
            if error.failure_class in RETRYABLE_PROVIDER_FAILURES and correction < 2:
                continue
            if isinstance(error, SchemaError) and correction < 2:
                previous = f"\n\nPREVIOUS UNCOMMITTED PAYLOAD\n{content}" if isinstance(content, str) else ""
                feedback += (
                    "\n\nCORRECTION REQUIRED\n"
                    f"The previous uncommitted payload failed validation:\n{error.reason}"
                    f"{previous}\n"
                    "Preserve every valid creative choice from that payload and the generation brief. "
                    "Change only what is required to pass validation, then return the complete corrected payload."
                )
                continue
            if isinstance(error, SchemaError):
                raise PausedError("Structured record correction", f"{step_id} exhausted 3 schema-correction attempts in this session. Resume to grant 3 more attempts. Last problem: {error.reason}") from error
            if error.failure_class in RETRYABLE_PROVIDER_FAILURES:
                raise PausedError("LM Studio response", f"{step_id} exhausted 3 provider-response attempts in this session. Resume to grant 3 more attempts. Last problem: {error.reason}", error.failure_class) from error
            raise
    else:
        raise PausedError("Structured record correction", f"{step_id} exhausted its correction attempts")
    commit_record(
        run_dir,
        record,
        content,
        response,
        planned_step_id=step_id,
        attempt=attempt,
        step_phase=phase,
        prompt=current_prompt,
        context=context,
        parameters=parameters,
        branch_relation=branch_relation,
    )
    inflight_path.unlink(missing_ok=True)
    return record


def reference_path(path) -> str:
    value = "$"
    for part in path:
        value = f"{value}[{part}]" if isinstance(part, int) else _child_path(value, part)
    return value


def named_reference_issues(run_dir: Path, payload: dict, definition: str, *, plan=None, specs=None):
    """Inventory reference fields explicitly; declaration IDs and fictional labels stay free."""
    genesis = committed_record(run_dir, "genesis") or {}
    foundation = committed_record(run_dir, "genesis_foundation") or {}
    cast = committed_record(run_dir, "genesis_cast") or {}
    architecture = committed_record(run_dir, "architecture") or planning_core(run_dir) or {}
    claimants = {item["claimant_id"]: item for item in genesis.get("claimants", foundation.get("claimant_anchors", []))}
    characters = {item["character_id"]: item for item in cast.get("characters", [])}
    arcs = {item["arc_id"]: item for item in architecture.get("arcs", [])}
    attractors = {item["attractor_id"]: item for item in architecture.get("attractors", [])}
    obligations = {key: event["data"] for key, event in _read_state_map(run_dir, "obligations.json").items()}
    plans = {item["packet_slot_id"]: item for item in architecture.get("packet_plans", [])}
    if architecture.get("scope_commitment"):
        plans = {item["packet_slot_id"]: item for item in planned_packet_specs(architecture)} | plans
    plans |= {item["packet_slot_id"]: item for item in specs or []}
    slots = {item["technical_slot_id"]: item for item in list(claimants.values()) + list(characters.values())}
    literary_slots = {slot: item for item in plans.values() for slot in item["scene_slot_ids"] + item["ending_slot_ids"]}
    slots |= literary_slots
    facts = {key: event["data"] for key, event in _read_state_map(run_dir, "canonical-facts.json").items()}
    if index_path(run_dir).exists():
        with index_connection(run_dir) as db:
            for row in db.execute("SELECT payload FROM events WHERE kind='canonical_fact' ORDER BY sequence"):
                fact = json.loads(row[0])["data"]
                facts.setdefault(fact["fact_id"], fact)
    motifs = _read_state_map(run_dir, "motifs.json")
    state_keys = {key: key for key in load_protocol(run_dir)["$defs"]["stateKey"]["enum"]}
    content = {item[key]: item for record in committed_records(run_dir, "creative_packet")
        for group, key in (("scenes", "scene_id"), ("endings", "ending_id")) for item in record[group]}
    issues = []

    def add(path, kind, candidates, context):
        cursor = payload
        for part in path:
            cursor = cursor[part]
        if cursor not in candidates:
            issues.append({"path": list(path), "kind": kind, "invalid": cursor,
                "candidates": candidates, "context": context})

    def many(path, kind, candidates, context):
        cursor = payload
        for part in path:
            cursor = cursor[part]
        for index in range(len(cursor)):
            add((*path, index), kind, candidates, context)

    def relevance(path, item):
        for field, kind, candidates in (
            ("claimant_ids", "claimant", claimants), ("character_ids", "character", characters),
            ("arc_ids", "arc", arcs), ("motif_ids", "motif", motifs),
            ("technical_slot_ids", "technical slot", slots),
            ("state_keys", "state variable", state_keys),
        ):
            if field in item.get("relevance", {}):
                many((*path, "relevance", field), kind, candidates, item)

    if definition == "genesisFoundationPayload":
        claimants = {f"claimant_{index:02d}": item for index, item in enumerate(payload["claimant_anchors"], 1)}
        many(("work_canon", "central_incident", "subjects"), "claimant", claimants, payload["work_canon"]["central_incident"])
        for index, item in enumerate(payload["work_canon"]["claimant_relationships"]):
            many(("work_canon", "claimant_relationships", index, "claimant_ids"), "claimant", claimants, item)
    elif definition == "genesisCastPayload":
        present = {item["claimant_id"] for item in payload["claimants"]}
        missing = {key: item for key, item in claimants.items() if key not in present}
        for index, item in enumerate(payload["claimants"]):
            if item["claimant_id"] not in claimants:
                add(("claimants", index, "claimant_id"), "claimant", missing, item)
    elif definition == "architectureCorePayload":
        arcs = {item["arc_id"]: item for item in payload["arcs"]}
        catalog = architecture_id_catalog(payload, run_dir)
        for issue in architecture_reference_issues(payload, run_dir):
            if issue["mode"] == "replace":
                issues.append({"path": list(issue["path"]), "kind": issue["label"], "invalid": issue["invalid"],
                    "candidates": {key: catalog.get(key, key) for key in issue["candidates"]}, "context": issue["context"]})
        nodes = {item["node_id"]: item for item in payload["topology"]["nodes"]}
        for field in ("entry_segment_id", "opening_branch_node_id"):
            add(("topology", field), "topology node", nodes, payload["topology"])
        many(("topology", "reconvergence_node_ids"), "topology node", nodes, payload["topology"])
        for index, item in enumerate(payload["topology"]["edges"]):
            for field in ("from_node_id", "to_node_id"):
                add(("topology", "edges", index, field), "topology node", nodes, item)
    elif definition == "architecturePlanBatchPayload":
        expected = {item["packet_slot_id"]: item for item in specs}
        present = {item["packet_slot_id"] for item in payload["packet_plans"]}
        missing = {key: item for key, item in expected.items() if key not in present}
        previous = {item["packet_slot_id"]: item for batch in planning_batches_view(run_dir) for item in batch["packet_plans"]
                    if item["packet_slot_id"] not in expected}
        allocation_order = list(plans)
        first_index = min((allocation_order.index(key) for key in expected if key in allocation_order), default=len(allocation_order))
        previous = {key: item for key, item in previous.items() if key in allocation_order[:first_index]}
        order = list(expected)
        for index, item in enumerate(payload["packet_plans"]):
            path = ("packet_plans", index)
            if item["packet_slot_id"] not in expected:
                add((*path, "packet_slot_id"), "assigned packet slot", missing, item)
            packet_id = item["packet_slot_id"]
            earlier = order[:order.index(packet_id)] if packet_id in expected else []
            allowed = previous | {key: expected[key] for key in earlier}
            many((*path, "depends_on_packet_slot_ids"), "earlier packet", allowed, item)
            ending = expected.get(packet_id, {}).get("packet_kind") == "ending"
            many((*path, "attractor_ids"), "attractor", {key: value for key, value in attractors.items() if not ending or value["kind"] == "ending"}, item)
            relevance(path, item)
    elif definition == "creativePacketPayload":
        for group in ("scenes", "endings"):
            assigned = plan["scene_slot_ids"] if group == "scenes" else plan["ending_slot_ids"]
            for index, item in enumerate(payload[group]):
                path = (group, index)
                add((*path, "technical_slot_id"), "assigned content slot", {key: plan for key in assigned}, item)
                field = "claimant_focus_ids" if group == "scenes" else "claimant_pressure_ids"
                many((*path, field), "claimant", claimants, item)
                if group == "scenes":
                    add((*path, "arc_id"), "arc", arcs, item)
                    if item.get("variant_of_scene_id") is not None:
                        add((*path, "variant_of_scene_id"), "committed scene", {key: value for key, value in content.items() if "scene_id" in value}, item)
                    for dependency_index, dependency in enumerate(item["epistemic_dependencies"]):
                        dep = (*path, "epistemic_dependencies", dependency_index)
                        add((*dep, "subject_id"), "knowledge subject", claimants | characters, dependency)
                        many((*dep, "proposition_ids"), "committed proposition", facts, dependency)
                for artifact_index, artifact in enumerate(item["artifacts"]):
                    many((*path, "artifacts", artifact_index, "claimant_relevance_ids"), "claimant", claimants, artifact)
                destinations = [((*path, "choices", choice_index, "destination"), choice["destination"]) for choice_index, choice in enumerate(item["choices"])]
                if group == "endings" and item["redirect_destination"] is not None:
                    destinations.append(((*path, "redirect_destination"), item["redirect_destination"]))
                for destination_path, destination in destinations:
                    add((*destination_path, "id"), destination["kind"], literary_slots if destination["kind"] == "technical_slot" else content, item)
                for field in ("state_inputs", "entry_conditions", "state_effects"):
                    for state_index, state_item in enumerate(item.get(field, [])):
                        add((*path, field, state_index, "key"), "state variable", state_keys, state_item)
                for choice_index, choice in enumerate(item["choices"]):
                    for field in ("state_conditions", "state_effects"):
                        for state_index, state_item in enumerate(choice[field]):
                            add((*path, "choices", choice_index, field, state_index, "key"), "state variable", state_keys, state_item)
    elif definition == "semanticDeltaPayload":
        local = {f"fact_{index:02d}": item for index, item in enumerate(payload["canonical_facts"], 1)}
        aliases = {alias for index in range(1, len(local) + 1) for alias in fact_position_aliases(index)}
        if plan is None:
            source_slots = slots | genesis_source_catalog(run_dir)
            slots = source_slots
            facts = {}
            motifs = {item["motif_id"]: item for item in payload["motif_events"]}
        else:
            source_slots = {key: plan for key in plan["scene_slot_ids"] + plan["ending_slot_ids"]}
            slots |= source_slots
            motifs |= {item["motif_id"]: item for item in payload["motif_events"]}
        for group in ("canonical_facts", "knowledge_changes", "new_soft_obligations", "obligation_updates", "motif_events"):
            for index, item in enumerate(payload[group]):
                path = (group, index)
                add((*path, "source", "technical_slot_id"), "source slot", source_slots, item)
                relevance(path, item)
                if group == "knowledge_changes":
                    add((*path, "subject_id"), "knowledge subject", claimants | characters, item)
                    if item["proposition_id"] not in aliases:
                        add((*path, "proposition_id"), "proposition", facts | local, item)
                elif group == "new_soft_obligations":
                    many((*path, "requires"), "obligation prerequisite", obligations, item)
                    many((*path, "termination_targets"), "termination target", obligations | attractors | {key: value for key, value in plans.items() if key != plan["packet_slot_id"]}, item)
                elif group == "obligation_updates":
                    add((*path, "obligation_id"), "obligation", obligations, item)
    return issues


def record_reference_answer(run_dir: Path, answer: dict) -> None:
    if any(item["planned_step_id"] == answer["step_id"] and item["attempt"] == answer["attempt"]
           for item in step_entries(run_dir, answer["step_id"])):
        return
    resolved = answer["result"] != "UNRESOLVED"
    state = load_state(run_dir)
    entry = new_ledger_entry(run_dir, planned_step_id=answer["step_id"], attempt=answer["attempt"],
        step_type="analysis", step_phase="validation", parent_state_hash=state["canonical_state_hash"],
        prompt_hash=answer["prompt_hash"], context_hash=answer["context_hash"], provider="LM Studio", model=state["model"],
        parameters=answer["parameters"], seed=answer["parameters"]["seed"], started_at=answer["api_response"].get("_cathedrals_started_at", utc_now()),
        output_hash=sha256_bytes(answer["result"].encode()), generated_ids=[], past_constraint_ids=[], future_obligation_ids=[],
        motif_ids=[], branch_relation=None, commit_status="COMMITTED" if resolved else "FAILED_BEFORE_COMMIT", state_hash_after=state["canonical_state_hash"],
        failure_class="none" if resolved else "mechanical_validation", usage=answer["api_response"].get("usage", {}))
    append_ledger_entry(run_dir, entry)
    refresh_run_counters(run_dir, state)


def successful_structural_repair_count(run_dir: Path) -> int:
    paths = list((run_dir / ".staging").glob("*.repair.json"))
    paths.extend((run_dir / "committed").glob("*/reference-repair.json"))
    return len({item["step_id"] for path in paths for item in read_json(path)["history"] if not item.get("usage_ledgered")})


def resolve_named_reference(run_dir: Path, step_id: str, issue: dict, transport=http_json) -> str:
    if not issue["candidates"]:
        return "UNRESOLVED"
    query_words = set(re.findall(r"[a-z0-9]+", json.dumps([issue["invalid"], issue["context"]]).lower()))
    description_fields = {"name", "title", "role", "incident_role", "description", "purpose", "kind", "status",
        "subject", "predicate", "value", "current_function", "pressure", "terminal_transformation", "packet_kind", "scene_slot_ids", "ending_slot_ids"}
    candidates = [{"id": key, "description": json.dumps(
        {field: detail for field, detail in value.items() if field in description_fields} if isinstance(value, dict) else value,
        ensure_ascii=False, sort_keys=True)[:1200]}
        for key, value in issue["candidates"].items()]
    candidates.sort(key=lambda item: (-len(query_words & set(re.findall(r"[a-z0-9]+", item["description"].lower()))), item["id"]))
    candidates = _within_record_budget(candidates, 8000)
    allowed = {item["id"] for item in candidates}
    descriptor = {key: issue[key] for key in ("path", "kind", "invalid", "context")} | {"candidates": candidates}
    signature = sha256_bytes(canonical_json(descriptor))[:16]
    repair_step = f"{step_id}_reference_{signature}"
    audit_path = run_dir / ".staging" / f"{step_id}.references.json"
    audit = read_json(audit_path) if audit_path.exists() else {"history": []}
    for entry in audit["history"]:
        if entry["step_id"] == repair_step and entry["result"] != "UNRESOLVED":
            record_reference_answer(run_dir, entry)
            return entry["result"]
    prompt = render_prompt(run_dir, "resolve-reference.md", {
        "INVALID_REFERENCE": json.dumps(issue["invalid"]), "FIELD_PATH": reference_path(issue["path"]),
        "REFERENCE_KIND": issue["kind"], "REFERENCE_CONTEXT": json.dumps(issue["context"], ensure_ascii=False),
        "REFERENCE_CANDIDATES": json.dumps(candidates, ensure_ascii=False),
    })
    brief = read_json(run_dir / "generation-brief.json")
    budgets = read_json(run_dir / "run-manifest.json")["budgets"]
    maximum = min(4096, budgets.get("max_analysis_output_tokens", ANALYSIS_OUTPUT_TOKENS))
    capacity = min(budgets["max_prepared_context_tokens"],
        budgets.get("model_context_window_tokens", 64148) - maximum - budgets.get("context_safety_reserve_tokens", 4096))
    if math.ceil(len(prompt.encode()) / 3) > capacity:
        raise CathedralsError("Reference resolution", "Reference context exceeds the frozen context budget", "budget_exhaustion")
    parameters = {"temperature": 0.0, "max_tokens": maximum, "seed": step_seed(brief["generation_seed"], repair_step), "stream": True, "stream_options": {"include_usage": True}}
    feedback = ""
    last_problem = ""
    for _ in range(3):
        attempts = [entry["attempt"] for entry in step_entries(run_dir, repair_step)]
        attempt = max(attempts, default=0) + 1
        response_path = run_dir / "raw" / f"{repair_step}-attempt{attempt}.api.json"
        started = utc_now()
        response = read_json(response_path) if response_path.exists() else None
        try:
            if response is None:
                completed = index_checkpoint(run_dir)["analysis_count"]
                if completed + successful_structural_repair_count(run_dir) >= budgets.get("max_analysis_step_count", float("inf")):
                    raise CathedralsError("Reference resolution", "Reference request exceeds max_analysis_step_count", "budget_exhaustion")
                usage = [(read_json(path).get("usage") or {}) for path in (run_dir / "raw").glob("*.api.json")]
                for key, ceiling, reserve in (
                    ("prompt_tokens", "max_cumulative_input_tokens", math.ceil(len((prompt + feedback).encode()) / 3)),
                    ("completion_tokens", "max_cumulative_output_tokens", maximum),
                ):
                    if sum(item.get(key) or 0 for item in usage) + reserve > budgets.get(ceiling, float("inf")):
                        raise CathedralsError("Reference resolution", f"Reference request exceeds {ceiling}", "budget_exhaustion")
                request = {"model": load_state(run_dir)["model"], "messages": [
                    {"role": "system", "content": "Resolve one reference in uncommitted structured data. Return only an identifier or UNRESOLVED."},
                    {"role": "user", "content": prompt + feedback}], **parameters}
                response, answer = provider_response(transport, api_url(brief["lm_studio_base_url"], "/v1/chat/completions"), request,
                    float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")), started_at=started,
                    preserve=lambda value: write_json(response_path, value, mode=0o444, exclusive=True),
                    stream_path=response_path.with_suffix(".sse"), plain_answers=allowed | {"UNRESOLVED"})
            else:
                answer = normalize_provider_response(response, plain_answers=allowed | {"UNRESOLVED"})
            answer = answer.strip()
            if answer not in allowed | {"UNRESOLVED"}:
                raise SchemaError("Reference resolution must return only one listed identifier or UNRESOLVED")
            audit["history"].append(descriptor | {"step_id": repair_step, "attempt": attempt, "result": answer, "api_response": response,
                "parameters": parameters, "prompt_hash": sha256_bytes((prompt + feedback).encode()), "context_hash": sha256_bytes(canonical_json(descriptor))})
            write_json(audit_path, audit)
            record_reference_answer(run_dir, audit["history"][-1])
            return answer
        except CathedralsError as error:
            last_problem = error.reason
            append_failed_attempt(run_dir, step_id=repair_step, attempt=attempt, phase="validation", prompt=prompt + feedback,
                context=json.dumps(descriptor), parameters=parameters, started_at=started,
                failure_class=error.failure_class, step_type="analysis", output_hash=sha256_file(response_path) if response_path.exists() else None,
                usage=read_json(response_path).get("usage", {}) if response_path.exists() else {})
            if isinstance(error, IncompleteResponseError):
                raise PausedError("Reference resolution", error.reason, error.failure_class) from error
            if not isinstance(error, (SchemaError, TruncationError)) and error.failure_class not in RETRYABLE_PROVIDER_FAILURES:
                raise
            if error.failure_class not in RETRYABLE_PROVIDER_FAILURES:
                feedback = "\nYour last answer was invalid. Return only a listed identifier or UNRESOLVED."
    raise PausedError("Reference resolution", f"{repair_step} exhausted 3 focused attempts for {issue['invalid']} at {reference_path(issue['path'])}; original output was preserved. Last problem: {last_problem}")


def repair_named_references(run_dir: Path, step_id: str, payload: dict, definition: str, schema: dict, transport=http_json, *, plan=None, specs=None, source_context=None) -> dict:
    errors = _collect_schema_errors(payload, schema, schema, "$")
    if any(error[1] not in {"enum", "const", "pattern"} for error in errors):
        validate_json_schema(payload, schema)
    value = copy.deepcopy(payload)
    motif_aliases = {item["motif_event_id"]: item["motif_id"]
                     for record in all_committed_records(run_dir)
                     for item in record.get("constraint_delta", {}).get("motif_events", [])}
    for item in _walk(value):
        if isinstance(item, dict) and isinstance(item.get("relevance"), dict):
            tags = item["relevance"]
            if "motif_ids" in tags:
                tags["motif_ids"] = [motif_aliases.get(identifier, identifier) for identifier in tags["motif_ids"]]
    if definition == "architectureCorePayload":
        value = normalize_architecture_core_payload(value, run_dir)
    elif definition == "semanticDeltaPayload":
        genesis = committed_record(run_dir, "genesis") or committed_record(run_dir, "genesis_foundation") or {}
        cast = committed_record(run_dir, "genesis_cast") or {}
        identities = {item["technical_slot_id"]: item.get("claimant_id", item.get("character_id"))
            for item in genesis.get("claimants", genesis.get("claimant_anchors", [])) + cast.get("characters", [])}
        for item in value["knowledge_changes"]:
            item["subject_id"] = identities.get(item["subject_id"], item["subject_id"])
    issues = named_reference_issues(run_dir, value, definition, plan=plan, specs=specs)
    errors = _collect_schema_errors(value, schema, schema, "$")
    paths = {reference_path(issue["path"]) for issue in issues}
    if any(error[0] not in paths for error in errors):
        validate_json_schema(value, schema)
    if not issues:
        return value
    # Recollect after each replacement: repaired join keys can narrow later candidate sets.
    deferred = set()
    for _ in range(len(issues) + 1):
        issues = [issue for issue in named_reference_issues(run_dir, value, definition, plan=plan, specs=specs)
            if reference_path(issue["path"]) not in deferred]
        if not issues:
            return value
        issue = issues[0]
        if source_context is not None:
            issue = issue | {"context": {"usage": issue["context"], "immutable_source": source_context}}
        replacement = resolve_named_reference(run_dir, step_id, issue, transport)
        if replacement == "UNRESOLVED":
            if definition == "semanticDeltaPayload" and plan is None:
                deferred.add(reference_path(issue["path"]))  # Genesis retains its explicit expansion path.
                continue
            raise SchemaError(f"Cannot resolve {issue['kind']} reference {issue['invalid']} at {reference_path(issue['path'])}",
                              paths=[reference_path(issue["path"])])
        cursor = value
        for part in issue["path"][:-1]:
            cursor = cursor[part]
        cursor[issue["path"][-1]] = replacement
    raise SchemaError("Reference repairs did not converge")


def validate_obligation_origins(obligations: list[dict], allowed_origins: set[str], label: str) -> None:
    for obligation in obligations:
        if not set(obligation["created_by_ids"]).issubset(allowed_origins):
            raise SchemaError(f"{label} has an unknown origin: {obligation['obligation_id']}")


def validate_architecture(architecture: dict, manifest: dict, committed_origin_ids: set[str] | None = None) -> None:
    scope = architecture["scope_commitment"]
    requested = manifest["scope"]["possible_scene_count"]
    if scope["possible_scene_count"] != requested or scope["planned_scene_count"] > requested:
        raise SchemaError("Architecture exceeded or replaced the user's possible scene count")
    if scope["planned_scene_count"] < 8:
        raise SchemaError("Architecture cannot satisfy the Cathedrals opening with fewer than eight scenes")
    if architecture.get("causal_scaffold"):
        scaffold = architecture["causal_scaffold"]
        validate_scaffold(scaffold, manifest["scope"], committed_origin_ids or set(), complete=True)
        order, _roots = scaffold_order(scaffold["nodes"])
        expected_slots, counters = {}, {"scene": 0, "ending": 0}
        scaffold_nodes = {node["node_id"]: node for node in scaffold["nodes"]}
        for identifier in order:
            node = scaffold_nodes[identifier]
            counters[node["kind"]] += 1
            expected_slots[identifier] = f"{node['kind']}_slot_{counters[node['kind']]:04d}"
        if scaffold["slot_ids"] != expected_slots or counters["scene"] != scope["planned_scene_count"] or counters["ending"] != scope["planned_ending_count"]:
            raise SchemaError("Scaffold technical slots and actual scope must match deterministic compilation")
        if len(architecture["attractors"]) > 16 + manifest["scope"]["ending_hard_max"]:
            raise SchemaError("Compiled outcome attractors exceed the macro and ending budgets")
        arcs = {arc["arc_id"] for arc in architecture["arcs"]}
        ending_attractors = {item["attractor_id"] for item in architecture["attractors"] if item["kind"] == "ending"}
        if any(node["arc_id"] not in arcs or node["kind"] == "ending" and node["attractor_id"] not in ending_attractors for node in scaffold["nodes"]):
            raise SchemaError("Scaffold contains an unknown arc or outcome attractor")
    plans = architecture["packet_plans"]
    plan_ids = {item["packet_slot_id"] for item in plans}
    if len(plan_ids) != len(plans):
        raise SchemaError("Architecture packet IDs are not unique")
    scene_slots = []
    ending_slots = []
    obligation_records = {item["obligation_id"]: item for item in architecture["obligation_graph"]}
    obligations = set(obligation_records)
    attractors = {item["attractor_id"]: item for item in architecture["attractors"]}
    if len(attractors) != len(architecture["attractors"]):
        raise SchemaError("Architecture attractor IDs are not unique")
    if not any(item["kind"] == "ending" for item in attractors.values()):
        raise SchemaError("Architecture must establish at least one ending attractor")
    if architecture["constraint_delta"]["new_obligations"]:
        raise SchemaError("Architecture obligations belong in obligation_graph, not a duplicate delta")
    obligation_origins = (
        set(attractors)
        | plan_ids
        | {architecture["commit_id"]}
        | {item["arc_id"] for item in architecture["arcs"]}
        | {item["node_id"] for item in architecture["topology"]["nodes"]}
        | {item["edge_id"] for item in architecture["topology"]["edges"]}
        | (committed_origin_ids or set())
    )
    validate_obligation_origins(list(obligation_records.values()), obligation_origins, "Architecture obligation")
    for obligation in obligation_records.values():
        if obligation["status"] != "active":
            raise SchemaError("Architecture obligations must begin active")
        if not set(obligation["requires"]).issubset(obligations):
            raise SchemaError(f"Obligation references an unknown prerequisite: {obligation['obligation_id']}")
        allowed_targets = obligations | set(attractors) | plan_ids
        if not set(obligation["termination_targets"]).issubset(allowed_targets):
            raise SchemaError(f"Obligation has an unknown termination target: {obligation['obligation_id']}")

    def assert_acyclic(graph: dict[str, list[str]], label: str) -> None:
        visiting = set()
        visited = set()

        def visit(node: str) -> None:
            if node in visiting:
                raise SchemaError(f"{label} contains a circular dependency at {node}")
            if node in visited:
                return
            visiting.add(node)
            for dependency in graph[node]:
                visit(dependency)
            visiting.remove(node)
            visited.add(node)

        for node in graph:
            visit(node)

    assert_acyclic({key: value["requires"] for key, value in obligation_records.items()}, "Obligation graph")
    assert_acyclic({item["packet_slot_id"]: item["depends_on_packet_slot_ids"] for item in plans}, "Packet graph")
    nodes = {item["node_id"] for item in architecture["topology"]["nodes"]}
    if architecture["topology"]["entry_segment_id"] not in nodes or architecture["topology"]["opening_branch_node_id"] not in nodes:
        raise SchemaError("Architecture entry or opening-branch node does not resolve")
    if not set(architecture["topology"]["reconvergence_node_ids"]).issubset(nodes):
        raise SchemaError("Architecture reconvergence node does not resolve")
    for node in architecture["topology"]["nodes"]:
        if not set(node["hard_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Architecture node references unknown canon: {node['node_id']}")
    for edge in architecture["topology"]["edges"]:
        if edge["from_node_id"] not in nodes or edge["to_node_id"] not in nodes or not set(edge["hard_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Architecture edge references unknown canon: {edge['edge_id']}")
    for arc in architecture["arcs"]:
        if not set(arc["hard_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Arc references unknown hard obligation: {arc['arc_id']}")
    for attractor in attractors.values():
        if not set(attractor["prerequisite_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Attractor references unknown obligation: {attractor['attractor_id']}")
        if any(obligation_records[item]["hardness"] != "hard" for item in attractor["prerequisite_obligation_ids"]):
            raise SchemaError("Attractor prerequisites must be hard obligations")
    for plan in plans:
        if plan["packet_slot_id"] in plan["depends_on_packet_slot_ids"] or not set(plan["depends_on_packet_slot_ids"]).issubset(plan_ids):
            raise SchemaError(f"Packet dependency does not resolve: {plan['packet_slot_id']}")
        if not set(plan["attractor_ids"]).issubset(attractors):
            raise SchemaError(f"Packet references an unknown constraint: {plan['packet_slot_id']}")
        if plan["packet_kind"] == "ending" and len(plan["attractor_ids"]) != 1:
            raise SchemaError("Each ending packet must realize exactly one ending attractor")
        scene_slots += plan["scene_slot_ids"]
        ending_slots += plan["ending_slot_ids"]
    if len(scene_slots) != len(set(scene_slots)) or len(scene_slots) != scope["planned_scene_count"]:
        raise SchemaError("Architecture scene slots are duplicated or do not match planned_scene_count")
    if len(ending_slots) != len(set(ending_slots)) or len(ending_slots) != scope["planned_ending_count"]:
        raise SchemaError("Architecture ending slots are duplicated or do not match planned_ending_count")
    if sum(plan["artifact_count"] for plan in plans) != scope["planned_artifact_count"]:
        raise SchemaError("Packet artifact allocations do not match planned_artifact_count")
    if sum(plan["formal_composition_count"] for plan in plans) != scope["planned_formal_composition_count"]:
        raise SchemaError("Packet formal-composition allocations do not match the frozen count")
    if scope["planned_artifact_count"] > manifest["scope"]["artifact_hard_max"]:
        raise SchemaError("Architecture exceeds the derived artifact budget")
    if scope["planned_ending_count"] > manifest["scope"]["ending_hard_max"]:
        raise SchemaError("Architecture exceeds the derived ending budget")
    assigned_attractor_slots = [slot for item in attractors.values() if item["kind"] == "ending" for slot in item["ending_slot_ids"]]
    if set(assigned_attractor_slots) != set(ending_slots) or len(assigned_attractor_slots) != len(set(assigned_attractor_slots)):
        raise SchemaError("Ending attractors must own every ending slot exactly once")
    for plan in (item for item in plans if item["packet_kind"] == "ending"):
        attractor = attractors[plan["attractor_ids"][0]]
        if attractor["kind"] != "ending" or not set(plan["ending_slot_ids"]).issubset(attractor["ending_slot_ids"]):
            raise SchemaError("Ending packet slots must belong to its ending attractor")
    if 4 + math.ceil(len(plans) / PLAN_BATCH_SIZE) + len(plans) > manifest["budgets"]["max_creative_step_count"]:
        raise SchemaError("Architecture exceeds the derived creative-step budget")


def validate_declared_id_uniqueness(record: dict) -> None:
    identifiers = [record.get("commit_id")]
    if record.get("record_type") == "genesis_foundation":
        identifiers += [record["work_canon"]["work_id"]]
        identifiers += [item["event_id"] for item in record["work_canon"]["chronology"]]
        identifiers += [item["claimant_id"] for item in record["claimant_anchors"]]
    elif record.get("record_type") == "genesis_cast":
        identifiers += [item["character_id"] for item in record["characters"]]
    elif record.get("record_type") == "genesis_constraints":
        identifiers += [item["anchor"]["claimant_id"] for item in record["claimant_extensions"]]
    elif record.get("record_type") == "architecture_core":
        identifiers += [item["obligation_id"] for item in record["obligation_graph"]]
        identifiers += [item["arc_id"] for item in record["arcs"]]
        identifiers += [item["node_id"] for item in record["topology"]["nodes"]]
        identifiers += [item["edge_id"] for item in record["topology"]["edges"]]
        identifiers += [item["attractor_id"] for item in record["attractors"]]
    elif record.get("record_type") == "architecture_plan_batch":
        identifiers += [item["packet_slot_id"] for item in record["packet_plans"]]
    elif record.get("record_type") == "creative_packet":
        identifiers += [item["scene_id"] for item in record["scenes"]]
        identifiers += [item["artifact_id"] for item in record["artifacts"]]
        identifiers += [item["ending_id"] for item in record["endings"]]
        identifiers += [item["composition_id"] for item in record["formal_compositions"]]
        identifiers += [item["edge_id"] for item in record["decision_edges"]]
    delta = record.get("constraint_delta", {})
    identifiers += [item["fact_id"] for item in delta.get("canonical_facts", [])]
    identifiers += [item["knowledge_id"] for item in delta.get("knowledge_changes", [])]
    identifiers += [item["obligation_id"] for item in delta.get("new_obligations", [])]
    identifiers += [item["update_id"] for item in delta.get("obligation_updates", [])]
    identifiers += [item["motif_event_id"] for item in delta.get("motif_events", [])]
    identifiers += [item["foreclosure_id"] for item in delta.get("potential_foreclosures", [])]
    identifiers = [identifier for identifier in identifiers if identifier]
    duplicates = sorted({identifier for identifier in identifiers if identifiers.count(identifier) > 1})
    if duplicates:
        raise SchemaError(f"Record declares duplicate generated IDs: {', '.join(duplicates)}")


def validate_packet_against_plan(packet: dict, plan: dict) -> None:
    if packet["packet_slot_id"] != plan["packet_slot_id"] or packet["packet_kind"] != plan["packet_kind"]:
        raise SchemaError("Creative packet does not match its frozen packet slot")
    expected = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
    actual = {
        item["technical_slot_id"]
        for item in (packet["scenes"] if plan["packet_kind"] == "literary" else packet["endings"])
    }
    if expected != actual:
        raise SchemaError(f"Packet {plan['packet_slot_id']} did not fill its assigned technical slots exactly once")
    if len(packet["artifacts"]) != plan["artifact_count"] or len(packet["formal_compositions"]) != plan["formal_composition_count"]:
        raise SchemaError(f"Packet {plan['packet_slot_id']} did not satisfy its frozen artifact/composition allocation")
    if not set(plan["advance_obligation_ids"]).issubset(packet["obligations_advanced"]):
        raise SchemaError(f"Packet {plan['packet_slot_id']} omitted an assigned obligation")


def technical_slot_map(scenes: list[dict], endings: list[dict]) -> dict[str, str]:
    slots = {}
    for item in scenes + endings:
        slot = item["technical_slot_id"]
        if slot in slots:
            raise SchemaError(f"Technical slot is owned more than once: {slot}")
        slots[slot] = item.get("scene_id") or item["ending_id"]
    return slots


def resolve_destination(destination: dict, slots: dict[str, str], content_ids: set[str]) -> str:
    identifier = destination["id"]
    if destination["kind"] == "technical_slot":
        if identifier not in slots:
            raise SchemaError(f"Technical destination does not resolve exactly once: {identifier}")
        return slots[identifier]
    if identifier not in content_ids:
        raise SchemaError(f"Content destination does not resolve: {identifier}")
    return identifier


def resolve_cross_packet_links(scenes: list[dict], endings: list[dict], edges: list[dict]) -> tuple[list[dict], list[dict]]:
    slots = technical_slot_map(scenes, endings)
    content_ids = set(slots.values())
    resolved_edges = [
        edge | {"resolved_content_id": resolve_destination(edge["destination"], slots, content_ids)}
        for edge in edges
    ]
    resolved_endings = [
        ending | {
            "resolved_redirect_content_id": resolve_destination(ending["redirect_destination"], slots, content_ids)
            if ending["redirect_destination"] else None
        }
        for ending in endings
    ]
    return resolved_edges, resolved_endings


def navigation_contract_route(architecture):
    plans = architecture["packet_plans"]
    scenes = {slot for plan in plans for slot in plan["scene_slot_ids"]}
    endings = {slot for plan in plans for slot in plan["ending_slot_ids"]}
    all_slots, graph = scenes | endings, {}
    for plan in plans:
        routes = plan.get("required_navigation", {})
        if not isinstance(routes, dict) or set(routes) != set(plan["scene_slot_ids"]):
            raise SchemaError(f"Navigation contract for {plan['packet_slot_id']} must cover exactly its scene slots")
        for slot, destinations in routes.items():
            if not isinstance(destinations, list) or not destinations or len(destinations) > 16 or any(not isinstance(target, str) for target in destinations) or len(set(destinations)) != len(destinations) or not set(destinations).issubset(all_slots):
                raise SchemaError(f"Navigation contract has missing, duplicate, or unknown destinations at {slot}")
            graph[slot] = destinations
    if not scenes or not endings:
        raise SchemaError("Navigation contract needs an opening scene and an ending")
    if architecture.get("causal_scaffold"):
        scaffold = architecture["causal_scaffold"]
        scaffold_order(scaffold["nodes"])
        expected = {scaffold["slot_ids"][node["node_id"]]: [scaffold["slot_ids"][edge["to_node_id"]] for edge in node["successors"]]
            for node in scaffold["nodes"] if node["kind"] == "scene"}
        if graph != expected:
            raise SchemaError("Navigation targets differ from the causal scaffold")
    opening = min(scenes)
    queue, parents = [opening], {opening: None}
    for slot in queue:
        for destination in sorted(graph.get(slot, [])):
            if destination not in parents:
                parents[destination] = slot
                queue.append(destination)
    if all_slots - parents.keys():
        raise SchemaError("Navigation contract leaves unreachable slots: " + ", ".join(sorted(all_slots - parents.keys())[:12]))
    reverse = {slot: [] for slot in all_slots}
    for slot, destinations in graph.items():
        for destination in destinations:
            reverse[destination].append(slot)
    escape, seen = sorted(endings), set(endings)
    for slot in escape:
        for previous in reverse[slot]:
            if previous not in seen:
                seen.add(previous)
                escape.append(previous)
    if scenes - seen:
        raise SchemaError("Navigation contract contains scenes with no route to an ending: " + ", ".join(sorted(scenes - seen)[:12]))
    terminal = next(slot for slot in queue if slot in endings)
    route = []
    while terminal is not None:
        route.append(terminal)
        terminal = parents[terminal]
    return list(reversed(route))


def reader_equal(left, right):
    if isinstance(left, (dict, list)) or isinstance(right, (dict, list)):
        return False
    return left == right and (type(left) is type(right) or type(left) in (int, float) and type(right) in (int, float))


def reader_conditions_hold(conditions, values):
    missing = object()
    def number(value):
        if value is missing:
            return float("nan")
        if value is None or isinstance(value, str) and not value.strip():
            return 0
        return float(value)
    for condition in conditions:
        current, expected, operator = values.get(condition["key"], missing), condition["value"], condition["operator"]
        equal = reader_equal(current, expected)
        contains = isinstance(current, list) and any(reader_equal(item, expected) for item in current)
        try:
            valid = {"equals": lambda: equal, "not_equals": lambda: not equal,
                "contains": lambda: contains, "not_contains": lambda: not contains,
                "gte": lambda: current >= expected if isinstance(current, str) and isinstance(expected, str) else number(current) >= number(expected),
                "lte": lambda: current <= expected if isinstance(current, str) and isinstance(expected, str) else number(current) <= number(expected)}[operator]()
        except (ValueError, TypeError, KeyError):
            valid = False
        if not valid:
            return False
    return True


def apply_reader_effects(effects, values):
    for effect in effects:
        key, value = effect["key"], effect["value"]
        current = values.get(key)
        if effect["operation"] == "set":
            values[key] = value
        elif effect["operation"] == "increment":
            if not isinstance(current or 0, (int, float)) or not isinstance(value, (int, float)):
                raise SchemaError(f"Completion route has a nonnumeric increment for {key}")
            values[key] = (current or 0) + value
        else:
            if current is not None and not isinstance(current, list):
                raise SchemaError(f"Completion route has a collection effect on non-array state {key}")
            items = list(current or [])
            if effect["operation"] == "add" and not any(reader_equal(item, value) for item in items):
                items.append(value)
            elif effect["operation"] == "remove":
                items = [item for item in items if not reader_equal(item, value)]
            values[key] = items


def validate_navigation_payload(run_dir, architecture, plan, payload):
    content, id_to_slot = {}, {}
    for record in committed_records(run_dir, "creative_packet"):
        for item in record["scenes"] + record["endings"]:
            identifier = item.get("scene_id", item.get("ending_id"))
            id_to_slot[identifier] = item["technical_slot_id"]
            content[item["technical_slot_id"]] = item | {"choices": [edge for edge in record["decision_edges"] if edge["from_content_id"] == identifier]}
    for item in payload["scenes"] + payload["endings"]:
        content[item["technical_slot_id"]] = item
        identifier = item.get("scene_id", item.get("ending_id"))
        if identifier:
            id_to_slot[identifier] = item["technical_slot_id"]
    def destination(choice):
        target = choice["destination"]
        return target["id"] if target["kind"] == "technical_slot" else id_to_slot.get(target["id"])
    for scene in payload["scenes"]:
        required = set(plan.get("required_navigation", {}).get(scene["technical_slot_id"], []))
        actual = {destination(choice) for choice in scene["choices"] if choice["availability"] == "playable"}
        if architecture.get("causal_scaffold") and actual != required:
            raise SchemaError(f"Scene {scene['technical_slot_id']} must preserve exactly its scaffold successors")
        if not required or not required.issubset(actual):
            raise SchemaError(f"Scene {scene['technical_slot_id']} must author playable exits to: {', '.join(sorted(required - actual)) or 'its frozen navigation targets'}")
    if architecture.get("causal_scaffold"):
        validate_scaffold_reader_states(architecture, content, destination)
        return
    route, values = navigation_contract_route(architecture), {}
    for index, slot in enumerate(route):
        if slot not in content:
            return
        item = content[slot]
        if not reader_conditions_hold(item.get("state_inputs", item.get("entry_conditions", [])), values):
            raise SchemaError(f"Completion route cannot enter {slot} under its authored state conditions")
        apply_reader_effects(item["state_effects"], values)
        if index + 1 == len(route):
            return
        choices = [choice for choice in item["choices"] if choice["availability"] == "playable" and destination(choice) == route[index + 1]
            and reader_conditions_hold(choice["state_conditions"], values)]
        if not choices:
            raise SchemaError(f"Completion route is blocked at {slot} -> {route[index + 1]}; correct the uncommitted navigation or state effects")
        apply_reader_effects(choices[0]["state_effects"], values)


