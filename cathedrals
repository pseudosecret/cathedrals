def compact_semantic_context(context: str, run_dir: Path | None = None) -> str:
    if run_dir is not None and "===== FROZEN ENGINE LAW =====\n" in context:
        law, _provenance = instruction_profile(run_dir, "semantic")
        context = re.sub(r"(?ms)^===== FROZEN ENGINE LAW =====\n.*?(?=^===== (?!engine/)[^\n]+ =====\n|\Z)",
            lambda _match: "===== FROZEN ENGINE LAW =====\n" + law + "\n\n", context, count=1)
    chunks = re.split(r"(?m)(^===== [^\n]+ =====\n)", context)
    decoder = json.JSONDecoder()
    for index, chunk in enumerate(chunks):
        remaining, values = chunk.strip(), []
        if not remaining.startswith(("{", "[")):
            continue
        try:
            while remaining:
                value, end = decoder.raw_decode(remaining)
                values.append(value)
                remaining = remaining[end:].lstrip()
        except json.JSONDecodeError:
            continue
        chunks[index] = "\n".join(canonical_json(value).decode() for value in values)
    return "".join(chunks)


def semantic_prompt(artistic: dict, context: str, instruction: str, accepted=None, *, run_dir: Path | None = None) -> str:
    prompt = ("IMMUTABLE ARTISTIC PAYLOAD\n" + canonical_json(artistic).decode() +
              "\nRELEVANT CANON AND CONSTRAINTS\n" + compact_semantic_context(context, run_dir) + "\n")
    if accepted is not None:
        # Preserve fact positions while showing repeated accepted records only once.
        seen, facts = {}, []
        for index, fact in enumerate(accepted.get("canonical_facts", []), 1):
            identity = canonical_json(fact)
            if identity in seen:
                facts.append({"$fact_ref": seen[identity]})
            else:
                seen[identity] = f"fact_{index:02d}"
                facts.append(fact)
        accepted = accepted | {"canonical_facts": facts}
        prompt += "ACCEPTED SEMANTIC METADATA\n" + canonical_json(accepted).decode()
    return prompt + "\nINSTRUCTION\n" + SEMANTIC_INSTRUCTION + " " + instruction + (
        " Retrieved PLANNED INTENTION describes future work, not events established by this payload. "
        "CONSTRAINT HISTORY may be superseded or retracted. Derive new assertions only from the immutable artistic payload. "
        "Each $context_ref expands losslessly through SHARED SOURCE RECORDS, SHARED SOURCE METADATA, or SHARED CONTEXT VALUES. "
        "In accepted metadata, $fact_ref repeats an earlier exact fact. Every array position keeps its original fact_NN alias; "
        "a repeated alias adds no new information. Never emit $fact_ref in your response. "
        "Genesis foundation, cast, and constraints are complete original records; apply their anchors, profiles, and extensions together.")


def semantic_attempt(run_dir: Path, step_id: str) -> int:
    attempts = [entry["attempt"] for entry in step_entries(run_dir, f"{step_id}_semantic")]
    attempts.extend(int(match.group(1)) for path in (run_dir / "raw").glob(f"{step_id}-semantic-attempt*.api.json")
                    if (match := re.fullmatch(rf"{re.escape(step_id)}-semantic-attempt([0-9]+)\.api\.json", path.name)))
    return max(attempts, default=0) + 1


def semantic_output_limit(run_dir: Path, prompt: str, schema: dict, maximum=8192) -> int:
    manifest = run_dir / "run-manifest.json"
    if not manifest.exists():
        return maximum
    budgets = read_json(manifest)["budgets"]
    maximum = min(maximum, budgets.get("max_analysis_output_tokens", maximum))
    maximum = planning_output_limit(run_dir, prompt, schema, maximum, "Semantic normalization", purpose="semantic normalization")
    if load_state(run_dir).get("analysis_step_count", 0) + successful_structural_repair_count(run_dir) >= budgets.get("max_analysis_step_count", float("inf")):
        raise CathedralsError("Semantic normalization", "Normalization exceeds max_analysis_step_count", "budget_exhaustion")
    usage = [read_json(path).get("usage") or {} for path in (run_dir / "raw").glob("*.api.json")]
    for key, ceiling, reserve in (("prompt_tokens", "max_cumulative_input_tokens", math.ceil(len(prompt.encode()) / 3)),
                                   ("completion_tokens", "max_cumulative_output_tokens", maximum)):
        if sum(item.get(key) or 0 for item in usage) + reserve > budgets.get(ceiling, float("inf")):
            raise CathedralsError("Semantic normalization", f"Normalization exceeds {ceiling}", "budget_exhaustion")
    return maximum


def semantic_error_categories(error: SchemaError) -> list[str]:
    categories = set()
    for path in error.paths:
        match = re.match(r"^\$\.(?:constraint_delta\.)?([a-z_]+)(?:\[|\.|$)", path)
        key = match.group(1) if match else None
        key = "new_soft_obligations" if key == "new_obligations" else key
        if key not in SEMANTIC_CATEGORIES:
            return []
        categories.add(key)
    return [key for key in SEMANTIC_CATEGORIES if key in categories]


def seed_semantic_recovery(run_dir: Path, step_id: str, artistic: dict, response: dict, *, payload=None, schema=None) -> dict:
    incomplete = []
    if payload is None:
        message = (response.get("choices") or [{}])[0].get("message") or {}
        content = message.get("content") or ""
        content = content if isinstance(content, str) else ""
        try:
            payload = parse_structured_content(content)
        except SchemaError:
            payload, incomplete = parsed_planning_fragment(content)
    payload = payload if isinstance(payload, dict) else {}
    base = schema or definition_schema("semanticDeltaPayload", load_protocol(run_dir))
    state = {"version": 1, "artistic_hash": sha256_bytes(canonical_json(artistic)),
             "payload": {key: [] for key in SEMANTIC_CATEGORIES}, "complete": {}, "pending": {},
             "page_size": {key: 8 for key in SEMANTIC_CATEGORIES}, "feedback": {}, "revision": {}, "calls": []}
    for key in SEMANTIC_CATEGORIES:
        items = payload.get(key)
        accepted = state["payload"][key]
        category_schema = base["properties"][key]
        if isinstance(items, list):
            for item in items:
                if len(accepted) >= category_schema.get("maxItems", float("inf")) or _collect_schema_errors(item, category_schema.get("items", {}), base, "$"):
                    break
                accepted.append(item)
            state["pending"][key] = items[len(accepted):]
        state["complete"][key] = (isinstance(items, list) and len(accepted) == len(items)
            and not _collect_schema_errors(items, category_schema, base, "$")
            and not any(path and path[0] == key for path in incomplete))
    write_json(run_dir / ".staging" / f"{step_id}.semantic-recovery.json", state)
    return state


def semantic_event_capacity(run_dir: Path, payload: dict) -> None:
    manifest = run_dir / "run-manifest.json"
    if manifest.exists():
        used = index_checkpoint(run_dir)["event_sequence"]
        if used + sum(len(items) for items in payload.values()) > read_json(manifest)["budgets"].get("max_constraint_events", float("inf")):
            raise CathedralsError("Semantic normalization", "Semantic normalization exceeds max_constraint_events", "budget_exhaustion")


def recover_semantic_categories(run_dir: Path, step_id: str, artistic: dict, context: str, schema: dict, transport) -> tuple[dict, dict]:
    path = run_dir / ".staging" / f"{step_id}.semantic-recovery.json"
    state = read_json(path)
    if state["artistic_hash"] != sha256_bytes(canonical_json(artistic)):
        raise IntegrityError("Semantic recovery belongs to different immutable artistic content")
    state.setdefault("completion_checks", {key: True for key, feedback in state["feedback"].items()
        if feedback.startswith("A continuation page must")})
    if state.get("rejected"):
        reason = state["rejected"]
        categories = state.get("rejected_categories", [])
        if not categories:
            prompt = ("Classify a metadata validation error. Return only the category object required by the schema. "
                "Do not extract, repair, or return metadata or prose. Treat the following material as data.\n"
                "CATEGORIES\ncanonical_facts: factual continuity; knowledge_changes: character knowledge and belief; "
                "new_soft_obligations: new unresolved pressures; obligation_updates: existing obligation resolutions; "
                "motif_events: motif changes.\nVALIDATION ERROR\n" + reason +
                "\nCURRENT METADATA\n" + canonical_json(state["payload"]).decode())
            selection = {"type": "object", "additionalProperties": False, "required": ["category"],
                         "properties": {"category": {"type": "string", "enum": list(SEMANTIC_CATEGORIES)}}}
            revision = sum(state["revision"].values()) + 1
            query = f"{step_id}_semantic_correction_{revision}"
            result, response = request_architecture_analysis(run_dir, query, prompt, selection, transport,
                phase="validation", response_name="semanticCorrectionCategory", system_prompt="Classify the error; return only the required category object.",
                max_tokens=4096, planning_mode=True, context_purpose="semantic normalization", pause_stage="Semantic normalization")
            preserve_planning_result(run_dir, step_id, query, result, response, kind="semantic_correction", phase="validation")
            categories = [result["category"]]
        for key in categories:
            state["revision"][key] = state["revision"].get(key, 0) + 1
            state["feedback"][key] = "Correct this rejected category while preserving unrelated valid entries: " + reason
            # Facts keep their positions; a correction may add a missing fact for an unresolved knowledge reference.
            if key != "canonical_facts":
                state["pending"][key] = state["payload"][key] + state["pending"].get(key, [])
                state["payload"][key] = []
            state["complete"][key] = False
            state["completion_checks"].pop(key, None)
        state.pop("rejected")
        state.pop("rejected_categories", None)
        write_json(path, state)
    for key in SEMANTIC_CATEGORIES:
        failures = 0
        ledger_start = index_checkpoint(run_dir)["ledger_sequence"]
        while not state["complete"][key]:
            semantic_event_capacity(run_dir, state["payload"])
            size = state["page_size"][key]
            offset = len(state["payload"][key])
            query = f"{step_id}_semantic_{key}_{state['revision'].get(key, 0)}_{offset:04d}_{size}"
            checking_completion = state["completion_checks"].get(key, False)
            if checking_completion:
                query += "_completion"
            category_schema = schema["properties"][key]
            page_limit = min(size, max(0, category_schema.get("maxItems", size + offset) - offset))
            page_schema = compact_planning_schema({"type": "object", "additionalProperties": False,
                "required": ["items", "complete"], "properties": {
                    "items": category_schema | {"maxItems": page_limit}, "complete": {"type": "boolean"}}, "$defs": schema.get("$defs", {})})
            instruction = (f"Continue ONLY {key} after its {offset} accepted records. Return at most {page_limit} NEW records in items. "
                "Set complete=true only when this category has no remaining important changes; otherwise complete=false. "
                "Never repeat accepted records or renumber accepted facts. An empty items array is allowed only with complete=true. "
                "Complete partial candidates in their original order when supported. Partial candidates: " +
                canonical_json(state["pending"].get(key, [])).decode() + " " + state["feedback"].get(key, ""))
            if checking_completion:
                instruction = (f"Audit completion of ONLY {key} against the immutable authored content and accepted metadata. "
                    "The previous page made no progress. Stop repeating the extraction sequence. "
                    'If all important supported changes are already recorded, return exactly {"items":[],"complete":true}. '
                    f"Otherwise return up to {page_limit} genuinely missing records, with complete=true only if none remain afterward. "
                    "Existing duplicates do not imply missing information. Preserve all accepted fact positions. "
                    "Pending candidates (retain only supported changes not already accepted): " +
                    canonical_json(state["pending"].get(key, [])).decode() + " " + state["feedback"].get(key, ""))
            prompt = semantic_prompt(artistic, context, instruction, state["payload"], run_dir=run_dir)
            distinct = len({canonical_json(item) for item in state["payload"][key]})
            print(f"Semantic normalization: {key}, {offset} accepted positions ({distinct} distinct records), "
                f"{'completion check' if checking_completion else f'up to {page_limit} per page'}", file=sys.stderr)
            response, error = None, None
            try:
                result, response = request_architecture_analysis(run_dir, query, prompt, page_schema, transport,
                    phase="validation", system_prompt=("Audit accepted metadata against immutable authored content. Return missing changes or explicit completion as JSON only."
                        if checking_completion else "Extract concise changes from immutable authored content. Return JSON only."),
                    response_name="semanticCompletionCheck" if checking_completion else "semanticCategoryPage", pause_stage="Semantic normalization", initial_draft=True,
                    planning_mode=True, context_purpose="semantic normalization", max_tokens=15000 if size == 1 and state.get("expanded") == key else 8192)
                incomplete = []
            except PausedError as paused:
                error = paused.__cause__
                if not isinstance(error, (SchemaError, TruncationError, IncompleteResponseError)):
                    raise
                paths = list((run_dir / "raw").glob(f"{query}-attempt*.api.json"))
                response = read_json(max(paths, key=lambda p: int(p.name.split("-attempt")[-1].split(".")[0])))
                content = ((response.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
                content = content if isinstance(content, str) else ""
                try:
                    result, incomplete = parse_structured_content(content), []
                except SchemaError:
                    result, incomplete = parsed_planning_fragment(content)
            items = result.get("items", []) if isinstance(result, dict) else []
            complete = error is None and isinstance(result, dict) and "items" in result and isinstance(items, list) and result.get("complete") is True and not any(p and p[0] == "items" for p in incomplete)
            before = len(state["payload"][key])
            consumed = 0
            if isinstance(items, list):
                for item in items:
                    if len(state["payload"][key]) >= category_schema.get("maxItems", float("inf")) or _collect_schema_errors(item, category_schema.get("items", {}), schema, "$"):
                        complete = False
                        break
                    consumed += 1
                    if item not in state["payload"][key]:
                        state["payload"][key].append(item)
                state["pending"][key] = items[consumed:]
            else:
                complete = False
            added = len(state["payload"][key]) - before
            if not complete and not added:
                if error is None:
                    state["completion_checks"][key] = True
                error = error or SchemaError(f"A continuation page must add a new supported record or explicitly finish with complete=true. "
                    f"Received {len(items) if isinstance(items, list) else 0} items; accepted {offset} positions "
                    f"({len({canonical_json(item) for item in state['payload'][key]})} distinct records); added 0.")
                complete = False
            else:
                state["completion_checks"].pop(key, None)
            if state["pending"].get(key):
                complete = False
            state["complete"][key] = complete
            if response is not None:
                meta = response["_cathedrals_request"]
                if not any(call["step_id"] == query and call["attempt"] == meta["attempt"] for call in state["calls"]):
                    state["calls"].append({"step_id": query, "attempt": meta["attempt"], "category": key})
                if error is None:
                    preserve_planning_result(run_dir, step_id, query, result, response, kind="semantic_page", phase="validation")
                elif not any(entry["planned_step_id"] == query and entry["attempt"] == meta["attempt"] for entry in step_entries(run_dir, query)):
                    append_failed_attempt(run_dir, step_id=query, attempt=meta["attempt"], phase="validation", prompt=prompt,
                        context=context, parameters=meta["parameters"], started_at=response.get("_cathedrals_started_at", utc_now()),
                        failure_class=error.failure_class, step_type="analysis", usage=response.get("usage") or {})
            write_json(path, state)
            semantic_event_capacity(run_dir, state["payload"])
            if isinstance(error, IncompleteResponseError):
                raise PausedError("Semantic normalization", f"{key}: interrupted after retaining {added} complete records. {error.reason}", error.failure_class) from error
            if isinstance(error, TruncationError) and not complete:
                if size > 1:
                    state["page_size"][key] = max(1, size // 2)
                    failures = 0
                elif state.get("expanded") != key:
                    state["expanded"] = key
                    failures = 0
                else:
                    failures += 1
            elif error is not None and not added:
                failures += 1
            else:
                failures = 0
            if error is not None:
                state["feedback"][key] = error.reason
            write_json(path, state)
            if failures >= 3:
                attempts = sum(entry["planned_step_id"].startswith(f"{step_id}_semantic_{key}_")
                               for entry in indexed_ledger(run_dir, after=ledger_start))
                raise PausedError("Semantic normalization", f"{key} exhausted {failures} page correction attempts in this invocation. "
                    f"This category made {attempts} provider attempts. Accepted metadata and prose were retained. Last problem: {error.reason}") from error
    semantic_event_capacity(run_dir, state["payload"])
    assembled = {"choices": [{"finish_reason": "stop", "message": {"content": canonical_json(state['payload']).decode()}}],
                 "usage": {}, "_cathedrals_semantic_assembled": True}
    return state["payload"], assembled


def audit_ending_resolutions(run_dir, step_id, artistic, normalized, transport):
    if not isinstance(normalized, dict) or not isinstance(normalized.get("obligation_updates"), list):
        return normalized  # The normal schema/category recovery must diagnose malformed metadata.
    obligations = _read_state_map(run_dir, "obligations.json")
    strict = ending_prerequisite_ids(committed_record(run_dir, "architecture") or {}, obligations)
    if not strict:
        return normalized
    sources = {item["technical_slot_id"]: [item["prose_mdx"]] + [artifact["body_mdx"] for artifact in item["artifacts"]]
        for item in artistic["scenes"] + artistic["endings"]}
    choices = {item["technical_slot_id"]: item["choices"] for item in artistic["scenes"] + artistic["endings"]}
    for slot, items in choices.items():
        sources[slot].extend(item["label"] for item in items)
    accepted = []
    for update in normalized["obligation_updates"]:
        if not isinstance(update, dict) or not isinstance(update.get("obligation_id"), str) or not isinstance(update.get("status"), str) or update["obligation_id"] not in strict:
            accepted.append(update)
            continue
        schema = {"type": "object", "additionalProperties": False, "required": ["outcome", "reason", "evidence_quotes"],
            "properties": {"outcome": {"enum": ["satisfied", "ongoing", "unsupported"]}, "reason": {"type": "string", "minLength": 1},
                "evidence_quotes": {"type": "array", "items": {"type": "object", "additionalProperties": False,
                    "required": ["technical_slot_id", "quote"], "properties": {"technical_slot_id": {"enum": sorted(sources)},
                        "quote": {"type": "string", "minLength": 1}}}}}}
        def validate(result):
            if result["outcome"] == "satisfied" and not result["evidence_quotes"]:
                raise SchemaError("A hard prerequisite resolution needs exact authored evidence")
            for evidence in result["evidence_quotes"]:
                if not any(evidence["quote"] in text for text in sources[evidence["technical_slot_id"]]):
                    raise SchemaError("Resolution audit must quote the immutable authored source exactly")
        prompt = ("Audit ONLY whether this ending prerequisite is actually satisfied by immutable authored content. "
            "A newly posed question, an ongoing demand for judgment, partial progress or future resolution is ongoing, not satisfaction. "
            "Choice labels and effects are authored affordances, not evidence that a reader has already selected them. "
            "They may satisfy an obligation to provide a decision, but cannot establish an unperformed fictional event. "
            "Thematic ambiguity may be a completed payoff only if the obligation's required transformation actually occurs here. "
            "Do not change prose or invent a resolution. Return satisfied, ongoing or unsupported, with reason and exact quotes.\nOBLIGATION\n" +
            canonical_json(obligations[update["obligation_id"]]["data"]).decode() + "\nPROPOSED UPDATE\n" + canonical_json(update).decode() +
            "\nIMMUTABLE AUTHORED CONTENT\n" + canonical_json(sources).decode() + "\nAUTHORED CHOICE AFFORDANCES\n" + canonical_json(choices).decode())
        query = f"{step_id}_resolution_{sha256_bytes(prompt.encode())[:12]}"
        result, response = request_architecture_analysis(run_dir, query, prompt, schema, transport, validator=validate,
            phase="validation", response_name="endingResolutionAudit", pause_stage="Ending resolution audit", max_tokens=4096,
            system_prompt="Audit source support for a proposed metadata update. Return JSON only.", planning_mode=True, context_purpose="semantic normalization")
        preserve_planning_result(run_dir, step_id, query, result, response, kind="ending_resolution", phase="validation")
        if result["outcome"] == "satisfied":
            if update["status"] != "satisfied":
                raise SchemaError("A proposed ambiguous prerequisite update cannot be coerced into satisfaction", paths=["$.obligation_updates"])
            accepted.append(update)
    return normalized | {"obligation_updates": accepted}


def request_semantic_normalization(run_dir: Path, step_id: str, artistic_payload: dict, context: str, transport=http_json, *, plan=None) -> dict:
    audit_scaffold_guarantees(run_dir, step_id, artistic_payload, plan, transport)
    target = run_dir / ".staging" / f"{step_id}.semantic.json"
    pending_path = run_dir / ".staging" / f"{step_id}.semantic-pending.json"
    semantic_api_path = run_dir / ".staging" / f"{step_id}.semantic.api.json"
    recovery_path = run_dir / ".staging" / f"{step_id}.semantic-recovery.json"
    cached = read_json(target) if target.exists() and semantic_api_path.exists() else None
    cached_response = read_json(semantic_api_path) if cached is not None else None
    source_slots = [item["technical_slot_id"] for item in artistic_payload["scenes"] + artistic_payload["endings"]]
    schema = compact_planning_schema(semantic_delta_schema(run_dir, source_slots, plan=plan))
    reference_plan = plan or {"scene_slot_ids": [item["technical_slot_id"] for item in artistic_payload["scenes"]],
        "ending_slot_ids": [item["technical_slot_id"] for item in artistic_payload["endings"]], "packet_slot_id": step_id}

    def validate_normalized(normalized):
        content_ids = {item["technical_slot_id"]: (kind, f"{kind}_{item['technical_slot_id'].split('_slot_')[-1]}")
            for group, kind in (("scenes", "scene"), ("endings", "ending")) for item in artistic_payload[group]}
        delta = build_semantic_delta(run_dir, step_id, normalized, content_ids)
        retracted_unknown = {(item["subject_id"], item["proposition_id"]) for item in delta["knowledge_changes"]
                             if item["relation"] == "explicitly_does_not_know" and item["action"] == "retract"}
        for request in epistemic_repair_state(run_dir, step_id, artistic_payload).get("learning", []):
            required = {(request["dependency"]["subject_id"], key) for key in request["missing_proposition_ids"]}
            if not required.issubset(retracted_unknown):
                raise SchemaError("A supported acquisition must retract the prior explicitly_does_not_know relation for the exact subject/proposition: " +
                                  canonical_json(request).decode(), paths=["$.knowledge_changes"])
        if plan is not None:
            record = build_creative_packet(run_dir, step_id, plan, artistic_payload, normalized)
            protocol = load_protocol(run_dir)
            validate_json_schema(record, protocol["$defs"]["creativePacket"], protocol)
            validate_declared_id_uniqueness(record)
            if reused_generated_ids(run_dir, record):
                raise SchemaError("Semantic normalization reuses previously committed IDs")
            validate_packet_for_run(record, run_dir, plan)
    brief = read_json(run_dir / "generation-brief.json")
    seed = step_seed(brief["generation_seed"], f"{step_id}_semantic")
    parameters = {"temperature": 0.0, "max_tokens": 8192, "seed": seed, "stream": True, "stream_options": {"include_usage": True}}
    feedback_path = run_dir / "state" / f"{step_id}.semantic-feedback.txt"
    feedback = f" Previous normalization failed canonical validation: {feedback_path.read_text(encoding='utf-8')}" if feedback_path.exists() else ""
    if feedback and recovery_path.exists():
        state = read_json(recovery_path)
        state["rejected"] = feedback
        state.pop("rejected_categories", None)
        write_json(recovery_path, state)
    sent = 0
    for correction in range(3):
        attempt = semantic_attempt(run_dir, step_id)
        pending = read_json(pending_path) if pending_path.exists() else None
        if pending:
            attempt = pending["attempt"]
        prompt = semantic_prompt(artistic_payload, context, "Return the complete semantic delta. " + feedback, run_dir=run_dir)
        response_path = run_dir / "raw" / f"{step_id}-semantic-attempt{attempt}.api.json"
        started, response, normalized = utc_now(), None, None
        try:
            if cached is not None:
                normalized, response = cached, cached_response
                cached = None
            elif pending:
                normalized = pending["payload"]
                response = pending.get("response") or read_json(response_path)
            elif recovery_path.exists():
                normalized, response = recover_semantic_categories(run_dir, step_id, artistic_payload, context, schema, transport)
            else:
                parameters["max_tokens"] = semantic_output_limit(run_dir, prompt, schema)
                request = {"model": load_state(run_dir)["model"],
                    "messages": [{"role": "system", "content": "Normalize immutable authored content into concise constraint changes. Return JSON only."},
                                 {"role": "user", "content": prompt}],
                    **parameters, "response_format": {"type": "json_schema", "json_schema": {"name": "semanticDeltaPayload", "strict": True, "schema": schema}}}
                sent += 1
                try:
                    response, content = provider_response(transport, api_url(brief["lm_studio_base_url"], "/v1/chat/completions"), request,
                        float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")), started_at=started,
                        preserve=lambda value: write_json(response_path, value, mode=0o444, exclusive=True),
                        stream_path=response_path.with_suffix(".sse"))
                    normalized = parse_structured_content(content)
                except (TruncationError, IncompleteResponseError) as error:
                    response = read_json(response_path) if response_path.exists() else error.response or {}
                    append_failed_attempt(run_dir, step_id=f"{step_id}_semantic", attempt=attempt, phase="validation", prompt=prompt,
                        context=context, parameters=parameters, started_at=started, failure_class=error.failure_class, step_type="analysis",
                        output_hash=sha256_file(response_path) if response_path.exists() else None, usage=response.get("usage") or {})
                    seed_semantic_recovery(run_dir, step_id, artistic_payload, response, schema=schema)
                    response = None
                    if isinstance(error, IncompleteResponseError):
                        raise PausedError("Semantic normalization", error.reason, error.failure_class) from error
                    normalized, response = recover_semantic_categories(run_dir, step_id, artistic_payload, context, schema, transport)
            write_json(pending_path, {"attempt": attempt, "payload": normalized, "response": response})
            normalized = repair_named_references(run_dir, step_id, normalized, "semanticDeltaPayload", schema, transport,
                plan=reference_plan, source_context=artistic_payload)
            normalized = audit_ending_resolutions(run_dir, step_id, artistic_payload, normalized, transport)
            validate_json_schema(normalized, schema)
            validate_normalized(normalized)
            semantic_event_capacity(run_dir, normalized)
            target.unlink(missing_ok=True)
            semantic_api_path.unlink(missing_ok=True)
            write_json(target, normalized, mode=0o444, exclusive=True)
            write_json(semantic_api_path, response, mode=0o444, exclusive=True)
            if recovery_path.exists():
                state = read_json(recovery_path)
                state["payload"] = normalized
                write_json(recovery_path, state)
            feedback_path.unlink(missing_ok=True)
            pending_path.unlink(missing_ok=True)
            return normalized
        except PausedError:
            raise
        except CathedralsError as error:
            pending_path.unlink(missing_ok=True)
            target.unlink(missing_ok=True)
            semantic_api_path.unlink(missing_ok=True)
            assembled = isinstance(response, dict) and response.get("_cathedrals_semantic_assembled")
            already_accounted = any(entry["attempt"] == attempt for entry in step_entries(run_dir, f"{step_id}_semantic"))
            if not assembled and not already_accounted:
                append_failed_attempt(run_dir, step_id=f"{step_id}_semantic", attempt=attempt, phase="validation", prompt=prompt,
                    context=context, parameters=parameters, started_at=started, failure_class=error.failure_class, step_type="analysis",
                    output_hash=sha256_file(response_path) if response_path.exists() else None,
                    usage=read_json(response_path).get("usage") or {} if response_path.exists() else response.get("usage") or {} if isinstance(response, dict) else {})
            if error.failure_class == "budget_exhaustion" or isinstance(error, IntegrityError):
                raise
            if isinstance(error, SchemaError):
                state = (read_json(recovery_path) if recovery_path.exists() else
                    seed_semantic_recovery(run_dir, step_id, artistic_payload, response or {}, payload=normalized, schema=schema))
                if normalized is not None:
                    # Reference repairs may have succeeded before canonical validation failed.
                    for key in SEMANTIC_CATEGORIES:
                        if state["complete"].get(key):
                            state["payload"][key] = normalized[key]
                state["rejected"] = error.reason
                state["rejected_categories"] = semantic_error_categories(error)
                if isinstance(error, EpistemicDependencyError):
                    state.pop("rejected")
                    state.pop("rejected_categories", None)
                    write_json(recovery_path, state)
                    learning = repair_epistemic_dependencies(run_dir, step_id, artistic_payload, error, transport)
                    if learning:
                        state["rejected"] = ("Record acquisition only if shown by the immutable content, using these exact committed "
                            "subject/proposition IDs. Establish the supported knows/believes/suspects relation and retract the prior "
                            "explicitly_does_not_know relation for each acquired proposition. Preserve other valid knowledge entries. " +
                            canonical_json(learning).decode())
                        state["rejected_categories"] = ["knowledge_changes"]
                write_json(recovery_path, state)
            if isinstance(error, SchemaError) and correction < 2:
                feedback = f" Previous normalization failed: {error.reason}"
                continue
            if error.failure_class in RETRYABLE_PROVIDER_FAILURES and correction < 2:
                continue
            detail = (f"metadata validation failed after {correction + 1} checks" if assembled else
                      f"semantic normalization exhausted {sent} attempts in this invocation")
            raise PausedError("Semantic normalization", f"{step_id} preserved its schema-valid artistic payload, but {detail}. "
                f"Resume without regenerating prose. Last problem: {error.reason}") from error
    raise PausedError("Semantic normalization", f"{step_id} semantic normalization paused")


def epistemic_conflicts(scenes: list[dict], knowledge: dict, changes: dict) -> list[dict]:
    learned = {(item["subject_id"], item["proposition_id"]) for item in changes["knowledge_changes"]
               if item["action"] == "establish" and item["relation"] in {"knows", "believes", "suspects"}}
    conflicts = []
    for scene in scenes:
        for index, dependency in enumerate(scene["epistemic_dependencies"]):
            unavailable = knowledge.get(dependency["subject_id"], {}).get("explicitly_does_not_know", {})
            missing = [key for key in dependency["proposition_ids"]
                       if key in unavailable and (dependency["subject_id"], key) not in learned]
            if missing:
                conflicts.append({"scene_slot_id": scene["technical_slot_id"], "dependency_index": index,
                    "dependency": dependency, "missing_proposition_ids": missing,
                    "prior_knowledge": {key: unavailable[key] for key in missing}})
    return conflicts


def epistemic_repair_state(run_dir: Path, step_id: str, artistic: dict) -> dict:
    path = run_dir / ".staging" / f"{step_id}.epistemic-repair.json"
    state = read_json(path) if path.exists() else {
        "version": 1, "generation_id": run_dir.name, "step_id": step_id,
        "artistic_hash": sha256_bytes(canonical_json(artistic)), "overrides": {}, "history": []}
    if (state["artistic_hash"] != sha256_bytes(canonical_json(artistic))
            or state["generation_id"] != run_dir.name or state["step_id"] != step_id):
        raise IntegrityError("Epistemic corrections belong to different immutable artistic content")
    return state


def epistemic_dependency_schema(run_dir: Path) -> dict:
    genesis = committed_record(run_dir, "genesis") or {}
    cast = committed_record(run_dir, "genesis_cast") or {}
    subjects = [item["claimant_id"] for item in genesis.get("claimants", [])]
    subjects += [item["character_id"] for item in cast.get("characters", [])]
    return {"type": "object", "additionalProperties": False, "required": ["subject_id", "proposition_ids"],
        "properties": {"subject_id": {"enum": sorted(set(subjects))},
                       "proposition_ids": {"type": "array", "uniqueItems": True,
                           "items": {"enum": sorted(_read_state_map(run_dir, "canonical-facts.json"))}}}}


def apply_epistemic_repairs(run_dir: Path, step_id: str, artistic: dict) -> dict:
    state = epistemic_repair_state(run_dir, step_id, artistic)
    if not state["overrides"]:
        return artistic
    result = copy.deepcopy(artistic)
    slots = {scene["technical_slot_id"]: scene for scene in result["scenes"]}
    schema = {"type": "array", "items": epistemic_dependency_schema(run_dir)}
    for slot, dependencies in state["overrides"].items():
        if slot not in slots:
            raise IntegrityError("Epistemic correction references a scene outside its artistic payload")
        validate_json_schema(dependencies, schema)
        slots[slot]["epistemic_dependencies"] = dependencies
    return result


def repair_epistemic_dependencies(run_dir: Path, step_id: str, artistic: dict,
                                  error: EpistemicDependencyError, transport) -> list[dict]:
    state = epistemic_repair_state(run_dir, step_id, artistic)
    effective = apply_epistemic_repairs(run_dir, step_id, artistic)
    scenes = {scene["technical_slot_id"]: scene for scene in effective["scenes"]}
    occupied = {scene["technical_slot_id"] for record in committed_records(run_dir, "creative_packet") for scene in record["scenes"]}
    targets = {(item["scene_slot_id"], item["dependency_index"]): item for item in error.conflicts}
    if occupied & {slot for slot, _index in targets}:
        raise IntegrityError("Cannot repair dependency declarations of committed content")
    for (slot, index), conflict in targets.items():
        if slot not in scenes or index >= len(scenes[slot]["epistemic_dependencies"]) or scenes[slot]["epistemic_dependencies"][index] != conflict["dependency"]:
            raise IntegrityError("Epistemic correction no longer matches its dependency declaration")
    cached_learning = {(item["scene_slot_id"], item["dependency_index"]): item for item in state.get("learning", [])}
    if targets and all(target in cached_learning and all(cached_learning[target][key] == value for key, value in conflict.items())
                       for target, conflict in targets.items()):
        return [cached_learning[target] for target in targets]
    sources = {f"{slot}/prose_mdx": scene["prose_mdx"] for slot, scene in scenes.items()}
    sources.update({f"{slot}/artifacts/{index}/body_mdx": item["body_mdx"]
                    for slot, scene in scenes.items() for index, item in enumerate(scene["artifacts"])})
    schema = {"type": "object", "additionalProperties": False, "required": ["decisions"], "properties": {
        "decisions": {"type": "array", "minItems": len(targets), "maxItems": len(targets), "items": {
            "type": "object", "additionalProperties": False,
            "required": ["scene_slot_id", "dependency_index", "action", "replacement", "reason", "evidence"],
            "properties": {"scene_slot_id": {"enum": sorted({slot for slot, _index in targets})},
                "dependency_index": {"enum": sorted({index for _slot, index in targets})},
                "action": {"enum": ["repair_declaration", "repair_knowledge", "unresolved"]},
                "replacement": {"type": ["array", "null"], "items": epistemic_dependency_schema(run_dir)},
                "reason": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": False,
                    "required": ["source", "quote"], "properties": {
                        "source": {"enum": sorted(sources)}, "quote": {"type": "string", "minLength": 1}}}}}}}}}
    def validate(result):
        seen = set()
        for decision in result["decisions"]:
            target = (decision["scene_slot_id"], decision["dependency_index"])
            if target not in targets or target in seen:
                raise SchemaError("Return exactly one decision per flagged dependency; do not edit unaffected declarations")
            seen.add(target)
            if decision["action"] == "repair_declaration":
                if not isinstance(decision["replacement"], list) or decision["replacement"] == [targets[target]["dependency"]]:
                    raise SchemaError("A declaration correction must change the flagged declaration")
            elif decision["replacement"] is not None:
                raise SchemaError("Only declaration corrections may supply replacement dependencies")
            if decision["action"] != "unresolved" and not decision["evidence"]:
                raise SchemaError("A correction requires exact supporting excerpts from the immutable scene or its artifacts")
            for evidence in decision["evidence"]:
                if not evidence["source"].startswith(target[0] + "/") or evidence["quote"] not in sources[evidence["source"]]:
                    raise SchemaError("Correction evidence must quote the unchanged scene or its artifacts exactly")
    prompt = ("Resolve ONLY the flagged technical dependency declarations. Preserve all literary text and committed canon. "
        "These are positive character reliance declarations, not lists of mentioned facts or negative knowledge. "
        "Choose repair_declaration only when a declaration misidentifies actual reliance: replace that entry, or use [] to remove "
        "an unsupported declaration. Never remove a supported dependency merely to pass validation. "
        "Choose repair_knowledge with replacement=null only if the text shows this exact character acquiring the exact missing "
        "proposition; cite the acquisition. Choose unresolved with replacement=null for genuine contradictions requiring different "
        "prose or canon. Every correction needs a reason and exact source excerpts. Return decisions, never rewritten text.\n"
        "FLAGGED DEPENDENCIES\n" + canonical_json(error.conflicts).decode() +
        "\nIMMUTABLE SOURCE TEXT\n" + canonical_json(sources).decode() +
        "\nCURRENT DECLARATIONS\n" + canonical_json({slot: scene["epistemic_dependencies"] for slot, scene in scenes.items()}).decode() +
        "\nEXISTING SUBJECTS\n" + canonical_json((committed_record(run_dir, "genesis") or {}).get("claimants", []) +
            (committed_record(run_dir, "genesis_cast") or {}).get("characters", [])).decode() +
        "\nCOMMITTED PROPOSITIONS\n" + canonical_json(_read_state_map(run_dir, "canonical-facts.json")).decode())
    revision = len(state["history"]) + 1
    query = f"{step_id}_epistemic_correction_{revision}"
    result, response = request_architecture_analysis(run_dir, query, prompt, schema, transport, validate,
        phase="validation", response_name="epistemicCorrection", system_prompt="Audit technical reliance metadata against immutable source text. Return only the required decisions.",
        max_tokens=8192, planning_mode=True, context_purpose="semantic normalization", pause_stage="Epistemic dependency correction")
    preserve_planning_result(run_dir, step_id, query, result, response, kind="epistemic_correction", phase="validation")
    before = copy.deepcopy(state["overrides"])
    learning, unresolved = [], []
    for decision in sorted(result["decisions"], key=lambda item: (item["scene_slot_id"], -item["dependency_index"])):
        slot, index = decision["scene_slot_id"], decision["dependency_index"]
        if decision["action"] == "repair_declaration":
            dependencies = state["overrides"].setdefault(slot, copy.deepcopy(scenes[slot]["epistemic_dependencies"]))
            dependencies[index:index + 1] = decision["replacement"]
        elif decision["action"] == "repair_knowledge":
            learning.append(targets[(slot, index)] | {"reason": decision["reason"], "evidence": decision["evidence"]})
        else:
            unresolved.append(decision["reason"])
    state["history"].append({"step_id": query, "decisions": result["decisions"], "before": before,
                             "after": copy.deepcopy(state["overrides"])})
    state["learning"] = learning
    write_json(run_dir / ".staging" / f"{step_id}.epistemic-repair.json", state)
    if unresolved:
        raise PausedError("Epistemic dependency correction", "Immutable content has an unresolved knowledge contradiction: " + "; ".join(unresolved))
    return learning


def build_creative_packet(run_dir: Path, step_id: str, plan: dict, payload: dict, semantic: dict) -> dict:
    payload = apply_epistemic_repairs(run_dir, step_id, payload)
    architecture = committed_record(run_dir, "architecture")
    geomancy = {item["technical_slot_id"]: item for item in ensure_frozen_geomancy(run_dir)["assignments"]}
    artifacts, edges, compositions, scenes, endings = [], [], [], [], []
    content_ids = {
        item["technical_slot_id"]: ("scene", f"scene_{item['technical_slot_id'].removeprefix('scene_slot_')}")
        for item in payload["scenes"]
    } | {
        item["technical_slot_id"]: ("ending", f"ending_{item['technical_slot_id'].removeprefix('ending_slot_')}")
        for item in payload["endings"]
    }

    def expand(item: dict, kind: str) -> tuple[dict, list[dict], list[dict], list[dict]]:
        slot = item["technical_slot_id"]
        content_id = content_ids[slot][1]
        local_artifacts = [artifact | {"artifact_id": deterministic_id("artifact", run_dir.name, slot, index)} for index, artifact in enumerate(item["artifacts"], 1)]
        local_edges = []
        for index, choice in enumerate(item["choices"], 1):
            edge_id = deterministic_id("edge", run_dir.name, slot, index)
            local_edges.append(choice | {"edge_id": edge_id, "from_content_id": content_id,
                "decision_group_id": deterministic_id("decision_group", run_dir.name, slot) if choice["major_decision"] else None})
        local_compositions = [composition | {"composition_id": deterministic_id("composition", run_dir.name, slot, index), "container_id": content_id} for index, composition in enumerate(item["formal_compositions"], 1)]
        body = {key: value for key, value in item.items() if key not in {"artifacts", "choices", "formal_compositions"}}
        if kind == "scene":
            assignment = geomancy[slot]
            body |= {"scene_id": content_id, "threshold_figure": assignment["figure"], "threshold_resultant": assignment["resultant"],
                "artifact_ids": [value["artifact_id"] for value in local_artifacts], "choice_edge_ids": [value["edge_id"] for value in local_edges]}
        else:
            attractor_id = plan["attractor_ids"][len(endings) % len(plan["attractor_ids"])]
            attractor = next(value for value in architecture["attractors"] if value["attractor_id"] == attractor_id)
            evidence = [source["artifact_id"] for obligation_id in attractor["prerequisite_obligation_ids"] for source in _read_state_map(run_dir, "obligations.json").get(obligation_id, {}).get("resolution_event", {}).get("sources", [])]
            body |= {"ending_id": content_id, "attractor_id": attractor_id,
                "satisfied_prerequisite_obligation_ids": attractor["prerequisite_obligation_ids"],
                "prerequisite_evidence_source_ids": sorted(set(evidence)) or [content_id]}
        return body, local_artifacts, local_edges, local_compositions

    for item in payload["scenes"]:
        body, local_artifacts, local_edges, local_compositions = expand(item, "scene")
        scenes.append(body); artifacts += local_artifacts; edges += local_edges; compositions += local_compositions
    for item in payload["endings"]:
        body, local_artifacts, local_edges, local_compositions = expand(item, "ending")
        endings.append(body); artifacts += local_artifacts; edges += local_edges; compositions += local_compositions
    delta = build_semantic_delta(run_dir, step_id, semantic, content_ids)
    return record_envelope(run_dir, "creative_packet", step_id) | {
        "architecture_core_commit_id": architecture["architecture_core_commit_id"],
        "packet_plan_commit_id": plan_batch_for(run_dir, plan["packet_slot_id"])["commit_id"], "story_format": "web",
        "packet_slot_id": plan["packet_slot_id"], "packet_kind": plan["packet_kind"],
        "packet_sequence": 1 + len(committed_records(run_dir, "creative_packet")),
        "obligations_advanced": sorted({item["obligation_id"] for item in delta["obligation_updates"]}),
        "scenes": scenes, "artifacts": artifacts, "endings": endings, "decision_edges": edges,
        "formal_compositions": compositions, "constraint_delta": delta,
    }


def validate_genesis_foundation(record: dict, run_dir: Path) -> None:
    brief = read_json(run_dir / "generation-brief.json")
    if record["generation_id"] != brief["generation_id"] or record["story_format"] != "web":
        raise SchemaError("Genesis foundation does not match the frozen generation or active web format")
    anchors = record["claimant_anchors"]
    count = len(anchors)
    expected_slots = [f"claimant_slot_{number:02d}" for number in range(1, count + 1)]
    if not INITIAL_CLAIMANT_MIN <= count <= INITIAL_CLAIMANT_MAX or sorted(
        item["technical_slot_id"] for item in anchors
    ) != expected_slots:
        raise SchemaError("Genesis foundation must anchor five to eight sequential claimant slots")
    if len({item["claimant_id"] for item in anchors}) != count:
        raise SchemaError("Genesis foundation claimant IDs must be unique")
    canon = record["work_canon"]
    claimant_ids = {item["claimant_id"] for item in anchors}
    unknown_subject_ids = sorted(set(canon["central_incident"]["subjects"]) - claimant_ids)
    if unknown_subject_ids:
        raise SchemaError(
            "Genesis foundation central-incident subjects reference unknown claimant IDs: "
            + ", ".join(unknown_subject_ids)
        )

    unknown_claimant_ids = sorted({
        claimant_id
        for relationship in canon["claimant_relationships"]
        for claimant_id in relationship["claimant_ids"]
        if claimant_id not in claimant_ids
    })

    if unknown_claimant_ids:
        raise SchemaError(
            "Genesis foundation relationships reference unknown claimant IDs: "
            + ", ".join(unknown_claimant_ids)
            + ". Valid claimant IDs are: "
            + ", ".join(sorted(claimant_ids))
        )

    if len(canon["generated_motifs"]) > 8 or len(canon["principal_tensions"]) > 8:
        raise SchemaError("Genesis foundation exceeds its bounded motif or tension count")
    


def validate_genesis_cast(record: dict, run_dir: Path) -> None:
    foundation = committed_record(run_dir, "genesis_foundation")
    if not foundation or record["foundation_commit_id"] != foundation["commit_id"]:
        raise SchemaError("Genesis cast does not descend from the committed foundation")
    anchor_ids = {item["claimant_id"] for item in foundation["claimant_anchors"]}
    claimant_ids = [item["claimant_id"] for item in record["claimants"]]
    missing = sorted(anchor_ids - set(claimant_ids))
    unexpected = sorted(set(claimant_ids) - anchor_ids)
    duplicates = sorted({item for item in claimant_ids if claimant_ids.count(item) > 1})
    problems = []
    if missing:
        problems.append("missing: " + ", ".join(missing))
    if unexpected:
        problems.append("unexpected: " + ", ".join(unexpected))
    if duplicates:
        problems.append("duplicated: " + ", ".join(duplicates))
    if problems:
        raise SchemaError("Genesis cast claimant IDs do not match committed anchors; " + "; ".join(problems))
    character_slots = [item["technical_slot_id"] for item in record["characters"]]
    expected_character_slots = [f"character_slot_{number:03d}" for number in range(1, len(character_slots) + 1)]
    if character_slots != expected_character_slots:
        raise SchemaError("Genesis cast characters must use sequential technical slots")


def validate_genesis_constraints(record: dict, run_dir: Path) -> None:
    cast = committed_record(run_dir, "genesis_cast")
    if not cast or record["cast_commit_id"] != cast["commit_id"]:
        raise SchemaError("Genesis constraints do not descend from the committed cast")
    foundation = committed_record(run_dir, "genesis_foundation")
    known_claimants = {item["claimant_id"] for item in foundation["claimant_anchors"]}
    characters = {item["character_id"]: item for item in cast["characters"]}
    promoted = set()
    initial_count = len(known_claimants)
    extensions = record["claimant_extensions"]
    if initial_count + len(extensions) > MAX_CLAIMANTS:
        raise SchemaError("Genesis constraints exceed the twelve-claimant maximum")
    for offset, extension in enumerate(extensions, initial_count + 1):
        anchor = extension["anchor"]
        claimant_id = f"claimant_{offset:02d}"
        if anchor["claimant_id"] != claimant_id or anchor["technical_slot_id"] != f"claimant_slot_{offset:02d}":
            raise SchemaError("Genesis claimant extensions must use sequential engine-assigned IDs and slots")
        if extension["profile"]["claimant_id"] != claimant_id:
            raise SchemaError("Genesis claimant extension profile does not match its anchor")
        origin = extension["origin_character_id"]
        if origin is not None:
            if origin not in characters or origin in promoted:
                raise SchemaError("Genesis claimant extension has an unknown or repeated character origin")
            if anchor["name"] != characters[origin]["name"]:
                raise SchemaError("Promoted claimant name does not match its committed character")
            promoted.add(origin)
        for relationship in extension["claimant_relationships"]:
            related = set(relationship["claimant_ids"])
            if claimant_id not in related or not related - {claimant_id} or not related.issubset(known_claimants | {claimant_id}):
                raise SchemaError("Genesis claimant extension relationship must connect it to an existing claimant")
        known_claimants.add(claimant_id)
    delta = record["constraint_delta"]
    if len(delta["canonical_facts"]) > 12 or len(delta["knowledge_changes"]) > 24 or len(delta["motif_events"]) > 8:
        raise SchemaError("Genesis constraints exceed their bounded initial counts")
    if delta["new_obligations"] or delta["obligation_updates"] or delta["potential_foreclosures"]:
        raise SchemaError("Genesis constraints cannot create obligations or foreclosures")
    semantic_facts = {
        canonical_json({key: item[key] for key in ("subject", "predicate", "value", "status")})
        for item in delta["canonical_facts"]
    }
    if len(semantic_facts) != len(delta["canonical_facts"]):
        raise SchemaError("Genesis constraints contain duplicate canonical facts")
    propositions = {item["fact_id"] for item in delta["canonical_facts"]}
    if any(item["proposition_id"] not in propositions for item in delta["knowledge_changes"]):
        raise SchemaError("Genesis knowledge state references an unknown proposition")


def provisional_architecture(core: dict) -> dict:
    ending_attractor = next(item["attractor_id"] for item in core["attractors"] if item["kind"] == "ending")
    plans = [
        spec | {
            "initial_priority": index,
            "depends_on_packet_slot_ids": [],
            "branch_path_relation": "uncommitted_plan_batch",
            "attractor_ids": [ending_attractor] if spec["packet_kind"] == "ending" else [],
            "relevance": {"claimant_ids": [], "arc_ids": [], "motif_ids": [], "keywords": []},
            "soft_guidance": [],
        }
        for index, spec in enumerate(planned_packet_specs(core), 1)
    ]
    ending_slots = [slot for plan in plans if plan["packet_kind"] == "ending" for slot in plan["ending_slot_ids"]]
    return core | {
        "record_type": "architecture",
        "packet_plans": plans,
        "attractors": [item | {"ending_slot_ids": ending_slots if item["attractor_id"] == ending_attractor else []} for item in core["attractors"]],
    }


def validate_architecture_core_for_run(record: dict, run_dir: Path) -> None:
    genesis = committed_record(run_dir, "genesis")
    if not genesis or record["genesis_commit_id"] != genesis["commit_id"]:
        raise SchemaError("Architecture core does not descend from completed Genesis")
    if record["story_format"] != "web":
        raise SchemaError("The active architecture format must be web")
    claimants = {item["claimant_id"] for item in genesis["claimants"]}
    if any(not set(arc["claimant_pressures"]).issubset(claimants) for arc in record["arcs"]):
        raise SchemaError("Architecture applies pressure from an unknown claimant")
    validate_architecture(provisional_architecture(record), read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))


def validate_architecture_plan_batch(record: dict, run_dir: Path, expected_specs: list[dict], sequence: int, count: int) -> None:
    core = planning_core(run_dir)
    if not core or record["architecture_core_commit_id"] != core["commit_id"]:
        raise SchemaError("Architecture plan batch does not descend from the committed core")
    if record["batch_sequence"] != sequence or record["batch_count"] != count:
        raise SchemaError("Architecture plan batch sequence does not match its frozen batch")
    expected = {item["packet_slot_id"]: item for item in expected_specs}
    actual = {item["packet_slot_id"]: item for item in record["packet_plans"]}
    if set(actual) != set(expected):
        raise SchemaError("Architecture plan batch did not fill its assigned packet slots exactly")
    fixed = ("packet_kind", "scene_slot_ids", "ending_slot_ids", "artifact_count", "formal_composition_count")
    allowed_dependencies = {
        plan["packet_slot_id"]
        for batch in planning_batches_view(run_dir)
        if batch["batch_sequence"] < sequence
        for plan in batch["packet_plans"]
    }
    for packet_id, spec in expected.items():
        if any(actual[packet_id][key] != spec[key] for key in fixed):
            raise SchemaError(f"Architecture plan batch changed frozen allocation {packet_id}")
        if not set(actual[packet_id]["depends_on_packet_slot_ids"]).issubset(allowed_dependencies):
            raise SchemaError(f"Architecture plan {packet_id} depends on an unfrozen future batch")
        allowed_dependencies.add(packet_id)
    if sequence == count:
        batches = [item for item in planning_batches_view(run_dir) if item["batch_sequence"] < sequence] + [record]
        validate_architecture(architecture_from_parts(core, batches), read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))


def validate_completed_architecture(run_dir: Path) -> None:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        raise SchemaError("Architecture plan batches are incomplete")
    validate_architecture(architecture, read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))
    if not architecture.get("causal_scaffold"):
        raise IntegrityError("Scaffold policy requires a committed causal scaffold")
    navigation_contract_route(architecture)
    if architecture.get("causal_scaffold") and architecture["packet_plans"] != scaffold_packet_plans(architecture):
        raise IntegrityError("Frozen packets differ from causal scaffold compilation")


def validate_ending_prerequisites(
    ending: dict,
    attractors: dict,
    obligation_state: dict,
    feasibility: dict,
    evidence_source_ids: set[str],
    satisfaction_evidence: dict[str, set[str]] | None = None,
) -> None:
    attractor = attractors.get(ending["attractor_id"])
    if not attractor or attractor["kind"] != "ending" or feasibility.get(ending["attractor_id"]) != "viable":
        raise SchemaError("Ending cannot realize an absent, non-ending, or nonviable attractor")
    satisfied = {
        key for key, value in obligation_state.items() if value["data"]["status"] == "satisfied"
    }
    prerequisites = set(attractor["prerequisite_obligation_ids"])
    if set(ending["satisfied_prerequisite_obligation_ids"]) != prerequisites or not prerequisites.issubset(satisfied):
        raise SchemaError("Ending cannot commit before every hard attractor prerequisite is satisfied")
    if not set(ending["prerequisite_evidence_source_ids"]).issubset(evidence_source_ids):
        raise SchemaError("Ending prerequisite evidence does not resolve to immutable source")
    satisfaction_evidence = satisfaction_evidence or {}
    required_evidence = {
        source_id for obligation_id in prerequisites for source_id in satisfaction_evidence.get(obligation_id, set())
    }
    if not required_evidence.issubset(ending["prerequisite_evidence_source_ids"]):
        raise SchemaError("Ending does not cite the evidence that satisfied its prerequisites")


def validate_packet_for_run(record: dict, run_dir: Path, plan: dict) -> None:
    architecture = committed_record(run_dir, "architecture")
    batch = plan_batch_for(run_dir, plan["packet_slot_id"])
    if (
        not architecture
        or not batch
        or record["architecture_core_commit_id"] != architecture["architecture_core_commit_id"]
        or record["packet_plan_commit_id"] != batch["commit_id"]
    ):
        raise SchemaError("Packet does not descend from its committed architecture and plan batch")
    if record["generation_id"] != run_dir.name or record["story_format"] != "web":
        raise SchemaError("Packet does not match the frozen run or active web format")
    committed_packet_count = sum(item.get("record_type") == "creative_packet" for item in all_committed_records(run_dir))
    if record["packet_sequence"] != committed_packet_count + 1:
        raise SchemaError("Packet sequence does not match immutable forward commit order")
    content = record["scenes"] if record["packet_kind"] == "literary" else record["endings"]
    scaffold_nodes = {architecture["causal_scaffold"]["slot_ids"][node["node_id"]]: node for node in architecture["causal_scaffold"]["nodes"]}
    for item in content:
        receipt_path = run_dir / ".staging" / f"scaffold-evidence-{item['technical_slot_id']}.json"
        if not receipt_path.exists():
            raise IntegrityError("A scaffold packet cannot commit without its source audit")
        receipt = read_json(receipt_path)
        if receipt["own_text_hash"] != sha256_bytes(canonical_json(scaffold_literary_texts(item, record))) or receipt["contract_hash"] != sha256_bytes(canonical_json(scaffold_nodes[item["technical_slot_id"]])):
            raise IntegrityError("Scaffold source audit does not match the committing prose or contract")
    occupied_slots = {
        item["technical_slot_id"]
        for chunk in packet_chunks(run_dir, record["packet_slot_id"])
        for item in (chunk["scenes"] if record["packet_kind"] == "literary" else chunk["endings"])
    }
    if occupied_slots & {item["technical_slot_id"] for item in content}:
        raise SchemaError("Packet chunk attempted to refill a committed technical slot")
    validate_packet_word_allowance(record, plan)
    obligation_state = _read_state_map(run_dir, "obligations.json")
    obligations = set(obligation_state)
    arcs = {item["arc_id"] for item in architecture["arcs"]}
    claimants = {item["claimant_id"] for item in committed_record(run_dir, "genesis")["claimants"]}
    attractors = {item["attractor_id"]: item for item in architecture["attractors"]}
    if not set(record["obligations_advanced"]).issubset(obligations):
        raise SchemaError("Packet claims an unknown obligation")
    if any(scene["arc_id"] not in arcs or not set(scene["claimant_focus_ids"]).issubset(claimants) for scene in record["scenes"]):
        raise SchemaError("Packet scene references an unknown arc or claimant")
    if any(not set(item["claimant_relevance_ids"]).issubset(claimants) for item in record["artifacts"]):
        raise SchemaError("Packet artifact references an unknown claimant")
    if any(not set(item["claimant_pressure_ids"]).issubset(claimants) for item in record["endings"]):
        raise SchemaError("Packet ending references an unknown claimant")
    for scene in record["scenes"]:
        validate_markdown_source(scene["prose_mdx"], f"Scene {scene['scene_id']}")
    for artifact in record["artifacts"]:
        validate_markdown_source(artifact["body_mdx"], f"Artifact {artifact['artifact_id']}")
    for ending in record["endings"]:
        validate_markdown_source(ending["prose_mdx"], f"Ending {ending['ending_id']}")
    changes = record["constraint_delta"]
    known_propositions = historical_fact_ids(run_dir) | {
        item["fact_id"] for item in changes["canonical_facts"]
    }
    if any(item["proposition_id"] not in known_propositions for item in changes["knowledge_changes"]):
        raise SchemaError("Knowledge state references an unknown proposition")
    new_obligation_ids = {item["obligation_id"] for item in changes["new_obligations"]}
    known_obligation_origins = set(_source_index(run_dir)) | (set(generated_ids(record)) - new_obligation_ids)
    validate_obligation_origins(changes["new_obligations"], known_obligation_origins, "New obligation")
    allowed_targets = (
        obligations
        | new_obligation_ids
        | set(attractors)
        | {item["packet_slot_id"] for item in architecture["packet_plans"] if item["packet_slot_id"] != plan["packet_slot_id"]}
    )
    for obligation in changes["new_obligations"]:
        if not set(obligation["requires"]).issubset(obligations | new_obligation_ids):
            raise SchemaError("New obligation references an unknown prerequisite")
        if obligation["range"] == "long_range" and not set(obligation["termination_targets"]).issubset(allowed_targets):
            raise SchemaError("New long-range obligation has no lawful future termination target")
    candidate_by_obligation = {
        obligation_id: candidate
        for candidate in changes["potential_foreclosures"]
        for obligation_id in candidate["negated_prerequisite_obligation_ids"]
    }
    for update in changes["obligation_updates"]:
        if update["obligation_id"] not in obligations:
            raise SchemaError("Obligation update references an unknown obligation")
        original = obligation_state[update["obligation_id"]]["data"]
        if update["obligation_id"] in ending_prerequisite_ids(architecture, obligation_state) and update["status"] == "intentionally_unresolved":
            raise SchemaError("An ending prerequisite must remain active until supported satisfaction; ambiguous ongoing work is not a terminal resolution",
                paths=["$.constraint_delta.obligation_updates"])
        if update["status"] == "foreclosed" and original["universality"] == "universal" and original["hardness"] == "hard":
            raise SchemaError("A universal hard obligation cannot be foreclosed")
        if update["status"] in {"foreclosed", "impossible"}:
            candidate = candidate_by_obligation.get(update["obligation_id"])
            if not candidate or candidate["attractor_id"] not in original["termination_targets"]:
                raise SchemaError("An obligation may become impossible or foreclosed only with a scoped foreclosure candidate")
    for candidate in changes["potential_foreclosures"]:
        attractor = attractors.get(candidate["attractor_id"])
        if not attractor or not set(candidate["negated_prerequisite_obligation_ids"]).issubset(attractor["prerequisite_obligation_ids"]):
            raise SchemaError("Potential foreclosure does not negate a known attractor prerequisite")
        if any(
            obligation_state[item]["data"]["universality"] == "universal"
            and obligation_state[item]["data"]["hardness"] == "hard"
            for item in candidate["negated_prerequisite_obligation_ids"]
        ):
            raise SchemaError("A universal obligation cannot be used to foreclose an attractor")
    conflicts = epistemic_conflicts(record["scenes"], _read_state_map(run_dir, "knowledge-state.json"), changes)
    if conflicts:
        raise EpistemicDependencyError(conflicts)
    prospective = _read_state_map(run_dir, "prospective-plan.json")
    feasibility = {item["attractor_id"]: item["status"] for item in prospective.get("feasibility", [])}
    effective = {identifier: event["data"]["status"] for identifier, event in obligation_state.items()}
    effective.update({update["obligation_id"]: update["status"] for update in changes["obligation_updates"]})
    active_architecture = architecture | {"attractors": [item for item in architecture["attractors"] if feasibility.get(item["attractor_id"]) != "foreclosed"]}
    pending = sorted(identifier for identifier in ending_prerequisite_ids(active_architecture, obligation_state) if effective.get(identifier) != "satisfied")
    filled = {scene["technical_slot_id"] for packet in committed_records(run_dir, "creative_packet") + [record] for scene in packet["scenes"]}
    remaining = {slot for item in architecture["packet_plans"] for slot in item["scene_slot_ids"]} - filled
    if pending and not remaining:
        raise SchemaError("No remaining literary slot can establish these ending prerequisites: " + ", ".join(pending), paths=["$.constraint_delta.obligation_updates"])
    satisfaction_evidence = {
        key: {source["artifact_id"] for source in value["resolution_event"]["sources"]}
        for key, value in obligation_state.items()
        if value["data"]["status"] == "satisfied" and "resolution_event" in value
    }
    satisfaction_evidence.update({
        item["obligation_id"]: {source["artifact_id"] for source in item["evidence_sources"]}
        for item in changes["obligation_updates"]
        if item["status"] == "satisfied"
    })
    for ending in record["endings"]:
        validate_ending_prerequisites(
            ending,
            attractors,
            obligation_state,
            feasibility,
            set(_source_index(run_dir)) | set(generated_ids(record)),
            satisfaction_evidence,
        )
    current_content = {item["scene_id"] for item in record["scenes"]} | {item["ending_id"] for item in record["endings"]}
    committed_content = {
        identifier
        for packet in all_committed_records(run_dir)
        if packet.get("record_type") == "creative_packet"
        for identifier in [
            *(item["scene_id"] for item in packet["scenes"]),
            *(item["ending_id"] for item in packet["endings"]),
        ]
    }
    declared_slots = {
        slot
        for packet_plan in architecture["packet_plans"]
        for slot in packet_plan["scene_slot_ids"] + packet_plan["ending_slot_ids"]
    }
    if any(edge["from_content_id"] not in current_content for edge in record["decision_edges"]):
        raise SchemaError("A packet cannot retroactively attach an edge to earlier content")
    destinations = [edge["destination"] for edge in record["decision_edges"]]
    destinations += [ending["redirect_destination"] for ending in record["endings"] if ending["redirect_destination"]]
    if any(destination["kind"] == "technical_slot" and destination["id"] not in declared_slots for destination in destinations):
        raise SchemaError("A packet references a technical destination outside frozen architecture")
    if any(destination["kind"] == "content" and destination["id"] not in current_content | committed_content for destination in destinations):
        raise SchemaError("A packet invented an uncommitted future literary content ID")
    geomancy = {item["technical_slot_id"]: item for item in ensure_frozen_geomancy(run_dir)["assignments"]}
    if any(
        scene["technical_slot_id"] not in geomancy
        or scene["threshold_figure"] != geomancy[scene["technical_slot_id"]]["figure"]
        or scene["threshold_resultant"] != geomancy[scene["technical_slot_id"]]["resultant"]
        for scene in record["scenes"]
    ):
        raise SchemaError("Packet changed its frozen threshold geomancy")
    validate_packet_against_plan(record, plan)
    candidate = {field: [item | {"choices": [edge for edge in record["decision_edges"]
        if edge["from_content_id"] == item.get("scene_id", item.get("ending_id"))]} for item in record[field]]
        for field in ("scenes", "endings")}
    validate_navigation_payload(run_dir, architecture, plan, candidate)


def compact_definition(run_dir: Path, definition: str) -> str:
    return json.dumps(definition_schema(definition, load_protocol(run_dir)), ensure_ascii=False, separators=(",", ":"))


def packet_dependency_schema(allowed):
    return {"type": "array", "uniqueItems": True,
        **({"items": {"type": "string", "enum": list(allowed)}} if allowed else {"maxItems": 0})}


def ending_prerequisite_ids(architecture, obligations):
    pending = [identifier for attractor in architecture.get("attractors", []) if attractor["kind"] == "ending"
        for identifier in attractor["prerequisite_obligation_ids"]]
    required = set()
    while pending:
        identifier = pending.pop()
        if identifier in required:
            continue
        required.add(identifier)
        if identifier in obligations:
            pending.extend(obligations[identifier]["data"]["requires"])
    return required


def semantic_delta_schema(run_dir: Path, source_slots, *, plan=None) -> dict:
    protocol = load_protocol(run_dir)
    schema = copy.deepcopy(definition_schema("semanticDeltaPayload", protocol))
    schema["$defs"]["semanticSource"]["properties"]["technical_slot_id"] = {
        "enum": sorted(set(source_slots))
    }
    if plan is not None:
        obligations = sorted(_read_state_map(run_dir, "obligations.json"))
        if obligations:
            schema["$defs"]["semanticObligationUpdate"]["properties"]["obligation_id"] = {"enum": obligations}
            schema["$defs"]["semanticSoftObligation"]["properties"]["requires"] = {"type": "array", "items": {"enum": obligations}}
        else:
            schema["properties"]["obligation_updates"] = {"type": "array", "maxItems": 0}
            schema["$defs"]["semanticSoftObligation"]["properties"]["requires"] = {"type": "array", "maxItems": 0}
        schema["$defs"]["semanticObligationUpdate"]["properties"]["status"] = {
            "enum": [status for status in protocol["$defs"]["obligationUpdate"]["properties"]["status"]["enum"]
                     if status not in {"foreclosed", "impossible"}]
        }
        if obligations:
            strict = ending_prerequisite_ids(committed_record(run_dir, "architecture") or {}, _read_state_map(run_dir, "obligations.json")) & set(obligations)
            if strict:
                base = schema["$defs"]["semanticObligationUpdate"]
                variants = []
                for identifiers, statuses in ((strict, ["satisfied"]), (set(obligations) - strict, ["satisfied", "intentionally_unresolved"])):
                    if identifiers:
                        variant = copy.deepcopy(base)
                        variant["properties"]["obligation_id"] = {"enum": sorted(identifiers)}
                        variant["properties"]["status"] = {"enum": statuses}
                        variants.append(variant)
                schema["$defs"]["semanticObligationUpdate"] = {"type": "object", "anyOf": variants}
    return schema


def genesis_constraints_schema(run_dir: Path, extensions=()) -> dict:
    protocol = load_protocol(run_dir)
    schema = copy.deepcopy(definition_schema("semanticDeltaPayload", protocol))
    for field, maximum in {
        "canonical_facts": 12,
        "knowledge_changes": 24,
        "motif_events": 8,
    }.items():
        schema["properties"][field]["maxItems"] = maximum
    for field in ("new_soft_obligations", "obligation_updates"):
        schema["properties"][field] = {"type": "array", "maxItems": 0}
    schema["$defs"]["semanticFact"]["properties"]["value"] = {
        "type": ["string", "number", "boolean", "null"]
    }
    knowledge = schema["$defs"]["semanticKnowledge"]["properties"]
    knowledge["relation"] = copy.deepcopy(protocol["$defs"]["knowledgeChange"]["properties"]["relation"])
    knowledge["action"] = copy.deepcopy(protocol["$defs"]["knowledgeChange"]["properties"]["action"])
    motif = schema["$defs"]["semanticMotif"]["properties"]
    motif["action"] = copy.deepcopy(protocol["$defs"]["motifEvent"]["properties"]["action"])
    motif["overuse_risk"] = copy.deepcopy(protocol["$defs"]["motifEvent"]["properties"]["overuse_risk"])
    needed = {
        "id", "idList", "nonEmptyString", "relevanceTags", "semanticFact",
        "semanticKnowledge", "semanticMotif", "semanticSource", "stringList",
    }
    schema["$defs"] = {name: definition for name, definition in schema["$defs"].items() if name in needed}
    catalog = genesis_constraint_catalog(run_dir, extensions)
    schema["$defs"]["semanticSource"]["properties"]["technical_slot_id"] = {"type": "string", "enum": sorted(catalog["sources"])}
    knowledge["subject_id"] = {"type": "string", "enum": sorted(set(catalog["claimants"]) | set(catalog["characters"]))}
    knowledge["proposition_id"] = {"type": "string", "enum": [f"fact_{index:02d}" for index in range(1, 13)]}
    tags = schema["$defs"]["relevanceTags"]["properties"]
    for field, identifiers in (("technical_slot_ids", catalog["sources"]), ("claimant_ids", catalog["claimants"]),
            ("character_ids", catalog["characters"]), ("state_keys", protocol["$defs"]["stateKey"]["enum"])):
        tags[field] = {"type": "array", "items": {"enum": sorted(identifiers)}} if identifiers else {"type": "array", "maxItems": 0}
    for field in ("arc_ids", "branch_ids"):
        tags[field] = {"type": "array", "maxItems": 0}
    return schema


def genesis_foundation_schema(run_dir: Path) -> dict:
    schema = copy.deepcopy(definition_schema("genesisFoundationPayload", load_protocol(run_dir)))
    claimant_ids = [f"claimant_{number:02d}" for number in range(1, INITIAL_CLAIMANT_MAX + 1)]
    canon = schema["$defs"]["workCanon"]["properties"]
    canon["central_incident"]["properties"]["subjects"] |= {
        "minItems": 1, "uniqueItems": True, "items": {"enum": claimant_ids}
    }
    canon["claimant_relationships"]["items"]["properties"]["claimant_ids"]["items"] = {
        "enum": claimant_ids
    }
    return schema


def genesis_cast_schema(run_dir: Path) -> dict:
    foundation = committed_record(run_dir, "genesis_foundation")
    if not foundation:
        raise IntegrityError("Genesis cast schema requires a committed foundation")
    claimant_ids = [item["claimant_id"] for item in foundation["claimant_anchors"]]
    schema = copy.deepcopy(definition_schema("genesisCastPayload", load_protocol(run_dir)))
    schema["properties"]["claimants"] |= {
        "minItems": len(claimant_ids), "maxItems": len(claimant_ids)
    }
    schema["$defs"]["claimant"]["properties"]["claimant_id"] = {"enum": claimant_ids}
    return schema


