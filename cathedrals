def step_was_truncated(run_dir: Path, step_id: str) -> bool:
    return any(
        entry["planned_step_id"] == step_id and entry["failure_class"] == "provider_truncation"
        for entry in ledger_entries(run_dir)
    )


def packet_step_id(plan: dict, expanded: bool = False) -> str:
    slots = plan["scene_slot_ids"] or plan["ending_slot_ids"]
    identity = canonical_json({
        "packet": plan["packet_slot_id"],
        "slots": slots,
        "artifacts": plan["artifact_count"],
        "compositions": plan["formal_composition_count"],
        "obligations": plan["advance_obligation_ids"],
    })
    return f"packet_{plan['packet_slot_id']}_{sha256_bytes(identity)[:12]}{'_expanded' if expanded else ''}"


def expanded_output_limit(run_dir: Path, prompt: str, base_step_id: str) -> int:
    manifest = read_json(run_dir / "run-manifest.json")
    state = load_state(run_dir)
    observed = max(
        (
            entry["token_accounting"]["input_tokens"] or 0
            for entry in ledger_entries(run_dir)
            if entry["planned_step_id"] == base_step_id
        ),
        default=0,
    )
    prompt_tokens = max(observed, math.ceil(len(prompt.encode("utf-8")) / 3))
    available = (
        min(
            manifest["budgets"]["model_context_window_tokens"],
            state.get("model_context_window_tokens", manifest["budgets"]["model_context_window_tokens"]),
        )
        - prompt_tokens
        - manifest["budgets"]["context_safety_reserve_tokens"]
    )
    return min(manifest["budgets"]["max_expanded_output_tokens"], available)


def request_bounded_record(run_dir: Path, **arguments) -> dict:
    step_id = arguments["step_id"]
    if not step_was_truncated(run_dir, step_id):
        try:
            return request_record(run_dir, **arguments)
        except TruncationError:
            pass
    expanded_id = f"{step_id}_expanded"
    if step_was_truncated(run_dir, expanded_id):
        raise TruncationError(f"Bounded step {step_id} was truncated after its context-safe expanded retry")
    maximum = expanded_output_limit(run_dir, arguments["prompt"], step_id)
    if maximum <= BASE_OUTPUT_TOKENS:
        raise TruncationError(f"Bounded step {step_id} was truncated and the model context has no safe expansion headroom")
    return request_record(run_dir, **(arguments | {"step_id": expanded_id, "max_tokens": maximum}))


def split_packet_plan(plan: dict) -> tuple[dict, dict]:
    key = "scene_slot_ids" if plan["packet_kind"] == "literary" else "ending_slot_ids"
    slots = plan[key]
    midpoint = len(slots) // 2
    artifact_counts = distribute_counts(plan["artifact_count"], 2)
    composition_counts = distribute_counts(plan["formal_composition_count"], 2)
    left = plan | {
        key: slots[:midpoint],
        "artifact_count": artifact_counts[0],
        "formal_composition_count": composition_counts[0],
        "advance_obligation_ids": [],
        "may_satisfy_obligation_ids": [],
    }
    right = plan | {
        key: slots[midpoint:],
        "artifact_count": artifact_counts[1],
        "formal_composition_count": composition_counts[1],
    }
    return left, right


def request_packet_slice(run_dir: Path, architecture: dict, plan: dict, transport=http_json) -> None:
    slots = plan["scene_slot_ids"] or plan["ending_slot_ids"]
    step_id = packet_step_id(plan)
    if step_was_truncated(run_dir, step_id):
        if len(slots) > 1:
            left, right = split_packet_plan(plan)
            request_packet_slice(run_dir, architecture, left, transport)
            request_packet_slice(run_dir, architecture, right, transport)
            return
        expanded_id = packet_step_id(plan, expanded=True)
        if step_was_truncated(run_dir, expanded_id):
            raise TruncationError("A single-content packet was truncated after its context-safe expanded retry")
        prompt, context = packet_prompt(run_dir, architecture, plan)
        maximum = expanded_output_limit(run_dir, prompt, step_id)
        if maximum <= BASE_OUTPUT_TOKENS:
            raise TruncationError("A single-content packet was truncated and the model context has no safe expansion headroom")
        request_record(
            run_dir,
            expected_record_type="creative_packet",
            step_id=expanded_id,
            phase="literary_packet" if plan["packet_kind"] == "literary" else "ending_packet",
            prompt=prompt,
            context=context,
            branch_relation=plan["branch_path_relation"],
            temperature=0.85 if plan["packet_kind"] == "literary" else 0.75,
            max_tokens=maximum,
            transport=transport,
            precommit_validator=lambda record: validate_packet_for_run(record, run_dir, plan),
        )
        return
    prompt, context = packet_prompt(run_dir, architecture, plan)
    try:
        request_record(
            run_dir,
            expected_record_type="creative_packet",
            step_id=step_id,
            phase="literary_packet" if plan["packet_kind"] == "literary" else "ending_packet",
            prompt=prompt,
            context=context,
            branch_relation=plan["branch_path_relation"],
            temperature=0.85 if plan["packet_kind"] == "literary" else 0.75,
            transport=transport,
            precommit_validator=lambda record: validate_packet_for_run(record, run_dir, plan),
        )
    except TruncationError:
        if len(slots) > 1:
            left, right = split_packet_plan(plan)
            request_packet_slice(run_dir, architecture, left, transport)
            request_packet_slice(run_dir, architecture, right, transport)
            return
        request_packet_slice(run_dir, architecture, plan, transport)


def execute_packet_plan(run_dir: Path, architecture: dict, plan: dict, transport=http_json) -> dict:
    content_key = "scenes" if plan["packet_kind"] == "literary" else "endings"
    slot_key = "scene_slot_ids" if plan["packet_kind"] == "literary" else "ending_slot_ids"
    chunks = packet_chunks(run_dir, plan["packet_slot_id"])
    filled = {item["technical_slot_id"] for chunk in chunks for item in chunk[content_key]}
    obligations_done = {item for chunk in chunks for item in chunk["obligations_advanced"]}
    remaining = plan | {
        slot_key: [slot for slot in plan[slot_key] if slot not in filled],
        "artifact_count": plan["artifact_count"] - sum(len(chunk["artifacts"]) for chunk in chunks),
        "formal_composition_count": plan["formal_composition_count"] - sum(len(chunk["formal_compositions"]) for chunk in chunks),
        "advance_obligation_ids": [item for item in plan["advance_obligation_ids"] if item not in obligations_done],
        "may_satisfy_obligation_ids": [item for item in plan["may_satisfy_obligation_ids"] if item not in obligations_done],
    }
    if remaining[slot_key]:
        request_packet_slice(run_dir, architecture, remaining, transport)
    packet = assembled_packet(run_dir, plan["packet_slot_id"])
    if not packet:
        raise IntegrityError(f"Packet {plan['packet_slot_id']} did not complete after its final chunk")
    return packet


def execute_creative_phases(run_dir: Path, output_fn=print, transport=http_json) -> None:
    verify_engine_snapshot(run_dir)
    ensure_frozen_geomancy(run_dir)
    output_fn("[03] Genesis                       …")
    if not committed_record(run_dir, "genesis_foundation"):
        prompt, context = genesis_foundation_prompt(run_dir)
        request_bounded_record(
            run_dir,
            expected_record_type="genesis_foundation",
            step_id="genesis_foundation",
            phase="genesis",
            prompt=prompt,
            context=context,
            branch_relation="generated_root_foundation",
            temperature=0.8,
            transport=transport,
            precommit_validator=lambda record: validate_genesis_foundation(record, run_dir),
        )
    if not committed_record(run_dir, "genesis_cast"):
        prompt, context = genesis_cast_prompt(run_dir)
        request_bounded_record(
            run_dir,
            expected_record_type="genesis_cast",
            step_id="genesis_cast",
            phase="genesis",
            prompt=prompt,
            context=context,
            branch_relation="generated_root_cast",
            temperature=0.8,
            transport=transport,
            precommit_validator=lambda record: validate_genesis_cast(record, run_dir),
        )
    if not committed_record(run_dir, "genesis_constraints"):
        prompt, context = genesis_constraints_prompt(run_dir)
        request_bounded_record(
            run_dir,
            expected_record_type="genesis_constraints",
            step_id="genesis_constraints",
            phase="genesis",
            prompt=prompt,
            context=context,
            branch_relation="generated_root_constraints",
            temperature=0.4,
            transport=transport,
            precommit_validator=lambda record: validate_genesis_constraints(record, run_dir),
        )
    output_fn("[03] Genesis                       ✓ committed (3 bounded records)")
    output_fn("[04] Architecture                  …")
    if not committed_record(run_dir, "architecture_core"):
        prompt, context = architecture_core_prompt(run_dir)
        request_bounded_record(
            run_dir,
            expected_record_type="architecture_core",
            step_id="architecture_core",
            phase="architecture",
            prompt=prompt,
            context=context,
            branch_relation="macroarchitecture",
            temperature=0.7,
            transport=transport,
            precommit_validator=lambda record: validate_architecture_core_for_run(record, run_dir),
        )
    core = committed_record(run_dir, "architecture_core")
    batches = plan_batches(core)
    for sequence, specs in enumerate(batches, 1):
        if any(item["batch_sequence"] == sequence for item in committed_records(run_dir, "architecture_plan_batch")):
            continue
        prompt, context = architecture_plan_prompt(run_dir, specs, sequence, len(batches))
        request_bounded_record(
            run_dir,
            expected_record_type="architecture_plan_batch",
            step_id=f"architecture_plan_batch_{sequence:04d}",
            phase="architecture",
            prompt=prompt,
            context=context,
            branch_relation="macroarchitecture_plan_batch",
            temperature=0.65,
            transport=transport,
            precommit_validator=lambda record, frozen_specs=specs, frozen_sequence=sequence: validate_architecture_plan_batch(
                record, run_dir, frozen_specs, frozen_sequence, len(batches)
            ),
        )
    validate_completed_architecture(run_dir)
    output_fn(f"[04] Architecture                  ✓ committed ({len(batches)} bounded plan batches)")
    architecture = committed_record(run_dir, "architecture")
    plans = architecture["packet_plans"]
    while True:
        committed_slots = completed_packet_slots(architecture, all_committed_records(run_dir))
        pending = [plan for plan in plans if plan["packet_slot_id"] not in committed_slots]
        if not pending:
            break
        plan = select_next_packet(run_dir, architecture)
        if plan is None:
            feasibility = {
                item["attractor_id"]: item["status"]
                for item in _read_state_map(run_dir, "prospective-plan.json").get("feasibility", [])
            }
            if all(
                item["packet_kind"] == "ending"
                and all(feasibility.get(attractor) == "foreclosed" for attractor in item["attractor_ids"])
                for item in pending
            ):
                break
            raise CathedralsError("Prospective planning", "No lawful packet remains while required work is still active.", "continuity_impossibility")
        completed_kind = sum(
            item["packet_kind"] == plan["packet_kind"] and item["packet_slot_id"] in committed_slots
            for item in plans
        )
        total_kind = sum(item["packet_kind"] == plan["packet_kind"] for item in plans)
        label = f"{'Literary' if plan['packet_kind'] == 'literary' else 'Ending'} packet {completed_kind + 1:02d}/{total_kind:02d}"
        missing = [dependency for dependency in plan["depends_on_packet_slot_ids"] if not committed_record(run_dir, "creative_packet", dependency)]
        if missing:
            raise CathedralsError("Traversal", f"{plan['packet_slot_id']} has uncommitted dependencies: {', '.join(missing)}", "continuity_impossibility")
        output_fn(f"      {label:<31} …")
        counts = execute_packet_plan(run_dir, architecture, plan, transport)
        output_fn(f"      {label:<31} ✓ committed ({len(counts['scenes'])} scenes, {len(counts['artifacts'])} artifacts, {len(counts['endings'])} endings)")


def literary_word_count(value: str) -> int:
    return len(re.findall(r"\b[\w’'-]+\b", value, flags=re.UNICODE))


def packet_literary_word_count(record: dict) -> int:
    return sum(literary_word_count(item["prose_mdx"]) for item in record["scenes"] + record["endings"]) + sum(
        literary_word_count(item["body_mdx"]) for item in record["artifacts"]
    )


HTML_TAG = re.compile(
    r"<!--.*?-->|<!DOCTYPE\s[^>]*>|<\s*/?\s*[A-Za-z][A-Za-z0-9-]*(?:\s[^<>]*|/[^<>]*)?>",
    re.DOTALL | re.IGNORECASE,
)


def validate_markdown_source(value: str, label: str) -> None:
    if HTML_TAG.search(value) or re.search(r"(^|\n)\s*(import|export)\b", value, re.IGNORECASE):
        raise SchemaError(f"{label} contains authored HTML or executable MDX; literary source must be Markdown only")


def _rgb(value: str) -> tuple[float, float, float]:
    if not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise SchemaError(f"Invalid art-direction color: {value!r}")
    channels = [int(value[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    return tuple(channel / 12.92 if channel <= 0.04045 else ((channel + 0.055) / 1.055) ** 2.4 for channel in channels)


def contrast_ratio(left: str, right: str) -> float:
    first, second = sorted((sum(weight * channel for weight, channel in zip((0.2126, 0.7152, 0.0722), _rgb(value))) for value in (left, right)), reverse=True)
    return (first + 0.05) / (second + 0.05)


def _mix_hex(first: str, second: str, first_weight: float) -> str:
    channels = [
        round(int(first[index:index + 2], 16) * first_weight + int(second[index:index + 2], 16) * (1 - first_weight))
        for index in (1, 3, 5)
    ]
    return "#" + "".join(f"{channel:02x}" for channel in channels)


def _force_contrast(foreground: str, backgrounds: tuple[str, ...], minimum: float) -> str:
    for step in range(101):
        candidate = _mix_hex(foreground, "#000000", 1 - step / 100)
        if all(contrast_ratio(candidate, background) >= minimum for background in backgrounds):
            return candidate
    return "#000000"


def light_art_direction_palette(direction: dict) -> dict[str, str]:
    palette = direction["palette"]
    background = _mix_hex(palette["background"], "#ffffff", 0.08)
    surface = _mix_hex(palette["surface"], "#ffffff", 0.05)
    backgrounds = (background, surface)
    return {
        "background": background,
        "surface": surface,
        "text": _force_contrast(palette["text"], backgrounds, 4.5),
        "muted": _force_contrast(palette["muted"], backgrounds, 4.5),
        "accent": _force_contrast(palette["accent"], backgrounds, 3.0),
        "danger": _force_contrast(palette["danger"], backgrounds, 3.0),
    }


def validate_art_direction(direction: dict) -> None:
    palette = direction["palette"]
    for foreground, background, minimum in (
        ("text", "background", 4.5),
        ("text", "surface", 4.5),
        ("muted", "background", 4.5),
        ("muted", "surface", 4.5),
        ("accent", "background", 3.0),
        ("accent", "surface", 3.0),
        ("danger", "background", 3.0),
        ("danger", "surface", 3.0),
    ):
        if contrast_ratio(palette[foreground], palette[background]) < minimum:
            raise SchemaError(f"Web art direction fails contrast: {foreground} on {background} must be at least {minimum}:1")


def accessible_art_direction_palette(direction: dict) -> dict[str, str]:
    palette = direction["palette"]
    backgrounds = (palette["background"], palette["surface"])

    return {
        "background": palette["background"],
        "surface": palette["surface"],
        "text": _force_contrast(palette["text"], backgrounds, 4.5),
        "muted": _force_contrast(palette["muted"], backgrounds, 4.5),
        "accent": _force_contrast(palette["accent"], backgrounds, 3.0),
        "danger": _force_contrast(palette["danger"], backgrounds, 3.0),
    }


