def definition_schema(definition_name: str, protocol=None):
    protocol = protocol or load_protocol()
    needed = {definition_name}
    queue = [definition_name]
    while queue:
        definition = protocol["$defs"][queue.pop()]
        for node in _walk(definition):
            ref = node.get("$ref") if isinstance(node, dict) else None
            if ref and ref.startswith("#/$defs/"):
                name = ref.split("/")[2]
                if name not in needed:
                    needed.add(name)
                    queue.append(name)
    schema = dict(protocol["$defs"][definition_name])
    schema["$defs"] = {name: protocol["$defs"][name] for name in sorted(needed)}
    return schema


def _walk(value):
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from _walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from _walk(child)


def parse_scene_count(value: str) -> int:
    try:
        count = int(value.strip())
    except ValueError as error:
        raise ValueError("enter a positive whole number") from error
    if count <= 0:
        raise ValueError("enter a positive whole number")
    return count


def normalize_requested_format(value: str) -> str:
    normalized = re.sub(r"\s+", " ", value.strip().lower())
    if normalized not in FORMAT_ALIASES:
        raise ValueError("enter web or visualnovel")
    return FORMAT_ALIASES[normalized]


def collect_inputs(input_fn=input, output_fn=print) -> FrozenInputs:
    output_fn("Cathedrals\n")
    project_name = input_fn('Name of project (default "Cathedrals"):\n').strip() or "Cathedrals"
    genre = input_fn(
        'Story premise, setting, genre/flavor, and constraints (default "existential mystery"):\n'
    ).strip() or "existential mystery"
