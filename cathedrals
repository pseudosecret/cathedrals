def index_path(run_dir: Path) -> Path:
    return run_dir / "state/index.sqlite3"


@contextmanager
def index_connection(run_dir: Path):
    connection = None
    try:
        index_path(run_dir).parent.mkdir(parents=True, exist_ok=True)
        connection = sqlite3.connect(index_path(run_dir), timeout=5)
        connection.execute("PRAGMA foreign_keys=ON")
        with connection:
            yield connection
    except sqlite3.Error as error:
        raise PausedError("SQLite state", f"Database access failed; durable progress was preserved. Resume to verify and recover: {error}") from error
    finally:
        if connection is not None:
            connection.close()


def create_index_schema(db, state):
    db.executescript("""
        PRAGMA user_version=3;
        CREATE TABLE identity (generation_id TEXT NOT NULL, manifest_hash TEXT NOT NULL);
        CREATE TABLE checkpoint (
            id INTEGER PRIMARY KEY CHECK(id=1), ledger_sequence INTEGER NOT NULL DEFAULT 0,
            ledger_hash TEXT, canonical_hash TEXT NOT NULL, event_sequence INTEGER NOT NULL DEFAULT 0,
            creative_count INTEGER NOT NULL DEFAULT 0, analysis_count INTEGER NOT NULL DEFAULT 0,
            input_tokens INTEGER NOT NULL DEFAULT 0, output_tokens INTEGER NOT NULL DEFAULT 0);
        CREATE TABLE ledger (sequence INTEGER PRIMARY KEY, step_id TEXT NOT NULL, attempt INTEGER NOT NULL,
            step_type TEXT NOT NULL, status TEXT NOT NULL, failure_class TEXT NOT NULL,
            entry_hash TEXT NOT NULL UNIQUE, payload TEXT NOT NULL);
        CREATE INDEX ledger_step ON ledger(step_id, attempt);
        CREATE INDEX ledger_phase ON ledger(json_extract(payload,'$.step_phase'));
        CREATE UNIQUE INDEX committed_step ON ledger(step_id) WHERE status='COMMITTED';
        CREATE TABLE records (commit_id TEXT PRIMARY KEY, sequence INTEGER NOT NULL UNIQUE REFERENCES ledger(sequence),
            step_id TEXT NOT NULL UNIQUE, record_type TEXT NOT NULL, packet_slot_id TEXT,
            path TEXT NOT NULL, record_hash TEXT NOT NULL, payload TEXT NOT NULL);
        CREATE INDEX records_kind ON records(record_type, packet_slot_id, sequence);
        CREATE TABLE staged_items (step_id TEXT NOT NULL, revision TEXT NOT NULL, pointer TEXT NOT NULL,
            item_id TEXT NOT NULL, authority TEXT NOT NULL CHECK(authority='TENTATIVE PLAN'), payload TEXT NOT NULL,
            PRIMARY KEY(step_id,pointer));
        CREATE INDEX staged_item_id ON staged_items(item_id,step_id);
        CREATE TABLE sources (id TEXT PRIMARY KEY, commit_id TEXT NOT NULL REFERENCES records(commit_id), hash TEXT NOT NULL);
        CREATE TABLE events (sequence INTEGER PRIMARY KEY, id TEXT NOT NULL UNIQUE, kind TEXT NOT NULL, payload TEXT NOT NULL);
        CREATE INDEX events_kind ON events(kind, sequence);
        CREATE TABLE event_sources (event_sequence INTEGER NOT NULL REFERENCES events(sequence),
            source_id TEXT NOT NULL REFERENCES sources(id), commit_id TEXT NOT NULL, hash TEXT NOT NULL);
        CREATE INDEX event_source_id ON event_sources(source_id);
        CREATE TABLE projection (map TEXT NOT NULL, key TEXT NOT NULL, payload TEXT NOT NULL,
            position INTEGER NOT NULL, PRIMARY KEY(map, key));
        CREATE TABLE subjects (id TEXT PRIMARY KEY, position INTEGER NOT NULL);
        CREATE TABLE knowledge (subject TEXT NOT NULL REFERENCES subjects(id), relation TEXT NOT NULL,
            proposition TEXT NOT NULL, payload TEXT NOT NULL, position INTEGER NOT NULL, event_sequence INTEGER NOT NULL,
            PRIMARY KEY(subject, relation, proposition));
        CREATE INDEX knowledge_event ON knowledge(event_sequence);
        CREATE INDEX knowledge_proposition ON knowledge(proposition,subject);
        CREATE TABLE motif_history (sequence INTEGER PRIMARY KEY REFERENCES events(sequence),
            motif_id TEXT NOT NULL, event_id TEXT NOT NULL, sources TEXT NOT NULL);
        CREATE INDEX motif_lookup ON motif_history(motif_id,sequence);
        CREATE TABLE plans (sequence INTEGER PRIMARY KEY, plan_id TEXT NOT NULL UNIQUE,
            commit_id TEXT NOT NULL UNIQUE, payload TEXT NOT NULL);
        CREATE INDEX sources_commit ON sources(commit_id);
        CREATE TABLE event_relevance (event_sequence INTEGER NOT NULL REFERENCES events(sequence), key TEXT NOT NULL,
            value TEXT NOT NULL, PRIMARY KEY(event_sequence,key,value));
        CREATE INDEX relevance_lookup ON event_relevance(key,value,event_sequence);
        CREATE TABLE search_documents (id INTEGER PRIMARY KEY, commit_id TEXT NOT NULL REFERENCES records(commit_id),
            pointer TEXT NOT NULL, source_id TEXT NOT NULL, kind TEXT NOT NULL, sequence INTEGER NOT NULL,
            title TEXT NOT NULL, body TEXT NOT NULL, event_sequence INTEGER REFERENCES events(sequence), UNIQUE(commit_id,pointer));
        CREATE INDEX search_source ON search_documents(source_id,kind);
        CREATE INDEX search_event ON search_documents(event_sequence);
        CREATE TABLE search_tags (document_id INTEGER NOT NULL REFERENCES search_documents(id), key TEXT NOT NULL,
            value TEXT NOT NULL, PRIMARY KEY(document_id,key,value));
        CREATE INDEX search_tag_lookup ON search_tags(key,value,document_id);
        CREATE VIRTUAL TABLE search_fts USING fts5(title,body,content='search_documents',content_rowid='id',tokenize='unicode61');
    """)
    db.execute("INSERT INTO identity VALUES (?, ?)", (state["generation_id"], state["manifest_hash"]))
    db.execute("INSERT INTO checkpoint(id, canonical_hash) VALUES (1, ?)", (state["manifest_hash"],))


def ensure_index(run_dir: Path) -> None:
    if index_path(run_dir).exists():
        return
    if (run_dir / "run-manifest.json").exists() and (run_dir / "generation-brief.json").exists():
        reconcile_run(run_dir)
    else:
        # Small offline fixtures can initialize the same store without a generated-work archive.
        state = load_state(run_dir) if state_path(run_dir).exists() else {"generation_id": run_dir.name, "manifest_hash": ""}
        with index_connection(run_dir) as db:
            create_index_schema(db, state)


def index_checkpoint(run_dir: Path) -> dict:
    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        db.row_factory = sqlite3.Row
        return dict(db.execute("SELECT * FROM checkpoint WHERE id=1").fetchone())


def indexed_ledger(run_dir: Path, *, step_id=None, after=0) -> list[dict]:
    ensure_index(run_dir)
    query = "SELECT payload FROM ledger WHERE sequence>?"
    parameters = [after]
    if step_id is not None:
        query += " AND step_id=?"
        parameters.append(step_id)
    with index_connection(run_dir) as db:
        return [json.loads(row[0]) for row in db.execute(query + " ORDER BY sequence", parameters)]


def step_entries(run_dir: Path, step_id: str) -> list[dict]:
    if run_dir in _REPLAYING or not index_path(run_dir).exists():
        return [entry for entry in ledger_entries(run_dir) if entry["planned_step_id"] == step_id]
    return indexed_ledger(run_dir, step_id=step_id)


def refresh_run_counters(run_dir: Path, state=None) -> None:
    checkpoint = index_checkpoint(run_dir)
    state = load_state(run_dir) if state is None else state
    for target, source in (("ledger_sequence", "ledger_sequence"), ("canonical_state_hash", "canonical_hash"),
                           ("creative_step_count", "creative_count"), ("analysis_step_count", "analysis_count"),
                           ("input_tokens", "input_tokens"), ("output_tokens", "output_tokens")):
        state[target] = checkpoint[source]
    save_state(run_dir, state)


