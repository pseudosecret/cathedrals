def validate_complete_work(run_dir: Path) -> dict:
    reconcile_run(run_dir)
    manifest = read_json(run_dir / "run-manifest.json")
    architecture = committed_record(run_dir, "architecture")
    packets = [record for record in all_committed_records(run_dir) if record.get("record_type") == "creative_packet"]
    if not architecture:
        return {"result": "FAIL", "reasons": ["Architecture is absent."]}
    plans = architecture["packet_plans"]
    prospective = _read_state_map(run_dir, "prospective-plan.json")
    feasibility = {item["attractor_id"]: item["status"] for item in prospective.get("feasibility", [])}
    required_plans = [
        plan
        for plan in plans
        if plan["packet_kind"] == "literary"
        or all(feasibility.get(attractor) != "foreclosed" for attractor in plan["attractor_ids"])
    ]
    by_slot = {packet["packet_slot_id"]: packet for packet in packets}
    reasons = []
    warnings = []
    try:
        navigation_contract_route(architecture)
        validate_navigation_payload(run_dir, architecture, {}, {"scenes": [], "endings": []})
    except SchemaError as error:
        reasons.append(error.reason)

    def warn(code: str, message: str) -> None:
        warnings.append({"stage": "mechanical_validation", "code": code, "message": message})
    if set(by_slot) != {plan["packet_slot_id"] for plan in required_plans}:
        reasons.append("Committed packets do not match the current lawful plan after prospective foreclosure.")
    if any(status == "universally_required_but_impossible" for status in feasibility.values()):
        reasons.append("An ending attractor is universally impossible at completion.")
    elif any(status == "endangered" for status in feasibility.values()):
        warn("endangered_attractor", "An ending attractor remains endangered at completion.")
    scenes = [item for packet in packets for item in packet["scenes"]]
    artifacts = [item for packet in packets for item in packet["artifacts"]]
    endings = [item for packet in packets for item in packet["endings"]]
    compositions = [item for packet in packets for item in packet["formal_compositions"]]
    edges = [item for packet in packets for item in packet["decision_edges"]]
    commitment = architecture["scope_commitment"]
    actual_counts = {
        "scenes": len(scenes),
        "artifacts": len(artifacts),
        "endings": len(endings),
        "formal_compositions": len(compositions),
    }
    expected_counts = {
        "scenes": sum(len(plan["scene_slot_ids"]) for plan in required_plans),
        "artifacts": sum(plan["artifact_count"] for plan in required_plans),
        "endings": sum(len(plan["ending_slot_ids"]) for plan in required_plans),
        "formal_compositions": sum(plan["formal_composition_count"] for plan in required_plans),
    }
    if actual_counts != expected_counts:
        reasons.append(f"Projected content counts {actual_counts} do not match the lawful feasible envelope {expected_counts}.")
    if not endings:
        reasons.append("No viable ending attractor was realized.")
    if len(scenes) > manifest["scope"]["possible_scene_count"]:
        reasons.append("The work exceeds the user's possible-scene scope.")
    content_ids = {item["scene_id"] for item in scenes} | {item["ending_id"] for item in endings}
    try:
        resolved_edges, resolved_endings = resolve_cross_packet_links(scenes, endings, edges)
    except SchemaError as error:
        reasons.append(error.reason)
        resolved_edges, resolved_endings = [], []
    edge_by_id = {edge["edge_id"]: edge for edge in resolved_edges}
    edge_ids = set(edge_by_id)
    artifact_ids = {item["artifact_id"] for item in artifacts}
    for edge in edges:
        if edge["from_content_id"] not in content_ids:
            reasons.append(f"Decision edge {edge['edge_id']} points outside committed content.")
    for scene in scenes:
        if not set(scene["choice_edge_ids"]).issubset(edge_ids):
            reasons.append(f"Scene {scene['scene_id']} references an absent choice edge.")
        if not set(scene["artifact_ids"]).issubset(artifact_ids):
            reasons.append(f"Scene {scene['scene_id']} references an absent artifact.")
        if any(edge_by_id[edge_id]["from_content_id"] != scene["scene_id"] for edge_id in scene["choice_edge_ids"] if edge_id in edge_by_id):
            reasons.append(f"Scene {scene['scene_id']} claims an edge owned by different content.")
        if scene["major_decision"] and not scene["hesitation_consequence"]:
            warn("missing_hesitation_consequence", f"Major decision {scene['scene_id']} has no consequential hesitation.")
        try:
            validate_markdown_source(scene["prose_mdx"], f"Scene {scene['scene_id']}")
        except SchemaError:
            reasons.append(f"Scene {scene['scene_id']} contains unsafe generated Markdown.")
    for artifact in artifacts:
        if literary_word_count(artifact["body_mdx"]) > 350:
            warn("artifact_word_target", f"Artifact {artifact['artifact_id']} exceeds the 350-word target.")
        try:
            validate_markdown_source(artifact["body_mdx"], f"Artifact {artifact['artifact_id']}")
        except SchemaError:
            reasons.append(f"Artifact {artifact['artifact_id']} contains unsafe generated Markdown.")
    for ending in endings:
        if literary_word_count(ending["prose_mdx"]) > 500:
            warn("ending_word_target", f"Ending {ending['ending_id']} exceeds the 500-word target.")
        try:
            validate_markdown_source(ending["prose_mdx"], f"Ending {ending['ending_id']}")
        except SchemaError:
            reasons.append(f"Ending {ending['ending_id']} contains unsafe generated Markdown.")
    groups = {}
    for edge in edges:
        if edge["decision_group_id"] is not None:
            groups.setdefault(edge["decision_group_id"], []).append(edge)
    if any(not 2 <= len(group) <= 5 for group in groups.values()):
        warn("decision_group_shape", "A decision group does not contain two to five prebuilt choices.")
    ordered_scenes = sorted(scenes, key=lambda scene: scene["technical_slot_id"])
    playable_choice_count = lambda scene: sum(edge_by_id[edge_id]["availability"] == "playable" for edge_id in scene["choice_edge_ids"] if edge_id in edge_by_id)
    first_hub = next((index for index, scene in enumerate(ordered_scenes) if playable_choice_count(scene) >= 2), None)
    if not architecture.get("causal_scaffold") and (first_hub is None or not 3 <= first_hub <= 5):
        warn("opening_hub_shape", "The first live hub does not follow three to five scene surfaces.")
    elif not architecture.get("causal_scaffold") and playable_choice_count(ordered_scenes[first_hub]) != 3:
        warn("opening_hub_shape", "The first live hub does not expose exactly three choices.")
    if ordered_scenes:
        reachable = {ordered_scenes[0]["scene_id"]}
        changed = True
        while changed:
            changed = False
            for edge in resolved_edges:
                if edge["availability"] == "playable" and edge["from_content_id"] in reachable and edge["resolved_content_id"] not in reachable:
                    reachable.add(edge["resolved_content_id"])
                    changed = True
        missing_content = content_ids - reachable
        if not any(item["ending_id"] in reachable for item in endings):
            reasons.append("No committed ending is reachable from the opening through playable links.")
        if missing_content:
            warn("reachability_quality", f"Committed content is unreachable from the entry scene: {', '.join(sorted(missing_content)[:8])}.")
    if len({scene["branch_depth"] for scene in scenes}) < 2:
        warn("branch_depth_quality", "Branch depth is uniform rather than meaningfully unequal.")
    containers = content_ids | artifact_ids
    if any(item["container_id"] not in containers for item in compositions):
        reasons.append("A formal composition anchor container does not resolve.")
    geomancy = {item["technical_slot_id"]: item for item in ensure_frozen_geomancy(run_dir)["assignments"]}
    for scene in scenes:
        assignment = geomancy.get(scene["technical_slot_id"])
        if not assignment or scene["threshold_figure"] != assignment["figure"] or scene["threshold_resultant"] != assignment["resultant"]:
            reasons.append(f"Scene {scene['scene_id']} does not preserve frozen threshold geomancy.")
    obligation_state = _read_state_map(run_dir, "obligations.json")
    architecture_obligations = {item["obligation_id"] for item in architecture["obligation_graph"]}
    if not architecture_obligations.issubset(obligation_state):
        reasons.append("An architectural obligation silently disappeared from derived state.")
    obligation_graph = {
        key: value["data"]["requires"] for key, value in obligation_state.items()
    }
    if any(not set(dependencies).issubset(obligation_state) for dependencies in obligation_graph.values()):
        reasons.append("The obligation graph contains an unresolved reference.")
    visiting = set()
    visited = set()

    def visit_obligation(identifier: str) -> bool:
        if identifier in visiting:
            return False
        if identifier in visited:
            return True
        visiting.add(identifier)
        valid = all(visit_obligation(item) for item in obligation_graph.get(identifier, []))
        visiting.remove(identifier)
        visited.add(identifier)
        return valid

    if not all(visit_obligation(identifier) for identifier in obligation_graph):
        reasons.append("The obligation graph contains a circular dependency.")
    for identifier, event in obligation_state.items():
        obligation = event["data"]
        status = obligation["status"]
        if status == "active":
            warn("residual_obligation", f"Future obligation {identifier} remained active without deliberate resolution.")
        if obligation["hardness"] == "hard" and obligation["universality"] == "universal" and status in {"foreclosed", "impossible"}:
            reasons.append(f"Universal hard obligation {identifier} was unlawfully discarded.")
        if status in {"satisfied", "foreclosed", "impossible", "intentionally_unresolved"} and "resolution_event" not in event:
            reasons.append(f"Resolved obligation {identifier} lacks an append-only evidence event.")
        if status == "impossible" and not any(
            feasibility.get(target) == "foreclosed" for target in obligation["termination_targets"]
        ):
            reasons.append(f"Impossible obligation {identifier} is not scoped to a lawfully foreclosed future.")
    source_index = _source_index(run_dir)
    known_propositions = historical_fact_ids(run_dir)
    constraint_path = run_dir / "constraints/constraint-events.jsonl"
    constraint_events = [json.loads(line) for line in constraint_path.read_text(encoding="utf-8").splitlines()] if constraint_path.exists() else []
    for event in constraint_events:
        if event["constraint_kind"] == "knowledge_state" and event["data"]["proposition_id"] not in known_propositions:
            reasons.append(f"Knowledge constraint {event['constraint_id']} references an unknown proposition.")
        for source in event["sources"]:
            resolved = source_index.get(source["artifact_id"])
            if not resolved or resolved["commit_id"] != source["source_commit_id"] or resolved["hash"] != source["source_hash"]:
                reasons.append(f"Constraint {event['constraint_id']} lost immutable source provenance.")
    motifs = _read_state_map(run_dir, "motifs.json")
    if any(not item.get("provenance") or not item.get("appearances") for item in motifs.values()):
        reasons.append("Motif pressure state lost occurrence provenance.")
    attractors = {item["attractor_id"]: item for item in architecture["attractors"]}
    for ending in endings:
        attractor = attractors[ending["attractor_id"]]
        if any(obligation_state[item]["data"]["status"] != "satisfied" for item in attractor["prerequisite_obligation_ids"]):
            reasons.append(f"Ending {ending['ending_id']} committed without a satisfied hard prerequisite.")
        satisfaction_sources = {
            source["artifact_id"]
            for item in attractor["prerequisite_obligation_ids"]
            for source in obligation_state[item].get("resolution_event", {}).get("sources", [])
        }
        if not satisfaction_sources.issubset(ending["prerequisite_evidence_source_ids"]):
            reasons.append(f"Ending {ending['ending_id']} does not cite its prerequisite satisfaction evidence.")
    state = load_state(run_dir)
    if state["creative_step_count"] > manifest["budgets"]["max_creative_step_count"]:
        reasons.append("Creative-step budget was exceeded.")
    if state["analysis_step_count"] > manifest["budgets"]["max_analysis_step_count"]:
        reasons.append("Analysis-step budget was exceeded.")
    if state["input_tokens"] > manifest["budgets"]["max_cumulative_input_tokens"] or state["output_tokens"] > manifest["budgets"]["max_cumulative_output_tokens"]:
        reasons.append("Cumulative token budget was exceeded.")
    if len(constraint_events) > manifest["budgets"]["max_constraint_events"]:
        reasons.append("Constraint-event capacity was exceeded.")
    if prospective and prospective["based_on_canonical_state_hash"] != state["canonical_state_hash"]:
        reasons.append("The mutable prospective plan is not based on current immutable canon.")
    total_words = sum(packet_literary_word_count(packet) for packet in packets)
    if total_words > manifest["budgets"]["max_total_literary_words"]:
        reasons.append("Total literary-word budget was exceeded.")
    project = run_dir / "projection/web"
    for scene in scenes:
        source = project / "public/source" / f"{scene['scene_id']}.md"
        if not source.exists() or source.read_bytes() != scene["prose_mdx"].encode():
            reasons.append(f"Projection changed immutable scene source {scene['scene_id']}.")
    for artifact in artifacts:
        source = project / "public/source" / f"{artifact['artifact_id']}.md"
        if not source.exists() or source.read_bytes() != artifact["body_mdx"].encode():
            reasons.append(f"Projection changed immutable artifact source {artifact['artifact_id']}.")
    for ending in endings:
        source = project / "public/source" / f"{ending['ending_id']}.md"
        if not source.exists() or source.read_bytes() != ending["prose_mdx"].encode():
            reasons.append(f"Projection changed immutable ending source {ending['ending_id']}.")
    if any(state[name] != 0 for name in ("human_intervention_count", "committed_rewrite_count", "committed_regeneration_count", "backtrack_count")):
        reasons.append("An irreversibility counter is nonzero.")
    verdict = {"result": "FAIL" if reasons else "PASS", "reasons": reasons or ["All committed records, counts, references, budgets, and complete-work constraints are mechanically valid."]}
    write_json(run_dir / "validation/mechanical.json", verdict)
    write_json(run_dir / "validation/warnings.json", warnings)
    append_deterministic_step(run_dir, "mechanical_validation", "validation", sha256_bytes(canonical_json(verdict)))
    return verdict


