        "ledger_sequence": 0,
        "canonical_state_hash": manifest_hash,
        "creative_step_count": 0,
        "analysis_step_count": 0,
        "human_intervention_count": 0,
        "committed_rewrite_count": 0,
        "committed_regeneration_count": 0,
        "backtrack_count": 0,
        "input_tokens": 0,
        "output_tokens": 0,
        "cost": None,
        "model": model,
        "started_at": utc_now(),
        "resume_declined": False,
    }


def state_path(run_dir: Path) -> Path:
    return run_dir / "state/run-state.json"


def load_state(run_dir: Path) -> dict:
    return read_json(state_path(run_dir))


def save_state(run_dir: Path, state: dict) -> None:
    write_json(state_path(run_dir), state)


def ledger_entries(run_dir: Path) -> list[dict]:
    path = run_dir / "ledger.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def compute_entry_hash(entry: dict) -> str:
    payload = dict(entry)
    payload.pop("entry_hash", None)
    return sha256_bytes(canonical_json(payload))


def append_ledger_entry(run_dir: Path, entry: dict) -> None:
    protocol = load_protocol(run_dir)
    validate_json_schema(entry, protocol["$defs"]["ledgerEntry"], protocol)
    entries = ledger_entries(run_dir)
    expected_sequence = len(entries) + 1
    expected_previous = entries[-1]["entry_hash"] if entries else None
    if entry["ledger_sequence"] != expected_sequence or entry["previous_entry_hash"] != expected_previous:
        raise IntegrityError("Ledger sequence or previous-entry hash is invalid")
    if compute_entry_hash(entry) != entry["entry_hash"]:
        raise IntegrityError("Ledger entry hash is invalid")
    path = run_dir / "ledger.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("ab") as handle:
        handle.write(canonical_json(entry))
        handle.flush()
        os.fsync(handle.fileno())


def new_ledger_entry(
    run_dir: Path,
    *,
    planned_step_id: str,
    attempt: int,
    step_type: str,
    step_phase: str,
    parent_state_hash: str,
    prompt_hash: str | None,
    context_hash: str | None,
    provider: str | None,
    model: str | None,
    parameters: dict | None,
    seed: str | None,
    started_at: str,
    output_hash: str | None,
    generated_ids: list[str],
    past_constraint_ids: list[str],
    future_obligation_ids: list[str],
    motif_ids: list[str],
    prospective_plan_hash: str | None = None,
    branch_relation: str | None,
    commit_status: str,
    state_hash_after: str,
    failure_class: str,
    usage: dict | None = None,
) -> dict:
    entries = ledger_entries(run_dir)
    usage = usage or {}
    entry = {
        "record_type": "ledger_entry",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": load_state(run_dir)["generation_id"],
        "ledger_sequence": len(entries) + 1,
        "planned_step_id": planned_step_id,
        "attempt": attempt,
        "step_type": step_type,
        "step_phase": step_phase,
        "previous_entry_hash": entries[-1]["entry_hash"] if entries else None,
        "entry_hash": "0" * 64,
        "parent_canonical_state_hash": parent_state_hash,
        "prompt_hash": prompt_hash,
        "context_hash": context_hash,
        "provider": provider,
        "model": model,
        "parameters": parameters,
        "seed": seed,
        "started_at": started_at,
        "completed_at": utc_now(),
        "output_hash": output_hash,
        "generated_artifact_ids": sorted(set(generated_ids)),
        "past_constraint_delta_ids": sorted(set(past_constraint_ids)),
        "future_obligation_delta_ids": sorted(set(future_obligation_ids)),
        "motif_pressure_delta_ids": sorted(set(motif_ids)),
        "prospective_plan_hash_after": prospective_plan_hash,
        "branch_path_relation": branch_relation,
        "commit_status": commit_status,
        "canonical_state_hash_after": state_hash_after,
        "failure_class": failure_class,
        "token_accounting": {
            "input_tokens": usage.get("prompt_tokens"),
            "output_tokens": usage.get("completion_tokens"),
            "cost": usage.get("cost"),
            "currency": usage.get("currency"),
        },
    }
    entry["entry_hash"] = compute_entry_hash(entry)
    return entry


def append_deterministic_step(
    run_dir: Path,
    step_id: str,
    phase: str,
    output_hash: str,
    *,
    prospective_plan_hash: str | None = None,
) -> None:
    if step_is_committed(run_dir, step_id):
        return
    state = load_state(run_dir)
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=step_id,
        attempt=1,
        step_type="deterministic",
        step_phase=phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=None,
        context_hash=None,
        provider=None,
        model=None,
        parameters=None,
        seed=None,
        started_at=utc_now(),
        output_hash=output_hash,
        generated_ids=[],
        past_constraint_ids=[],
        future_obligation_ids=[],
        motif_ids=[],
        prospective_plan_hash=prospective_plan_hash,
        branch_relation=None,
        commit_status="COMMITTED",
        state_hash_after=state["canonical_state_hash"],
        failure_class="none",
    )
    append_ledger_entry(run_dir, entry)
    state["ledger_sequence"] = entry["ledger_sequence"]
    save_state(run_dir, state)


def create_run(
    frozen: FrozenInputs,
    base_url: str,
    model: str,
    output_fn=print,
    model_context_window_tokens: int = 64148,
) -> Path:
    identifier = generation_id(frozen.project_name)
    ensure_runtime_layout()
    run_dir = RUNS_ROOT / identifier
    for child in ("raw", "committed", "constraints", "planning", "state", "logs", "validation", ".staging"):
        (run_dir / child).mkdir(parents=True, exist_ok=False)
    copy_engine_snapshot(run_dir)
    timestamp = utc_now()
    seed = secrets.token_hex(16)
    brief = dataclasses.asdict(frozen) | {
        "generation_id": identifier,
        "generation_timestamp": timestamp,
        "lm_studio_base_url": base_url,
        "model": model,
        "generation_seed": seed,
    }
    brief_hash = sha256_bytes(canonical_json(brief))
    derived = derive_scope(frozen.possible_scene_count)
    derived["budgets"]["model_context_window_tokens"] = model_context_window_tokens
    manifest = {
        "record_type": "run_manifest",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": identifier,
        "created_at": timestamp,
        "generation_brief": brief,
        "generation_brief_hash": brief_hash,
        "engine_snapshot": {
            "work_id": "hospice-annex-v01",
            "path": "engine-snapshot",
            "work_seed": seed,
            "structural_seed": sha256_bytes(f"structure:{seed}".encode()),
            "geomancy_seed": sha256_bytes(f"geomancy:{seed}".encode()),
        },
        "generation_run": {
            "human_creative_interventions_required": 0,
            "committed_creative_rewrites_allowed": False,
            "committed_creative_regeneration_allowed": False,
            "backward_canon_mutation_allowed": False,
            "candidate_cherry_picking_allowed": False,
            "append_only": True,
            "creative_authorship_forward_only": True,
            "planning_may_reason_backward": True,
        },
        "scope": derived["scope"],
        "budgets": derived["budgets"],
        "traversal": {
            "strategy": "constraint_relevance",
            "seed": sha256_bytes(f"traversal:{seed}".encode()),
            "prospective_plan_mutable": True,
        },
        "models": [
            {"purpose": purpose, "provider": "LM Studio", "model": model, "parameters": {"structured_output": True}}
            for purpose in ("creative", "analysis", "artistic_acceptance")
        ],
        "retention_policy": "preserve_failed",
        "complete_work_barrier": {
            "partial_play_allowed": False,
            "runtime_generation_allowed": False,
            "playable_status": "READY_TO_PLAY",
        },
    }
    protocol = load_protocol(run_dir)
    validate_json_schema(manifest, protocol["$defs"]["runManifest"], protocol)
    manifest_hash = sha256_bytes(canonical_json(manifest))
    write_json(run_dir / "generation-brief.json", brief, mode=0o444, exclusive=True)
    write_json(run_dir / "run-manifest.json", manifest, mode=0o444, exclusive=True)
    frozen_context = run_dir / "state/frozen-engine-context.txt"
    write_atomic(frozen_context, engine_context(run_dir).encode(), mode=0o444, exclusive=True)
    run_state = initial_run_state(identifier, brief_hash, manifest_hash, model)
    run_state["model_context_window_tokens"] = model_context_window_tokens
    save_state(run_dir, run_state)
    append_deterministic_step(run_dir, "preflight", "preflight", brief_hash)
    append_deterministic_step(run_dir, "engine_snapshot", "engine_snapshot", manifest_hash)
    output_fn(f"Generation: {identifier}")
    output_fn("Format: web")
    output_fn(f"Model: {model}")
    output_fn(f"Requested scope: up to {frozen.possible_scene_count} scenes\n")
    output_fn(
        f"Derived safeguards: up to {derived['budgets']['max_creative_step_count']} creative steps, "
        f"{derived['budgets']['max_total_literary_words']:,} literary words, and "
        f"{derived['budgets']['max_cumulative_output_tokens']:,} cumulative output tokens.\n"
    )
    return run_dir


def incomplete_runs() -> list[Path]:
    if not RUNS_ROOT.exists():
        return []
    candidates = []
    for run_dir in RUNS_ROOT.iterdir():
        path = state_path(run_dir)
        if not path.exists():
            continue
        state = read_json(path)
        if state.get("status") not in TERMINAL_STATES and not state.get("resume_declined"):
            candidates.append(run_dir)
    return sorted(candidates, key=lambda path: path.stat().st_mtime, reverse=True)


def choose_resume(input_fn=input, output_fn=print) -> Path | None:
    candidates = incomplete_runs()
    if not candidates:
        return None
    run_dir = candidates[0]
    output_fn(f"Incomplete generation detected:\n{run_dir.name}\n")
    answer = input_fn("Resume it? [Y/n] ").strip().lower()
    if answer in {"", "y", "yes"}:
        return run_dir
    state = load_state(run_dir)
    state["resume_declined"] = True
    save_state(run_dir, state)
    return None


def generated_ids(record: dict) -> list[str]:
    ids = [record.get("commit_id")]
    if record.get("record_type") == "genesis_foundation":
        ids += [record["work_canon"]["work_id"]]
        ids += [item["event_id"] for item in record["work_canon"]["chronology"]]
        ids += [item["claimant_id"] for item in record["claimant_anchors"]]
    if record.get("record_type") == "genesis_cast":
        ids += [item["claimant_id"] for item in record["claimants"]]
        ids += [item["character_id"] for item in record["characters"]]
    if record.get("record_type") == "architecture_core":
        ids += [item["arc_id"] for item in record["arcs"]]
        ids += [item["node_id"] for item in record["topology"]["nodes"]]
        ids += [item["edge_id"] for item in record["topology"]["edges"]]
        ids += [item["obligation_id"] for item in record["obligation_graph"]]
        ids += [item["attractor_id"] for item in record["attractors"]]
    if record.get("record_type") == "architecture_plan_batch":
        ids += [item["packet_slot_id"] for item in record["packet_plans"]]
    if record.get("record_type") == "creative_packet":
        ids += [item["scene_id"] for item in record["scenes"]]
        ids += [item["artifact_id"] for item in record["artifacts"]]
        ids += [item["ending_id"] for item in record["endings"]]
        ids += [item["composition_id"] for item in record["formal_compositions"]]
        ids += [item["edge_id"] for item in record["decision_edges"]]
    delta = record.get("constraint_delta", {})
    ids += [item["fact_id"] for item in delta.get("canonical_facts", [])]
    ids += [item["knowledge_id"] for item in delta.get("knowledge_changes", [])]
    ids += [item["obligation_id"] for item in delta.get("new_obligations", [])]
    ids += [item["update_id"] for item in delta.get("obligation_updates", [])]
    ids += [item["motif_event_id"] for item in delta.get("motif_events", [])]
    ids += [item["foreclosure_id"] for item in delta.get("potential_foreclosures", [])]
    return sorted({item for item in ids if item})


def reused_generated_ids(run_dir: Path, record: dict) -> set[str]:
    duplicates = set(generated_ids(record)) & set(_source_index(run_dir))
    if record.get("record_type") == "genesis_cast":
        foundation = committed_record(run_dir, "genesis_foundation")
        if foundation:
            duplicates -= {item["claimant_id"] for item in foundation["claimant_anchors"]}
    return duplicates


def constraint_deltas(record: dict) -> tuple[dict, list[str], list[str], list[str]]:
    delta = record.get("constraint_delta", {})
    groups = {
        "canonical_facts": list(delta.get("canonical_facts", [])),
        "knowledge_changes": list(delta.get("knowledge_changes", [])),
        "new_obligations": list(delta.get("new_obligations", [])),
        "obligation_updates": list(delta.get("obligation_updates", [])),
        "motif_events": list(delta.get("motif_events", [])),
        "potential_foreclosures": list(delta.get("potential_foreclosures", [])),
    }
    if record.get("record_type") == "architecture_core":
        groups["new_obligations"] = list(record["obligation_graph"]) + groups["new_obligations"]
    past = [item["fact_id"] for item in groups["canonical_facts"]]
    past += [item["knowledge_id"] for item in groups["knowledge_changes"]]
    future = [item["obligation_id"] for item in groups["new_obligations"]]
    future += [item["update_id"] for item in groups["obligation_updates"]]
    future += [item["foreclosure_id"] for item in groups["potential_foreclosures"]]
    motifs = [item["motif_event_id"] for item in groups["motif_events"]]
    return groups, past, future, motifs


def _source_index(run_dir: Path) -> dict:
    path = run_dir / "state/source-index.json"
    return read_json(path) if path.exists() else {}


def make_constraint_events(run_dir: Path, record: dict, commit_id: str, record_hash: str, step_id: str) -> list[dict]:
    groups, _, _, _ = constraint_deltas(record)
    source_index = _source_index(run_dir)
    for identifier in generated_ids(record):
        source_index[identifier] = {"commit_id": commit_id, "hash": record_hash}
    current_events = run_dir / "constraints/constraint-events.jsonl"
    sequence = len(current_events.read_text(encoding="utf-8").splitlines()) if current_events.exists() else 0
    protocol = load_protocol(run_dir)
    events = []
    definitions = (
        ("canonical_facts", "past_constraint", "canonical_fact", "fact_id", "sources"),
        ("knowledge_changes", "past_constraint", "knowledge_state", "knowledge_id", "sources"),
        ("new_obligations", "future_obligation", "obligation", "obligation_id", "sources"),
        ("obligation_updates", "future_obligation", "obligation_update", "update_id", "evidence_sources"),
        ("motif_events", "motif_pressure", "motif_state", "motif_event_id", "sources"),
        ("potential_foreclosures", "prospective_foreclosure", "foreclosure_candidate", "foreclosure_id", "sources"),
    )
    for group, constraint_class, constraint_kind, id_key, source_key in definitions:
      for item in groups[group]:
        sources = []
        for source in item[source_key]:
            resolved = source_index.get(source["artifact_id"])
            if not resolved:
                raise SchemaError(f"Constraint source does not resolve: {source['artifact_id']}")
            sources.append(
                source
                | {
                    "source_commit_id": resolved["commit_id"],
                    "source_hash": resolved["hash"],
                }
            )
        action = item.get("action", "establish")
        if constraint_kind == "obligation_update":
            action = {
                "satisfied": "satisfy",
                "foreclosed": "foreclose",
                "impossible": "mark_impossible",
                "intentionally_unresolved": "resolve_ambiguously",
            }[item["status"]]
        elif constraint_kind == "motif_state":
            action = "establish" if item["action"] == "establish" else "update"
        event = {
            "record_type": "constraint_event",
            "protocol_version": PROTOCOL_VERSION,
            "generation_id": record["generation_id"],
            "constraint_event_sequence": sequence + len(events) + 1,
            "origin_step_id": step_id,
            "constraint_id": item[id_key],
            "constraint_class": constraint_class,
            "constraint_kind": constraint_kind,
            "action": action,
            "data": {key: value for key, value in item.items() if key != source_key},
            "sources": sources,
        }
        validate_json_schema(event, protocol["$defs"]["constraintEvent"], protocol)
        events.append(event)
    return events


def project_constraint_state(events: list[dict]) -> tuple[dict, dict, dict, dict, dict]:
    facts = {}
    knowledge = {}
    obligations = {}
    motifs = {}
    foreclosures = {}
    for event in events:
        data = event["data"]
        kind = event["constraint_kind"]
        if kind == "canonical_fact":
            if data.get("supersedes_fact_id"):
                facts.pop(data["supersedes_fact_id"], None)
            facts[data["fact_id"]] = event
        elif kind == "knowledge_state":
            subject = knowledge.setdefault(data["subject_id"], {name: {} for name in ("knows", "believes", "suspects", "explicitly_does_not_know", "claims")})
            target = subject[data["relation"]]
            if data["action"] == "retract":
                target.pop(data["proposition_id"], None)
            else:
                target[data["proposition_id"]] = event
        elif kind == "obligation":
            obligations[data["obligation_id"]] = event
        elif kind == "obligation_update":
            obligation = obligations.get(data["obligation_id"])
            if not obligation:
                raise IntegrityError(f"Obligation update references unknown obligation: {data['obligation_id']}")
            obligation = json.loads(json.dumps(obligation))
            obligation["data"]["status"] = data["status"]
            obligation["resolution_event"] = event
            obligations[data["obligation_id"]] = obligation
        elif kind == "motif_state":
            motif = motifs.setdefault(data["motif_id"], {"motif_id": data["motif_id"], "appearances": [], "provenance": []})
            motif["appearances"].extend(source["artifact_id"] for source in event["sources"])
            motif["current_function"] = data["current_function"]
            motif["pressure"] = data["pressure"]
            motif["overuse_risk"] = data["overuse_risk"]
            motif["provenance"].append(event["constraint_id"])
        elif kind == "foreclosure_candidate":
            foreclosures[event["constraint_id"]] = event
    return facts, knowledge, obligations, motifs, foreclosures


def committed_directories(run_dir: Path) -> list[Path]:
    return sorted(path for path in (run_dir / "committed").iterdir() if path.is_dir())


def verify_immutable_file(path: Path, expected_hash: str) -> None:
    if not path.exists() or sha256_file(path) != expected_hash:
        raise IntegrityError(f"Committed file changed or disappeared: {path}")


def reconcile_run(run_dir: Path) -> None:
    state = load_state(run_dir)
    verify_engine_snapshot(run_dir)
    verify_immutable_file(run_dir / "generation-brief.json", state["brief_hash"])
    verify_immutable_file(run_dir / "run-manifest.json", state["manifest_hash"])
    entries = ledger_entries(run_dir)
    previous = None
    for index, entry in enumerate(entries, 1):
        if entry["ledger_sequence"] != index or entry["previous_entry_hash"] != previous:
            raise IntegrityError("Ledger order or hash chain was changed")
        if compute_entry_hash(entry) != entry["entry_hash"]:
            raise IntegrityError(f"Ledger entry {index} was changed")
        previous = entry["entry_hash"]
    prospective_history = run_dir / "planning/prospective-plans.jsonl"
    prospective_plans = [
        json.loads(line) for line in prospective_history.read_text(encoding="utf-8").splitlines()
    ] if prospective_history.exists() else []
    protocol = load_protocol(run_dir)
    for index, plan in enumerate(prospective_plans, 1):
        validate_json_schema(plan, protocol["$defs"]["prospectivePlan"], protocol)
        if plan["plan_id"] != f"prospective_plan_{index:04d}":
            raise IntegrityError("Prospective plan history was reordered or truncated")
        step_id = f"prospective_{sha256_bytes(plan['recomputed_after_commit_id'].encode())[:16]}"
        plan_hash = sha256_bytes(canonical_json(plan))
        match = next(
            (
                entry for entry in entries
                if entry["planned_step_id"] == step_id and entry["commit_status"] == "COMMITTED"
            ),
            None,
        )
        if not match:
            append_deterministic_step(
                run_dir,
                step_id,
                "prospective_plan",
                plan_hash,
                prospective_plan_hash=plan_hash,
            )
            entries = ledger_entries(run_dir)
            match = entries[-1]
        if match["output_hash"] != plan_hash or match["prospective_plan_hash_after"] != plan_hash:
            raise IntegrityError(f"Prospective plan audit hash changed: {plan['plan_id']}")
    if prospective_plans:
        write_json(run_dir / "state/prospective-plan.json", prospective_plans[-1])
    committed_steps = {}
    expected_constraints = []
    source_index = {}
    for directory in committed_directories(run_dir):
        meta = read_json(directory / "commit-meta.json")
        verify_immutable_file(directory / "record.json", meta["record_hash"])
        verify_immutable_file(directory / "raw-response.txt", meta["raw_response_hash"])
        verify_immutable_file(directory / "api-response.json", meta["api_response_hash"])
        step_id = meta["ledger_entry"]["planned_step_id"]
        if step_id in committed_steps:
            raise IntegrityError(f"Creative step committed more than once: {step_id}")
        committed_steps[step_id] = directory
        match = next((entry for entry in entries if entry["planned_step_id"] == step_id and entry["commit_status"] == "COMMITTED"), None)
        if match is None:
            if meta["ledger_entry"]["previous_entry_hash"] != (entries[-1]["entry_hash"] if entries else None):
                raise IntegrityError(f"Cannot reconcile ledger for {step_id}")
            append_ledger_entry(run_dir, meta["ledger_entry"])
            entries.append(meta["ledger_entry"])
        elif match != meta["ledger_entry"]:
            raise IntegrityError(f"Ledger metadata differs from immutable commit {step_id}")
        record = read_json(directory / "record.json")
        for identifier in generated_ids(record):
            if identifier in source_index:
                raise IntegrityError(f"Generated ID was reused: {identifier}")
            source_index[identifier] = {"commit_id": record["commit_id"], "hash": meta["record_hash"]}
        expected_constraints.extend(meta["constraint_events"])
    inflight_path = run_dir / "state/inflight.json"
    if inflight_path.exists() and read_json(inflight_path).get("step_id") in committed_steps:
        inflight_path.unlink()
    for event in expected_constraints:
        for source in event["sources"]:
            resolved = source_index.get(source["artifact_id"])
            if not resolved or resolved != {"commit_id": source["source_commit_id"], "hash": source["source_hash"]}:
                raise IntegrityError(f"Constraint source provenance changed: {source['artifact_id']}")
    constraint_bytes = b"".join(canonical_json(event) for event in expected_constraints)
    constraint_path = run_dir / "constraints/constraint-events.jsonl"
    existing = constraint_path.read_bytes() if constraint_path.exists() else b""
    if not constraint_bytes.startswith(existing):
        raise IntegrityError("Constraint event history was changed")
    if len(existing) < len(constraint_bytes):
        with constraint_path.open("ab") as handle:
            handle.write(constraint_bytes[len(existing):])
            handle.flush()
            os.fsync(handle.fileno())
    write_json(run_dir / "state/source-index.json", source_index)
    facts, knowledge, obligations, motifs, foreclosures = project_constraint_state(expected_constraints)
    write_json(run_dir / "state/canonical-facts.json", facts)
    write_json(run_dir / "state/knowledge-state.json", knowledge)
    write_json(run_dir / "state/obligations.json", obligations)
    write_json(run_dir / "state/motifs.json", motifs)
    write_json(run_dir / "state/foreclosure-candidates.json", foreclosures)
    entries = ledger_entries(run_dir)
    state["ledger_sequence"] = len(entries)
    if entries:
        state["canonical_state_hash"] = entries[-1]["canonical_state_hash_after"]
    state["creative_step_count"] = sum(
        entry["step_type"] == "creative" and entry["commit_status"] == "COMMITTED" for entry in entries
    )
    state["analysis_step_count"] = sum(
        entry["step_type"] == "analysis" and entry["commit_status"] == "COMMITTED" for entry in entries
    )
    state["input_tokens"] = sum(entry["token_accounting"]["input_tokens"] or 0 for entry in entries)
    state["output_tokens"] = sum(entry["token_accounting"]["output_tokens"] or 0 for entry in entries)
    save_state(run_dir, state)


def commit_record(
    run_dir: Path,
    record: dict,
    raw_response: str,
    api_response: dict,
    *,
    planned_step_id: str,
    attempt: int,
    step_phase: str,
    prompt: str,
    context: str,
    parameters: dict,
    branch_relation: str,
) -> Path:
    reconcile_run(run_dir)
    state = load_state(run_dir)
    protocol = load_protocol(run_dir)
    definition = protocol["$defs"][RECORD_DEFS[record["record_type"]]]
    validate_json_schema(record, definition, protocol)
    if record["generation_id"] != state["generation_id"]:
        raise SchemaError("Record generation_id does not match the frozen run")
    if any(
        entry["planned_step_id"] == planned_step_id and entry["commit_status"] == "COMMITTED"
        for entry in ledger_entries(run_dir)
    ):
        raise IntegrityError(f"Refusing to regenerate committed step {planned_step_id}")
    duplicate_ids = reused_generated_ids(run_dir, record)
    if duplicate_ids:
        raise SchemaError(f"Record reuses previously committed IDs: {', '.join(sorted(duplicate_ids))}")
    record_bytes = canonical_json(record)
    record_hash = sha256_bytes(record_bytes)
    raw_bytes = raw_response.encode("utf-8")
    api_bytes = canonical_json(api_response)
    _, past_ids, future_ids, motif_ids = constraint_deltas(record)
    commit_id = record["commit_id"]
    constraint_events = make_constraint_events(run_dir, record, commit_id, record_hash, planned_step_id)
    constraint_hash = sha256_bytes(b"".join(canonical_json(item) for item in constraint_events))
    state_after = sha256_bytes(f"{state['canonical_state_hash']}:{record_hash}:{constraint_hash}".encode())
    usage = api_response.get("usage", {}) if isinstance(api_response, dict) else {}
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=planned_step_id,
        attempt=attempt,
        step_type="creative",
        step_phase=step_phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=sha256_bytes(prompt.encode()),
        context_hash=sha256_bytes(context.encode()),
        provider="LM Studio",
        model=state["model"],
        parameters=parameters,
        seed=parameters["seed"],
        started_at=api_response.get("_cathedrals_started_at", utc_now()),
        output_hash=record_hash,
        generated_ids=generated_ids(record),
        past_constraint_ids=past_ids,
        future_obligation_ids=future_ids,
        motif_ids=motif_ids,
        branch_relation=branch_relation,
        commit_status="COMMITTED",
        state_hash_after=state_after,
        failure_class="none",
        usage=usage,
    )
    sequence = entry["ledger_sequence"]
    destination = run_dir / "committed" / f"{sequence:04d}-{planned_step_id}"
    if destination.exists():
        raise IntegrityError(f"Commit directory already exists: {destination}")
    staging = Path(tempfile.mkdtemp(prefix=f"{planned_step_id}-", dir=run_dir / ".staging"))
    write_atomic(staging / "record.json", record_bytes)
    write_atomic(staging / "raw-response.txt", raw_bytes)
    write_atomic(staging / "api-response.json", api_bytes)
    meta = {
        "record_hash": record_hash,
        "raw_response_hash": sha256_bytes(raw_bytes),
        "api_response_hash": sha256_bytes(api_bytes),
        "constraint_events": constraint_events,
        "ledger_entry": entry,
    }
    write_json(staging / "commit-meta.json", meta)
    for path in staging.iterdir():
        make_read_only(path)
    os.replace(staging, destination)
    os.chmod(destination, 0o555)
    append_ledger_entry(run_dir, entry)
    raw_view = run_dir / "raw" / f"{sequence:04d}-{planned_step_id}.txt"
    if not raw_view.exists():
        try:
            os.link(destination / "raw-response.txt", raw_view)
        except OSError:
            shutil.copyfile(destination / "raw-response.txt", raw_view)
            make_read_only(raw_view)
    state["canonical_state_hash"] = state_after
    state["stage"] = step_phase.upper()
    save_state(run_dir, state)
    reconcile_run(run_dir)
    if record["record_type"] == "creative_packet" or (
        record["record_type"] == "architecture_plan_batch" and assembled_architecture(run_dir)
    ):
        recompute_prospective_plan(run_dir, record["commit_id"])
    return destination


def append_failed_attempt(
    run_dir: Path,
    *,
    step_id: str,
    attempt: int,
    phase: str,
    prompt: str,
    context: str,
    parameters: dict,
    started_at: str,
    failure_class: str,
    output_hash: str | None = None,
    step_type: str = "creative",
    usage: dict | None = None,
) -> None:
    state = load_state(run_dir)
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=step_id,
        attempt=attempt,
        step_type=step_type,
        step_phase=phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=sha256_bytes(prompt.encode()),
        context_hash=sha256_bytes(context.encode()),
        provider="LM Studio",
        model=state["model"],
        parameters=parameters,
        seed=parameters["seed"],
        started_at=started_at,
        output_hash=output_hash,
        generated_ids=[],
        past_constraint_ids=[],
        future_obligation_ids=[],
        motif_ids=[],
        branch_relation=None,
        commit_status="FAILED_BEFORE_COMMIT",
        state_hash_after=state["canonical_state_hash"],
        failure_class=failure_class,
        usage=usage,
    )
    append_ledger_entry(run_dir, entry)
    state["ledger_sequence"] = entry["ledger_sequence"]
    save_state(run_dir, state)


def committed_record(run_dir: Path, record_type: str, packet_slot_id: str | None = None):
    if record_type == "genesis":
        return assembled_genesis(run_dir)
    if record_type == "architecture":
        return assembled_architecture(run_dir)
    if record_type == "creative_packet" and packet_slot_id is not None:
        return assembled_packet(run_dir, packet_slot_id)
    for directory in committed_directories(run_dir):
        record = read_json(directory / "record.json")
        if record.get("record_type") == record_type and (packet_slot_id is None or record.get("packet_slot_id") == packet_slot_id):
            return record
    return None


def all_committed_records(run_dir: Path) -> list[dict]:
    return [read_json(path / "record.json") for path in committed_directories(run_dir)]


def committed_records(run_dir: Path, record_type: str) -> list[dict]:
    return [record for record in all_committed_records(run_dir) if record.get("record_type") == record_type]


def assembled_genesis(run_dir: Path) -> dict | None:
    foundation = committed_record(run_dir, "genesis_foundation")
    cast = committed_record(run_dir, "genesis_cast")
    constraints = committed_record(run_dir, "genesis_constraints")
    if not foundation or not cast or not constraints:
        return None
    return {
        "record_type": "genesis",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": foundation["generation_id"],
        "commit_id": constraints["commit_id"],
        "story_format": "web",
        "format_composition_law": foundation["format_composition_law"],
        "work_canon": foundation["work_canon"],
        "web_art_direction": foundation["web_art_direction"],
        "claimants": cast["claimants"],
        "characters": cast["characters"],
        "constraint_delta": constraints["constraint_delta"],
    }


def assembled_architecture(run_dir: Path) -> dict | None:
    core = committed_record(run_dir, "architecture_core")
    if not core:
        return None
    batches = sorted(committed_records(run_dir, "architecture_plan_batch"), key=lambda item: item["batch_sequence"])
    if not batches or len(batches) != batches[0]["batch_count"]:
        return None
    return architecture_from_parts(core, batches)


def architecture_from_parts(core: dict, batches: list[dict]) -> dict:
    plans = [plan for batch in batches for plan in batch["packet_plans"]]
    attractor_slots = {
        attractor["attractor_id"]: [
            slot
            for plan in plans
            if plan["packet_kind"] == "ending" and attractor["attractor_id"] in plan["attractor_ids"]
            for slot in plan["ending_slot_ids"]
        ]
        for attractor in core["attractors"]
    }
    return core | {
        "record_type": "architecture",
        "commit_id": batches[-1]["commit_id"],
        "architecture_core_commit_id": core["commit_id"],
        "packet_plan_commit_ids": [item["commit_id"] for item in batches],
        "attractors": [item | {"ending_slot_ids": attractor_slots[item["attractor_id"]]} for item in core["attractors"]],
        "packet_plans": plans,
    }


def plan_batch_for(run_dir: Path, packet_slot_id: str) -> dict | None:
    return next(
        (
            batch
            for batch in committed_records(run_dir, "architecture_plan_batch")
            if any(plan["packet_slot_id"] == packet_slot_id for plan in batch["packet_plans"])
        ),
        None,
    )


def packet_chunks(run_dir: Path, packet_slot_id: str) -> list[dict]:
    return [
        record for record in committed_records(run_dir, "creative_packet")
        if record["packet_slot_id"] == packet_slot_id
    ]


def completed_packet_slots(architecture: dict, records: list[dict]) -> set[str]:
    complete = set()
    for plan in architecture["packet_plans"]:
        chunks = [record for record in records if record.get("record_type") == "creative_packet" and record.get("packet_slot_id") == plan["packet_slot_id"]]
        if not chunks:
            continue
        key = "scenes" if plan["packet_kind"] == "literary" else "endings"
        items = [item for chunk in chunks for item in chunk[key]]
        if items and "technical_slot_id" not in items[0]:
            complete.add(plan["packet_slot_id"])
            continue
        expected = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
        actual = {item["technical_slot_id"] for item in items}
        if (
            actual == expected
            and sum(len(chunk["artifacts"]) for chunk in chunks) == plan["artifact_count"]
            and sum(len(chunk["formal_compositions"]) for chunk in chunks) == plan["formal_composition_count"]
        ):
            complete.add(plan["packet_slot_id"])
    return complete


def assembled_packet(run_dir: Path, packet_slot_id: str) -> dict | None:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        return None
    plan = next((item for item in architecture["packet_plans"] if item["packet_slot_id"] == packet_slot_id), None)
    chunks = packet_chunks(run_dir, packet_slot_id)
    return packet_from_chunks(plan, chunks)


def packet_from_chunks(plan: dict | None, chunks: list[dict]) -> dict | None:
    if not plan or not chunks:
        return None
    content_key = "scenes" if plan["packet_kind"] == "literary" else "endings"
    expected_slots = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
    actual_slots = {
        item["technical_slot_id"] for chunk in chunks for item in chunk[content_key]
    }
    if actual_slots != expected_slots:
        return None
    if sum(len(chunk["artifacts"]) for chunk in chunks) != plan["artifact_count"]:
        return None
    if sum(len(chunk["formal_compositions"]) for chunk in chunks) != plan["formal_composition_count"]:
        return None
    delta = {
        key: [item for chunk in chunks for item in chunk["constraint_delta"][key]]
        for key in ("canonical_facts", "knowledge_changes", "new_obligations", "obligation_updates", "motif_events", "potential_foreclosures")
    }
    first, last = chunks[0], chunks[-1]
    return first | {
        "commit_id": last["commit_id"],
        "packet_sequence": last["packet_sequence"],
        "obligations_advanced": sorted({item for chunk in chunks for item in chunk["obligations_advanced"]}),
        "scenes": [item for chunk in chunks for item in chunk["scenes"]],
        "artifacts": [item for chunk in chunks for item in chunk["artifacts"]],
        "endings": [item for chunk in chunks for item in chunk["endings"]],
        "decision_edges": [item for chunk in chunks for item in chunk["decision_edges"]],
        "formal_compositions": [item for chunk in chunks for item in chunk["formal_compositions"]],
        "constraint_delta": delta,
    }


def retrieve_original_sources(
    run_dir: Path,
    constraints: list[dict],
    limit: int = 24,
    records: list[dict] | None = None,
) -> list[dict]:
    wanted = []
    locators = {}
    for constraint in constraints:
        for source in constraint.get("sources", []):
            identifier = source["artifact_id"]
            if identifier not in wanted:
                wanted.append(identifier)
                locators[identifier] = source["source_locator"]
        if len(wanted) >= limit:
            break
    retrieved = []
    committed = list(reversed(records if records is not None else all_committed_records(run_dir)))
    for identifier in wanted:
        for record in committed:
            candidates = []
            if record.get("record_type") == "creative_packet":
                candidates = record["scenes"] + record["artifacts"] + record["endings"] + record["formal_compositions"]
            elif identifier in generated_ids(record):
                candidates = [record]
            source = next(
                (
                    item
                    for item in candidates
                    if identifier
                    in {
                        item.get("scene_id"),
                        item.get("artifact_id"),
                        item.get("ending_id"),
                        item.get("composition_id"),
                        item.get("commit_id"),
                    }
                ),
                candidates[0] if len(candidates) == 1 else None,
            )
            if source is not None:
                retrieved.append(
                    {
                        "source_id": identifier,
                        "source_locator": locators[identifier],
                        "immutable_source": source,
                    }
                )
                break
    return retrieved


def geomancy_figures(run_dir: Path | None = None) -> list[dict]:
    figures = []
    current = None
    for line in (engine_root(run_dir) / "data/threshold-geomancy.yaml").read_text(encoding="utf-8").splitlines():
        match = re.match(r"  - id: ([123]-[123]-[123]-[123])$", line)
        if match:
            if current:
                figures.append(current)
            current = {"figure": match.group(1)}
            continue
        if current:
            field = re.match(r"    (name|summary|scene_motion|pressure_type): (.+)$", line)
            if field:
                current[field.group(1)] = field.group(2)
    if current:
        figures.append(current)
    if len(figures) != 81:
        raise CathedralsError("Engine freeze", f"Expected 81 threshold figures; found {len(figures)}")
    return figures


def precompute_geomancy(seed: str, possible_scene_count: int, run_dir: Path | None = None) -> dict:
    figures = geomancy_figures(run_dir)
    assignments = []
    for number in range(1, possible_scene_count + 1):
        slot = f"scene_slot_{number:04d}"
        digest = hashlib.sha256(f"{seed}:{slot}".encode()).digest()
        figure = figures[int.from_bytes(digest[:4], "big") % len(figures)]
        assignments.append({"technical_slot_id": slot} | figure)
    for index, assignment in enumerate(assignments):
        if index + 1 == len(assignments):
            assignment["resultant"] = None
            continue
        left = [int(value) for value in assignment["figure"].split("-")]
        right = [int(value) for value in assignments[index + 1]["figure"].split("-")]
        assignment["resultant"] = "-".join(str(((a + b - 2) % 3) + 1) for a, b in zip(left, right))
    return {"seed": seed, "assignments": assignments}


def ensure_frozen_geomancy(run_dir: Path) -> dict:
    path = run_dir / "state/frozen-geomancy.json"
    if path.exists():
        value = read_json(path)
        expected = load_state(run_dir).get("geomancy_hash")
        if expected and sha256_file(path) != expected:
            raise IntegrityError("Frozen threshold geomancy changed")
        return value
    manifest = read_json(run_dir / "run-manifest.json")
    value = precompute_geomancy(
        manifest["engine_snapshot"]["geomancy_seed"],
        manifest["scope"]["possible_scene_count"],
        run_dir,
    )
    write_json(path, value, mode=0o444, exclusive=True)
    state = load_state(run_dir)
    state["geomancy_hash"] = sha256_file(path)
    save_state(run_dir, state)
    return value


def engine_context(run_dir: Path | None = None) -> str:
    sections = []
    for relative in ENGINE_CONTEXT_FILES:
        path = engine_root(run_dir) / relative
        sections.append(f"===== engine/{relative} =====\n{path.read_text(encoding='utf-8')}")
    return "\n\n".join(sections)


def render_prompt(run_dir: Path, name: str, replacements: dict[str, str]) -> str:
    value = (engine_root(run_dir) / "prompts" / name).read_text(encoding="utf-8")
    for key, replacement in replacements.items():
        value = value.replace("{{" + key + "}}", replacement)
    if re.search(r"\{\{[A-Z0-9_]+\}\}", value):
        raise CathedralsError("Prompt assembly", f"Unresolved prompt placeholder in {name}")
    return value


def bounded_context(sections: list[tuple[str, object]], max_tokens: int) -> str:
    maximum = max_tokens * 4
    output = []
    used = 0
    for label, value in sections:
        header = f"===== {label} =====\n"
        separator_size = 1 if output else 0
        values = value if isinstance(value, list) else [value]
        packed = []
        for item in values:
            text = item if isinstance(item, str) else json.dumps(item, ensure_ascii=False, indent=2)
            candidate = header + "\n\n".join(packed + [text]) + "\n"
            if used + separator_size + len(candidate) <= maximum:
                packed.append(text)
        if packed:
            section = header + "\n\n".join(packed) + "\n"
            output.append(section)
            used += separator_size + len(section)
    return "\n".join(output)


def parse_structured_content(content: str):
    try:
        return json.loads(content)
    except json.JSONDecodeError:
        match = re.fullmatch(r"\s*```(?:json)?\s*\n([\s\S]*)\n```\s*", content)
        if not match:
            raise SchemaError("LM Studio returned malformed JSON")
        try:
            return json.loads(match.group(1))
        except json.JSONDecodeError as error:
            raise SchemaError("LM Studio returned malformed JSON inside deterministic code-fence framing") from error


def normalize_provider_response(response) -> str:
    if response is None:
        raise CathedralsError(
            "LM Studio response",
            "LM Studio request completed without a provider response",
            "provider_before_creative_output",
        )
    try:
        choice = response["choices"][0]
        message = choice["message"]
    except (KeyError, IndexError, TypeError) as error:
        raise CathedralsError(
            "LM Studio response",
            "LM Studio returned no usable response message",
            "provider_before_creative_output",
        ) from error
    if not isinstance(choice, dict) or not isinstance(message, dict):
        raise CathedralsError(
            "LM Studio response",
            "LM Studio returned no usable response message",
            "provider_before_creative_output",
        )
    if choice.get("finish_reason") in {"length", "max_tokens"}:
        raise TruncationError(f"LM Studio response was truncated ({choice['finish_reason']})", response)
    content = message.get("content")
    reasoning = message.get("reasoning")
    reasoning_content = message.get("reasoning_content")
    if isinstance(content, str) and content.strip():
        return content
    if content is not None and not isinstance(content, str):
        raise SchemaError("LM Studio message.content is not text")
    if any(value is not None and not isinstance(value, str) for value in (reasoning, reasoning_content)):
        raise SchemaError("LM Studio reasoning fields are not text")
    populated_reasoning = [
        value for value in (reasoning, reasoning_content)
        if isinstance(value, str) and value.strip()
    ]
    if populated_reasoning:
        try:
            parsed_reasoning = [json.loads(value) for value in populated_reasoning]
        except json.JSONDecodeError as error:
            raise SchemaError("LM Studio reasoning fallback is not a complete JSON value") from error
        if len(parsed_reasoning) == 2 and parsed_reasoning[0] != parsed_reasoning[1]:
            raise SchemaError("LM Studio returned conflicting reasoning and reasoning_content fields")
        return populated_reasoning[0]
    raise CathedralsError(
        "LM Studio response",
        "LM Studio returned a truly empty provider response",
        "provider_before_creative_output",
    )


def provider_response(transport, url: str, payload: dict, timeout: float, *, started_at=None, preserve=None):
    response = transport("POST", url, payload, timeout=timeout)
    if isinstance(response, dict) and started_at:
        response = response | {"_cathedrals_started_at": started_at}
    if response is not None and preserve:
        preserve(response)
    return response, normalize_provider_response(response)


def step_seed(generation_seed: str, step_id: str) -> str:
    return str(int.from_bytes(hashlib.sha256(f"{generation_seed}:{step_id}".encode()).digest()[:4], "big"))


def request_record(
    run_dir: Path,
    *,
    expected_record_type: str,
    step_id: str,
    phase: str,
    prompt: str,
    context: str,
    branch_relation: str,
    temperature: float,
    max_tokens: int = BASE_OUTPUT_TOKENS,
    transport=http_json,
    precommit_validator=None,
) -> dict:
    state = load_state(run_dir)
    brief = read_json(run_dir / "generation-brief.json")
    if len(prompt) // 4 > read_json(run_dir / "run-manifest.json")["budgets"]["max_prepared_context_tokens"]:
        raise CathedralsError("Context assembly", f"Prepared prompt for {step_id} exceeds the frozen context budget", "budget_exhaustion")
    seed = step_seed(brief["generation_seed"], step_id)
    protocol = load_protocol(run_dir)
    schema = record_schema(expected_record_type, protocol)
    parameters = {"temperature": temperature, "max_tokens": max_tokens, "seed": seed, "stream": False}
    payload = {
        "model": state["model"],
        "messages": [
            {
                "role": "system",
                "content": "Execute the supplied Cathedrals phase. Return only the schema-constrained record.",
            },
            {"role": "user", "content": prompt},
        ],
        **parameters,
        "response_format": {
            "type": "json_schema",
            "json_schema": {
                "name": expected_record_type,
                "strict": True,
                "schema": schema,
            },
        },
    }
    request_hash = sha256_bytes(canonical_json(payload))
    failed_attempts = [entry for entry in ledger_entries(run_dir) if entry["planned_step_id"] == step_id]
    attempt = len(failed_attempts) + 1
    inflight_path = run_dir / "state/inflight.json"
    if inflight_path.exists():
        inflight = read_json(inflight_path)
        if inflight["step_id"] != step_id or inflight["request_hash"] != request_hash:
            raise IntegrityError("Resume found a different in-flight creative request")
        attempt = inflight["attempt"]
    else:
        write_json(
            inflight_path,
            {"step_id": step_id, "attempt": attempt, "request_hash": request_hash, "started_at": utc_now()},
            exclusive=True,
        )
    inflight = read_json(inflight_path)
    response_path = run_dir / "raw" / f"{step_id}-attempt{attempt}.api.json"
    response = read_json(response_path) if response_path.exists() else None
    try:
        content = normalize_provider_response(response) if response is not None else None
    except TruncationError as error:
        append_failed_attempt(
            run_dir,
            step_id=step_id,
            attempt=attempt,
            phase=phase,
            prompt=prompt,
            context=context,
            parameters=parameters,
            started_at=inflight["started_at"],
            failure_class=error.failure_class,
            output_hash=sha256_bytes(canonical_json(response)),
            usage=response.get("usage", {}) if isinstance(response, dict) else {},
        )
        inflight_path.unlink(missing_ok=True)
        raise
    if response is None:
        failures = 0
        while failures < 3:
            try:
                response, content = provider_response(
                    transport,
                    api_url(brief["lm_studio_base_url"], "/v1/chat/completions"),
                    payload,
                    float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "3600")),
                    started_at=inflight["started_at"],
                    preserve=lambda value: write_json(response_path, value, mode=0o444, exclusive=True),
                )
                break
            except CathedralsError as error:
                failed_response = error.response if isinstance(error, TruncationError) else None
                append_failed_attempt(
                    run_dir,
                    step_id=step_id,
                    attempt=attempt,
                    phase=phase,
                    prompt=prompt,
                    context=context,
                    parameters=parameters,
                    started_at=inflight["started_at"],
                    failure_class=error.failure_class,
                    output_hash=sha256_bytes(canonical_json(failed_response)) if failed_response else None,
                    usage=failed_response.get("usage", {}) if failed_response else {},
                )
                failures += 1
                if error.failure_class not in RETRYABLE_PROVIDER_FAILURES or failures == 3:
                    inflight_path.unlink(missing_ok=True)
                    raise
                attempt += 1
                inflight["attempt"] = attempt
                inflight["started_at"] = utc_now()
                write_json(inflight_path, inflight)
                response_path = run_dir / "raw" / f"{step_id}-attempt{attempt}.api.json"
    try:
        record = parse_structured_content(content)
        validate_json_schema(record, protocol["$defs"][RECORD_DEFS[expected_record_type]], protocol)
        validate_declared_id_uniqueness(record)
        duplicate_ids = reused_generated_ids(run_dir, record)
        if duplicate_ids:
            raise SchemaError(f"Record reuses previously committed IDs: {', '.join(sorted(duplicate_ids))}")
        if precommit_validator:
            precommit_validator(record)
    except SchemaError:
        append_failed_attempt(
            run_dir,
            step_id=step_id,
            attempt=attempt,
            phase=phase,
            prompt=prompt,
            context=context,
            parameters=parameters,
            started_at=inflight["started_at"],
            failure_class="malformed_response",
            output_hash=sha256_bytes(content.encode()),
            usage=response.get("usage", {}) if isinstance(response, dict) else {},
        )
        inflight_path.unlink(missing_ok=True)
        raise
    commit_record(
        run_dir,
        record,
        content,
        response,
        planned_step_id=step_id,
        attempt=attempt,
        step_phase=phase,
        prompt=prompt,
        context=context,
        parameters=parameters,
        branch_relation=branch_relation,
    )
    inflight_path.unlink(missing_ok=True)
    return record


def validate_obligation_origins(obligations: list[dict], allowed_origins: set[str], label: str) -> None:
    for obligation in obligations:
        if not set(obligation["created_by_ids"]).issubset(allowed_origins):
            raise SchemaError(f"{label} has an unknown origin: {obligation['obligation_id']}")


def validate_architecture(architecture: dict, manifest: dict, committed_origin_ids: set[str] | None = None) -> None:
    scope = architecture["scope_commitment"]
    requested = manifest["scope"]["possible_scene_count"]
    if scope["possible_scene_count"] != requested or scope["planned_scene_count"] > requested:
        raise SchemaError("Architecture exceeded or replaced the user's possible scene count")
    if scope["planned_scene_count"] < 8:
        raise SchemaError("Architecture cannot satisfy the Cathedrals opening with fewer than eight scenes")
    plans = architecture["packet_plans"]
    plan_ids = {item["packet_slot_id"] for item in plans}
    if len(plan_ids) != len(plans):
        raise SchemaError("Architecture packet IDs are not unique")
    scene_slots = []
    ending_slots = []
    obligation_records = {item["obligation_id"]: item for item in architecture["obligation_graph"]}
    obligations = set(obligation_records)
    attractors = {item["attractor_id"]: item for item in architecture["attractors"]}
    if len(attractors) != len(architecture["attractors"]):
        raise SchemaError("Architecture attractor IDs are not unique")
    if not any(item["kind"] == "ending" for item in attractors.values()):
        raise SchemaError("Architecture must establish at least one ending attractor")
    if architecture["constraint_delta"]["new_obligations"]:
        raise SchemaError("Architecture obligations belong in obligation_graph, not a duplicate delta")
    obligation_origins = (
        set(attractors)
        | plan_ids
        | {architecture["commit_id"]}
        | {item["arc_id"] for item in architecture["arcs"]}
        | {item["node_id"] for item in architecture["topology"]["nodes"]}
        | {item["edge_id"] for item in architecture["topology"]["edges"]}
        | (committed_origin_ids or set())
    )
    validate_obligation_origins(list(obligation_records.values()), obligation_origins, "Architecture obligation")
    for obligation in obligation_records.values():
        if obligation["status"] != "active":
            raise SchemaError("Architecture obligations must begin active")
        if not set(obligation["requires"]).issubset(obligations):
            raise SchemaError(f"Obligation references an unknown prerequisite: {obligation['obligation_id']}")
        allowed_targets = obligations | set(attractors) | plan_ids
        if not set(obligation["termination_targets"]).issubset(allowed_targets):
            raise SchemaError(f"Obligation has an unknown termination target: {obligation['obligation_id']}")

    def assert_acyclic(graph: dict[str, list[str]], label: str) -> None:
        visiting = set()
        visited = set()

        def visit(node: str) -> None:
            if node in visiting:
                raise SchemaError(f"{label} contains a circular dependency at {node}")
            if node in visited:
                return
            visiting.add(node)
            for dependency in graph[node]:
                visit(dependency)
            visiting.remove(node)
            visited.add(node)

        for node in graph:
            visit(node)

    assert_acyclic({key: value["requires"] for key, value in obligation_records.items()}, "Obligation graph")
    assert_acyclic({item["packet_slot_id"]: item["depends_on_packet_slot_ids"] for item in plans}, "Packet graph")
    nodes = {item["node_id"] for item in architecture["topology"]["nodes"]}
    if architecture["topology"]["entry_segment_id"] not in nodes or architecture["topology"]["opening_branch_node_id"] not in nodes:
        raise SchemaError("Architecture entry or opening-branch node does not resolve")
    if not set(architecture["topology"]["reconvergence_node_ids"]).issubset(nodes):
        raise SchemaError("Architecture reconvergence node does not resolve")
    for node in architecture["topology"]["nodes"]:
        if not set(node["hard_obligation_ids"]).issubset(obligations) or not set(node["generation_dependency_ids"]).issubset(nodes):
            raise SchemaError(f"Architecture node references unknown canon: {node['node_id']}")
    for edge in architecture["topology"]["edges"]:
        if edge["from_node_id"] not in nodes or edge["to_node_id"] not in nodes or not set(edge["hard_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Architecture edge references unknown canon: {edge['edge_id']}")
    opening_edges = [
        edge
        for edge in architecture["topology"]["edges"]
        if edge["from_node_id"] == architecture["topology"]["opening_branch_node_id"] and edge["relation"] == "branch"
    ]
    if len(opening_edges) != 3:
        raise SchemaError("Macroarchitecture opening hub must establish exactly three branch relations")
    for arc in architecture["arcs"]:
        if not set(arc["hard_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Arc references unknown hard obligation: {arc['arc_id']}")
    for attractor in attractors.values():
        if not set(attractor["prerequisite_obligation_ids"]).issubset(obligations):
            raise SchemaError(f"Attractor references unknown obligation: {attractor['attractor_id']}")
        if any(obligation_records[item]["hardness"] != "hard" for item in attractor["prerequisite_obligation_ids"]):
            raise SchemaError("Attractor prerequisites must be hard obligations")
    for plan in plans:
        if plan["packet_slot_id"] in plan["depends_on_packet_slot_ids"] or not set(plan["depends_on_packet_slot_ids"]).issubset(plan_ids):
            raise SchemaError(f"Packet dependency does not resolve: {plan['packet_slot_id']}")
        if not set(plan["attractor_ids"]).issubset(attractors):
            raise SchemaError(f"Packet references an unknown constraint: {plan['packet_slot_id']}")
        if plan["packet_kind"] == "ending" and len(plan["attractor_ids"]) != 1:
            raise SchemaError("Each ending packet must realize exactly one ending attractor")
        scene_slots += plan["scene_slot_ids"]
        ending_slots += plan["ending_slot_ids"]
    if len(scene_slots) != len(set(scene_slots)) or len(scene_slots) != scope["planned_scene_count"]:
        raise SchemaError("Architecture scene slots are duplicated or do not match planned_scene_count")
    if len(ending_slots) != len(set(ending_slots)) or len(ending_slots) != scope["planned_ending_count"]:
        raise SchemaError("Architecture ending slots are duplicated or do not match planned_ending_count")
    if sum(plan["artifact_count"] for plan in plans) != scope["planned_artifact_count"]:
        raise SchemaError("Packet artifact allocations do not match planned_artifact_count")
    if sum(plan["formal_composition_count"] for plan in plans) != scope["planned_formal_composition_count"]:
        raise SchemaError("Packet formal-composition allocations do not match the frozen count")
    if scope["planned_artifact_count"] > manifest["scope"]["artifact_hard_max"]:
        raise SchemaError("Architecture exceeds the derived artifact budget")
    if scope["planned_ending_count"] > manifest["scope"]["ending_hard_max"]:
        raise SchemaError("Architecture exceeds the derived ending budget")
    assigned_attractor_slots = [slot for item in attractors.values() if item["kind"] == "ending" for slot in item["ending_slot_ids"]]
    if set(assigned_attractor_slots) != set(ending_slots) or len(assigned_attractor_slots) != len(set(assigned_attractor_slots)):
        raise SchemaError("Ending attractors must own every ending slot exactly once")
    for plan in (item for item in plans if item["packet_kind"] == "ending"):
        attractor = attractors[plan["attractor_ids"][0]]
        if attractor["kind"] != "ending" or not set(plan["ending_slot_ids"]).issubset(attractor["ending_slot_ids"]):
            raise SchemaError("Ending packet slots must belong to its ending attractor")
    if 4 + math.ceil(len(plans) / PLAN_BATCH_SIZE) + len(plans) > manifest["budgets"]["max_creative_step_count"]:
        raise SchemaError("Architecture exceeds the derived creative-step budget")


def validate_declared_id_uniqueness(record: dict) -> None:
    identifiers = [record.get("commit_id")]
    if record.get("record_type") == "genesis_foundation":
        identifiers += [record["work_canon"]["work_id"]]
        identifiers += [item["event_id"] for item in record["work_canon"]["chronology"]]
        identifiers += [item["claimant_id"] for item in record["claimant_anchors"]]
    elif record.get("record_type") == "genesis_cast":
        identifiers += [item["claimant_id"] for item in record["claimants"]]
        identifiers += [item["character_id"] for item in record["characters"]]
    elif record.get("record_type") == "architecture_core":
        identifiers += [item["obligation_id"] for item in record["obligation_graph"]]
        identifiers += [item["arc_id"] for item in record["arcs"]]
        identifiers += [item["node_id"] for item in record["topology"]["nodes"]]
        identifiers += [item["edge_id"] for item in record["topology"]["edges"]]
        identifiers += [item["attractor_id"] for item in record["attractors"]]
    elif record.get("record_type") == "architecture_plan_batch":
        identifiers += [item["packet_slot_id"] for item in record["packet_plans"]]
    elif record.get("record_type") == "creative_packet":
        identifiers += [item["scene_id"] for item in record["scenes"]]
        identifiers += [item["artifact_id"] for item in record["artifacts"]]
        identifiers += [item["ending_id"] for item in record["endings"]]
        identifiers += [item["composition_id"] for item in record["formal_compositions"]]
        identifiers += [item["edge_id"] for item in record["decision_edges"]]
    delta = record.get("constraint_delta", {})
    identifiers += [item["fact_id"] for item in delta.get("canonical_facts", [])]
    identifiers += [item["knowledge_id"] for item in delta.get("knowledge_changes", [])]
    identifiers += [item["obligation_id"] for item in delta.get("new_obligations", [])]
    identifiers += [item["update_id"] for item in delta.get("obligation_updates", [])]
    identifiers += [item["motif_event_id"] for item in delta.get("motif_events", [])]
    identifiers += [item["foreclosure_id"] for item in delta.get("potential_foreclosures", [])]
    identifiers = [identifier for identifier in identifiers if identifier]
    duplicates = sorted({identifier for identifier in identifiers if identifiers.count(identifier) > 1})
    if duplicates:
        raise SchemaError(f"Record declares duplicate generated IDs: {', '.join(duplicates)}")


def validate_packet_against_plan(packet: dict, plan: dict) -> None:
    if packet["packet_slot_id"] != plan["packet_slot_id"] or packet["packet_kind"] != plan["packet_kind"]:
        raise SchemaError("Creative packet does not match its frozen packet slot")
    expected = set(plan["scene_slot_ids"] if plan["packet_kind"] == "literary" else plan["ending_slot_ids"])
    actual = {
        item["technical_slot_id"]
        for item in (packet["scenes"] if plan["packet_kind"] == "literary" else packet["endings"])
    }
    if expected != actual:
        raise SchemaError(f"Packet {plan['packet_slot_id']} did not fill its assigned technical slots exactly once")
    if len(packet["artifacts"]) != plan["artifact_count"] or len(packet["formal_compositions"]) != plan["formal_composition_count"]:
        raise SchemaError(f"Packet {plan['packet_slot_id']} did not satisfy its frozen artifact/composition allocation")
    if not set(plan["advance_obligation_ids"]).issubset(packet["obligations_advanced"]):
        raise SchemaError(f"Packet {plan['packet_slot_id']} omitted an assigned obligation")


def technical_slot_map(scenes: list[dict], endings: list[dict]) -> dict[str, str]:
    slots = {}
    for item in scenes + endings:
        slot = item["technical_slot_id"]
        if slot in slots:
            raise SchemaError(f"Technical slot is owned more than once: {slot}")
        slots[slot] = item.get("scene_id") or item["ending_id"]
    return slots


def resolve_destination(destination: dict, slots: dict[str, str], content_ids: set[str]) -> str:
    identifier = destination["id"]
    if destination["kind"] == "technical_slot":
        if identifier not in slots:
            raise SchemaError(f"Technical destination does not resolve exactly once: {identifier}")
        return slots[identifier]
    if identifier not in content_ids:
        raise SchemaError(f"Content destination does not resolve: {identifier}")
    return identifier


def resolve_cross_packet_links(scenes: list[dict], endings: list[dict], edges: list[dict]) -> tuple[list[dict], list[dict]]:
    slots = technical_slot_map(scenes, endings)
    content_ids = set(slots.values())
    resolved_edges = [
        edge | {"resolved_content_id": resolve_destination(edge["destination"], slots, content_ids)}
        for edge in edges
    ]
    resolved_endings = [
        ending | {
            "resolved_redirect_content_id": resolve_destination(ending["redirect_destination"], slots, content_ids)
            if ending["redirect_destination"] else None
        }
        for ending in endings
    ]
    return resolved_edges, resolved_endings


def _read_state_map(run_dir: Path, name: str) -> dict:
    path = run_dir / "state" / name
    return read_json(path) if path.exists() else {}


def _tag_set(value: dict, key: str) -> set[str]:
    return set(value.get("relevance", {}).get(key, []))


def relevance_score(event: dict, plan: dict, architecture: dict, dependency_source_ids: set[str], total_events: int) -> int:
    data = event["data"]
    score = 0
    obligation_ids = set(plan.get("advance_obligation_ids", [])) | set(plan.get("may_satisfy_obligation_ids", []))
    plan_tags = plan.get("relevance", {})
    sources = {source["artifact_id"] for source in event.get("sources", [])}
    if sources & dependency_source_ids:
        score += 12
    if event["constraint_kind"] in {"obligation", "obligation_update"}:
        obligation_id = data.get("obligation_id")
        original = next((item for item in architecture["obligation_graph"] if item["obligation_id"] == obligation_id), data)
        if obligation_id in obligation_ids:
            score += 12 if original.get("hardness") == "hard" else 6
        if original.get("kind") == "causal_debt" and obligation_id in obligation_ids:
            score += 8
        prerequisites = {
            item
            for attractor in architecture["attractors"]
            if attractor["attractor_id"] in plan["attractor_ids"]
            for item in attractor["prerequisite_obligation_ids"]
        }
        if obligation_id in prerequisites:
            score += 8
    for key, weight in (
        ("arc_ids", 10),
        ("branch_ids", 10),
        ("claimant_ids", 8),
        ("technical_slot_ids", 8),
        ("object_ids", 6),
        ("location_ids", 6),
        ("state_keys", 6),
        ("motif_ids", 5),
    ):
        if _tag_set(data, key) & set(plan_tags.get(key, [])):
            score += weight
    if event["constraint_kind"] == "knowledge_state" and (
        data.get("subject_id") in set(plan_tags.get("character_ids", []))
        or _tag_set(data, "character_ids") & set(plan_tags.get("character_ids", []))
    ):
        score += 9
    words = set(re.findall(r"[a-z0-9_]+", " ".join(plan["soft_guidance"] + plan_tags.get("keywords", [])).lower()))
    event_words = set(re.findall(r"[a-z0-9_]+", json.dumps(data, ensure_ascii=False).lower()))
    score += min(5, len(words & event_words))
    if total_events:
        score += min(2, 2 * event["constraint_event_sequence"] // total_events)
    return score


def select_relevant_constraints(
    run_dir: Path,
    architecture: dict,
    plan: dict,
    limit: int = 96,
    records: list[dict] | None = None,
) -> list[dict]:
    path = run_dir / "constraints/constraint-events.jsonl"
    events = [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()] if path.exists() else []
    committed = records if records is not None else all_committed_records(run_dir)
    dependencies = [
        record for record in committed
        if record.get("record_type") == "creative_packet" and record.get("packet_slot_id") in plan["depends_on_packet_slot_ids"]
    ]
    dependency_ids = {identifier for record in dependencies for identifier in generated_ids(record)}
    scored = [(relevance_score(event, plan, architecture, dependency_ids, len(events)), event) for event in events]
    return [event for score, event in sorted(scored, key=lambda item: (-item[0], item[1]["constraint_event_sequence"])) if score > 0][:limit]


def _within_record_budget(records: list[dict], max_tokens: int) -> list[dict]:
    maximum = max_tokens * 4
    output = []
    used = 0
    for record in records:
        size = len(json.dumps(record, ensure_ascii=False, indent=2))
        if used + size <= maximum:
            output.append(record)
            used += size
    return output


def relevant_packet_context(run_dir: Path, architecture: dict, plan: dict) -> str:
    manifest = read_json(run_dir / "run-manifest.json")
    genesis = committed_record(run_dir, "genesis")
    records = all_committed_records(run_dir)
    dependency_records = [
        record for record in records
        if record.get("record_type") == "creative_packet" and record.get("packet_slot_id") in plan["depends_on_packet_slot_ids"]
    ]
    recent = [record for record in records if record.get("record_type") == "creative_packet"][-2:]
    selected = select_relevant_constraints(run_dir, architecture, plan, records=records)
    selected_fact_ids = {
        event["data"]["fact_id"] for event in selected if event["constraint_kind"] == "canonical_fact"
    }
    fact_state = _read_state_map(run_dir, "canonical-facts.json")
    past = [event for key, event in fact_state.items() if key in selected_fact_ids]
    selected_motif_ids = {
        event["data"]["motif_id"] for event in selected if event["constraint_kind"] == "motif_state"
    }
    motif_state = _read_state_map(run_dir, "motifs.json")
    motifs = [value for key, value in motif_state.items() if key in selected_motif_ids]
    retrieved_sources = _within_record_budget(
        retrieve_original_sources(run_dir, selected, records=records), manifest["budgets"]["max_retrieved_source_tokens"]
    )
    geomancy = ensure_frozen_geomancy(run_dir)
    slots = set(plan["scene_slot_ids"])
    relevant_geomancy = [item for item in geomancy["assignments"] if item["technical_slot_id"] in slots]
    obligation_state = _read_state_map(run_dir, "obligations.json")
    selected_knowledge_ids = {
        event["constraint_id"] for event in selected if event["constraint_kind"] == "knowledge_state"
    }
    knowledge_state = _read_state_map(run_dir, "knowledge-state.json")
    knowledge = []
    for subject_id, relations in knowledge_state.items():
        relevant_relations = {
            relation: {
                proposition_id: event
                for proposition_id, event in propositions.items()
                if event["constraint_id"] in selected_knowledge_ids
            }
            for relation, propositions in relations.items()
        }
        if any(relevant_relations.values()):
            knowledge.append({"subject_id": subject_id, **relevant_relations})
    selected_obligation_ids = {
        event["data"].get("obligation_id")
        for event in selected
        if event["constraint_class"] == "future_obligation"
    }
    active_obligations = [
        event for key, event in obligation_state.items()
        if key in selected_obligation_ids and event["data"]["status"] == "active"
    ]
    hard_obligations = [item for item in active_obligations if item["data"]["hardness"] == "hard"]
    soft_obligations = [item for item in active_obligations if item["data"]["hardness"] == "soft"]
    advance = sorted(
        (obligation_state[item] for item in plan["advance_obligation_ids"] if item in obligation_state),
        key=lambda item: item["data"]["hardness"] != "hard",
    )
    may_satisfy = sorted(
        (obligation_state[item] for item in plan["may_satisfy_obligation_ids"] if item in obligation_state),
        key=lambda item: item["data"]["hardness"] != "hard",
    )
    attractors = [item for item in architecture["attractors"] if item["attractor_id"] in plan["attractor_ids"]]
    ending_sections = []
    if plan["packet_kind"] == "ending":
        prerequisite_ids = sorted({
            obligation_id for attractor in attractors for obligation_id in attractor["prerequisite_obligation_ids"]
        })
        prerequisite_chain = [obligation_state[item] for item in prerequisite_ids if item in obligation_state]
        relevant_debts = [obligation_state[item] for item in selected_obligation_ids if item in obligation_state]
        ending_sections = [
            ("BACKWARD PREREQUISITE CHAIN", prerequisite_chain),
            ("SATISFIED PREREQUISITES WITH SOURCES", [item for item in prerequisite_chain if item["data"]["status"] == "satisfied"]),
            ("RELEVANT UNSATISFIED / AMBIGUOUS PRESSURES", [item for item in relevant_debts if item["data"]["status"] in {"active", "intentionally_unresolved"}]),
            ("CURRENT READER STATE", [item for item in past if "reader" in item["data"]["subject"] or item["data"].get("relevance", {}).get("state_keys")]),
            ("BRANCH RESIDUE", [item for item in relevant_debts if item["data"]["kind"] == "branch_residue"]),
            ("CLAIMANT PRESSURES", [item for item in relevant_debts if item["data"].get("relevance", {}).get("claimant_ids")]),
        ]
    return bounded_context(
        [
            ("FROZEN ENGINE LAW", (run_dir / "state/frozen-engine-context.txt").read_text(encoding="utf-8")),
            ("FROZEN GENERATION BRIEF", manifest["generation_brief"]),
            ("IMMUTABLE GENERATED ROOT CANON", genesis),
            ("CURRENT PACKET STRUCTURAL POSITION", plan),
            ("IMMUTABLE PAST CONSTRAINTS", past),
            ("ACTIVE HARD FUTURE OBLIGATIONS", hard_obligations),
            ("OBLIGATIONS THIS PACKET SHOULD ADVANCE", advance),
            ("OBLIGATIONS THIS PACKET MAY SATISFY", may_satisfy),
            ("DIRECT DEPENDENCY SOURCE EVIDENCE", dependency_records),
            ("CHARACTER KNOWLEDGE / BELIEF CONSTRAINTS", knowledge),
            ("ENDING ATTRACTOR" if plan["packet_kind"] == "ending" else "ENDING / BRANCH ATTRACTORS EXERTING PRESSURE", attractors),
            *ending_sections,
            ("RETRIEVED ORIGINAL SOURCE EVIDENCE", retrieved_sources),
            ("RELEVANT MOTIF PRESSURES", motifs),
            ("FROZEN THRESHOLD GEOMANCY", relevant_geomancy),
            ("RECENT LOCAL SOURCE", recent),
            ("SOFT FUTURE PRESSURES", soft_obligations),
        ],
        manifest["budgets"]["max_prepared_context_tokens"] - 14000,
    )


def evaluate_feasibility(architecture: dict, obligations: dict, foreclosure_candidates: dict) -> list[dict]:
    results = []
    for attractor in architecture["attractors"]:
        prerequisite_ids = set(attractor["prerequisite_obligation_ids"])
        prerequisites = [obligations[item]["data"] for item in prerequisite_ids if item in obligations]
        missing = prerequisite_ids - set(obligations)
        candidates = [
            event
            for event in foreclosure_candidates.values()
            if event["data"]["attractor_id"] == attractor["attractor_id"]
        ]
        universal_impossible = [
            item for item in prerequisites
            if item["hardness"] == "hard" and item["universality"] == "universal" and item["status"] == "impossible"
        ]
        impossible = [item for item in prerequisites if item["hardness"] == "hard" and item["status"] == "impossible"]
        lawful = []
        for candidate in candidates:
            negated = set(candidate["data"]["negated_prerequisite_obligation_ids"])
            if (
                attractor["foreclosable"]
                and negated
                and negated.issubset(prerequisite_ids)
                and all(
                    item in obligations
                    and obligations[item]["data"]["status"] == "impossible"
                    and obligations[item]["data"]["universality"] != "universal"
                    for item in negated
                )
            ):
                lawful.append(candidate)
        if missing or universal_impossible or (impossible and not attractor["foreclosable"]):
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "universally_required_but_impossible",
                "reason": "A required obligation is missing or mechanically impossible and cannot be lawfully foreclosed.",
                "source_ids": [source["artifact_id"] for item in universal_impossible for source in obligations[item["obligation_id"]]["sources"]],
            })
        elif lawful:
            candidate = lawful[-1]
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "foreclosed",
                "reason": candidate["data"]["reason"],
                "source_ids": [source["artifact_id"] for source in candidate["sources"]],
            })
        elif candidates or impossible:
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "endangered",
                "reason": "Committed history threatens this attractor, but lawful foreclosure is not yet established.",
                "source_ids": [source["artifact_id"] for item in candidates for source in item["sources"]],
            })
        else:
            results.append({
                "attractor_id": attractor["attractor_id"],
                "status": "viable",
                "reason": "No hard prerequisite has been irreversibly negated.",
                "source_ids": [],
            })
    return results


def obligation_assignment_score(obligation: dict, plan: dict, architecture: dict) -> int:
    score = 0
    targets = set(obligation["termination_targets"])
    if plan["packet_slot_id"] in targets or set(plan["attractor_ids"]) & targets:
        score += 12
    obligation_tags = obligation.get("relevance", {})
    plan_tags = plan.get("relevance", {})
    for key, weight in (
        ("arc_ids", 10), ("branch_ids", 10), ("claimant_ids", 8),
        ("character_ids", 8), ("technical_slot_ids", 8), ("object_ids", 6),
        ("location_ids", 6), ("state_keys", 6), ("motif_ids", 5),
    ):
        if set(obligation_tags.get(key, [])) & set(plan_tags.get(key, [])):
            score += weight
    if any(
        obligation["obligation_id"] in attractor["prerequisite_obligation_ids"]
        for attractor in architecture["attractors"]
        if attractor["attractor_id"] in plan["attractor_ids"]
    ):
        score += 8
    words = set(re.findall(r"[a-z0-9_]+", " ".join(plan["soft_guidance"] + plan_tags.get("keywords", [])).lower()))
    obligation_words = set(re.findall(r"[a-z0-9_]+", obligation["description"].lower()))
    return score + min(5, len(words & obligation_words))


def build_prospective_plan(run_dir: Path, architecture: dict, recomputed_after_commit_id: str) -> dict:
    obligations = _read_state_map(run_dir, "obligations.json")
    foreclosures = _read_state_map(run_dir, "foreclosure-candidates.json")
    feasibility = evaluate_feasibility(architecture, obligations, foreclosures)
    feasibility_by_id = {item["attractor_id"]: item["status"] for item in feasibility}
    committed = completed_packet_slots(architecture, all_committed_records(run_dir))
    uncommitted_plans = [plan for plan in architecture["packet_plans"] if plan["packet_slot_id"] not in committed]
    literary_pending = any(plan["packet_kind"] == "literary" for plan in uncommitted_plans)
    obligation_assignments = []
    for obligation_id, event in obligations.items():
        obligation = event["data"]
        if obligation["status"] != "active":
            continue
        candidates = [
            plan for plan in uncommitted_plans
            if plan["packet_kind"] != "ending"
            or (
                obligation["hardness"] == "soft"
                and all(feasibility_by_id[item] == "viable" for item in plan["attractor_ids"])
                and all(
                    obligations[prerequisite]["data"]["status"] == "satisfied"
                    for attractor_id in plan["attractor_ids"]
                    for prerequisite in next(
                        item for item in architecture["attractors"] if item["attractor_id"] == attractor_id
                    )["prerequisite_obligation_ids"]
                )
            )
        ]
        if not candidates:
            continue
        ranked = sorted(
            ((obligation_assignment_score(obligation, plan, architecture), plan) for plan in candidates),
            key=lambda item: (-item[0], item[1]["initial_priority"], item[1]["packet_slot_id"]),
        )
        score, assigned = ranked[0]
        obligation_assignments.append({
            "obligation_id": obligation_id,
            "packet_slot_id": assigned["packet_slot_id"],
            "score": score,
            "reason": "Best current lawful target by declared termination, structural relevance, and lexical pressure.",
        })
    packet_order = []
    for plan in uncommitted_plans:
        if plan["packet_slot_id"] in committed or not set(plan["depends_on_packet_slot_ids"]).issubset(committed):
            continue
        if plan["packet_kind"] == "ending" and literary_pending:
            continue
        statuses = [feasibility_by_id[item] for item in plan["attractor_ids"]]
        if plan["packet_kind"] == "ending":
            prerequisites = [
                prerequisite
                for attractor_id in plan["attractor_ids"]
                for prerequisite in next(
                    item for item in architecture["attractors"] if item["attractor_id"] == attractor_id
                )["prerequisite_obligation_ids"]
            ]
            if any(status != "viable" for status in statuses) or any(
                obligations[item]["data"]["status"] != "satisfied" for item in prerequisites
            ):
                continue
        assigned_ids = [
            item["obligation_id"] for item in obligation_assignments if item["packet_slot_id"] == plan["packet_slot_id"]
        ]
        active = [obligations[item]["data"] for item in assigned_ids]
        score = sum(12 if item["hardness"] == "hard" else 5 for item in active)
        score += max(0, 8 - plan["initial_priority"])
        packet_order.append({
            "packet_slot_id": plan["packet_slot_id"],
            "score": score,
            "reason": "Eligible by committed dependencies; ranked by active constraint pressure and initial priority.",
        })
    packet_order.sort(key=lambda item: (-item["score"], item["packet_slot_id"]))
    history = run_dir / "planning/prospective-plans.jsonl"
    sequence = len(history.read_text(encoding="utf-8").splitlines()) + 1 if history.exists() else 1
    return {
        "record_type": "prospective_plan",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": run_dir.name,
        "plan_id": f"prospective_plan_{sequence:04d}",
        "based_on_canonical_state_hash": load_state(run_dir)["canonical_state_hash"],
        "recomputed_after_commit_id": recomputed_after_commit_id,
        "created_at": utc_now(),
        "feasibility": feasibility,
        "obligation_assignments": obligation_assignments,
        "packet_order": packet_order,
    }


def recompute_prospective_plan(run_dir: Path, recomputed_after_commit_id: str) -> dict:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        return {}
    step_id = f"prospective_{sha256_bytes(recomputed_after_commit_id.encode())[:16]}"
    if step_is_committed(run_dir, step_id):
        return _read_state_map(run_dir, "prospective-plan.json")
    plan = build_prospective_plan(run_dir, architecture, recomputed_after_commit_id)
    protocol = load_protocol(run_dir)
    validate_json_schema(plan, protocol["$defs"]["prospectivePlan"], protocol)
    history = run_dir / "planning/prospective-plans.jsonl"
    with history.open("ab") as handle:
        handle.write(canonical_json(plan))
        handle.flush()
        os.fsync(handle.fileno())
    write_json(run_dir / "state/prospective-plan.json", plan)
    plan_hash = sha256_bytes(canonical_json(plan))
    append_deterministic_step(run_dir, step_id, "prospective_plan", plan_hash, prospective_plan_hash=plan_hash)
    return plan


def select_next_packet(run_dir: Path, architecture: dict) -> dict | None:
    prospective = _read_state_map(run_dir, "prospective-plan.json")
    if not prospective:
        prospective = recompute_prospective_plan(run_dir, architecture["commit_id"])
    impossible = [item for item in prospective["feasibility"] if item["status"] == "universally_required_but_impossible"]
    if impossible:
        raise CathedralsError("Forward feasibility", impossible[0]["reason"], "continuity_impossibility")
    plans = {item["packet_slot_id"]: item for item in architecture["packet_plans"]}
    if not prospective["packet_order"]:
        return None
    packet_slot_id = prospective["packet_order"][0]["packet_slot_id"]
    assignments = [
        item["obligation_id"]
        for item in prospective["obligation_assignments"]
        if item["packet_slot_id"] == packet_slot_id
    ]
    obligations = _read_state_map(run_dir, "obligations.json")
    may_satisfy = [
        item for item in assignments
        if all(obligations[required]["data"]["status"] == "satisfied" for required in obligations[item]["data"]["requires"])
    ]
    return plans[packet_slot_id] | {
        "advance_obligation_ids": assignments,
        "may_satisfy_obligation_ids": may_satisfy,
    }


def step_is_committed(run_dir: Path, step_id: str) -> bool:
    return any(
        entry["planned_step_id"] == step_id and entry["commit_status"] == "COMMITTED"
        for entry in ledger_entries(run_dir)
    )


def distribute_counts(total: int, groups: int) -> list[int]:
    quotient, remainder = divmod(total, groups)
    return [quotient + (index < remainder) for index in range(groups)]


def planned_packet_specs(architecture_core: dict) -> list[dict]:
    scope = architecture_core["scope_commitment"]
    scene_groups = grouped_counts(scope["planned_scene_count"], 6, 3, 8)
    ending_groups = grouped_counts(scope["planned_ending_count"], 2, 2, 6)
    artifact_counts = distribute_counts(scope["planned_artifact_count"], len(scene_groups))
    composition_counts = distribute_counts(scope["planned_formal_composition_count"], len(scene_groups))
    if any(value > 6 for value in artifact_counts) or any(value > 4 for value in composition_counts):
        raise SchemaError("Architecture scope cannot fit bounded packet allocations")
    specs = []
    scene_number = 1
    for index, size in enumerate(scene_groups, 1):
        slots = [f"scene_slot_{number:04d}" for number in range(scene_number, scene_number + size)]
        scene_number += size
        specs.append({
            "packet_slot_id": f"literary_packet_{index:04d}",
            "packet_kind": "literary",
            "scene_slot_ids": slots,
            "ending_slot_ids": [],
            "artifact_count": artifact_counts[index - 1],
            "formal_composition_count": composition_counts[index - 1],
        })
    ending_number = 1
    for index, size in enumerate(ending_groups, 1):
        slots = [f"ending_slot_{number:04d}" for number in range(ending_number, ending_number + size)]
        ending_number += size
        specs.append({
            "packet_slot_id": f"ending_packet_{index:04d}",
            "packet_kind": "ending",
            "scene_slot_ids": [],
            "ending_slot_ids": slots,
            "artifact_count": 0,
            "formal_composition_count": 0,
        })
    return specs


def plan_batches(architecture_core: dict) -> list[list[dict]]:
    specs = planned_packet_specs(architecture_core)
    return [specs[index:index + PLAN_BATCH_SIZE] for index in range(0, len(specs), PLAN_BATCH_SIZE)]


def validate_genesis_foundation(record: dict, run_dir: Path) -> None:
    brief = read_json(run_dir / "generation-brief.json")
    if record["generation_id"] != brief["generation_id"] or record["story_format"] != "web":
        raise SchemaError("Genesis foundation does not match the frozen generation or active web format")
    anchors = record["claimant_anchors"]
    if sorted(item["technical_slot_id"] for item in anchors) != [f"claimant_slot_{number:02d}" for number in range(1, 6)]:
        raise SchemaError("Genesis foundation must anchor each claimant slot once")
    if len({item["claimant_id"] for item in anchors}) != 5:
        raise SchemaError("Genesis foundation claimant IDs must be unique")
    canon = record["work_canon"]
    claimant_ids = {item["claimant_id"] for item in anchors}
    
    unknown_claimant_ids = sorted({
        claimant_id
        for relationship in canon["claimant_relationships"]
        for claimant_id in relationship["claimant_ids"]
        if claimant_id not in claimant_ids
    })

    if unknown_claimant_ids:
        raise SchemaError(
            "Genesis foundation relationships reference unknown claimant IDs: "
            + ", ".join(unknown_claimant_ids)
            + ". Valid claimant IDs are: "
            + ", ".join(sorted(claimant_ids))
        )

    if len(canon["generated_motifs"]) > 8 or len(canon["principal_tensions"]) > 8:
        raise SchemaError("Genesis foundation exceeds its bounded motif or tension count")
    


def validate_genesis_cast(record: dict, run_dir: Path) -> None:
    foundation = committed_record(run_dir, "genesis_foundation")
    if not foundation or record["foundation_commit_id"] != foundation["commit_id"]:
        raise SchemaError("Genesis cast does not descend from the committed foundation")
    anchors = {item["claimant_id"]: item for item in foundation["claimant_anchors"]}
    claimants = {item["claimant_id"]: item for item in record["claimants"]}
    if set(anchors) != set(claimants):
        raise SchemaError("Genesis cast must expand exactly the five committed claimant anchors")
    for claimant_id, anchor in anchors.items():
        claimant = claimants[claimant_id]
        if any(claimant[key] != anchor[key] for key in ("technical_slot_id", "name", "incident_role")):
            raise SchemaError(f"Genesis cast changed committed claimant anchor {claimant_id}")
    character_ids = {item["character_id"] for item in record["characters"]}
    if not set(foundation["work_canon"]["central_incident"]["subjects"]).issubset(set(claimants) | character_ids):
        raise SchemaError("Genesis cast did not define every central-incident subject anchored by the foundation")


def validate_genesis_constraints(record: dict, run_dir: Path) -> None:
    cast = committed_record(run_dir, "genesis_cast")
    if not cast or record["cast_commit_id"] != cast["commit_id"]:
        raise SchemaError("Genesis constraints do not descend from the committed cast")
    delta = record["constraint_delta"]
    if len(delta["canonical_facts"]) > 12 or len(delta["knowledge_changes"]) > 24 or len(delta["motif_events"]) > 8:
        raise SchemaError("Genesis constraints exceed their bounded initial counts")
    if delta["new_obligations"] or delta["obligation_updates"] or delta["potential_foreclosures"]:
        raise SchemaError("Genesis constraints cannot create obligations or foreclosures")
    semantic_facts = {
        canonical_json({key: item[key] for key in ("subject", "predicate", "value", "status")})
        for item in delta["canonical_facts"]
    }
    if len(semantic_facts) != len(delta["canonical_facts"]):
        raise SchemaError("Genesis constraints contain duplicate canonical facts")
    propositions = {item["fact_id"] for item in delta["canonical_facts"]}
    if any(item["proposition_id"] not in propositions for item in delta["knowledge_changes"]):
        raise SchemaError("Genesis knowledge state references an unknown proposition")


def provisional_architecture(core: dict) -> dict:
    ending_attractor = next(item["attractor_id"] for item in core["attractors"] if item["kind"] == "ending")
    plans = [
        spec | {
            "initial_priority": index,
            "depends_on_packet_slot_ids": [],
            "branch_path_relation": "uncommitted_plan_batch",
            "attractor_ids": [ending_attractor] if spec["packet_kind"] == "ending" else [],
            "relevance": {"claimant_ids": [], "arc_ids": [], "motif_ids": [], "keywords": []},
            "soft_guidance": [],
        }
        for index, spec in enumerate(planned_packet_specs(core), 1)
    ]
    ending_slots = [slot for plan in plans if plan["packet_kind"] == "ending" for slot in plan["ending_slot_ids"]]
    return core | {
        "record_type": "architecture",
        "packet_plans": plans,
        "attractors": [item | {"ending_slot_ids": ending_slots if item["attractor_id"] == ending_attractor else []} for item in core["attractors"]],
    }


def validate_architecture_core_for_run(record: dict, run_dir: Path) -> None:
    genesis = committed_record(run_dir, "genesis")
    if not genesis or record["genesis_commit_id"] != genesis["commit_id"]:
        raise SchemaError("Architecture core does not descend from completed Genesis")
    if record["story_format"] != "web":
        raise SchemaError("The active architecture format must be web")
    claimants = {item["claimant_id"] for item in genesis["claimants"]}
    if any(not set(arc["claimant_pressures"]).issubset(claimants) for arc in record["arcs"]):
        raise SchemaError("Architecture applies pressure from an unknown claimant")
    validate_architecture(provisional_architecture(record), read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))


def validate_architecture_plan_batch(record: dict, run_dir: Path, expected_specs: list[dict], sequence: int, count: int) -> None:
    core = committed_record(run_dir, "architecture_core")
    if not core or record["architecture_core_commit_id"] != core["commit_id"]:
        raise SchemaError("Architecture plan batch does not descend from the committed core")
    if record["batch_sequence"] != sequence or record["batch_count"] != count:
        raise SchemaError("Architecture plan batch sequence does not match its frozen batch")
    expected = {item["packet_slot_id"]: item for item in expected_specs}
    actual = {item["packet_slot_id"]: item for item in record["packet_plans"]}
    if set(actual) != set(expected):
        raise SchemaError("Architecture plan batch did not fill its assigned packet slots exactly")
    fixed = ("packet_kind", "scene_slot_ids", "ending_slot_ids", "artifact_count", "formal_composition_count")
    allowed_dependencies = {
        plan["packet_slot_id"]
        for batch in committed_records(run_dir, "architecture_plan_batch")
        for plan in batch["packet_plans"]
    }
    for packet_id, spec in expected.items():
        if any(actual[packet_id][key] != spec[key] for key in fixed):
            raise SchemaError(f"Architecture plan batch changed frozen allocation {packet_id}")
        if not set(actual[packet_id]["depends_on_packet_slot_ids"]).issubset(allowed_dependencies):
            raise SchemaError(f"Architecture plan {packet_id} depends on an unfrozen future batch")
        allowed_dependencies.add(packet_id)
    if sequence == count:
        batches = sorted(committed_records(run_dir, "architecture_plan_batch") + [record], key=lambda item: item["batch_sequence"])
        validate_architecture(architecture_from_parts(core, batches), read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))


def validate_completed_architecture(run_dir: Path) -> None:
    architecture = committed_record(run_dir, "architecture")
    if not architecture:
        raise SchemaError("Architecture plan batches are incomplete")
    validate_architecture(architecture, read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))


def validate_ending_prerequisites(
    ending: dict,
    attractors: dict,
    obligation_state: dict,
    feasibility: dict,
    evidence_source_ids: set[str],
    satisfaction_evidence: dict[str, set[str]] | None = None,
) -> None:
    attractor = attractors.get(ending["attractor_id"])
    if not attractor or attractor["kind"] != "ending" or feasibility.get(ending["attractor_id"]) != "viable":
        raise SchemaError("Ending cannot realize an absent, non-ending, or nonviable attractor")
    satisfied = {
        key for key, value in obligation_state.items() if value["data"]["status"] == "satisfied"
    }
    prerequisites = set(attractor["prerequisite_obligation_ids"])
    if set(ending["satisfied_prerequisite_obligation_ids"]) != prerequisites or not prerequisites.issubset(satisfied):
        raise SchemaError("Ending cannot commit before every hard attractor prerequisite is satisfied")
    if not set(ending["prerequisite_evidence_source_ids"]).issubset(evidence_source_ids):
        raise SchemaError("Ending prerequisite evidence does not resolve to immutable source")
    satisfaction_evidence = satisfaction_evidence or {}
    required_evidence = {
        source_id for obligation_id in prerequisites for source_id in satisfaction_evidence.get(obligation_id, set())
    }
    if not required_evidence.issubset(ending["prerequisite_evidence_source_ids"]):
        raise SchemaError("Ending does not cite the evidence that satisfied its prerequisites")


def validate_packet_for_run(record: dict, run_dir: Path, plan: dict) -> None:
    architecture = committed_record(run_dir, "architecture")
    batch = plan_batch_for(run_dir, plan["packet_slot_id"])
    if (
        not architecture
        or not batch
        or record["architecture_core_commit_id"] != architecture["architecture_core_commit_id"]
        or record["packet_plan_commit_id"] != batch["commit_id"]
    ):
        raise SchemaError("Packet does not descend from its committed architecture and plan batch")
    if record["generation_id"] != run_dir.name or record["story_format"] != "web":
        raise SchemaError("Packet does not match the frozen run or active web format")
    committed_packet_count = sum(item.get("record_type") == "creative_packet" for item in all_committed_records(run_dir))
    if record["packet_sequence"] != committed_packet_count + 1:
        raise SchemaError("Packet sequence does not match immutable forward commit order")
    content = record["scenes"] if record["packet_kind"] == "literary" else record["endings"]
    occupied_slots = {
        item["technical_slot_id"]
        for chunk in packet_chunks(run_dir, record["packet_slot_id"])
        for item in (chunk["scenes"] if record["packet_kind"] == "literary" else chunk["endings"])
    }
    if occupied_slots & {item["technical_slot_id"] for item in content}:
        raise SchemaError("Packet chunk attempted to refill a committed technical slot")
    packet_words = packet_literary_word_count(record)
    if packet_words > PACKET_LITERARY_WORDS:
        raise SchemaError(f"Creative packet exceeds its {PACKET_LITERARY_WORDS:,}-word literary allowance")
    obligation_state = _read_state_map(run_dir, "obligations.json")
    obligations = set(obligation_state)
    arcs = {item["arc_id"] for item in architecture["arcs"]}
    claimants = {item["claimant_id"] for item in committed_record(run_dir, "genesis")["claimants"]}
    attractors = {item["attractor_id"]: item for item in architecture["attractors"]}
    if not set(record["obligations_advanced"]).issubset(obligations):
        raise SchemaError("Packet claims an unknown obligation")
    if any(scene["arc_id"] not in arcs or not set(scene["claimant_focus_ids"]).issubset(claimants) for scene in record["scenes"]):
        raise SchemaError("Packet scene references an unknown arc or claimant")
    if any(not set(item["claimant_relevance_ids"]).issubset(claimants) for item in record["artifacts"]):
        raise SchemaError("Packet artifact references an unknown claimant")
    if any(not set(item["claimant_pressure_ids"]).issubset(claimants) for item in record["endings"]):
        raise SchemaError("Packet ending references an unknown claimant")
    for scene in record["scenes"]:
        validate_markdown_source(scene["prose_mdx"], f"Scene {scene['scene_id']}")
    for artifact in record["artifacts"]:
        validate_markdown_source(artifact["body_mdx"], f"Artifact {artifact['artifact_id']}")
    for ending in record["endings"]:
        validate_markdown_source(ending["prose_mdx"], f"Ending {ending['ending_id']}")
    changes = record["constraint_delta"]
    known_propositions = set(_read_state_map(run_dir, "canonical-facts.json")) | {
        item["fact_id"] for item in changes["canonical_facts"]
    }
    if any(item["proposition_id"] not in known_propositions for item in changes["knowledge_changes"]):
        raise SchemaError("Knowledge state references an unknown proposition")
    new_obligation_ids = {item["obligation_id"] for item in changes["new_obligations"]}
    known_obligation_origins = set(_source_index(run_dir)) | (set(generated_ids(record)) - new_obligation_ids)
    validate_obligation_origins(changes["new_obligations"], known_obligation_origins, "New obligation")
    allowed_targets = (
        obligations
        | new_obligation_ids
        | set(attractors)
        | {item["packet_slot_id"] for item in architecture["packet_plans"] if item["packet_slot_id"] != plan["packet_slot_id"]}
    )
    for obligation in changes["new_obligations"]:
        if not set(obligation["requires"]).issubset(obligations | new_obligation_ids):
            raise SchemaError("New obligation references an unknown prerequisite")
        if obligation["range"] == "long_range" and not set(obligation["termination_targets"]).issubset(allowed_targets):
            raise SchemaError("New long-range obligation has no lawful future termination target")
    candidate_by_obligation = {
        obligation_id: candidate
        for candidate in changes["potential_foreclosures"]
        for obligation_id in candidate["negated_prerequisite_obligation_ids"]
    }
    for update in changes["obligation_updates"]:
        if update["obligation_id"] not in obligations:
            raise SchemaError("Obligation update references an unknown obligation")
        original = obligation_state[update["obligation_id"]]["data"]
        if update["status"] == "foreclosed" and original["universality"] == "universal" and original["hardness"] == "hard":
            raise SchemaError("A universal hard obligation cannot be foreclosed")
        if update["status"] in {"foreclosed", "impossible"}:
            candidate = candidate_by_obligation.get(update["obligation_id"])
            if not candidate or candidate["attractor_id"] not in original["termination_targets"]:
                raise SchemaError("An obligation may become impossible or foreclosed only with a scoped foreclosure candidate")
    for candidate in changes["potential_foreclosures"]:
        attractor = attractors.get(candidate["attractor_id"])
        if not attractor or not set(candidate["negated_prerequisite_obligation_ids"]).issubset(attractor["prerequisite_obligation_ids"]):
            raise SchemaError("Potential foreclosure does not negate a known attractor prerequisite")
        if any(
            obligation_state[item]["data"]["universality"] == "universal"
            and obligation_state[item]["data"]["hardness"] == "hard"
            for item in candidate["negated_prerequisite_obligation_ids"]
        ):
            raise SchemaError("A universal obligation cannot be used to foreclose an attractor")
    knowledge = _read_state_map(run_dir, "knowledge-state.json")
    learned_here = {
        (item["subject_id"], item["proposition_id"])
        for item in changes["knowledge_changes"]
        if item["action"] == "establish" and item["relation"] in {"knows", "believes", "suspects"}
    }
    for scene in record["scenes"]:
        for dependency in scene["epistemic_dependencies"]:
            unavailable = knowledge.get(dependency["subject_id"], {}).get("explicitly_does_not_know", {})
            if any(
                proposition in unavailable and (dependency["subject_id"], proposition) not in learned_here
                for proposition in dependency["proposition_ids"]
            ):
                raise SchemaError("Scene relies on knowledge explicitly unavailable to its character")
    prospective = _read_state_map(run_dir, "prospective-plan.json")
    feasibility = {item["attractor_id"]: item["status"] for item in prospective.get("feasibility", [])}
    satisfaction_evidence = {
        key: {source["artifact_id"] for source in value["resolution_event"]["sources"]}
        for key, value in obligation_state.items()
        if value["data"]["status"] == "satisfied" and "resolution_event" in value
    }
    satisfaction_evidence.update({
        item["obligation_id"]: {source["artifact_id"] for source in item["evidence_sources"]}
        for item in changes["obligation_updates"]
        if item["status"] == "satisfied"
    })
    for ending in record["endings"]:
        validate_ending_prerequisites(
            ending,
            attractors,
            obligation_state,
            feasibility,
            set(_source_index(run_dir)) | set(generated_ids(record)),
            satisfaction_evidence,
        )
    current_content = {item["scene_id"] for item in record["scenes"]} | {item["ending_id"] for item in record["endings"]}
    committed_content = {
        identifier
        for packet in all_committed_records(run_dir)
        if packet.get("record_type") == "creative_packet"
        for identifier in [
            *(item["scene_id"] for item in packet["scenes"]),
            *(item["ending_id"] for item in packet["endings"]),
        ]
    }
    declared_slots = {
        slot
        for packet_plan in architecture["packet_plans"]
        for slot in packet_plan["scene_slot_ids"] + packet_plan["ending_slot_ids"]
    }
    if any(edge["from_content_id"] not in current_content for edge in record["decision_edges"]):
        raise SchemaError("A packet cannot retroactively attach an edge to earlier content")
    destinations = [edge["destination"] for edge in record["decision_edges"]]
    destinations += [ending["redirect_destination"] for ending in record["endings"] if ending["redirect_destination"]]
    if any(destination["kind"] == "technical_slot" and destination["id"] not in declared_slots for destination in destinations):
        raise SchemaError("A packet references a technical destination outside frozen architecture")
    if any(destination["kind"] == "content" and destination["id"] not in current_content | committed_content for destination in destinations):
        raise SchemaError("A packet invented an uncommitted future literary content ID")
    geomancy = {item["technical_slot_id"]: item for item in ensure_frozen_geomancy(run_dir)["assignments"]}
    if any(
        scene["technical_slot_id"] not in geomancy
        or scene["threshold_figure"] != geomancy[scene["technical_slot_id"]]["figure"]
        or scene["threshold_resultant"] != geomancy[scene["technical_slot_id"]]["resultant"]
        for scene in record["scenes"]
    ):
        raise SchemaError("Packet changed its frozen threshold geomancy")
    validate_packet_against_plan(record, plan)


