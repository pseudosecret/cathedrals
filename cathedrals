def readable_search_text(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return "\n".join(readable_search_text(item) for item in value)
    if isinstance(value, dict):
        excluded = {"record_type", "protocol_version", "story_format", "web_art_direction", "web_composition",
                    "threshold_figure", "threshold_resultant", "source_locator", "source_hash", "sources", "evidence_sources"}
        return "\n".join(readable_search_text(item) for key, item in sorted(value.items())
                         if key not in excluded and not key.endswith(("_id", "_ids", "_hash"))
                         and not (key == "subject" and isinstance(item, str) and re.fullmatch(r"[a-z][a-z0-9]*(?:_[a-z0-9]+)+", item)))
    return "" if value is None else json.dumps(value, ensure_ascii=False)


def search_documents_for(record, meta, inherited_tags=None):
    documents = []
    event_by_id = {event["constraint_id"]: event for event in meta["constraint_events"]}

    def add(pointer, unit, kind, source_id=None):
        identifier = source_id or (unit["anchor"].get("claimant_id") if isinstance(unit, dict) and isinstance(unit.get("anchor"), dict) else None) or next((unit[key] for key in ("scene_id", "artifact_id", "ending_id", "composition_id", "edge_id",
            "arc_id", "node_id", "attractor_id", "packet_slot_id", "claimant_id", "character_id") if isinstance(unit, dict) and key in unit), record["commit_id"])
        event = event_by_id.get(identifier)
        tags = {key: list(values) for key, values in (inherited_tags or {}).items()}
        if isinstance(unit, dict):
            for key, values in unit.get("relevance", {}).items():
                tags.setdefault(key, []).extend(values)
            for field, key in (("arc_id", "arc_ids"), ("claimant_id", "claimant_ids"), ("character_id", "character_ids"),
                               ("technical_slot_id", "technical_slot_ids"), ("subject_id", "character_ids"), ("motif_id", "motif_ids")):
                if unit.get(field):
                    tags.setdefault(key, []).append(unit[field])
            tags.setdefault("claimant_ids", []).extend(unit.get("claimant_focus_ids", []))
            if isinstance(unit.get("anchor"), dict) and unit["anchor"].get("claimant_id"):
                tags.setdefault("claimant_ids", []).append(unit["anchor"]["claimant_id"])
        title = unit.get("title", unit.get("name", "")) if isinstance(unit, dict) else ""
        documents.append({"commit_id": record["commit_id"], "pointer": pointer, "source_id": identifier, "kind": kind,
            "sequence": meta["ledger_entry"]["ledger_sequence"], "title": title, "body": readable_search_text(unit),
            "event_sequence": event["constraint_event_sequence"] if event else None,
            "tags": {key: sorted(set(values)) for key, values in tags.items() if values}})

    def group(field, kind, parent=record, prefix=""):
        for index, unit in enumerate(parent.get(field, [])):
            add(f"{prefix}/{field}/{index}", unit, kind)

    kind = record["record_type"]
    if kind == "genesis_foundation":
        add("/work_canon", record["work_canon"], "root", record["work_canon"]["work_id"])
        add("/format_composition_law", record["format_composition_law"], "root")
        group("claimant_anchors", "root")
    elif kind == "genesis_cast":
        group("claimants", "root")
        group("characters", "root")
    elif kind == "genesis_constraints":
        group("claimant_extensions", "root")
    elif kind == "architecture_core":
        for field in ("arcs", "attractors"):
            group(field, "plan")
        for field in ("nodes", "edges"):
            group(field, "plan", record["topology"], "/topology")
    elif kind == "architecture_plan_batch":
        group("packet_plans", "plan")
    elif kind == "creative_packet":
        for field in ("scenes", "artifacts", "endings", "decision_edges"):
            group(field, "literary")
        group("formal_compositions", "composition")
    groups = [("/constraint_delta", record.get("constraint_delta", {}))]
    if kind == "architecture_core":
        groups.append(("", {"obligation_graph": record["obligation_graph"]}))
    for prefix, delta in groups:
        for field, units in delta.items():
            for index, unit in enumerate(units):
                identifier = next((unit[key] for key in ("fact_id", "knowledge_id", "update_id", "obligation_id", "motif_event_id", "foreclosure_id") if key in unit), None)
                add(f"{prefix}/{field}/{index}", unit, "constraint", identifier)
    return documents


def insert_search_document(db, document):
    fields = ("commit_id", "pointer", "source_id", "kind", "sequence", "title", "body", "event_sequence")
    cursor = db.execute("INSERT INTO search_documents(commit_id,pointer,source_id,kind,sequence,title,body,event_sequence) VALUES (?,?,?,?,?,?,?,?)",
                        tuple(document[key] for key in fields))
    identifier = cursor.lastrowid
    db.execute("INSERT INTO search_fts(rowid,title,body) VALUES (?,?,?)", (identifier, document["title"], document["body"]))
    db.executemany("INSERT INTO search_tags VALUES (?,?,?)", [(identifier, key, value) for key, values in document["tags"].items() for value in values])


def index_search_documents(db, record, meta):
    tags = {}
    if record.get("packet_slot_id"):
        for key, value in db.execute("SELECT t.key,t.value FROM search_tags t JOIN search_documents d ON d.id=t.document_id WHERE d.kind='plan' AND d.source_id=?", (record["packet_slot_id"],)):
            tags.setdefault(key, []).append(value)
    for document in search_documents_for(record, meta, tags):
        insert_search_document(db, document)


def search_index_matches(db, commits):
    expected, expected_tags, plan_tags = [], [], {}
    fields = ("commit_id", "pointer", "source_id", "kind", "sequence", "title", "body", "event_sequence")
    for _directory, meta, record in commits:
        if record["record_type"] == "architecture_plan_batch":
            for plan in record["packet_plans"]:
                plan_tags[plan["packet_slot_id"]] = plan.get("relevance", {})
        for document in search_documents_for(record, meta, plan_tags.get(record.get("packet_slot_id"))):
            expected.append(tuple(document[key] for key in fields))
            expected_tags.extend((document["commit_id"], document["pointer"], key, value) for key, values in document["tags"].items() for value in values)
    actual = db.execute("SELECT commit_id,pointer,source_id,kind,sequence,title,body,event_sequence FROM search_documents ORDER BY sequence,pointer").fetchall()
    tags = db.execute("SELECT d.commit_id,d.pointer,t.key,t.value FROM search_tags t JOIN search_documents d ON d.id=t.document_id ORDER BY d.commit_id,d.pointer,t.key,t.value").fetchall()
    if actual != sorted(expected, key=lambda row: (row[4], row[1])) or tags != sorted(expected_tags):
        return False
    db.execute("INSERT INTO search_fts(search_fts,rank) VALUES('integrity-check',1)")
    return True


def search_query(plan, genesis=None):
    terms, seen = [], set()

    def add(term):
        term = " ".join(term.replace("\x00", " ").split()).strip()
        if re.search(r"[^\W_]", term, re.UNICODE) and term.casefold() not in seen and len(terms) < SEARCH_TERMS:
            terms.append(term)
            seen.add(term.casefold())

    tags = plan.get("relevance", {})
    for term in tags.get("keywords", []):
        add(term)
    entity_ids = {identifier for key, values in tags.items() if key.endswith("_ids") for identifier in values}
    for entity in (genesis or {}).get("claimants", []) + (genesis or {}).get("characters", []):
        if entity.get("claimant_id", entity.get("character_id")) in entity_ids and entity.get("name"):
            add(entity["name"])
    guidance = re.sub(r"\b[^\W_]+(?:_[^\W_]+)+\b", " ", " ".join(plan.get("soft_guidance", [])))
    for word in re.findall(r"[^\W_]+", guidance, re.UNICODE):
        if len(word) >= 3 and not word.isdecimal():
            add(word)
    return {"terms": terms, "expression": " OR ".join('"' + term.replace('"', '""') + '"' for term in terms)}


def search_history(run_dir, query, *, constraints=False, plan=None, limit=SEARCH_CANDIDATES):
    if not query["expression"]:
        return []
    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        rows = db.execute("""SELECT d.id,d.commit_id,d.pointer,d.source_id,d.kind,d.sequence,d.event_sequence,bm25(search_fts,2.0,1.0)
            FROM search_fts JOIN search_documents d ON d.id=search_fts.rowid
            WHERE search_fts MATCH ? AND (d.kind='constraint')=?
            ORDER BY bm25(search_fts,2.0,1.0),d.sequence,d.commit_id,d.pointer LIMIT ?""", (query["expression"], int(constraints), limit)).fetchall()
        hits = []
        tags_by_id = {row[0]: {} for row in rows}
        if rows:
            identifiers = list(tags_by_id)
            for identifier,key,value in db.execute("SELECT document_id,key,value FROM search_tags WHERE document_id IN (" + ",".join("?" for _ in identifiers) + ") ORDER BY document_id,key,value", identifiers):
                tags_by_id[identifier].setdefault(key, []).append(value)
        for row in rows:
            hit = dict(zip(("document_id", "commit_id", "pointer", "source_id", "kind", "sequence", "event_sequence", "bm25"), row))
            hit["tags"] = tags_by_id[row[0]]
            hit["locality"] = sum(bool(set(values) & set((plan or {}).get("relevance", {}).get(key, []))) for key, values in hit["tags"].items())
            hits.append(hit)
        return sorted(hits, key=lambda hit: (hit["bm25"], -hit["locality"], hit["sequence"], hit["commit_id"], hit["pointer"]))


def read_search_source(run_dir, hit, cache=None):
    cache = {} if cache is None else cache
    if hit["commit_id"] not in cache:
        with index_connection(run_dir) as db:
            row = db.execute("SELECT path,record_hash FROM records WHERE commit_id=?", (hit["commit_id"],)).fetchone()
        if row is None:
            raise IntegrityError(f"Search source disappeared: {hit['commit_id']}")
        path = run_dir / row[0] / "record.json"
        verify_immutable_file(path, row[1])
        cache[hit["commit_id"]] = (read_json(path), row[1], str(path))
    record, digest, archive = cache[hit["commit_id"]]
    value = read_evidence_pointer(record, hit["pointer"], source_id=hit["source_id"], archive=archive)
    return {"source_id": hit["source_id"], "source_commit_id": hit["commit_id"], "source_hash": digest,
            "record_pointer": hit["pointer"], "authority": {"plan": "PLANNED INTENTION", "root": "GENERATED ROOT CANON",
                "literary": "COMMITTED LITERARY MATERIAL", "composition": "COMMITTED COMPOSITION METADATA", "constraint": "CONSTRAINT HISTORY"}[hit["kind"]],
            "immutable_source": value}


def event_relevance_tags(event):
    data = event["data"]
    tags = {key: list(values) for key, values in data.get("relevance", {}).items()}
    if data.get("obligation_id"):
        tags["_obligation"] = [data["obligation_id"]]
    if event["constraint_kind"] == "knowledge_state":
        tags["_knowledge_character"] = list(set(tags.get("character_ids", [])) | {data["subject_id"]})
    return tags


def index_event(db, event):
    sequence, kind, data = event["constraint_event_sequence"], event["constraint_kind"], event["data"]
    expected = db.execute("SELECT event_sequence+1 FROM checkpoint WHERE id=1").fetchone()[0]
    if sequence != expected:
        raise IntegrityError("Constraint event sequence is invalid")
    db.execute("INSERT INTO events VALUES (?,?,?,?)", (sequence, event["constraint_id"], kind, canonical_json(event).decode()))
    db.executemany("INSERT INTO event_relevance VALUES (?,?,?)", [(sequence,key,value) for key, values in event_relevance_tags(event).items() for value in sorted(set(values))])
    for source in event["sources"]:
        resolved = db.execute("SELECT commit_id,hash FROM sources WHERE id=?", (source["artifact_id"],)).fetchone()
        if resolved != (source["source_commit_id"], source["source_hash"]):
            raise IntegrityError(f"Constraint source provenance changed: {source['artifact_id']}")
        db.execute("INSERT INTO event_sources VALUES (?,?,?,?)", (sequence, source["artifact_id"], *resolved))
    if kind == "canonical_fact":
        if data.get("supersedes_fact_id"):
            db.execute("DELETE FROM projection WHERE map='canonical-facts.json' AND key=?", (data["supersedes_fact_id"],))
        put_projection(db, "canonical-facts.json", data["fact_id"], event, sequence)
    elif kind == "knowledge_state":
        db.execute("INSERT OR IGNORE INTO subjects VALUES (?,?)", (data["subject_id"], sequence))
        keys = (data["subject_id"], data["relation"], data["proposition_id"])
        if data["action"] == "retract":
            db.execute("DELETE FROM knowledge WHERE subject=? AND relation=? AND proposition=?", keys)
        else:
            db.execute("INSERT INTO knowledge VALUES (?,?,?,?,?,?) ON CONFLICT(subject,relation,proposition) DO UPDATE SET payload=excluded.payload,event_sequence=excluded.event_sequence",
                       (*keys, canonical_json(event).decode(), sequence, sequence))
    elif kind == "obligation":
        put_projection(db, "obligations.json", data["obligation_id"], event, sequence)
    elif kind == "obligation_update":
        row = db.execute("SELECT payload FROM projection WHERE map='obligations.json' AND key=?", (data["obligation_id"],)).fetchone()
        if row is None:
            raise IntegrityError(f"Obligation update references unknown obligation: {data['obligation_id']}")
        obligation = json.loads(row[0])
        obligation["data"]["status"] = data["status"]
        obligation["resolution_event"] = event
        put_projection(db, "obligations.json", data["obligation_id"], obligation, sequence)
    elif kind == "motif_state":
        motif = {"motif_id": data["motif_id"], "appearances": [], "provenance": [],
                 **{key: data[key] for key in ("current_function", "pressure", "overuse_risk")}}
        put_projection(db, "motifs.json", data["motif_id"], motif, sequence)
        db.execute("INSERT INTO motif_history VALUES (?,?,?,?)", (sequence, data["motif_id"], event["constraint_id"],
                   canonical_json([source["artifact_id"] for source in event["sources"]]).decode()))
    elif kind == "foreclosure_candidate":
        put_projection(db, "foreclosure-candidates.json", event["constraint_id"], event, sequence)
    db.execute("UPDATE checkpoint SET event_sequence=? WHERE id=1", (sequence,))


def index_entry(db, entry):
    sequence = entry["ledger_sequence"]
    previous, head = db.execute("SELECT ledger_sequence,ledger_hash FROM checkpoint WHERE id=1").fetchone()
    if sequence != previous + 1 or entry["previous_entry_hash"] != head:
        raise IntegrityError("SQLite ledger checkpoint disagrees with the durable step")
    db.execute("INSERT INTO ledger VALUES (?,?,?,?,?,?,?,?)", (sequence, entry["planned_step_id"], entry["attempt"],
        entry["step_type"], entry["commit_status"], entry["failure_class"], entry["entry_hash"], canonical_json(entry).decode()))
    committed = entry["commit_status"] == "COMMITTED"
    usage = entry["token_accounting"]
    db.execute("UPDATE checkpoint SET ledger_sequence=?,ledger_hash=?,canonical_hash=?,creative_count=creative_count+?,analysis_count=analysis_count+?,input_tokens=input_tokens+?,output_tokens=output_tokens+? WHERE id=1",
               (sequence, entry["entry_hash"], entry["canonical_state_hash_after"], int(committed and entry["step_type"] == "creative"),
                int(committed and entry["step_type"] == "analysis"), usage["input_tokens"] or 0, usage["output_tokens"] or 0))


def index_commit(db, directory, meta, record):
    db.execute("INSERT INTO records VALUES (?,?,?,?,?,?,?,?)", (record["commit_id"], meta["ledger_entry"]["ledger_sequence"],
        meta["ledger_entry"]["planned_step_id"], record["record_type"], record.get("packet_slot_id"), directory,
        meta["record_hash"], canonical_json(record).decode()))
    for identifier in generated_ids(record):
        db.execute("INSERT INTO sources VALUES (?,?,?)", (identifier, record["commit_id"], meta["record_hash"]))
    for event in meta["constraint_events"]:
        index_event(db, event)
    index_search_documents(db, record, meta)


def index_plan(db, plan):
    sequence = int(plan["plan_id"].rsplit("_", 1)[1])
    db.execute("INSERT INTO plans VALUES (?,?,?,?)", (sequence, plan["plan_id"], plan["recomputed_after_commit_id"], canonical_json(plan).decode()))
    put_projection(db, "prospective-plan.json", "latest", plan, sequence)


def rebuild_index(run_dir, entries, commits, plans):
    destination = index_path(run_dir)
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix="index-", suffix=".sqlite3", dir=destination.parent)
    os.close(descriptor)
    try:
        db = sqlite3.connect(temporary)
        try:
            db.execute("PRAGMA foreign_keys=ON")
            create_index_schema(db, load_state(run_dir))
            by_sequence = {meta["ledger_entry"]["ledger_sequence"]: (directory, meta, record) for directory, meta, record in commits}
            with db:
                for entry in entries:
                    index_entry(db, entry)
                    if entry["ledger_sequence"] in by_sequence:
                        index_commit(db, *by_sequence[entry["ledger_sequence"]])
                for plan in plans:
                    index_plan(db, plan)
                for path in sorted((run_dir / ".staging").glob("*.planning.json")):
                    index_staged_plan(db, path.name.removesuffix(".planning.json"), read_json(path))
        finally:
            db.close()
        os.replace(temporary, destination)
    except sqlite3.Error as error:
        raise PausedError("SQLite recovery", f"Could not rebuild the index; archives were preserved: {error}") from error
    finally:
        Path(temporary).unlink(missing_ok=True)


def index_matches(run_dir, entries, commits, plans, expected_maps, sources, events):
    if not index_path(run_dir).exists():
        return False
    try:
        with closing(sqlite3.connect(index_path(run_dir))) as db:
            state = load_state(run_dir)
            if db.execute("PRAGMA user_version").fetchone()[0] != INDEX_VERSION or db.execute("PRAGMA quick_check").fetchone()[0] != "ok":
                return False
            if db.execute("SELECT * FROM identity").fetchall() != [(state["generation_id"], state["manifest_hash"])]:
                return False
            expected_ledger = [(item["ledger_sequence"], item["planned_step_id"], item["attempt"], item["step_type"],
                item["commit_status"], item["failure_class"], item["entry_hash"], canonical_json(item).decode()) for item in entries]
            if db.execute("SELECT * FROM ledger ORDER BY sequence").fetchall() != expected_ledger:
                return False
            expected_records = [(record["commit_id"], meta["ledger_entry"]["ledger_sequence"], meta["ledger_entry"]["planned_step_id"],
                record["record_type"], record.get("packet_slot_id"), directory, meta["record_hash"], canonical_json(record).decode()) for directory, meta, record in commits]
            if db.execute("SELECT * FROM records ORDER BY sequence").fetchall() != expected_records:
                return False
            actual_sources = {identifier: {"commit_id": commit_id, "hash": digest} for identifier, commit_id, digest in db.execute("SELECT * FROM sources ORDER BY rowid")}
            expected_events = [(item["constraint_event_sequence"], item["constraint_id"], item["constraint_kind"], canonical_json(item).decode()) for item in events]
            if actual_sources != sources or db.execute("SELECT * FROM events ORDER BY sequence").fetchall() != expected_events:
                return False
            expected_sources = [(item["constraint_event_sequence"], source["artifact_id"], source["source_commit_id"], source["source_hash"])
                                for item in events for source in item["sources"]]
            if db.execute("SELECT * FROM event_sources ORDER BY rowid").fetchall() != expected_sources or db.execute("PRAGMA foreign_key_check").fetchall():
                return False
            if any(read_projection(db, name) != value for name, value in zip(STATE_MAPS, expected_maps)):
                return False
            if [json.loads(row[0]) for row in db.execute("SELECT payload FROM plans ORDER BY sequence")] != plans:
                return False
            if read_projection(db, "prospective-plan.json") != (plans[-1] if plans else {}):
                return False
            if not search_index_matches(db, commits):
                return False
            expected_relevance = []
            for event in events:
                tags = event_relevance_tags(event)
                expected_relevance.extend((event["constraint_event_sequence"],key,value) for key, values in tags.items() for value in set(values))
            if db.execute("SELECT * FROM event_relevance ORDER BY event_sequence,key,value").fetchall() != sorted(expected_relevance):
                return False
            head = entries[-1] if entries else None
            expected = (1, len(entries), head["entry_hash"] if head else None,
                head["canonical_state_hash_after"] if head else state["manifest_hash"], len(events),
                sum(item["step_type"] == "creative" and item["commit_status"] == "COMMITTED" for item in entries),
                sum(item["step_type"] == "analysis" and item["commit_status"] == "COMMITTED" for item in entries),
                sum(item["token_accounting"]["input_tokens"] or 0 for item in entries),
                sum(item["token_accounting"]["output_tokens"] or 0 for item in entries))
            return db.execute("SELECT * FROM checkpoint").fetchall() == [expected]
    except (sqlite3.Error, ValueError, KeyError, TypeError, AttributeError):
        return False


def indexed_records(run_dir, record_type=None, packet_slot_id=None):
    ensure_index(run_dir)
    query, parameters = "SELECT payload FROM records WHERE 1=1", []
    for key, value in (("record_type", record_type), ("packet_slot_id", packet_slot_id)):
        if value is not None:
            query += f" AND {key}=?"
            parameters.append(value)
    with index_connection(run_dir) as db:
        return [json.loads(row[0]) for row in db.execute(query + " ORDER BY sequence", parameters)]


def constraint_events(run_dir):
    ensure_index(run_dir)
    with index_connection(run_dir) as db:
        return [json.loads(row[0]) for row in db.execute("SELECT payload FROM events ORDER BY sequence")]


def ledger_entries(run_dir: Path) -> list[dict]:
    if run_dir not in _REPLAYING and index_path(run_dir).exists():
        return indexed_ledger(run_dir)
    path = run_dir / "ledger.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def compute_entry_hash(entry: dict) -> str:
    payload = dict(entry)
    payload.pop("entry_hash", None)
    return sha256_bytes(canonical_json(payload))


def append_ledger_entry(run_dir: Path, entry: dict, *, commit=None, plan=None) -> None:
    protocol = load_protocol(run_dir)
    validate_json_schema(entry, protocol["$defs"]["ledgerEntry"], protocol)
    if run_dir in _REPLAYING:
        entries = ledger_entries(run_dir)
        expected_sequence = len(entries) + 1
        expected_previous = entries[-1]["entry_hash"] if entries else None
    else:
        checkpoint = index_checkpoint(run_dir)
        expected_sequence = checkpoint["ledger_sequence"] + 1
        expected_previous = checkpoint["ledger_hash"]
    if entry["ledger_sequence"] != expected_sequence or entry["previous_entry_hash"] != expected_previous:
        raise IntegrityError("Ledger sequence or previous-entry hash is invalid")
    if compute_entry_hash(entry) != entry["entry_hash"]:
        raise IntegrityError("Ledger entry hash is invalid")
    path = run_dir / "ledger.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("ab") as handle:
        handle.write(canonical_json(entry))
        handle.flush()
        os.fsync(handle.fileno())
    if run_dir not in _REPLAYING:
        if commit is not None:
            directory, meta, record = commit
            constraint_path = run_dir / "constraints/constraint-events.jsonl"
            constraint_path.parent.mkdir(parents=True, exist_ok=True)
            with constraint_path.open("ab") as handle:
                handle.write(b"".join(canonical_json(event) for event in meta["constraint_events"]))
                handle.flush()
                os.fsync(handle.fileno())
        with index_connection(run_dir) as db:
            index_entry(db, entry)
            if commit is not None:
                index_commit(db, str(directory.relative_to(run_dir)), meta, record)
            if plan is not None:
                index_plan(db, plan)
        refresh_run_counters(run_dir)
        if entry["provider"] and (run_dir / "run-manifest.json").exists() and execution_policy(run_dir):
            phase = entry["step_phase"]
            with index_connection(run_dir) as db:
                calls, input_tokens, output_tokens, reasoning, retries = db.execute("""SELECT COUNT(*),
                    COALESCE(SUM(json_extract(payload,'$.token_accounting.input_tokens')),0),
                    COALESCE(SUM(json_extract(payload,'$.token_accounting.output_tokens')),0),
                    COALESCE(SUM(json_extract(payload,'$.token_accounting.reasoning_tokens')),0),
                    COALESCE(SUM(status!='COMMITTED'),0) FROM ledger
                    WHERE json_extract(payload,'$.step_phase')=? AND json_extract(payload,'$.provider') IS NOT NULL
                    AND json_extract(payload,'$.parameters.assembly') IS NULL""", (phase,)).fetchone()
            print(f"{phase}: {calls} calls; input {input_tokens:,}; output {output_tokens:,} "
                f"(reasoning {reasoning:,}); retries {retries}; retrieval {execution_policy(run_dir)['retrieval_mode']}", file=sys.stderr, flush=True)


def new_ledger_entry(
    run_dir: Path,
    *,
    planned_step_id: str,
    attempt: int,
    step_type: str,
    step_phase: str,
    parent_state_hash: str,
    prompt_hash: str | None,
    context_hash: str | None,
    provider: str | None,
    model: str | None,
    parameters: dict | None,
    seed: str | None,
    started_at: str,
    output_hash: str | None,
    generated_ids: list[str],
    past_constraint_ids: list[str],
    future_obligation_ids: list[str],
    motif_ids: list[str],
    prospective_plan_hash: str | None = None,
    branch_relation: str | None,
    commit_status: str,
    state_hash_after: str,
    failure_class: str,
    usage: dict | None = None,
) -> dict:
    if run_dir in _REPLAYING:
        entries = ledger_entries(run_dir)
        sequence, previous = len(entries), entries[-1]["entry_hash"] if entries else None
    else:
        checkpoint = index_checkpoint(run_dir)
        sequence, previous = checkpoint["ledger_sequence"], checkpoint["ledger_hash"]
    usage = usage or {}
    entry = {
        "record_type": "ledger_entry",
        "protocol_version": PROTOCOL_VERSION,
        "generation_id": load_state(run_dir)["generation_id"],
        "ledger_sequence": sequence + 1,
        "planned_step_id": planned_step_id,
        "attempt": attempt,
        "step_type": step_type,
        "step_phase": step_phase,
        "previous_entry_hash": previous,
        "entry_hash": "0" * 64,
        "parent_canonical_state_hash": parent_state_hash,
        "prompt_hash": prompt_hash,
        "context_hash": context_hash,
        "provider": provider,
        "model": model,
        "parameters": parameters,
        "seed": seed,
        "started_at": started_at,
        "completed_at": utc_now(),
        "output_hash": output_hash,
        "generated_artifact_ids": sorted(set(generated_ids)),
        "past_constraint_delta_ids": sorted(set(past_constraint_ids)),
        "future_obligation_delta_ids": sorted(set(future_obligation_ids)),
        "motif_pressure_delta_ids": sorted(set(motif_ids)),
        "prospective_plan_hash_after": prospective_plan_hash,
        "branch_path_relation": branch_relation,
        "commit_status": commit_status,
        "canonical_state_hash_after": state_hash_after,
        "failure_class": failure_class,
        "token_accounting": {
            "input_tokens": usage.get("prompt_tokens"),
            "output_tokens": usage.get("completion_tokens"),
            "cost": usage.get("cost"),
            "currency": usage.get("currency"),
        },
    }
    reasoning = (usage.get("completion_tokens_details") or {}).get("reasoning_tokens")
    if reasoning is not None:
        entry["token_accounting"]["reasoning_tokens"] = reasoning
    entry["entry_hash"] = compute_entry_hash(entry)
    return entry


def append_deterministic_step(
    run_dir: Path,
    step_id: str,
    phase: str,
    output_hash: str,
    *,
    prospective_plan_hash: str | None = None,
    plan: dict | None = None,
) -> None:
    if step_is_committed(run_dir, step_id):
        return
    state = load_state(run_dir)
    entry = new_ledger_entry(
        run_dir,
        planned_step_id=step_id,
        attempt=1,
        step_type="deterministic",
        step_phase=phase,
        parent_state_hash=state["canonical_state_hash"],
        prompt_hash=None,
        context_hash=None,
        provider=None,
        model=None,
        parameters=None,
        seed=None,
        started_at=utc_now(),
        output_hash=output_hash,
        generated_ids=[],
        past_constraint_ids=[],
        future_obligation_ids=[],
