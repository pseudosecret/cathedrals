def parse_node_version(value: str) -> tuple[int, int, int] | None:
    match = re.match(r"v?(\d+)\.(\d+)\.(\d+)", value.strip())
    return tuple(map(int, match.groups())) if match else None


def download(url: str, destination: Path) -> None:
    request = urllib.request.Request(url, headers={"User-Agent": "Cathedrals generator"})
    with urllib.request.urlopen(request, timeout=120) as response, destination.open("wb") as handle:
        shutil.copyfileobj(response, handle)


def ensure_node(output_fn=print) -> tuple[Path, Path]:
    system_node = shutil.which("node")
    system = run_command([system_node, "--version"]) if system_node else None
    version = parse_node_version(system.stdout) if system and system.returncode == 0 else None
    if version and version >= NODE_MINIMUM and version[0] % 2 == 0 and shutil.which("npm"):
        return Path(shutil.which("node")), Path(shutil.which("npm"))
    machine = platform.machine().lower()
    architecture = "x64" if machine in {"x86_64", "amd64"} else "arm64" if machine in {"aarch64", "arm64"} else None
    if not architecture:
        raise CathedralsError("Web toolchain", f"No pinned Node binary is configured for {machine}", "build_failure")
    base = RUNTIME_ROOT / "toolchains/node" / NODE_VERSION
    node = base / f"node-v{NODE_VERSION}-linux-{architecture}/bin/node"
    npm = node.parent / "npm"
    if node.exists() and npm.exists():
        return node, npm
    output_fn(f"      Downloading pinned Node {NODE_VERSION} into .cathedrals/toolchains/node/")
    base.mkdir(parents=True, exist_ok=True)
    archive_name = f"node-v{NODE_VERSION}-linux-{architecture}.tar.xz"
    release = f"https://nodejs.org/download/release/v{NODE_VERSION}"
    with tempfile.TemporaryDirectory(dir=RUNTIME_ROOT / "cache") as temporary:
        archive = Path(temporary) / archive_name
        checksums = Path(temporary) / "SHASUMS256.txt"
        download(f"{release}/{archive_name}", archive)
        download(f"{release}/SHASUMS256.txt", checksums)
        expected = next((line.split()[0] for line in checksums.read_text().splitlines() if line.endswith(f"  {archive_name}")), None)
        if not expected or sha256_file(archive) != expected:
            raise CathedralsError("Web toolchain", "Pinned Node download failed SHA-256 verification", "build_failure")
        with tarfile.open(archive, "r:xz") as bundle:
            try:
                bundle.extractall(base, filter="data")
            except TypeError:
                if any(member.name.startswith("/") or ".." in Path(member.name).parts for member in bundle.getmembers()):
                    raise CathedralsError("Web toolchain", "Unsafe path in Node archive", "build_failure")
                bundle.extractall(base)
    return node, npm


def build_web(run_dir: Path, project: Path, output_fn=print) -> dict:
    node, npm = ensure_node(output_fn)
    environment = os.environ.copy()
    environment["PATH"] = str(node.parent) + os.pathsep + environment.get("PATH", "")
    environment["npm_config_cache"] = str(RUNTIME_ROOT / "cache/npm")
    install = run_command([npm, "install", "--no-audit", "--no-fund"], cwd=project, env=environment)
    (run_dir / "logs/npm-install.log").write_text(install.stdout + install.stderr, encoding="utf-8")
    if install.returncode:
        raise CathedralsError("Astro dependency install", "npm install failed; see the run log", "build_failure")
    build = run_command([npm, "run", "build"], cwd=project, env=environment)
    (run_dir / "logs/astro-build.log").write_text(build.stdout + build.stderr, encoding="utf-8")
    if build.returncode:
        raise CathedralsError("Astro build", "Astro static build failed; see the run log", "build_failure")
    required = [project / "dist/index.html", project / "dist/work.json"]
    reasons = [f"Missing static build output: {path.name}" for path in required if not path.exists()]
    verdict = {"result": "FAIL" if reasons else "PASS", "reasons": reasons or ["Astro emitted the complete static reader and immutable work data."]}
    write_json(run_dir / "validation/build.json", verdict)
    if reasons:
        raise CathedralsError("Static build validation", reasons[0], "build_failure")
    append_deterministic_step(run_dir, "static_astro_build", "build_validation", sha256_bytes(canonical_json(verdict)))
    return verdict


def preflight_model_capacity(base_url: str, model: str, output_fn=print, transport=http_json) -> None:
    required = 49152 + 10900 + 4096
    try:
        payload = transport("GET", api_url(base_url, "/api/v1/models"), timeout=10.0)
    except CathedralsError as error:
        raise CathedralsError(
            "LM Studio preflight",
            "LM Studio model capacity could not be read from /api/v1/models. Update LM Studio, keep the Local Server running, and try again.",
            error.failure_class,
        ) from error
    limits = []
    loaded_limits = []
    for candidate in payload.get("models", []) if isinstance(payload, dict) else []:
        if candidate.get("type") != "llm":
            continue
        for instance in candidate.get("loaded_instances", []):
            config = instance.get("config", {})
            limit = config.get("context_length") or candidate.get("max_context_length")
            if isinstance(limit, int):
                loaded_limits.append(limit)
            if model in {candidate.get("key"), instance.get("id")}:
                if isinstance(limit, int):
                    limits.append(limit)
    if not limits and len(loaded_limits) == 1:
        limits = loaded_limits
    if not limits:
        raise CathedralsError("LM Studio preflight", f"No loaded context limit could be resolved for {model!r}.", "budget_exhaustion")
    if limits and max(limits) < required:
        raise CathedralsError(
            "LM Studio preflight",
            f"The selected model is loaded with a {max(limits):,}-token context; Cathedrals requires at least {required:,} for a prepared packet, output, and safety reserve.",
            "budget_exhaustion",
        )


def committed_hashes(run_dir: Path) -> dict[str, str]:
    values = {"run_manifest": sha256_file(run_dir / "run-manifest.json")}
    for directory in committed_directories(run_dir):
        record = read_json(directory / "record.json")
        identifier = record.get("commit_id", record.get("index_batch_id", directory.name))
        values[identifier] = sha256_file(directory / "record.json")
    return values


def make_finalization(run_dir: Path, status: str, failure_class: str, reason: str | None = None) -> dict:
    state = load_state(run_dir)
    entries = ledger_entries(run_dir)
    mechanical = read_json(run_dir / "validation/mechanical.json") if (run_dir / "validation/mechanical.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    artistic = read_json(run_dir / "validation/artistic.json") if (run_dir / "validation/artistic.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    build = read_json(run_dir / "validation/build.json") if (run_dir / "validation/build.json").exists() else {"result": "NOT_RUN", "reasons": [reason or "Not reached."]}
    ready = status == "READY_TO_PLAY"
    if not ready and reason:
        target = mechanical if mechanical["result"] == "NOT_RUN" else build if build["result"] == "NOT_RUN" else None
        if target:
            target["reasons"] = [reason]
    memory_path = run_dir / "memory/memory-events.jsonl"
    finalization = {
        "record_type": "finalization",
        "protocol_version": "2.0",
        "generation_id": run_dir.name,
        "run_status": status,
        "run_manifest_hash": state["manifest_hash"],
        "generation_brief_hash": state["brief_hash"],
        "completed_at": utc_now(),
        "creative_step_count": state["creative_step_count"],
        "analysis_or_index_step_count": state["analysis_or_index_step_count"],
        "human_intervention_count": state["human_intervention_count"],
        "committed_rewrite_count": state["committed_rewrite_count"],
        "committed_regeneration_count": state["committed_regeneration_count"],
        "backtrack_count": state["backtrack_count"],
        "ledger_head_hash": entries[-1]["entry_hash"],
        "committed_record_hashes": committed_hashes(run_dir),
        "memory_event_stream_hash": sha256_file(memory_path) if memory_path.exists() else sha256_bytes(b""),
        "token_accounting": {"input_tokens": state["input_tokens"], "output_tokens": state["output_tokens"], "cost": state["cost"], "currency": None},
        "mechanical_validation": mechanical,
        "artistic_acceptance": artistic,
        "static_build_validation": build,
        "complete_work_barrier_satisfied": ready,
        "playable": ready,
        "failure_class": failure_class,
    }
    protocol = load_protocol()
    validate_json_schema(finalization, protocol["$defs"]["finalization"], protocol)
    return finalization


def copy_provenance(run_dir: Path, destination: Path) -> None:
    destination.mkdir(parents=True, exist_ok=True)
    for name in ("generation-brief.json", "run-manifest.json", "ledger.jsonl", "finalization.json"):
        source = run_dir / name
        if source.exists():
            shutil.copy2(source, destination / ("run-ledger.jsonl" if name == "ledger.jsonl" else name))
    for name in ("raw", "committed", "memory", "validation"):
        source = run_dir / name
        if source.exists():
            shutil.copytree(source, destination / name, dirs_exist_ok=True)


def publish_success(run_dir: Path, project: Path) -> Path:
    parent = ROOT / "generated-work"
    destination = parent / run_dir.name
    if destination.exists():
        raise IntegrityError(f"Refusing to overwrite published generation {destination}")
    staging = run_dir / "publish-staging"
    if staging.exists():
        shutil.rmtree(staging)
    shutil.copytree(project, staging / "web", ignore=shutil.ignore_patterns("node_modules"))
    copy_provenance(run_dir, staging / "provenance")
    parent.mkdir(parents=True, exist_ok=True)
    os.replace(staging, destination)
    return destination / "web/dist"


def publish_failure_provenance(run_dir: Path) -> None:
    destination = ROOT / "generated-work" / run_dir.name / "provenance"
    if destination.exists():
        return
    copy_provenance(run_dir, destination)


def finalize_success(run_dir: Path, project: Path) -> tuple[Path, dict]:
    reconcile_run(run_dir)
    finalization = make_finalization(run_dir, "READY_TO_PLAY", "none")
    write_json(run_dir / "finalization.json", finalization, mode=0o444, exclusive=True)
    build_path = publish_success(run_dir, project)
    state = load_state(run_dir)
    state["status"] = "READY_TO_PLAY"
    state["stage"] = "READY_TO_PLAY"
    state["completed_at"] = finalization["completed_at"]
    state["build_path"] = str(build_path)
    save_state(run_dir, state)
    return build_path, finalization


def finalize_failure(run_dir: Path, error: CathedralsError) -> dict:
    existing = run_dir / "finalization.json"
    if existing.exists():
        finalization = read_json(existing)
        if finalization["run_status"] == "READY_TO_PLAY":
            return finalization
        return finalization
    finalization = make_finalization(run_dir, "FAILED_GENERATION", error.failure_class, error.reason)
    write_json(existing, finalization, mode=0o444, exclusive=True)
    state = load_state(run_dir)
    state["status"] = "FAILED_GENERATION"
    state["stage"] = error.stage
    state["failure_reason"] = error.reason
    state["completed_at"] = finalization["completed_at"]
    save_state(run_dir, state)
    publish_failure_provenance(run_dir)
    return finalization


def ensure_resume_ready(run_dir: Path, output_fn=print, transport=http_json) -> None:
    state = load_state(run_dir)
    if current_branch() != state["branch"]:
        if git("status", "--porcelain"):
            raise CathedralsError("Resume preflight", "The worktree has changes; cannot switch to the frozen generation branch.")
        git("switch", state["branch"])
    reconcile_run(run_dir)
    brief = read_json(run_dir / "generation-brief.json")
    payload = transport("GET", api_url(brief["lm_studio_base_url"], "/v1/models"), timeout=10.0)
    if state["model"] not in usable_model_ids(payload):
        raise CathedralsError("Resume preflight", f"Frozen model {state['model']!r} is no longer visible to LM Studio.", "provider_before_creative_output")
    preflight_model_capacity(brief["lm_studio_base_url"], state["model"], output_fn, transport)


def execute_run(run_dir: Path, output_fn=print, transport=http_json) -> tuple[Path, dict, dict]:
    execute_creative_phases(run_dir, output_fn, transport)
    output_fn("[05] Complete web projection        …")
    project, counts = project_web(run_dir)
    output_fn("[05] Complete web projection        ✓")
    output_fn("[06] Mechanical validation          …")
    mechanical = validate_complete_work(run_dir)
    if mechanical["result"] != "PASS":
        raise CathedralsError("Mechanical validation", mechanical["reasons"][0], "mechanical_validation")
    output_fn("[06] Mechanical validation          ✓")
    output_fn("[07] Whole-work artistic acceptance …")
    artistic = artistic_acceptance(run_dir, transport=transport)
    if artistic["result"] != "PASS":
        raise CathedralsError("Whole-work artistic acceptance", artistic["reasons"][0], "artistic_rejection")
    output_fn("[07] Whole-work artistic acceptance ✓")
    output_fn("[08] Static Astro build             …")
    build_web(run_dir, project, output_fn)
    output_fn("[08] Static Astro build             ✓")
    build_path, _ = finalize_success(run_dir, project)
    return build_path, counts, read_json(run_dir / "generation-brief.json")


def print_failure(run_dir: Path | None, error: CathedralsError, output_fn=print) -> None:
    output_fn("\nFAILED_GENERATION\n")
    output_fn(f"Generation:\n{run_dir.name if run_dir else 'not created'}\n")
    output_fn(f"Failure stage:\n{error.stage}\n")
    output_fn(f"Reason:\n{error.reason}\n")
    output_fn("Committed work was not rewritten.\nNo partial game is playable.")


def print_success(run_dir: Path, build_path: Path, counts: dict, brief: dict, output_fn=print) -> None:
    output_fn("\nREADY_TO_PLAY\n")
    output_fn(f"Project: {brief['project_name']}")
    output_fn(f"Generation: {run_dir.name}")
    output_fn("Format: web")
    output_fn(f"Scenes: {counts['scenes']}")
    output_fn(f"Artifacts: {counts['artifacts']}")
    output_fn(f"Endings: {counts['endings']}\n")
    output_fn(f"Build:\n{build_path}\n")
    output_fn(f"Run:\npython3 -m http.server 4321 --directory {build_path}")


def main(argv=None, *, input_fn=input, output_fn=print, transport=http_json) -> int:
    parser = argparse.ArgumentParser(description="Generate one complete static Cathedrals work through LM Studio.")
    parser.parse_args(argv)
    run_dir = None
    try:
        ensure_runtime_layout()
        run_dir = choose_resume(input_fn, output_fn)
        if run_dir:
            ensure_resume_ready(run_dir, output_fn, transport)
            brief = read_json(run_dir / "generation-brief.json")
            output_fn(f"Generation: {run_dir.name}\nFormat: web\nModel: {brief['model']}\nRequested scope: up to {brief['possible_scene_count']} scenes\n")
            output_fn("[01] Preflight                     ✓ resumed")
            output_fn("[02] Engine frozen                ✓ verified")
        else:
            frozen = collect_inputs(input_fn, output_fn)
            base_url = configured_lm_studio_url()
            model = lm_studio_preflight(base_url, os.environ.get("CATHEDRALS_MODEL"), input_fn, output_fn, transport)
            preflight_model_capacity(base_url, model, output_fn, transport)
            run_dir = create_run(frozen, base_url, model, output_fn)
            output_fn("[01] Preflight                     ✓")
            output_fn("[02] Engine frozen                ✓")
        build_path, counts, brief = execute_run(run_dir, output_fn, transport)
        print_success(run_dir, build_path, counts, brief, output_fn)
        return 0
    except KeyboardInterrupt:
        if run_dir:
            output_fn(f"\nGeneration interrupted before its next commit.\nRun ./cathedrals again to resume {run_dir.name}.")
        else:
            output_fn("\nCancelled before generation state was created.")
        return 130
    except CathedralsError as error:
        if run_dir and state_path(run_dir).exists():
            try:
                finalize_failure(run_dir, error)
            except Exception as finalization_error:
                error = CathedralsError(error.stage, f"{error.reason} (failure finalization also failed: {finalization_error})", error.failure_class)
        print_failure(run_dir, error, output_fn)
        return 1
    except Exception as error:
        wrapped = CathedralsError("Generator", str(error) or error.__class__.__name__)
        if run_dir and state_path(run_dir).exists():
            try:
                finalize_failure(run_dir, wrapped)
            except Exception:
                pass
        print_failure(run_dir, wrapped, output_fn)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
