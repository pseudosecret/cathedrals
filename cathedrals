    db.execute("INSERT INTO projection VALUES (?, ?, ?, ?) ON CONFLICT(map,key) DO UPDATE SET payload=excluded.payload",
               (name, key, canonical_json(value).decode(), sequence))


def read_projection(db, name):
    if name == "knowledge-state.json":
        result = {row[0]: {relation: {} for relation in ("believes", "claims", "explicitly_does_not_know", "knows", "suspects")}
                  for row in db.execute("SELECT id FROM subjects ORDER BY id")}
        for subject, relation, proposition, payload in db.execute("SELECT subject,relation,proposition,payload FROM knowledge ORDER BY subject,relation,proposition"):
            result[subject][relation][proposition] = json.loads(payload)
        return result
    result = {key: json.loads(payload) for key, payload in db.execute(
        "SELECT key,payload FROM projection WHERE map=? ORDER BY key", (name,))}
    if name == "motifs.json":
        for motif_id, event_id, sources in db.execute("SELECT motif_id,event_id,sources FROM motif_history ORDER BY sequence"):
            result[motif_id]["appearances"].extend(json.loads(sources))
            result[motif_id]["provenance"].append(event_id)
    return result.get("latest", {}) if name == "prospective-plan.json" else result


