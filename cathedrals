def retrieval_tools():
    identifiers = {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": True,
        "items": {"type": "string", "maxLength": 96, "pattern": "^[a-z][a-z0-9_-]*$"}}
    schemas = {
        "search_records": ({"query": {"type": "string", "minLength": 1, "maxLength": 512},
            "limit": {"type": "integer", "minimum": 1, "maximum": 24}}, "Find committed source IDs using literal full text search."),
        "get_records": ({"ids": identifiers}, "Read complete immutable source units by ID with verified commit/hash/pointer provenance."),
        "get_constraints": ({"ids": identifiers}, "Read historical constraint events by constraint ID or proposition/obligation ID; current state is separate."),
        "get_plan_items": ({"ids": identifiers}, "Read tentative planning records by allocated ID. Tentative plans are intentions, never established facts."),
    }
    return [{"type": "function", "function": {"name": name, "description": description,
        "parameters": {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}}}
        for name, (properties, description) in schemas.items()]


def read_retrieval_tool(run_dir, name, arguments):
    definitions = {tool["function"]["name"]: tool["function"]["parameters"] for tool in retrieval_tools()}
    if name not in definitions:
        raise SchemaError("Unknown read tool")
    validate_json_schema(arguments, definitions[name])
    ensure_index(run_dir)
    if name == "get_plan_items":
        # Checkpoints are authoritative, including after interruption between a file and index write.
        with index_connection(run_dir) as db:
            for path in sorted((run_dir / ".staging").glob("*.planning.json")):
                index_staged_plan(db, path.name.removesuffix(".planning.json"), read_json(path))
    with closing(sqlite3.connect(index_path(run_dir).as_uri() + "?mode=ro", uri=True)) as db:
        db.execute("PRAGMA query_only=ON")
        if name == "search_records":
            query = search_query({"relevance": {"keywords": re.findall(r"[^\W_]+", arguments["query"])}})
            if not query["expression"]:
                return []
            return [dict(zip(("source_id", "source_commit_id", "record_pointer", "kind", "title"), row)) for row in db.execute(
                "SELECT d.source_id,d.commit_id,d.pointer,d.kind,d.title FROM search_fts JOIN search_documents d "
                "ON d.id=search_fts.rowid WHERE search_fts MATCH ? ORDER BY bm25(search_fts),d.sequence,d.id LIMIT ?",
                (query["expression"], arguments["limit"]))]
        ids = arguments["ids"]
        placeholders = ",".join("?" for _ in ids)
        if name == "get_plan_items":
            return [{"step_id": row[0], "revision": row[1], "record_pointer": row[2], "authority": "TENTATIVE PLAN", "item": json.loads(row[3])}
                for row in db.execute(f"SELECT step_id,revision,pointer,payload FROM staged_items WHERE item_id IN ({placeholders}) ORDER BY step_id,pointer LIMIT 24", ids)]
        if name == "get_constraints":
            return [json.loads(row[0]) for row in db.execute(
                f"SELECT payload FROM events WHERE id IN ({placeholders}) OR json_extract(payload,'$.data.fact_id') IN ({placeholders}) "
                f"OR json_extract(payload,'$.data.obligation_id') IN ({placeholders}) ORDER BY sequence LIMIT 24", ids * 3)]
        rows = db.execute(f"SELECT commit_id,source_id,pointer,kind FROM search_documents WHERE source_id IN ({placeholders}) ORDER BY sequence,id LIMIT 24", ids).fetchall()
    result = [read_search_source(run_dir, dict(zip(("commit_id", "source_id", "pointer", "kind"), row))) for row in rows]
    missing = [identifier for identifier in ids if identifier not in {item["source_id"] for item in result}]
    if missing and len(result) < SEARCH_SOURCE_LIMIT:
        result.extend(retrieve_original_sources(run_dir, [{"sources": [{"artifact_id": identifier, "source_locator": "Record requested by ID"} for identifier in missing]}],
            limit=SEARCH_SOURCE_LIMIT - len(result), follow_sources=False))
    return result


def compact_retrieval_prompt(run_dir, task):
    descriptor = {"task": task, "catalog": [], "catalog_partial": False,
        "catalog_note": "Optional catalog; search for additional IDs. get_records retrieves complete source units."}
    if estimated_prompt_tokens(canonical_json(descriptor).decode()) > 2048:
        raise PausedError("Retrieval context", "Retrieval task descriptor exceeds 2,048 tokens; the authoring prompt was not sent to retrieval", "budget_exhaustion")
    with index_connection(run_dir) as db:
        rows = db.execute("SELECT source_id,kind,substr(title,1,160) FROM search_documents "
            "WHERE kind IN ('root','plan') ORDER BY sequence,id LIMIT 65").fetchall()
    for identifier, kind, title in rows:
        item = {"id": identifier, "kind": kind, "title": title}
        if item in descriptor["catalog"]:
            continue
        descriptor["catalog"].append(item)
        if len(descriptor["catalog"]) > 64 or estimated_prompt_tokens(canonical_json(descriptor).decode()) > 2048:
            descriptor["catalog"].pop()
            descriptor["catalog_partial"] = True
    if len(rows) == 65:
        descriptor["catalog_partial"] = True
    return canonical_json(descriptor).decode()


def retrieval_scope_revision(run_dir, scope_step, groups=()):
    upstream = {}
    for path in sorted((run_dir / ".staging").glob("*.planning.json")):
        state = read_json(path)
        if path.name == f"{scope_step}.planning.json":
            if not groups:
                continue
            payload = copy.deepcopy(state.get("payload", {}))
            for group in groups:
                cursor = payload
                parts = group.split(".")
                for part in parts[:-1]:
                    cursor = cursor.get(part, {})
                cursor.pop(parts[-1], None)
            value = {"other_groups": payload}
        else:
            value = {key: state.get(key) for key in ("payload", "record")}
        upstream[path.stem] = sha256_bytes(canonical_json(value))
    return {"canonical_state_hash": load_state(run_dir)["canonical_state_hash"], "upstream_plans": upstream}


def current_retrieval_records(run_dir, records):
    if not isinstance(records, list):
        raise IntegrityError(f"Retrieval working_set must be an array; received {type(records).__name__}")
    result, checkpoints, archives = copy.deepcopy(records), {}, {}
    for record in result:
        retrieval_record_metadata(record)
        if record.get("authority") == "TENTATIVE PLAN":
            step = record["step_id"]
            path = run_dir / ".staging" / f"{step}.planning.json"
            if not path.exists():
                return None
            if step not in checkpoints:
                checkpoints[step] = read_json(path)
            state = checkpoints[step]
            try:
                value = read_evidence_pointer(state.get("payload", {}), record["record_pointer"], source_id=step, archive=str(path))
            except IntegrityError:
                return None
            if value != record["item"]:
                return None
            record["revision"] = sha256_bytes(canonical_json(state))
        elif "immutable_source" in record:
            source = read_search_source(run_dir, {"commit_id": record["source_commit_id"], "source_id": record["source_id"],
                "pointer": record["record_pointer"], "kind": "root"}, archives)
            if source["source_hash"] != record["source_hash"] or source["immutable_source"] != record["immutable_source"]:
                raise IntegrityError("Cached retrieval evidence changed")
        elif "constraint_id" in record:
            with index_connection(run_dir) as db:
                row = db.execute("SELECT payload FROM events WHERE id=?", (record["constraint_id"],)).fetchone()
            if row is None or json.loads(row[0]) != record:
                return None
    return result


def retrieval_working_set(run_dir, step_id, task, transport, *, scope_id=None, scope_step=None):
    policy = execution_policy(run_dir)
    if policy.get("retrieval_mode") != "tools":
        return []
    saved = run_dir / "raw" / f"{step_id}.retrieval-session.json"
    if saved.exists():
        return read_json(saved)["working_set"]
    checkpoint = run_dir / ".staging" / f"{step_id}.retrieval-session.json"
    revision = retrieval_scope_revision(run_dir, scope_step, task.get("record_groups", []) if isinstance(task, dict) else []) if scope_id else None
    shared = run_dir / ".staging" / f"retrieval-cache-{sha256_bytes(canonical_json([scope_id, revision]))[:24]}.json" if scope_id else None
    if shared and shared.exists() and not checkpoint.exists():
        cache = read_json(shared)
        records = current_retrieval_records(run_dir, cache["working_set"])
        if records is not None:
            write_json(saved, {"working_set": records, "rounds": [], "call_count": 0,
                "revision": revision, "reused_from": cache["source_step_id"]}, mode=0o444, exclusive=True)
            return records
    state = read_json(checkpoint) if checkpoint.exists() else {"rounds": [], "working_set": [], "call_count": 0,
        "argument_errors": 0, "revision": load_state(run_dir)["canonical_state_hash"],
        "planning_revisions": {path.name: sha256_file(path) for path in sorted((run_dir / ".staging").glob("*.planning.json"))}}
    messages = [{"role": "system", "content": "Retrieve optional supporting records for the following task. Do not author fiction or plan changes. "
        "Mandatory evidence is already supplied. Use only read tools when more context is needed; otherwise say READY. "
        "At most two rounds and eight calls; sources are complete units. Search first when you need IDs."},
        {"role": "user", "content": compact_retrieval_prompt(run_dir, task)}]
    for round_ in state["rounds"]:
        messages.extend(round_["messages"])
    for number in range(len(state["rounds"]) + 1, policy["max_tool_rounds"] + 1):
        if state["call_count"] >= policy["max_tool_calls"]:
            break
        round_step = f"{step_id}_retrieval_round_{number:02d}"
        parameters = {"temperature": 0.0, "max_tokens": 8192, "seed": step_seed(read_json(run_dir / "generation-brief.json")["generation_seed"], round_step),
            "stream": True, "stream_options": {"include_usage": True}}
        parameters["max_tokens"] = planning_output_limit(run_dir, canonical_json(messages).decode(), {}, parameters["max_tokens"], "Retrieval context")
        request = {"model": load_state(run_dir)["model"], "messages": messages, "tools": retrieval_tools(), "tool_choice": "auto", **parameters}
        paths = sorted((run_dir / "raw").glob(f"{round_step}-attempt*.api.json"), key=lambda path: int(path.name.split("-attempt")[-1].split(".")[0]))
        response = read_json(paths[-1]) if paths else None
        if response is not None and response.get("_cathedrals_stream_complete") is False:
            response = None
        attempt = (int(paths[-1].name.split("-attempt")[-1].split(".")[0]) + (response is None)) if paths else 1
        path = run_dir / "raw" / f"{round_step}-attempt{attempt}.api.json"
        meta = {"step_id": round_step, "attempt": attempt, "parameters": parameters,
            "prompt_hash": sha256_bytes(canonical_json(messages)), "context_hash": state["revision"]}
        if response is None:
            brief = read_json(run_dir / "generation-brief.json")
            budgets = read_json(run_dir / "run-manifest.json")["budgets"]
            tokens = estimated_prompt_tokens(canonical_json(request).decode())
            if tokens > packet_input_limit(run_dir, parameters["max_tokens"]):
                raise PausedError("Retrieval context", "Complete tool envelope exceeds the frozen input ceiling", "budget_exhaustion")
            if load_state(run_dir)["analysis_step_count"] >= budgets["max_analysis_step_count"]:
                raise PausedError("Retrieval budget", "Read rounds exhausted the frozen analysis allowance", "budget_exhaustion")
            usage = [(read_json(item).get("usage") or {}) for item in (run_dir / "raw").glob("*.api.json")]
            for key, ceiling, reserve in (("prompt_tokens", "max_cumulative_input_tokens", tokens),
                    ("completion_tokens", "max_cumulative_output_tokens", parameters["max_tokens"])):
                if sum(item.get(key) or 0 for item in usage) + reserve > budgets[ceiling]:
                    raise PausedError("Retrieval budget", f"Read round exceeds {ceiling}", "budget_exhaustion")
            try:
                response, _ = provider_response(transport, api_url(brief["lm_studio_base_url"], "/v1/chat/completions"), request,
                    float(os.environ.get("CATHEDRALS_HTTP_TIMEOUT", "5400")), allow_tools=True, started_at=utc_now(),
                    preserve=lambda value: write_json(path, value | {"_cathedrals_request": meta}, mode=0o444, exclusive=True),
                    stream_path=path.with_suffix(".sse"))
            except CathedralsError as error:
                append_failed_attempt(run_dir, step_id=round_step, attempt=attempt, phase="architecture",
                    prompt=canonical_json(messages).decode(), context=state["revision"], parameters=parameters,
                    started_at=utc_now(), step_type="analysis",
                    usage=((getattr(error, "response", None) or (read_json(path) if path.exists() else {})).get("usage") or {}),
                    failure_class=error.failure_class)
                raise
        response["_cathedrals_request"] = meta
        preserve_planning_result(run_dir, step_id, round_step, {"synthetic": False, "read_only": True}, response, kind="read_only_retrieval", phase="architecture")
        calls = completed_tool_calls(response)
        assistant = response["choices"][0]["message"]
        round_messages = [{key: assistant[key] for key in ("role", "content", "tool_calls") if key in assistant} | {"role": "assistant"}]
        for call in calls:
            state["call_count"] += 1
            if state["call_count"] > policy["max_tool_calls"]:
                result = {"error": "Task tool call limit reached"}
            else:
                try:
                    arguments = parse_structured_content(call["function"].get("arguments", ""))
                    records = read_retrieval_tool(run_dir, call["function"].get("name"), arguments)
                    result = {"records": [], "omissions": []}
                    if call["function"].get("name") == "search_records":
                        result["records"] = records
                        round_messages.append({"role": "tool", "tool_call_id": call["id"], "content": canonical_json(result).decode()})
                        continue
                    for record in records:
                        if record in state["working_set"]:
                            result["records"].append(record)
                            continue
                        prospective = state["working_set"] + [record]
                        if len(prospective) > SEARCH_SOURCE_LIMIT or estimated_prompt_tokens(compact_context_value(prospective)) > 12288:
                            result["omissions"].append({"reason": "Optional retrieval budget; complete record not included"})
                        else:
                            state["working_set"].append(record)
                            result["records"].append(record)
                except (SchemaError, ValueError, TypeError) as error:
                    state["argument_errors"] += 1
                    result = {"error": str(error), "correction_allowed": state["argument_errors"] == 1}
            round_messages.append({"role": "tool", "tool_call_id": call["id"], "content": canonical_json(result).decode()})
        state["rounds"].append({"messages": round_messages, "step_id": round_step})
        write_json(checkpoint, state)
        messages.extend(round_messages)
        if not calls or state["argument_errors"] > 1 or state["working_set"] and not state["argument_errors"] and all(
                call["function"].get("name") != "search_records" for call in calls):
            break
    write_json(saved, state, mode=0o444, exclusive=True)
    if shared:
        write_json(shared, {"source_step_id": step_id, "working_set": state["working_set"]})
    return state["working_set"]


def compact_planning_schema(schema: dict) -> dict:
    result = copy.deepcopy(schema)
    definitions = result.pop("$defs", {})
    needed, pending = {}, [result]
    while pending:
        for item in _walk(pending.pop()):
            reference = item.get("$ref", "") if isinstance(item, dict) else ""
            if reference.startswith("#/$defs/"):
                name = reference.split("/")[2]
                if name not in needed:
                    needed[name] = definitions[name]
                    pending.append(needed[name])
    if needed:
        result["$defs"] = needed
    return result


def prepared_context_limit(budgets: dict, *, planning=False):
    limit = budgets.get("max_prepared_context_tokens", float("inf"))
    return budgets.get("max_planning_context_tokens", limit) if planning else limit


def execution_policy(run_dir):
    return read_json(run_dir / "run-manifest.json").get("execution_policy", {})


def scoped_planning_context(run_dir, step_id, state, paths):
    payload = state["payload"]
    targets = []
    for path in paths:
        cursor = payload
        for part in path:
            if isinstance(cursor, dict) and part in cursor or isinstance(cursor, list) and isinstance(part, int) and part < len(cursor):
                cursor = cursor[part]
            else:
                cursor = {}
                break
        targets.append({"path": path, "retained_value": cursor})
    core = planning_core(run_dir)
    items = []
    def collect(value):
        if isinstance(value, dict):
            identity = next((value[key] for key in ("arc_id", "attractor_id", "obligation_id", "node_id", "edge_id", "packet_slot_id") if key in value), None)
            if identity:
                items.append((identity, value))
            else:
                for child in value.values():
                    collect(child)
        elif isinstance(value, list):
            for child in value:
                collect(child)
    collect(payload)
    if step_id != "architecture_core" and core:
        collect(core)
    references = set(re.findall(r'"([a-z][a-z0-9_]+)"', canonical_json(targets).decode()))
    neighbors = [value for identity, value in items if identity in references]
    for value in neighbors:
        references.update(re.findall(r'"([a-z][a-z0-9_]+)"', canonical_json(value).decode()))
    catalog = [{"id": identity, **{key: value[key] for key in ("kind", "purpose", "description", "terminal_transformation", "role") if key in value}}
        for identity, value in items]
    genesis = committed_record(run_dir, "genesis")
    law, provenance = instruction_profile(run_dir)
    context = {"frozen_law": law, "instruction_profile": provenance,
        "brief": read_json(run_dir / "generation-brief.json"), "targets": targets, "candidate_catalog": catalog,
        "committed_source_catalog": genesis_reference_catalog(run_dir),
        "relevant_records": [value for identity, value in items if identity in references],
        "global_canon": {key: genesis[key] for key in ("work_canon", "format_composition_law") if key in genesis},
        "entity_catalog": [{key: value[key] for key in ("claimant_id", "character_id", "name", "public_role", "occupation", "epistemic_regime", "setting_relationship", "role") if key in value}
            for group in ("claimants", "characters") for value in genesis.get(group, [])],
        "relevant_entities": [value for group in ("claimants", "characters") for value in genesis.get(group, [])
            if any(value.get(key) in references for key in ("claimant_id", "character_id") if value.get(key))],
        "pending_hints": state.get("hints", [])}
    if core:
        context["allocations"] = planned_packet_specs(core)
    return context


def planning_retrieval_task(step_id, state, paths, *, context=None):
    groups = set()
    for path in paths:
        if len(path) == 2 and path[0] in {"arcs", "attractors", "obligation_graph", "packet_plans"} and isinstance(path[1], int):
            groups.add((path[0],))
        elif len(path) == 3 and path[0] == "topology" and path[1] in {"nodes", "edges"} and isinstance(path[2], int):
            groups.add(tuple(path[:2]))
    if not groups:
        return None
    identities = []
    for group in sorted(groups):
        values = state["payload"]
        for part in group:
            values = values.get(part, {})
        for value in values:
            for field in ("arc_id", "attractor_id", "obligation_id", "node_id", "edge_id", "packet_slot_id"):
                if value.get(field):
                    identities.append(value[field])
                    break
    names = [".".join(group) for group in sorted(groups)]
    context = context or {}
    focus = [context.get("global_canon", {}).get("work_canon", {}).get("premise", "")]
    for target in context.get("targets", []):
        value = target.get("retained_value")
        if isinstance(value, dict):
            focus.extend(value.get(field, "") for field in ("purpose", "description", "terminal_transformation", "branch_path_relation"))
    keywords = search_query({"relevance": {"keywords": [context.get("brief", {}).get("genre_flavor", "")]},
        "soft_guidance": [text for text in focus if isinstance(text, str)]})["terms"]
    return {"scope_id": f"{step_id}:{','.join(names)}", "step_id": step_id,
        "task": {"phase": step_id, "record_groups": names, "allocated_ids": identities, "keywords": keywords,
            "purpose": "Find optional committed evidence or upstream plan records that support this whole record group. Mandatory context is supplied separately to each authoring call."}}


def planning_output_limit(run_dir: Path, prompt: str, schema: dict, requested: int, stage: str, *, purpose="planning") -> int:
    budgets = read_json(run_dir / "run-manifest.json")["budgets"]
    prompt_tokens = math.ceil(len(prompt.encode()) / 3)
    prompt_tokens = provider_input_tokens({"messages": [{"role": "user", "content": prompt}],
        "response_format": {"type": "json_schema", "json_schema": {"schema": schema}}}) + 256
    reserve = budgets.get("context_safety_reserve_tokens", 4096)
    window = min(budgets.get("model_context_window_tokens", float("inf")),
                 load_state(run_dir).get("model_context_window_tokens", float("inf")))
    available = window - prompt_tokens - reserve
    limit = prepared_context_limit(budgets, planning=purpose == "planning")
    if prompt_tokens > limit or available < MIN_PLANNING_OUTPUT_TOKENS:
        schema_tokens = math.ceil(len(canonical_json(schema)) / 3)
        raise PausedError(stage,
            f"Complete compact {purpose} context cannot fit: estimated prompt {prompt_tokens:,} tokens "
            f"(response schema {schema_tokens:,}); prepared-context limit {limit:,}, "
            f"model window {window:,}, requested output {requested:,}, safety reserve {reserve:,}. "
            "All context and accepted work were retained; no oversized request was sent.", "budget_exhaustion")
    return int(min(requested, available))


def preserve_planning_result(run_dir: Path, step_id: str, repair_step: str, result, response: dict, *, kind: str, phase="architecture") -> None:
    meta = response["_cathedrals_request"]
    if not any(item["planned_step_id"] == repair_step and item["attempt"] == meta["attempt"] for item in step_entries(run_dir, repair_step)):
        state = load_state(run_dir)
        entry = new_ledger_entry(run_dir, planned_step_id=repair_step, attempt=meta["attempt"],
            step_type="analysis", step_phase=phase, parent_state_hash=state["canonical_state_hash"],
            prompt_hash=meta["prompt_hash"], context_hash=meta["context_hash"], provider="LM Studio", model=state["model"],
            parameters=meta["parameters"], seed=meta["parameters"]["seed"], started_at=response.get("_cathedrals_started_at", utc_now()),
            output_hash=sha256_bytes(canonical_json(result)), generated_ids=[], past_constraint_ids=[], future_obligation_ids=[],
            motif_ids=[], branch_relation=None, commit_status="COMMITTED", state_hash_after=state["canonical_state_hash"],
            failure_class="none", usage=response.get("usage") or {})
        append_ledger_entry(run_dir, entry)
        refresh_run_counters(run_dir)
    repair_path = run_dir / ".staging" / f"{step_id}.repair.json"
    audit = read_json(repair_path) if repair_path.exists() else {"history": []}
    if not any(item["step_id"] == repair_step for item in audit["history"]):
        audit["history"].append({"kind": kind, "step_id": repair_step, "result": result,
                                 "api_response": response, "usage_ledgered": True})
        write_json(repair_path, audit)


def planning_value(run_dir: Path, step_id: str, state: dict, path: list, schema: dict,
                   reason: str, transport, *, validator=None):
    if "type" not in schema and schema.get("enum") and all(isinstance(item, str) for item in schema["enum"]):
        schema = schema | {"type": "string"}
    schema = compact_planning_schema(schema)
    context = scoped_planning_context(run_dir, step_id, state, [path])
    task = {"path": path, "schema": schema, "reason": reason, "context": context}
    signature = sha256_bytes(canonical_json(task))[:16]
    if signature in state["values"]:
        value = state["values"][signature]
        validate_json_schema(value, schema)
        if validator:
            validator(value)
        return value
    prompt = (
        "Repair or complete ONE planning value. The engine assembles the surrounding JSON.\n"
        "Preserve accepted creative decisions. Reason backward from the desired payoff to its earlier setup.\n"
        "Setup instruction_ref values are JSON Pointers to complete guidance elsewhere in this context.\n"
        "Paths containing $ task labels identify engine operations, not JSON properties to create or patches to return.\n"
        f"FIELD PATH\n{reference_path(path)}\n"
        f"PURPOSE\n{reason}\n"
        f"VALUE SCHEMA\n{canonical_json(schema).decode()}\n"
        "FULL ASSEMBLED PLANNING CONTEXT\n" + canonical_json(context).decode() +
        ('\nReturn exactly {"value": "the requested string"}, with no other keys. ' if schema.get("type") == "string"
            else "\nReturn only the requested JSON value. ") +
        "Do not return a containing record, alternatives, or explanations."
    )
    repair_step = f"{step_id}_value_{signature}"
    value, response = request_architecture_analysis(
        run_dir, repair_step, prompt, schema, transport, validator,
        system_prompt=('Supply one authored planning string as {"value": "..."}; the engine applies it to the surrounding plan.'
            if schema.get("type") == "string" else "Supply one authored planning value in its complete story context."),
        response_name="planningValue", pause_stage=f"Planning value {reference_path(path)}", value_mode=True, value_path=path, planning_mode=True,
    )
    state["values"][signature] = value
    preserve_planning_result(run_dir, step_id, repair_step, value, response, kind="planning_value")
    save_planning_draft(run_dir, step_id, state)
    return value


def parsed_planning_fragment(content: str) -> tuple[dict, list[list]]:
    """Parse closed values inside unfinished containers without inventing JSON bytes."""
    decoder = json.JSONDecoder()
    incomplete = []

    def skip(position):
        while position < len(content) and content[position].isspace():
            position += 1
        return position

    def parse(position, path):
        position = skip(position)
        try:
            value, end = decoder.raw_decode(content, position)
            if end == len(content) or content[end].isspace() or content[end] in ",]}":
                return value, end, True
        except json.JSONDecodeError:
            pass
        if position >= len(content) or content[position] not in "[{":
            return None, position, False
        is_object = content[position] == "{"
        result = {} if is_object else []
        position = skip(position + 1)
        while position < len(content):
            key = len(result)
            if is_object:
                try:
                    key, position = decoder.raw_decode(content, position)
                except json.JSONDecodeError:
                    break
                if not isinstance(key, str) or key in result:
                    break
                position = skip(position)
                if position >= len(content) or content[position] != ":":
                    break
                position += 1
            value, end, complete = parse(position, path + [key])
            if complete or isinstance(value, (dict, list)) and value:
                if is_object:
                    result[key] = value
                else:
                    result.append(value)
            if not complete:
                break
            position = skip(end)
            if position >= len(content) or content[position] != ",":
                break
            position = skip(position + 1)
        incomplete.append(path)
        return result, position, False

    payload, _, _ = parse(0, [])
    return (payload if isinstance(payload, dict) else {}), incomplete


def planning_schema_node(schema: dict, root: dict) -> dict:
    if "$ref" in schema:
        return planning_schema_node(_resolve_pointer(root, schema["$ref"]), root) | {
            key: value for key, value in schema.items() if key != "$ref"}
    return schema


def planning_location(state: dict, path: list):
    sections = {"$layout": "layout", "$resolutions": "resolutions"}
    if path and path[0] in sections:
        return state.setdefault(sections[path[0]], {}), path[1:]
    return state["payload"], path


def planning_get(state: dict, path: list):
    value, parts = planning_location(state, path)
    try:
        for part in parts:
            value = value[part]
        return value
    except (KeyError, IndexError, TypeError):
        return None


def planning_assign(state: dict, path: list, value) -> None:
    if not path:
        state["payload"] = value
        return
    cursor, parts = planning_location(state, path)
    for index, part in enumerate(parts[:-1]):
        missing = part not in cursor if isinstance(cursor, dict) else cursor[part] is None
        if missing:
            cursor[part] = [] if isinstance(parts[index + 1], int) else {}
        cursor = cursor[part]
    cursor[parts[-1]] = value


def merge_planning_shape(existing, authored, schema: dict, root: dict):
    schema = planning_schema_node(schema, root)
    if not _collect_schema_errors(existing, schema, root, "$"):
        return existing
    if isinstance(existing, dict) and isinstance(authored, dict):
        return existing | {key: merge_planning_shape(existing.get(key), value, schema["properties"][key], root)
                           for key, value in authored.items()}
    if isinstance(existing, list) and isinstance(authored, list) and len(existing) == len(authored):
        return [merge_planning_shape(before, after, schema["items"], root) for before, after in zip(existing, authored)]
    return authored


def planning_batch(run_dir: Path, step_id: str, state: dict, tasks: list[dict], transport, *, size=4) -> None:
    """Checkpoint independent successes; split only failed targets down to values."""
    if not tasks:
        return
    if len(tasks) > size:
        for start in range(0, len(tasks), size):
            planning_batch(run_dir, step_id, state, tasks[start:start + size], transport, size=size)
        return
    pending = []

    def accept(task, value):
        schema = task["schema"]
        validate_json_schema(value, schema)
        key = sha256_bytes(canonical_json({name: task[name] for name in ("path", "schema", "reason")}))
        state.setdefault("accepted_tasks", {})[key] = value
        if task.get("preserve_schema"):
            value = merge_planning_shape(planning_get(state, task["path"]), value,
                                         task["preserve_schema"], task["root_schema"])
        planning_assign(state, task["path"], value)
        state["incomplete"] = [path for path in state.get("incomplete", []) if path[:len(task["path"])] != task["path"]]
        save_planning_draft(run_dir, step_id, state)

    for original in tasks:
        task = original | {"schema": compact_planning_schema(original["schema"])}
        key = sha256_bytes(canonical_json({name: task[name] for name in ("path", "schema", "reason")}))
        if key in state.get("accepted_tasks", {}):
            accept(task, state["accepted_tasks"][key])
        else:
            pending.append(task)
    if not pending:
        return
    single_node = planning_schema_node(pending[0]["schema"], pending[0]["schema"])
    structured = (single_node.get("type") == "object" and single_node.get("required") or
                  single_node.get("type") == "array" and planning_schema_node(single_node.get("items", {}), pending[0]["schema"]).get("type") == "object")
    if len(pending) == 1 and not structured:
        task = pending[0]
        value = planning_value(run_dir, step_id, state, task["path"], task["schema"], task["reason"], transport)
        accept(task, value)
        return
    descriptors = [{"key": f"value_{index:03d}", "path": reference_path(task["path"]), "purpose": task["reason"]}
                   for index, task in enumerate(pending, 1)]
    properties = {item["key"]: task["schema"] for item, task in zip(descriptors, pending)}
    # Definitions inside each target must be rooted at the response document.
    definitions = {key: value for node in properties.values() for key, value in node.get("$defs", {}).items()}
    schema = {"type": "object", "additionalProperties": False, "required": list(properties),
              "properties": {key: {name: value for name, value in node.items() if name != "$defs"} for key, node in properties.items()},
              "$defs": definitions}
    schema = compact_planning_schema(schema)
    context = scoped_planning_context(run_dir, step_id, state, [task["path"] for task in pending])
    prompt = ("Complete only the pending planning targets as one coherent batch. Preserve accepted decisions. "
              "Reason backward from payoffs to earlier setups. Keep planning concise and proportionate to the requested scope.\n"
              "Setup instruction_ref values are JSON Pointers to complete guidance elsewhere in this context.\n"
              "BATCH TARGETS\n" + canonical_json(descriptors).decode() +
              "\nVALUE SCHEMA\n" + canonical_json(schema).decode() +
              "\nFULL ASSEMBLED PLANNING CONTEXT\n" + canonical_json(context).decode() +
              "\nReturn one JSON object keyed exactly as the targets. Do not rewrite accepted fields.")
    signature = sha256_bytes(prompt.encode())[:16]
    repair_step = f"{step_id}_batch_{signature}"
    state.setdefault("batch_calls", {})[signature] = descriptors
    save_planning_draft(run_dir, step_id, state)
    print(f"Planning recovery: {len(pending)} pending targets in a batch", file=sys.stderr)
    incomplete, interruption = [], None
    paths = list((run_dir / "raw").glob(f"{repair_step}-attempt*.api.json"))
    try:
        if paths:
            response = read_json(max(paths, key=lambda item: int(item.name.split("-attempt")[-1].split(".")[0])))
            content = (response.get("choices") or [{}])[0].get("message", {}).get("content") or ""
            try:
                result = parse_structured_content(content)
            except SchemaError:
                result, incomplete = parsed_planning_fragment(content)
        else:
            result, response = request_architecture_analysis(run_dir, repair_step, prompt, schema, transport,
                initial_draft=True, planning_mode=True, max_tokens=8192,
                retrieval_task=planning_retrieval_task(step_id, state, [task["path"] for task in pending], context=context),
                response_name="planningBatchValues", pause_stage="Planning batch")
    except PausedError as error:
        if error.failure_class == "budget_exhaustion":
            smaller = pending
            if len(pending) == 1:
                task = pending[0]
                node = planning_schema_node(task["schema"], task["schema"])
                if node.get("type") != "object" or not node.get("required"):
                    raise
                smaller = []
                for key in node["required"]:
                    child = task | {"path": task["path"] + [key],
                                    "schema": node["properties"][key] | {"$defs": task["schema"].get("$defs", {})}}
                    if task.get("preserve_schema"):
                        child["preserve_schema"] = planning_schema_node(task["preserve_schema"], task["root_schema"])["properties"][key]
                    smaller.append(child)
            planning_batch(run_dir, step_id, state, smaller, transport, size=max(1, math.ceil(len(smaller) / 2)))
            return
        if not isinstance(error.__cause__, (SchemaError, TruncationError, IncompleteResponseError)):
            raise
        if isinstance(error.__cause__, IncompleteResponseError):
            interruption = error
        paths = list((run_dir / "raw").glob(f"{repair_step}-attempt*.api.json"))
        response = read_json(max(paths, key=lambda item: int(item.name.split("-attempt")[-1].split(".")[0])))
        content = (response.get("choices") or [{}])[0].get("message", {}).get("content") or ""
        try:
            result = parse_structured_content(content)
        except SchemaError:
            result, incomplete = parsed_planning_fragment(content)
    result = result if isinstance(result, dict) else {}
    preserve_planning_result(run_dir, step_id, repair_step, result, response, kind="planning_batch")
    failed = []

    def collect(task, value, result_path, supplied=True):
        node = planning_schema_node(task["schema"], task["schema"])
        unfinished = any(path[:len(result_path)] == result_path for path in incomplete)
        if supplied and not unfinished and not _collect_schema_errors(value, task["schema"], task["schema"], "$"):
            accept(task, value)
            return
        if node.get("type") == "object" and node.get("required"):
            if not isinstance(planning_get(state, task["path"]), dict):
                planning_assign(state, task["path"], {})
            for key in node.get("required", node["properties"]):
                child = task | {"path": task["path"] + [key], "schema": node["properties"][key] | {"$defs": task["schema"].get("$defs", {})}}
                if task.get("preserve_schema"):
                    before = planning_schema_node(task["preserve_schema"], task["root_schema"])
                    child["preserve_schema"] = before["properties"][key]
                collect(child, value.get(key) if isinstance(value, dict) else None, result_path + [key],
                        isinstance(value, dict) and key in value)
        elif node.get("type") == "array" and planning_schema_node(node.get("items", {}), task["schema"]).get("type") == "object" and node.get("minItems") == node.get("maxItems"):
            length = node["minItems"]
            previous = planning_get(state, task["path"])
            if not isinstance(previous, list) or len(previous) != length:
                planning_assign(state, task["path"], [{} for _ in range(length)])
            for index in range(length):
                child = task | {"path": task["path"] + [index],
                                "schema": planning_schema_node(node["items"], task["schema"]) | {"$defs": task["schema"].get("$defs", {})}}
                if task.get("preserve_schema"):
                    child["preserve_schema"] = planning_schema_node(task["preserve_schema"], task["root_schema"])["items"]
                present = isinstance(value, list) and index < len(value)
                collect(child, value[index] if present else None, result_path + [index], present)
        else:
            failed.append(task)

    for descriptor, task in zip(descriptors, pending):
        collect(task, result.get(descriptor["key"]), [descriptor["key"]], descriptor["key"] in result)
    if interruption:
        raise interruption
    if failed:
        planning_batch(run_dir, step_id, state, failed, transport, size=max(1, math.ceil(len(failed) / 2)))


def fill_planning_shape(run_dir: Path, step_id: str, state: dict, schema: dict, transport) -> None:
    root = schema

    def prepare(value, node, path, counts):
        node = planning_schema_node(node, root)
        if node.get("type") == "object":
            if not isinstance(value, dict) and not node.get("required"):
                return
            value = value if isinstance(value, dict) else {}
            planning_assign(state, path, value)
            if node.get("additionalProperties") is False:
                for key in list(value):
                    if key not in node["properties"]:
                        hint = {"source_path": path + [key], "text": json.dumps(value.pop(key), ensure_ascii=False)}
                        if hint not in state["hints"]:
                            state["hints"].append(hint)
            if len(path) == 2 and path[0] == "obligation_graph":
                value["status"] = "active"
            if state.get("checkpoint_version") == 3 and (len(path) == 2 and path[0] in {
                    "arcs", "attractors", "obligation_graph", "packet_plans"} or
                    len(path) == 3 and path[:2] in (["topology", "nodes"], ["topology", "edges"])):
                return
            for key in dict.fromkeys(node.get("required", []) + list(value)):
                if key in node.get("properties", {}):
                    prepare(value.get(key), node["properties"][key], path + [key], counts)
        elif node.get("type") == "array" and planning_schema_node(node.get("items", {}), root).get("type") == "object":
            minimum, maximum = node.get("minItems", 0), node.get("maxItems", 256)
            unfinished = path in state.get("incomplete", [])
            if not isinstance(value, list) or not minimum <= len(value) <= maximum or unfinished:
                existing = value if isinstance(value, list) else []
                counts.append({"path": ["$layout", reference_path(path)],
                    "schema": {"type": "integer", "minimum": max(minimum, min(len(existing), maximum)), "maximum": maximum},
                    "reason": f"Choose the total record count for {reference_path(path)}. Preserve its {len(existing)} retained records. Use only capacity needed for this scope.",
                    "collection_path": path, "existing": existing})
                return
            for index, item in enumerate(value):
                prepare(item, node["items"], path + [index], counts)

    while True:
        counts = []
        prepare(state["payload"], schema, [], counts)
        if not counts:
            break
        planning_batch(run_dir, step_id, state, counts, transport, size=len(counts))
        for task in counts:
            count = planning_get(state, task["path"])
            previous = task["existing"]
            if len(previous) > count:
                state["unassigned"].append({"source_path": task["collection_path"], "overflow": previous[count:]})
            value = previous[:count] + [{} for _ in range(max(0, count - len(previous)))]
            planning_assign(state, task["collection_path"], value)
            state["incomplete"] = [path for path in state.get("incomplete", []) if path != task["collection_path"]]
        save_planning_draft(run_dir, step_id, state)

    if step_id == "architecture_core":
        for path in (["attractors"], ["obligation_graph"], ["arcs"], ["topology", "nodes"], ["topology", "edges"]):
            items = planning_get(state, path)
            node = root
            for part in path:
                node = planning_schema_node(node, root)["properties"][part]
            properties = planning_schema_node(planning_schema_node(node, root)["items"], root)["properties"]
            identity = next(key for key in properties if key.endswith("_id"))
            declared = [item.get(identity) for item in items]
            for index, item in enumerate(items):
                identifier = item.get(identity)
                if not isinstance(identifier, str) or not re.fullmatch(r"[a-z][a-z0-9_]*", identifier) or declared.count(identifier) != 1:
                    item[identity] = f"draft_{identity[:-3]}_{index + 1:03d}"
        save_planning_draft(run_dir, step_id, state)

    def missing_schema(value, node):
        node = planning_schema_node(node, root)
        if not _collect_schema_errors(value, node, root, "$"):
            return None
        if node.get("type") == "object" and isinstance(value, dict):
            properties = {}
            for key in dict.fromkeys(node.get("required", []) + list(value)):
                if key in node["properties"]:
                    child = missing_schema(value.get(key), node["properties"][key])
                    if child is not None:
                        properties[key] = child
            return {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}
        if node.get("type") == "array" and isinstance(value, list) and planning_schema_node(node.get("items", {}), root).get("type") == "object":
            return node | {"minItems": len(value), "maxItems": len(value)}
        return node

    def task_for(path, node):
        if len(path) == 2 and path[0] == "packet_plans":
            variants = root["properties"]["packet_plans"]["items"].get("anyOf")
            if variants:
                node = variants[path[1]]
        value = planning_get(state, path)
        missing = missing_schema(value, node)
        if missing is None:
            return []
        if missing.get("type") == "object" and len(missing["properties"]) == 1:
            key = next(iter(missing["properties"]))
            return task_for(path + [key], planning_schema_node(node, root)["properties"][key])
        return [{"path": path, "schema": missing | {"$defs": root.get("$defs", {})},
                 "preserve_schema": node, "root_schema": root,
                 "reason": "Supply the pending fields together as a coherent planning record, preserving all accepted decisions."}]

    if step_id == "architecture_core":
        for group in ("attractors", "obligation_graph", "arcs"):
            node = planning_schema_node(root["properties"][group], root)["items"]
            tasks = [task for index in range(len(state["payload"][group])) for task in task_for([group, index], node)]
            planning_batch(run_dir, step_id, state, tasks, transport)
        for group in ("nodes", "edges"):
            topology = planning_schema_node(root["properties"]["topology"], root)
            node = topology["properties"][group]["items"]
            tasks = [task for index in range(len(state["payload"]["topology"][group])) for task in task_for(["topology", group, index], node)]
            planning_batch(run_dir, step_id, state, tasks, transport)
        tasks = task_for(["topology"], root["properties"]["topology"]) + task_for(["saturation_rationale"], root["properties"]["saturation_rationale"])
    else:
        if "packet_plans" in root.get("properties", {}):
            node = planning_schema_node(root["properties"]["packet_plans"], root)["items"]
            tasks = [task for index in range(len(state["payload"]["packet_plans"])) for task in task_for(["packet_plans", index], node)]
        else:
            tasks = task_for([], root)
    planning_batch(run_dir, step_id, state, tasks, transport)
    save_planning_draft(run_dir, step_id, state)


def canonical_planning_aliases(run_dir: Path, payload: dict, audit=None) -> dict:
    result = copy.deepcopy(payload)
    aliases = {item["motif_event_id"]: item["motif_id"] for record in all_committed_records(run_dir)
               for item in record.get("constraint_delta", {}).get("motif_events", [])}
    for item in _walk(result):
        if isinstance(item, dict) and isinstance(item.get("relevance"), dict):
            tags = item["relevance"]
            if isinstance(tags.get("motif_ids"), list):
                if audit is not None:
                    for identifier in tags["motif_ids"]:
                        entry = {"field": "relevance.motif_ids", "from": identifier, "to": aliases.get(identifier)}
                        if identifier in aliases and entry not in audit:
                            audit.append(entry)
                tags["motif_ids"] = [aliases.get(value, value) for value in tags["motif_ids"]]
    return result


def repair_planning_references(run_dir: Path, step_id: str, state: dict, schema: dict, transport) -> None:
    seen = {}
    while True:
        fingerprint = sha256_bytes(canonical_json(state["payload"]))
        seen[fingerprint] = seen.get(fingerprint, 0) + 1
        if seen[fingerprint] > 3:
            raise PausedError("Planning references", "Three passes made no progress; accepted planning records were preserved")
        state["payload"] = canonical_planning_aliases(run_dir, state["payload"], state.setdefault("aliases", []))
        state["payload"] = normalize_architecture_core_payload(state["payload"], run_dir)
        issues = architecture_reference_issues(state["payload"], run_dir)
        topology = state["payload"]["topology"]
        nodes = [item["node_id"] for item in topology["nodes"]]
        for field in ("entry_segment_id", "opening_branch_node_id"):
            if topology[field] not in nodes:
                issues.append({"path": ["topology", field], "invalid": topology[field], "candidates": nodes, "mode": "replace"})
        for index, identifier in enumerate(topology["reconvergence_node_ids"]):
            if identifier not in nodes:
                issues.append({"path": ["topology", "reconvergence_node_ids", index], "invalid": identifier, "candidates": nodes, "mode": "replace"})
        for index, edge in enumerate(topology["edges"]):
            for field in ("from_node_id", "to_node_id"):
                if edge[field] not in nodes:
                    issues.append({"path": ["topology", "edges", index, field], "invalid": edge[field], "candidates": nodes, "mode": "replace"})
        if not issues:
            save_planning_draft(run_dir, step_id, state)
            return
        selected = []
        for issue in issues[:16]:
            path = list(issue["path"])
            field = path[-2] if isinstance(path[-1], int) else path[-1]
            choices, additions = list(issue["candidates"]), {}
            if "relevance" in path:
                choices.append("__NARRATIVE_HINT__")
            choices.extend(additions)
            if not choices:
                raise PausedError("Planning value", f"No lawful targets for {reference_path(path)}; draft retained")
            key = sha256_bytes(canonical_json({"path": path, "invalid": issue["invalid"], "choices": choices}))[:16]
            selected.append((issue, additions, {"path": ["$resolutions", key],
                "schema": {"type": "string", "enum": choices},
                "reason": f"Resolve {issue['invalid']!r} at {reference_path(path)} using its meaning in the full draft. Choose __NARRATIVE_HINT__ for authored setup intent rather than a typed ID; it will be preserved in the planning audit. Choose a NEW option only for a missing local definition."}))
        planning_batch(run_dir, step_id, state, [task for _, _, task in selected], transport,
            size=4)
        # Reverse order keeps original array indices stable when hints are removed.
        for issue, additions, task in reversed(selected):
            path = list(issue["path"])
            replacement = planning_get(state, task["path"])
            cursor = state["payload"]
            for part in path[:-1]:
                cursor = cursor[part]
            if replacement == "__NARRATIVE_HINT__":
                state["hints"].append({"source_path": path, "text": str(issue["invalid"])})
                del cursor[path[-1]]
            else:
                if replacement in additions:
                    group, identity = additions[replacement]
                    replacement = issue["invalid"]
                    if not isinstance(replacement, str) or not re.fullmatch(r"[a-z][a-z0-9_]*", replacement):
                        replacement = f"draft_{identity[:-3]}_{len(state['payload'][group]) + 1:03d}"
                    if not any(item[identity] == replacement for item in state["payload"][group]):
                        if len(state["payload"][group]) >= schema["properties"][group]["maxItems"]:
                            continue
                        state["payload"][group].append({identity: replacement})
                        fill_planning_shape(run_dir, step_id, state, schema, transport)
                cursor[path[-1]] = [replacement] if issue.get("mode") == "set_list" else replacement
            save_planning_draft(run_dir, step_id, state)


def allocate_core_draft(run_dir, schema, transport):
    scope = read_json(run_dir / "run-manifest.json")["scope"]
    groups = {key: schema["properties"][key] for key in ("arcs", "attractors", "obligation_graph")}
    properties = {key: {"type": "integer", "minimum": max(node["minItems"], 4 if key == "nodes" else 3 if key == "edges" else 1),
        "maximum": min(node["maxItems"], scope["possible_scene_count"] if key in {"arcs", "nodes"} else node["maxItems"])}
        for key, node in groups.items()}
    layout_schema = {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}
    genesis = committed_record(run_dir, "genesis")
    prompt = ("Choose the smallest useful architecture record counts for this scope. Do not write the records yet. "
        "The engine allocates stable IDs, then asks you to author coherent batches. "
        "Routing for scaffold runs is derived later from backward expansion. Counts are capacity, not quality targets.\n"
        + canonical_json({"scope": scope, "global_canon": genesis["work_canon"], "schema": layout_schema}).decode())
    result, response = request_architecture_analysis(run_dir, "architecture_layout", prompt, layout_schema, transport,
        response_name="architectureLayout", planning_mode=True, max_tokens=8192)
    preserve_planning_result(run_dir, "architecture_core", "architecture_layout", result, response, kind="planning_layout")
    payload = {}
    for group, identity, prefix in (("arcs", "arc_id", "arc"), ("attractors", "attractor_id", "attractor"),
            ("obligation_graph", "obligation_id", "obligation"), ("nodes", "node_id", "architecture_node"),
            ("edges", "edge_id", "architecture_edge")):
        if group not in result:
            continue
        parent = payload.setdefault("topology", {}) if group in {"nodes", "edges"} else payload
        parent[group] = [{identity: f"{prefix}_{index:03d}"} for index in range(1, result[group] + 1)]
    payload["topology"] = scaffold_macro_topology()
    state = {"payload": payload, "values": {}, "hints": [], "unassigned": [], "incomplete": [],
        "checkpoint_version": 3, "ready": False}
    save_planning_draft(run_dir, "architecture_core", state)
    return state


def constrain_planning_ids(schema, payload, run_dir):
    groups = {"arc_id": [value["arc_id"] for value in payload["arcs"]],
        "attractor_id": [value["attractor_id"] for value in payload["attractors"]],
        "obligation_id": [value["obligation_id"] for value in payload["obligation_graph"]],
        "node_id": [value["node_id"] for value in payload["topology"]["nodes"]]}
    genesis = committed_record(run_dir, "genesis")
    groups["claimant_id"] = [value["claimant_id"] for value in genesis["claimants"]]
    groups["character_id"] = [value["character_id"] for value in genesis.get("characters", [])]
    groups["termination"] = groups["obligation_id"] + groups["attractor_id"]
    groups["source"] = sorted(set(genesis_reference_catalog(run_dir)) | set(groups["termination"] + groups["arc_id"] + groups["node_id"]))
    fields = {"requires": "obligation_id", "hard_obligation_ids": "obligation_id",
        "prerequisite_obligation_ids": "obligation_id", "claimant_pressures": "claimant_id",
        "entry_segment_id": "node_id", "opening_branch_node_id": "node_id", "reconvergence_node_ids": "node_id",
        "from_node_id": "node_id", "to_node_id": "node_id", "arc_ids": "arc_id",
        "attractor_ids": "attractor_id", "claimant_ids": "claimant_id", "character_ids": "character_id",
        "termination_targets": "termination", "created_by_ids": "source", "artifact_id": "source"}
    for value in _walk(schema):
        if not isinstance(value, dict) or "properties" not in value:
            continue
        for name, kind in fields.items():
            if name not in value["properties"]:
                continue
            old = planning_schema_node(value["properties"][name], schema)
            value["properties"][name] = (old | ({"items": {"enum": groups[kind]}, "uniqueItems": True} if groups[kind] else {"maxItems": 0})
                if old.get("type") == "array" else {"type": "string", "enum": groups[kind]})


def scaffold_order(nodes):
    """Iterative topological order also works for several thousand linear scenes."""
    by_id = {node["node_id"]: node for node in nodes}
    if len(by_id) != len(nodes):
        raise SchemaError("Scaffold node IDs must be unique")
    incoming = {identifier: 0 for identifier in by_id}
    for node in nodes:
        targets = [edge["to_node_id"] for edge in node["successors"]]
        if len(targets) != len(set(targets)) or not set(targets).issubset(by_id):
            raise SchemaError(f"Scaffold has duplicate or unknown successors at {node['node_id']}")
        for target in targets:
            incoming[target] += 1
    queue = sorted(identifier for identifier, count in incoming.items() if not count)
    roots = list(queue)
    for identifier in queue:
        for edge in by_id[identifier]["successors"]:
            target = edge["to_node_id"]
            incoming[target] -= 1
            if not incoming[target]:
                queue.append(target)
    if len(queue) != len(nodes):
        raise SchemaError("Scaffold progression contains a cycle")
    return queue, roots


def scaffold_frontier(nodes):
    admitted = {edge["target_case_id"] for node in nodes for edge in node["successors"]}
    return sorted(node["node_id"] for node in nodes if any(case["case_id"] not in admitted for case in node["entry_cases"]))


def scaffold_entry_routes(architecture, node):
    scaffold = architecture["causal_scaffold"]
    routes = [(edge["target_case_id"], scaffold["slot_ids"][parent["node_id"]]) for parent in scaffold["nodes"]
        for edge in parent["successors"] if edge["to_node_id"] == node["node_id"]]
    return routes or [(node["entry_cases"][0]["case_id"], "genesis")]


def validate_scaffold(scaffold, scope, genesis_ids, *, complete=False):
    nodes = scaffold["nodes"]
    by_id = {node["node_id"]: node for node in nodes}
    order, roots = scaffold_order(nodes)
    scenes = [node for node in nodes if node["kind"] == "scene"]
    endings = [node for node in nodes if node["kind"] == "ending"]
    if len(scenes) > scope["possible_scene_count"] or not 2 <= len(endings) <= scope["ending_hard_max"]:
        raise SchemaError("Scaffold exceeds scene/ending capacity or has fewer than two outcomes")
    if not any(node["terminal_role"] == "final" for node in endings):
        raise SchemaError("Scaffold needs at least one final outcome")
    identities = [value[key] for node in nodes for key, values in (("case_id", node["entry_cases"]),
        ("requirement_id", node["guarantees"])) for value in values]
    identities += [req["requirement_id"] for node in nodes for case in node["entry_cases"] for req in case["requirements"]]
    if len(identities) != len(set(identities)) or set(identities).intersection(set(by_id) | set(genesis_ids)):
        raise SchemaError("Scaffold case/requirement IDs must be globally unique and distinct from node IDs")
    admitted = set()

    def support_case(supports, case, guarantees):
        required = {req["requirement_id"] for req in case["requirements"]}
        supplied = [item["requirement_id"] for item in supports]
        if set(supplied) != required or len(supplied) != len(required):
            raise SchemaError(f"Scaffold transition must support every requirement of {case['case_id']} exactly once")
        for item in supports:
            if (not item["guarantee_ids"] and not item["genesis_source_ids"] or
                    not set(item["guarantee_ids"]).issubset(guarantees) or
                    not set(item["genesis_source_ids"]).issubset(genesis_ids)):
                raise SchemaError(f"Scaffold has unsupported causal requirements at {case['case_id']}")

    for node in nodes:
        if node["kind"] == "ending":
            if node["successors"] or node["terminal_role"] not in {"final", "premature"} or not node["attractor_id"]:
                raise SchemaError("Scaffold outcomes must be terminal and name an ending attractor")
        elif not 1 <= len(node["successors"]) <= 5 or node["terminal_role"] != "none" or node["attractor_id"] is not None or node["prerequisite_obligation_ids"]:
            raise SchemaError("A scaffold scene needs one continuation or two to five branches")
        guarantees = {item["requirement_id"] for item in node["guarantees"]}
        for edge in node["successors"]:
            target = by_id[edge["to_node_id"]]
            case = next((case for case in target["entry_cases"] if case["case_id"] == edge["target_case_id"]), None)
            if case is None:
                raise SchemaError(f"Scaffold transition names an unknown entry case at {target['node_id']}")
            support_case(edge["supports"], case, guarantees)
            admitted.add(case["case_id"])
    if complete:
        opening = scaffold["opening_node_id"]
        if roots != [opening] or opening not in by_id or by_id[opening]["kind"] != "scene" or len(scenes) < 8:
            raise SchemaError("Scaffold needs one grounded opening, at least eight scenes, and no disconnected frontier")
        if len(by_id[opening]["entry_cases"]) != 1:
            raise SchemaError("Opening must have one Genesis-grounded entry case")
        case = by_id[opening]["entry_cases"][0]
        if not case["requirements"]:
            raise SchemaError("Opening needs an explicit Genesis-grounded entry requirement")
        support_case(scaffold["opening_support"], case, set())
        admitted.add(case["case_id"])
        if any(case["case_id"] not in admitted for node in nodes for case in node["entry_cases"]):
            raise SchemaError("Scaffold contains an entry case without a supporting incoming route")
    else:
        remaining = scope["possible_scene_count"] - len(scenes)
        missing_per_node = [sum(case["case_id"] not in admitted for case in node["entry_cases"]) for node in nodes]
        reserve = max(1, math.ceil((sum(missing_per_node) - 1) / 4), max(missing_per_node, default=0))
        if remaining < reserve:
            raise SchemaError(f"Scaffold needs at least {reserve} scene slots to close {sum(missing_per_node)} pending entry cases across "
                f"{len(scaffold_frontier(nodes))} frontier nodes; only {remaining} remain")
    return order, roots


def scaffold_macro_topology(scaffold=None):
    # Macro nodes are a compatibility projection; only the per-scene scaffold owns routes.
    groups = {"architecture_node_001": ("introduction", []), "architecture_node_002": ("branch_family", []),
              "architecture_node_003": ("ending_family", [])}
    mapping = {}
    if scaffold:
        for node in scaffold["nodes"]:
            group = "architecture_node_003" if node["kind"] == "ending" else (
                "architecture_node_001" if node["node_id"] == scaffold["opening_node_id"] else "architecture_node_002")
            mapping[node["node_id"]] = group
            groups[group][1].append(node["purpose"])
        pairs = sorted({(mapping[node["node_id"]], mapping[edge["to_node_id"]]) for node in scaffold["nodes"]
            for edge in node["successors"] if mapping[node["node_id"]] != mapping[edge["to_node_id"]]})
    else:
        pairs = [("architecture_node_001", "architecture_node_002"), ("architecture_node_002", "architecture_node_003")]
    return {"entry_segment_id": "architecture_node_001", "opening_branch_node_id": "architecture_node_001",
        "nodes": [{"node_id": key, "node_type": kind, "purpose": "; ".join(purposes[:3]) or "Compatibility projection of the causal scaffold.",
                   "hard_obligation_ids": []} for key, (kind, purposes) in groups.items()],
        "edges": [{"edge_id": f"architecture_edge_{index:03d}", "from_node_id": source, "to_node_id": target,
                   "relation": "progression", "hard_obligation_ids": []} for index, (source, target) in enumerate(pairs, 1)],
        "reconvergence_node_ids": []}


def scaffold_declaration_schema(run_dir, maximum, *, seed=False, minimum=1):
    core = planning_core(run_dir)
    text = {"type": "string", "minLength": 1, "maxLength": 800}
    fields = {"arc_id": {"enum": [arc["arc_id"] for arc in core["arcs"]]},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1200},
        "intended_change": {"type": "string", "minLength": 1, "maxLength": 1200},
        "entry_cases": {"type": "array", "minItems": 1, "maxItems": 5, "items": {
            "type": "object", "additionalProperties": False, "required": ["requirements"],
            "properties": {"requirements": {"type": "array", "maxItems": 8, "items": text}}}},
        "guarantees": {"type": "array", "minItems": 1 if seed else 0, "maxItems": 8, "items": text},
        "preserves": {"type": "array", "maxItems": 8, "items": text}}
    if seed:
        fields |= {"terminal_role": {"enum": ["final", "premature"]},
            "attractor_id": {"enum": [item["attractor_id"] for item in core["attractors"] if item["kind"] == "ending"]},
            "prerequisite_obligation_ids": packet_dependency_schema([item["obligation_id"] for item in core["obligation_graph"] if item["hardness"] == "hard"])}
    properties = {"nodes": {"type": "array", "minItems": minimum, "maxItems": maximum, "items": {
        "type": "object", "additionalProperties": False, "required": list(fields), "properties": fields}}}
    if seed:
        properties["complete"] = {"type": "boolean"}
    return {"type": "object", "additionalProperties": False, "required": list(properties), "properties": properties}


def scaffold_contract_signature(value):
    if isinstance(value, str):
        return " ".join(value.split())
    if isinstance(value, list):
        return [scaffold_contract_signature(item) for item in value]
    if isinstance(value, dict):
        return {key: scaffold_contract_signature(item) for key, item in value.items()}
    return value


def validate_scaffold_declaration(declaration):
    clauses = [declaration["purpose"], declaration["intended_change"], *declaration["guarantees"], *declaration["preserves"]]
    signatures = []
    for case in declaration["entry_cases"]:
        clauses.extend(case["requirements"])
        signature = sorted(scaffold_contract_signature(case["requirements"]))
        if signature in signatures:
            raise SchemaError("Duplicate scaffold entry cases: alternatives must describe distinct sufficient conditions")
        signatures.append(signature)
    for clause in clauses:
        inspected = re.sub(r'\\+(?=["\'])', '', clause)
        if not any(character.isalnum() for character in clause) or re.search(
                r'''\b(?:node_id|case_id|requirement_id|guarantee_id)["']\s*:''', inspected):
            raise SchemaError(f"Malformed scaffold clause: {clause!r}. Return a plain condition or transformation, without serialized engine fields")


def validate_scaffold_amendment(prior, amendment):
    candidate = prior | amendment
    validate_scaffold_declaration(candidate)
    if scaffold_contract_signature(candidate) == scaffold_contract_signature(prior):
        raise SchemaError("No-op scaffold amendment: the requested repair must change the contract")
    if "guarantees" in amendment and not prior["guarantees"] and not candidate["guarantees"]:
        raise SchemaError("Missing guarantees remain empty; changing other fields does not repair the missing exit guarantees")
    return candidate


def compile_scaffold_declarations(declarations, allocated, *, seed=False, revisions=None):
    if not 1 <= len(declarations) <= len(allocated):
        raise SchemaError("Scaffold declarations exceed their allocated capacity")
    result = []
    for identifier, declaration in zip(allocated, declarations):
        validate_scaffold_declaration(declaration)
        prefix = f"{identifier}_r{(revisions or {}).get(identifier, 0):03d}"
        cases = []
        for index, case in enumerate(declaration["entry_cases"], 1):
            case_id = f"{prefix}_entry_{index:03d}"
            cases.append({"case_id": case_id, "requirements": [{"requirement_id": f"{case_id}_req_{number:03d}",
                "description": text} for number, text in enumerate(case["requirements"], 1)]})
        result.append({"node_id": identifier, "kind": "ending" if seed else "scene",
            "terminal_role": declaration["terminal_role"] if seed else "none",
            "arc_id": declaration["arc_id"], "attractor_id": declaration["attractor_id"] if seed else None,
            "purpose": declaration["purpose"], "intended_change": declaration["intended_change"],
            "entry_cases": cases, "guarantees": [{"requirement_id": f"{prefix}_guarantee_{index:03d}", "description": text}
                for index, text in enumerate(declaration["guarantees"], 1)], "preserves": declaration["preserves"],
            "successors": [], "prerequisite_obligation_ids": declaration["prerequisite_obligation_ids"] if seed else []})
    return result


def scaffold_target_schema(targets, *, allow_finish=False, locks=None):
    fields = {node["node_id"]: {"enum": [case["case_id"] for case in node["entry_cases"]]} for node in targets}
    for identifier, case in (locks or {}).items():
        if identifier not in fields or case not in fields[identifier]["enum"]:
            raise IntegrityError("Locked scaffold target is outside the current interfaces")
        fields[identifier] = {"const": case}
    selection = {"type": "object", "additionalProperties": False, "required": ["targets", "causal_job"], "properties": {
        "targets": {"type": "object", "additionalProperties": False, "minProperties": 1, "maxProperties": 5,
            "required": list(locks or {}), "properties": fields},
        "causal_job": {"type": "string", "minLength": 1, "maxLength": 1200}}}
    return {"type": "object", "additionalProperties": False, "required": ["selection"], "properties": {
        "selection": {"anyOf": [selection, {"type": "null"}]} if allow_finish else selection}}


def scaffold_assigned_interfaces(assignment, targets):
    validate_json_schema({"selection": assignment}, scaffold_target_schema(targets))
    return [{key: ([case for case in node["entry_cases"] if case["case_id"] == assignment["targets"][node["node_id"]]]
                   if key == "entry_cases" else value)
             for key, value in node.items() if key != "successors"}
            for node in targets if node["node_id"] in assignment["targets"]]


def scaffold_support_value_schema(evidence_ids):
    return {"type": "object", "additionalProperties": False, "required": ["evidence_ids", "reason"], "properties": {
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": True,
            "items": {"enum": sorted(evidence_ids)}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1200}}}


def scaffold_support_selection_schema(case, evidence_ids, *, shared=False):
    support = {"$ref": "#/$defs/scaffoldEvidenceSupport"} if shared else scaffold_support_value_schema(evidence_ids)
    fields = {requirement["requirement_id"]: support for requirement in case["requirements"]}
    return {"type": "object", "additionalProperties": False, "required": list(fields), "properties": fields}


def compile_scaffold_supports(selection, case, guarantee_ids, genesis_ids):
    validate_json_schema(selection, scaffold_support_selection_schema(case, set(guarantee_ids) | set(genesis_ids)))
    return [{"requirement_id": requirement["requirement_id"],
        "guarantee_ids": [identifier for identifier in selection[requirement["requirement_id"]]["evidence_ids"] if identifier in guarantee_ids],
        "genesis_source_ids": [identifier for identifier in selection[requirement["requirement_id"]]["evidence_ids"] if identifier in genesis_ids],
        "reason": selection[requirement["requirement_id"]]["reason"]} for requirement in case["requirements"]]


def scaffold_connection_schema(node, targets, genesis_ids, *, allow_amendment=False):
    evidence = set(genesis_ids) | {item["requirement_id"] for item in node["guarantees"]}
    fields = {}
    for target in targets:
        fields[target["node_id"]] = {"anyOf": [{"type": "object", "additionalProperties": False,
            "required": ["entry_case_id", "supports"], "properties": {"entry_case_id": {"const": case["case_id"]},
                "supports": scaffold_support_selection_schema(case, evidence, shared=True)}} for case in target["entry_cases"]]}
    schema = {"type": "object", "additionalProperties": False,
        "$defs": {"scaffoldEvidenceSupport": scaffold_support_value_schema(evidence)}, "required": ["connections"], "properties": {
        "connections": {"type": "object", "minProperties": 1, "maxProperties": 5,
            "additionalProperties": False, "properties": fields}}}
    if allow_amendment:
        repair = {"type": "object", "additionalProperties": False, "required": ["contract_issue"], "properties": {
            "contract_issue": {"type": "object", "additionalProperties": False, "required": ["fields", "reason"], "properties": {
                "fields": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": True,
                    "items": {"enum": ["arc_id", "purpose", "intended_change", "entry_cases", "guarantees", "preserves"]}},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1200}}}}}
        definitions = schema.pop("$defs")
        return {"anyOf": [schema, repair], "$defs": definitions}
    return schema


def compile_scaffold_connections(node, targets, selection, genesis_ids):
    validate_json_schema(selection, scaffold_connection_schema(node, targets, genesis_ids))
    by_id = {item["node_id"]: item for item in targets}
    guarantees = {item["requirement_id"] for item in node["guarantees"]}
    connections = []
    for target_id, selected in sorted(selection["connections"].items()):
        case = next(case for case in by_id[target_id]["entry_cases"] if case["case_id"] == selected["entry_case_id"])
        connections.append({"to_node_id": target_id, "target_case_id": case["case_id"],
            "supports": compile_scaffold_supports(selected["supports"], case, guarantees, genesis_ids)})
    return node | {"successors": connections}


def scaffold_opening_candidate(state, nodes):
    combined = state["nodes"] + nodes
    _order, roots = scaffold_order(combined)
    if sum(node["kind"] == "scene" for node in combined) < 8 or roots != [nodes[-1]["node_id"]]:
        return None
    opening = nodes[-1]
    if len(opening["entry_cases"]) != 1 or not opening["entry_cases"][0]["requirements"]:
        return None
    admitted = {edge["target_case_id"] for node in combined for edge in node["successors"]}
    admitted.add(opening["entry_cases"][0]["case_id"])
    if any(case["case_id"] not in admitted for node in combined for case in node["entry_cases"]):
        return None
    return opening


def normalize_scaffold_repair_selectors(result):
    if not isinstance(result, dict):
        return result
    result = copy.deepcopy(result)
    def unique(items):
        return list(dict.fromkeys(items)) if isinstance(items, list) and all(isinstance(item, str) for item in items) else items
    for field in ("contract_repairs", "connection_repairs"):
        if isinstance(result.get(field), dict):
            result[field] = {identifier: unique(items) for identifier, items in result[field].items()}
    issue = result.get("contract_issue")
    if isinstance(issue, dict) and "fields" in issue:
        issue["fields"] = unique(issue["fields"])
    return result


def review_scaffold_connections(run_dir, step, patch, frontier, contract_fields, mechanical_problem, transport):
    identifiers = [node["node_id"] for node in patch["nodes"]]
    source_ids = {identifier for node in patch["nodes"] for edge in node["successors"] for support in edge["supports"]
        for identifier in support["genesis_source_ids"]}
    source_ids.update(identifier for support in patch["opening_support"] for identifier in support["genesis_source_ids"])
    sources = retrieve_original_sources(run_dir, [{"sources": [{"artifact_id": identifier} for identifier in sorted(source_ids)]}],
        limit=None, strict=True, follow_sources=False) if source_ids else []
    schema = {"type": "object", "additionalProperties": False,
        "required": ["supported", "reason", "contract_repairs", "connection_repairs"], "properties": {
            "supported": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1},
            "contract_repairs": {"type": "object", "additionalProperties": False, "properties": {
                identifier: {"type": "array", "minItems": 1, "maxItems": len(contract_fields), "uniqueItems": True,
                    "items": {"enum": list(contract_fields)}} for identifier in identifiers}},
            "connection_repairs": {"type": "object", "additionalProperties": False, "properties": {
                node["node_id"]: {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": True,
                    "items": {"enum": [edge["to_node_id"] for edge in node["successors"]]}} for node in patch["nodes"]}}}}
    def validate(result):
        repairs = bool(result["contract_repairs"] or result["connection_repairs"])
        if result["supported"] and (repairs or mechanical_problem):
            raise SchemaError("supported=true conflicts with requested repairs or a mechanical problem; return supported=false and identify the necessary repairs")
        if not result["supported"] and not repairs:
            raise SchemaError("Identify the specific uncommitted contract fields or predecessor connections needing correction")
    prompt = render_prompt(run_dir, "generation-scaffold-review.md", {"SCAFFOLD_CONTEXT": canonical_json({
        "patch": patch, "existing_successors": [{key: value for key, value in node.items() if key != "successors"} for node in frontier],
        "committed_genesis_sources": sources,
        "mechanical_problem": mechanical_problem}).decode()})
    query = step + "_review_" + sha256_bytes(prompt.encode())[:16]
    result, response = request_architecture_analysis(run_dir, query, prompt, schema, transport, validator=validate,
        planning_mode=True, max_tokens=3072, pause_stage="Scaffold causal support",
        system_prompt="Verify only causal support and compatibility in uncommitted planning. Return JSON only.",
        result_normalizer=normalize_scaffold_repair_selectors)
    preserve_planning_result(run_dir, "architecture_core", query, result, response, kind="scaffold_connection_review")
    return result


def prepare_scaffold_expansion(run_dir, state, core, targets, allocated, transport):
    step = f"scaffold_expand_{state['round'] + 1:05d}"
    path = run_dir / ".staging" / f"{step}.contracts.json"
    scope = read_json(run_dir / "run-manifest.json")["scope"]
    genesis = genesis_reference_catalog(run_dir)
    frontier = [node for identifier in targets for node in state["nodes"] if node["node_id"] == identifier]
    input_hash = sha256_bytes(canonical_json({"nodes": state["nodes"], "targets": targets, "allocated": allocated, "scope": scope}))
    declaration_schema = scaffold_declaration_schema(run_dir, 1, minimum=1)
    fields = declaration_schema["properties"]["nodes"]["items"]["properties"]
    if path.exists():
        draft = read_json(path)
        if draft.get("version") != 3 or draft["input_hash"] != input_hash:
            raise IntegrityError("Scaffold contract checkpoint belongs to a different planner, frontier or allocation")
    else:
        draft = {"version": 3, "input_hash": input_hash, "assignments": {}, "declarations": [], "revisions": {},
            "connections": {}, "connection_locks": {}, "history": [], "feedback": {}, "pending": {},
            "needs_guarantees": [], "last_repairs": {}, "batch_closed": False}
        write_json(path, draft)
    canon = committed_record(run_dir, "genesis") or {}
    common = {"scope": scope, "arcs": core["arcs"], "genesis_sources": genesis,
        "global_canon": {key: canon[key] for key in ("work_canon", "format_composition_law") if key in canon}}
    replanned = set()

    def save():
        write_json(path, draft)

    def compiled():
        return compile_scaffold_declarations(draft["declarations"], allocated, revisions=draft["revisions"]) if draft["declarations"] else []

    def ask(kind, prompt, schema, *, pause_stage, **kwargs):
        query = step + "_" + kind + "_" + sha256_bytes(canonical_json([prompt, schema]))[:16]
        result, response = request_architecture_analysis(run_dir, query, prompt, schema, transport,
            planning_mode=True, pause_stage=pause_stage, **kwargs)
        preserve_planning_result(run_dir, "architecture_core", query, result, response, kind="scaffold_" + kind.split("_")[0])
        return result

    def clear_publication_check():
        draft.pop("opening_input", None)
        draft.pop("accepted_patch", None)

    def invalidate_contract(identifier, old_node, new_node):
        invalidated = [identifier]
        draft["connections"].pop(identifier, None)
        draft["connection_locks"].pop(identifier, None)
        for consumer, assignment in list(draft["assignments"].items()):
            if identifier not in assignment["targets"]:
                continue
            old_case = next(case for case in old_node["entry_cases"] if case["case_id"] == assignment["targets"][identifier])
            descriptions = scaffold_contract_signature([item["description"] for item in old_case["requirements"]])
            replacement = next((case for case in new_node["entry_cases"] if
                scaffold_contract_signature([item["description"] for item in case["requirements"]]) == descriptions), None)
            existing = draft["connection_locks"].get(consumer, {}) | draft["connections"].pop(consumer, {}).get("connections", {})
            draft["connection_locks"][consumer] = {key: value for key, value in existing.items() if key != identifier}
            if replacement is not None:
                assignment["targets"][identifier] = replacement["case_id"]
            else:
                draft["assignments"].pop(consumer)
                draft["pending"][consumer] = "A selected successor entry condition changed; reselect and redeclare this predecessor."
            draft["feedback"][consumer] = "The successor contract changed; bind the current requirement IDs against their exact conditions."
            invalidated.append(consumer)
        clear_publication_check()
        return invalidated

    def replan(identifier, reason):
        if identifier in replanned:
            raise PausedError("Scaffold contract re-declaration", f"{identifier} remains unsupported after its bounded local re-declaration. "
                "The latest contract and accepted unrelated work were retained. Last problem: " + reason)
        replanned.add(identifier)
        draft["pending"][identifier] = reason
        draft["feedback"][identifier] = reason
        draft["assignments"].pop(identifier, None)
        draft["connections"].pop(identifier, None)
        draft["connection_locks"].pop(identifier, None)
        clear_publication_check()
        save()

    def repair(review):
        owners = set(review["contract_repairs"]) | set(review["connection_repairs"])
        for identifier in sorted(owners):
            names = review["contract_repairs"].get(identifier, [])
            destinations = review["connection_repairs"].get(identifier, [])
            signature = {"fields": sorted(names), "destinations": sorted(destinations)}
            index = allocated.index(identifier)
            prior = copy.deepcopy(draft["declarations"])
            draft["feedback"][identifier] = review["reason"]
            if "guarantees" in names and not prior[index]["guarantees"] and identifier not in draft["needs_guarantees"]:
                draft["needs_guarantees"].append(identifier)
            if identifier in draft["pending"]:
                save()
                continue
            if draft["last_repairs"].get(identifier) == signature:
                replan(identifier, review["reason"])
                continue
            invalidated = []
            if names:
                amendment_fields = {name: copy.deepcopy(fields[name]) for name in names}
                if identifier in draft["needs_guarantees"]:
                    amendment_fields["guarantees"] = copy.deepcopy(fields["guarantees"]) | {"minItems": 1}
                schema = {"type": "object", "additionalProperties": False, "required": [identifier], "properties": {
                    identifier: {"type": "object", "additionalProperties": False,
                        "required": list(amendment_fields), "properties": amendment_fields}}}
                def validate(result):
                    validate_scaffold_amendment(prior[index], result[identifier])
                known = frontier + compiled()[:index]
                assignment = draft["assignments"][identifier]
                prompt = ("Repair only these flagged fields of one uncommitted predecessor. Make an actual change. "
                    "If guarantees are missing, add the promised exit conditions; changing preserves alone is insufficient. "
                    "Write plain clauses without serialized engine IDs. This scene immediately precedes the selected entry cases, "
                    "not necessarily the opening of the story. Do not turn Genesis premises into unwritten reader experiences.\n" +
                    canonical_json(common | {"problem": review["reason"], "field_requests": {identifier: list(amendment_fields)},
                        "contracts": {identifier: prior[index]}, "assignment": assignment,
                        "successor_interfaces": scaffold_assigned_interfaces(assignment, known)}).decode())
                try:
                    amendments = ask("amend_" + identifier, prompt, schema, validator=validate,
                        pause_stage="Scaffold contract amendment", max_tokens=6144)
                except PausedError as error:
                    if error.stage != "Scaffold contract amendment" or error.failure_class != "corrective_pause":
                        raise
                    replan(identifier, error.reason)
                    continue
                old_node = compiled()[index]
                draft["declarations"][index] = validate_scaffold_amendment(prior[index], amendments[identifier])
                draft["revisions"][identifier] = draft["revisions"].get(identifier, 0) + 1
                invalidated = invalidate_contract(identifier, old_node, compiled()[index])
            else:
                existing = draft["connection_locks"].get(identifier, {}) | draft["connections"].pop(identifier, {}).get("connections", {})
                draft["connection_locks"][identifier] = {key: value for key, value in existing.items() if key not in destinations}
                invalidated = [identifier]
                clear_publication_check()
            draft["last_repairs"][identifier] = signature
            draft["history"].append({"review": review, "prior_declarations": prior,
                "invalidated_connections": sorted(invalidated), "locked_connections": copy.deepcopy(draft["connection_locks"])})
            draft["opening_feedback"] = review["reason"]
            save()

    for recovery in range(4):
        binding_issue = None
        for index, identifier in enumerate(allocated):
            if index >= len(draft["declarations"]) and draft["batch_closed"]:
                break
            nodes = compiled()
            known = frontier + nodes[:index]
            if identifier not in draft["assignments"]:
                locks = {key: value["entry_case_id"] for key, value in draft["connection_locks"].get(identifier, {}).items()}
                schema = scaffold_target_schema(known, allow_finish=index > 0 and index == len(nodes), locks=locks)
                context = common | {"source_node_id": identifier, "scenes_accepted": sum(node["kind"] == "scene" for node in state["nodes"]) + index,
                    "remaining_batch_capacity": len(allocated) - index,
                    "frontier_contracts": [{key: value for key, value in node.items() if key != "successors"} for node in known],
                    "correction": draft["feedback"].get(identifier), "previous_contract": draft["declarations"][index] if index < len(nodes) else None}
                prompt = render_prompt(run_dir, "generation-scaffold-targets.md", {"SCAFFOLD_CONTEXT": canonical_json(context).decode()})
                selected = ask("targets_" + identifier, prompt, schema, pause_stage="Scaffold targets", max_tokens=4096)
                if selected["selection"] is None:
                    draft["batch_closed"] = True
                    save()
                    break
                draft["assignments"][identifier] = selected["selection"]
                save()
            assignment = draft["assignments"][identifier]
            interfaces = scaffold_assigned_interfaces(assignment, known)
            if index == len(nodes) or identifier in draft["pending"]:
                schema = copy.deepcopy(declaration_schema)
                if identifier in draft["needs_guarantees"]:
                    schema["properties"]["nodes"]["items"]["properties"]["guarantees"]["minItems"] = 1
                prior = copy.deepcopy(draft["declarations"])
                def validate(result):
                    compile_scaffold_declarations(result["nodes"], [identifier])
                    if index < len(prior) and scaffold_contract_signature(result["nodes"][0]) == scaffold_contract_signature(prior[index]):
                        raise SchemaError("No-op scaffold re-declaration: replace the deficient contract to fulfill its backward assignment")
                prompt = render_prompt(run_dir, "generation-scaffold-declarations.md", {"SCAFFOLD_CONTEXT": canonical_json(common | {
                    "source_node_id": identifier, "assignment": assignment, "successor_interfaces": interfaces,
                    "scenes_accepted": sum(node["kind"] == "scene" for node in state["nodes"]) + index, "allocated_capacity": 1,
                    "previous_contract": prior[index] if index < len(prior) else None, "correction": draft["pending"].get(identifier)}).decode()})
                declared = ask("declare_" + identifier, prompt, schema, validator=validate,
                    pause_stage="Scaffold declarations", temperature=0.5, max_tokens=6144)
                if index == len(nodes):
                    draft["declarations"].append(declared["nodes"][0])
                else:
                    old_node = nodes[index]
                    draft["declarations"][index] = declared["nodes"][0]
                    draft["revisions"][identifier] = draft["revisions"].get(identifier, 0) + 1
                    invalidated = invalidate_contract(identifier, old_node, compiled()[index])
                    draft["history"].append({"kind": "redeclaration", "node_id": identifier, "prior_declarations": prior,
                        "invalidated_connections": sorted(invalidated)})
                    draft["last_repairs"].pop(identifier, None)
                draft["pending"].pop(identifier, None)
                save()
                nodes = compiled()
            node = nodes[index]
            schema = scaffold_connection_schema(node, interfaces, genesis, allow_amendment=True)
            connection_fields = schema["anyOf"][0]["properties"]["connections"]
            connection_fields["required"] = list(assignment["targets"])
            for target_id, value in draft["connection_locks"].get(identifier, {}).items():
                if target_id not in connection_fields["properties"]:
                    raise IntegrityError("Locked scaffold connection is outside the selected successor interfaces")
                connection_fields["properties"][target_id] = {"const": value}
            if identifier in draft["connections"]:
                selected = draft["connections"][identifier]
                validate_json_schema(selected, schema)
            else:
                prompt = render_prompt(run_dir, "generation-scaffold-connections.md", {"SCAFFOLD_CONTEXT": canonical_json({
                    "predecessor": node, "assignment": assignment, "successor_interfaces": interfaces,
                    "genesis_sources": genesis, "correction": draft["feedback"].get(identifier)}).decode()})
                selected = ask("connect_" + identifier, prompt, schema, pause_stage="Scaffold connections", max_tokens=6144,
                    result_normalizer=normalize_scaffold_repair_selectors)
                if "contract_issue" in selected:
                    binding_issue = {"supported": False, "reason": selected["contract_issue"]["reason"],
                        "contract_repairs": {identifier: selected["contract_issue"]["fields"]}, "connection_repairs": {}}
                    break
                draft["connections"][identifier] = selected
                save()
        else:
            draft["batch_closed"] = True
            save()
        if binding_issue is not None:
            review = binding_issue
            draft["last_review"] = {"reason": review["reason"], "revisions": copy.deepcopy(draft["revisions"])}
            save()
            if recovery < 3:
                repair(review)
            continue
        nodes = [compile_scaffold_connections(node, frontier + compiled()[:index], draft["connections"][node["node_id"]], genesis)
            for index, node in enumerate(compiled())]
        patch = {"nodes": nodes, "complete": False, "opening_node_id": None, "opening_support": []}
        opening = scaffold_opening_candidate(state, nodes)
        if opening is not None:
            case = opening["entry_cases"][0]
            exhausted = len([node for node in state["nodes"] + nodes if node["kind"] == "scene"]) == scope["possible_scene_count"]
            opening_schema = {"type": "object", "additionalProperties": False, "required": ["opening"], "properties": {
                "opening": {"type": "object", "additionalProperties": False, "required": ["supports"],
                    "properties": {"supports": scaffold_support_selection_schema(case, genesis)}}}}
            if not exhausted:
                opening_schema["properties"]["opening"] = {"anyOf": [opening_schema["properties"]["opening"], {"type": "null"}]}
            signature = sha256_bytes(canonical_json(patch))
            if draft.get("opening_input") != signature:
                prompt = ("Decide whether this structurally eligible uncommitted opening is the earned beginning of this work. "
                    "Return opening=null to keep planning earlier scenes when capacity remains. To finish, support every entry "
                    "requirement with supplied Genesis evidence only. Do not invent events or claim plans as history.\n" +
                    canonical_json({"opening": opening, "remaining_scenes": scope["possible_scene_count"] - sum(node["kind"] == "scene" for node in state["nodes"] + nodes),
                        "genesis": committed_record(run_dir, "genesis"), "genesis_sources": genesis,
                        "correction": draft.get("opening_feedback")}).decode())
                query = step + "_opening_" + sha256_bytes(prompt.encode())[:16]
                result, response = request_architecture_analysis(run_dir, query, prompt, opening_schema, transport,
                    planning_mode=True, max_tokens=4096, pause_stage="Scaffold opening")
                preserve_planning_result(run_dir, "architecture_core", query, result, response, kind="scaffold_opening")
                draft |= {"opening_input": signature, "opening": result["opening"]}
                write_json(path, draft)
            if draft["opening"] is not None:
                validate_json_schema({"opening": draft["opening"]}, opening_schema)
                patch |= {"complete": True, "opening_node_id": opening["node_id"],
                    "opening_support": compile_scaffold_supports(draft["opening"]["supports"], case, set(), set(genesis))}
        problem = None
        try:
            validate_scaffold(state | {"nodes": state["nodes"] + nodes, "opening_node_id": patch["opening_node_id"],
                "opening_support": patch["opening_support"]}, scope, set(genesis), complete=patch["complete"])
        except SchemaError as error:
            problem = error.reason
        if draft.get("accepted_patch") == patch:
            if problem:
                raise IntegrityError("Accepted scaffold checkpoint is no longer structurally valid: " + problem)
            return patch
        review = review_scaffold_connections(run_dir, step, patch, frontier,
            declaration_schema["properties"]["nodes"]["items"]["properties"], problem, transport)
        if review["supported"]:
            draft["accepted_patch"] = patch
            write_json(path, draft)
            return patch
        draft["last_review"] = {"reason": review["reason"], "revisions": copy.deepcopy(draft["revisions"])}
        save()
        if recovery < 3:
            repair(review)
    last = draft["last_review"]
    raise PausedError("Scaffold connections", "Four scaffold repair cycles did not establish a valid expansion in this invocation. "
        f"Last evaluated revisions: {last['revisions']}; pending declarations: {sorted(draft['pending'])}. "
        "Accepted unrelated work was retained. Last problem: " + last["reason"])


def prepare_causal_scaffold(run_dir, core, transport):
    if core.get("causal_scaffold"):
        validate_json_schema(core["causal_scaffold"], definition_schema("causalScaffold", load_protocol(run_dir)))
        validate_scaffold(core["causal_scaffold"], read_json(run_dir / "run-manifest.json")["scope"],
            set(genesis_reference_catalog(run_dir)), complete=True)
        return core
    path = run_dir / ".staging/causal-scaffold.json"
    scope = read_json(run_dir / "run-manifest.json")["scope"]
    genesis_ids = set(genesis_reference_catalog(run_dir))
    state = read_json(path) if path.exists() else {"version": 1, "nodes": [], "round": 0, "complete": False,
        "opening_node_id": None, "opening_support": [], "outcomes_complete": False}
    state.setdefault("outcomes_complete", state["complete"] or any(node["kind"] == "scene" for node in state["nodes"]))
    if state["nodes"]:
        for node in state["nodes"]:
            validate_json_schema(node, definition_schema("scaffoldNode", load_protocol(run_dir)))
    while not state["outcomes_complete"]:
        offset = len(state["nodes"])
        capacity = min(4, scope["ending_hard_max"] - offset)
        if capacity < 1:
            raise PausedError("Scaffold outcomes", "Outcome capacity exhausted before outcome planning closed; draft retained")
        allocated = [f"scaffold_outcome_{index:04d}" for index in range(offset + 1, offset + capacity + 1)]
        schema = scaffold_declaration_schema(run_dir, capacity, seed=True, minimum=2 if not offset else 1)
        prompt = ("Declare terminal outcomes as narrative contracts only. Do not emit node, case, requirement, or guarantee IDs. "
            "The engine assigns those IDs from array order. Include a final outcome on the first page. Premature outcomes "
            "have their own sufficient entry requirements, not every final revelation. Finish this outcome stage with "
            "complete=true when enough distinct outcomes exist, and always at the hard ending limit. No prose.\n" +
            canonical_json({"scope": scope, "outcomes_accepted": offset, "maximum_this_page": capacity,
                "recent_outcome_contracts": state["nodes"][-4:], "genesis": committed_record(run_dir, "genesis"),
                "arcs": core["arcs"], "attractors": core["attractors"]}).decode())
        def validate_seed(result):
            authored = compile_scaffold_declarations(result["nodes"], allocated, seed=True)
            if [node["node_id"] for node in authored] != allocated[:len(authored)]:
                raise SchemaError("Use the allocated outcome IDs in order, preserving accepted outcomes")
            candidate = state | {"nodes": state["nodes"] + authored}
            validate_scaffold(candidate, scope, genesis_ids)
            if len({node["purpose"] for node in candidate["nodes"]}) != len(candidate["nodes"]):
                raise SchemaError("Terminal outcomes must have distinct authored purposes")
            if len(candidate["nodes"]) == scope["ending_hard_max"] and not result["complete"]:
                raise SchemaError("Outcome planning must finish at its hard ending limit")
        step = f"scaffold_outcomes_{offset + 1:05d}"
        result, response = request_architecture_analysis(run_dir, step, prompt, schema, transport,
            validator=validate_seed, planning_mode=True, temperature=0.5, max_tokens=8192,
            pause_stage="Scaffold outcomes", system_prompt="Author only the requested uncommitted story contracts. Return JSON only.")
        preserve_planning_result(run_dir, "architecture_core", step, result, response, kind="scaffold_outcomes")
        state["nodes"].extend(compile_scaffold_declarations(result["nodes"], allocated, seed=True))
        state["outcomes_complete"] = result["complete"]
        write_json(path, state)
    while not state["complete"]:
        validate_scaffold(state, scope, genesis_ids)
        frontier = scaffold_frontier(state["nodes"])
        count = sum(node["kind"] == "scene" for node in state["nodes"])
        available = min(4, scope["possible_scene_count"] - count)
        if available < 1:
            raise PausedError("Scaffold expansion", "No scene capacity remains for a grounded opening; accepted contracts retained")
        allocated = [f"scaffold_scene_{count + index:05d}" for index in range(1, available + 1)]
        targets = frontier[:5]
        by_id = {node["node_id"]: node for node in state["nodes"]}
        result = prepare_scaffold_expansion(run_dir, state, core, targets, allocated, transport)
        state |= {"nodes": state["nodes"] + result["nodes"], "round": state["round"] + 1,
            "complete": result["complete"], "opening_node_id": result["opening_node_id"], "opening_support": result["opening_support"]}
        write_json(path, state)
    validate_scaffold(state, scope, genesis_ids, complete=True)
    order, _roots = scaffold_order(state["nodes"])
    node_by_id = {node["node_id"]: node for node in state["nodes"]}
    counters, slots = {"scene": 0, "ending": 0}, {}
    for identifier in order:
        kind = node_by_id[identifier]["kind"]
        counters[kind] += 1
        slots[identifier] = f"{kind}_slot_{counters[kind]:04d}"
    scaffold = copy.deepcopy({key: state[key] for key in ("version", "nodes", "opening_node_id", "opening_support")}) | {"slot_ids": slots}
    actual = derive_scope(counters["scene"])["scope"]
    attractors = [item | {"kind": "branch"} if item["kind"] == "ending" else item for item in core["attractors"]]
    original_attractors = {item["attractor_id"]: item for item in core["attractors"]}
    for index, node in enumerate((node for node in scaffold["nodes"] if node["kind"] == "ending"), 1):
        original = original_attractors[node["attractor_id"]]
        identifier = f"attractor_outcome_{index:04d}"
        attractors.append(original | {"attractor_id": identifier, "terminal_transformation": node["intended_change"],
            "prerequisite_obligation_ids": node["prerequisite_obligation_ids"], "foreclosable": False,
            "soft_seed_conditions": [requirement["description"] for case in node["entry_cases"] for requirement in case["requirements"]],
            "unresolved_realization": [node["intended_change"]]})
        node["attractor_id"] = identifier
    compiled = core | {"causal_scaffold": scaffold, "topology": scaffold_macro_topology(scaffold), "attractors": attractors,
        "scope_commitment": core["scope_commitment"] | {"planned_scene_count": counters["scene"],
            "planned_ending_count": counters["ending"], "planned_artifact_count": actual["artifact_target"],
            "planned_formal_composition_count": actual["formal_composition_target"]}}
    draft = read_json(run_dir / ".staging/architecture_core.planning.json")
    draft["record"] = compiled
    save_planning_draft(run_dir, "architecture_core", draft)
    return compiled


def scaffold_packet_plans(core):
    specs = planned_packet_specs(core)
    scaffold = core["causal_scaffold"]
    slots, nodes = scaffold["slot_ids"], {node["node_id"]: node for node in scaffold["nodes"]}
    owners = {slot: spec["packet_slot_id"] for spec in specs for slot in spec["scene_slot_ids"] + spec["ending_slot_ids"]}
    parents = {identifier: [] for identifier in nodes}
    for node in nodes.values():
        for edge in node["successors"]:
            parents[edge["to_node_id"]].append(node["node_id"])
    plans = []
    for index, spec in enumerate(specs, 1):
        own = set(spec["scene_slot_ids"] + spec["ending_slot_ids"])
        local = [node for node in nodes.values() if slots[node["node_id"]] in own]
        dependencies = sorted({owners[slots[parent]] for node in local for parent in parents[node["node_id"]]
            if owners[slots[parent]] != spec["packet_slot_id"]})
        plans.append(spec | {"initial_priority": index, "depends_on_packet_slot_ids": dependencies,
            "branch_path_relation": "; ".join(node["purpose"] for node in local),
            "attractor_ids": sorted({node["attractor_id"] for node in local if node["attractor_id"]}),
            "relevance": {"arc_ids": sorted({node["arc_id"] for node in local}), "technical_slot_ids": sorted(own),
                "claimant_ids": sorted({identifier for arc in core["arcs"] if arc["arc_id"] in {node["arc_id"] for node in local}
                    for identifier in arc["claimant_pressures"]})},
            "soft_guidance": [node["intended_change"] for node in local],
            "required_navigation": {slots[node["node_id"]]: [slots[edge["to_node_id"]] for edge in node["successors"]]
                for node in local if node["kind"] == "scene"}})
    return plans


def compile_scaffold_batches(run_dir, core):
    plans = scaffold_packet_plans(core)
    groups = [plans[index:index + PLAN_BATCH_SIZE] for index in range(0, len(plans), PLAN_BATCH_SIZE)]
    records = []
    for index, plans in enumerate(groups, 1):
        step = f"architecture_plan_batch_{index:04d}"
        committed = next((record for record in committed_records(run_dir, "architecture_plan_batch") if record["batch_sequence"] == index), None)
        if committed:
            if committed["packet_plans"] != plans:
                raise IntegrityError("Committed scaffold compilation differs from its frozen core")
            records.append(committed)
            continue
        record = record_envelope(run_dir, "architecture_plan_batch", step) | {
            "architecture_core_commit_id": core["commit_id"], "story_format": "web", "batch_sequence": index,
            "batch_count": len(groups), "packet_plans": plans}
        state = {"payload": {"packet_plans": plans}, "record": record, "ready": True, "values": {},
            "checkpoint_version": 3}
        save_planning_draft(run_dir, step, state)
        records.append(record)
    return records


def validate_scaffold_reader_states(architecture, content, destination):
    scaffold = architecture["causal_scaffold"]
    order, _roots = scaffold_order(scaffold["nodes"])
    slots = scaffold["slot_ids"]
    by_id = {node["node_id"]: node for node in scaffold["nodes"]}
    arrivals = {slots[scaffold["opening_node_id"]]: {"{}": {}}}
    for identifier in order:
        slot = slots[identifier]
        if slot not in content:
            continue
        item, node = content[slot], by_id[identifier]
        states = arrivals.get(slot, {})
        if not states:
            raise SchemaError(f"Scaffold reader cannot reach {slot} under the authored state effects")
        required = {slots[edge["to_node_id"]] for edge in node["successors"]}
        choices = [choice for choice in item["choices"] if choice["availability"] == "playable"]
        if {destination(choice) for choice in choices} != required or len(choices) != len(required):
            raise SchemaError(f"Authored exits at {slot} differ from the frozen scaffold")
        reached = set()
        for state in states.values():
            values = copy.deepcopy(state)
            if not reader_conditions_hold(item.get("state_inputs", item.get("entry_conditions", [])), values):
                raise SchemaError(f"Scaffold entry {slot} rejects a reachable incoming state")
            apply_reader_effects(item["state_effects"], values)
            live = [choice for choice in choices if reader_conditions_hold(choice["state_conditions"], values)]
            if node["kind"] == "scene" and not live:
                raise SchemaError(f"Scaffold scene {slot} has no playable continuation for a reachable state")
            for choice in live:
                target, after = destination(choice), copy.deepcopy(values)
                reached.add(target)
                apply_reader_effects(choice["state_effects"], after)
                arrivals.setdefault(target, {})[canonical_json(after).decode()] = after
                if len(arrivals[target]) > 128:
                    raise PausedError("Scaffold state verification", f"{target} has more than 128 distinct incoming states; "
                        "verification retained the authored work and stopped without dropping paths")
        if reached != required:
            raise SchemaError(f"Scaffold exits from {slot} are never playable: {', '.join(sorted(required - reached))}")


def scaffold_local_contract(architecture, plan):
    scaffold = architecture.get("causal_scaffold")
    if not scaffold:
        return {}
    slots = scaffold["slot_ids"]
    own = set(plan["scene_slot_ids"] + plan["ending_slot_ids"])
    local = [node for node in scaffold["nodes"] if slots[node["node_id"]] in own]
    identifiers = {node["node_id"] for node in local}
    incoming = [{"from_node_id": node["node_id"], "from_slot_id": slots[node["node_id"]], **edge}
        for node in scaffold["nodes"] for edge in node["successors"] if edge["to_node_id"] in identifiers]
    successor_ids = {edge["to_node_id"] for node in local for edge in node["successors"]}
    return {"nodes": local, "technical_slots": {node["node_id"]: slots[node["node_id"]] for node in local},
        "incoming": incoming, "successor_requirements": [
            {"node_id": node["node_id"], "technical_slot_id": slots[node["node_id"]], "entry_cases": node["entry_cases"]}
            for node in scaffold["nodes"] if node["node_id"] in successor_ids],
        "opening_support": scaffold["opening_support"] if scaffold["opening_node_id"] in identifiers else []}


def scaffold_source_strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for child in value.values():
            yield from scaffold_source_strings(child)
    elif isinstance(value, list):
        for child in value:
            yield from scaffold_source_strings(child)


def scaffold_literary_texts(item, record=None):
    artifacts = item.get("artifacts", []) if record is None else [artifact for artifact in record["artifacts"]
        if artifact["artifact_id"] in item.get("artifact_ids", [])]
    # Affordances may explain an exit, but cannot prove an already performed event.
    return [item["prose_mdx"]] + [artifact["body_mdx"] for artifact in artifacts]


def scaffold_source_units(run_dir, architecture, identifiers):
    identifiers = set(identifiers)
    slots = set(architecture["causal_scaffold"]["slot_ids"].values())
    source_slots = identifiers & slots
    owners = {slot: plan["packet_slot_id"] for plan in architecture["packet_plans"]
        for slot in plan["scene_slot_ids"] + plan["ending_slot_ids"] if slot in source_slots}
    units = {}
    for record in packet_records(run_dir, set(owners.values()), verify=True):
        for item in record["scenes"] + record["endings"]:
            slot = item["technical_slot_id"]
            if slot in source_slots:
                units[slot] = scaffold_literary_texts(item, record)
    genesis_ids = identifiers - source_slots
    if genesis_ids:
        sources = retrieve_original_sources(run_dir, [{"sources": [{"artifact_id": identifier} for identifier in sorted(genesis_ids)]}],
            limit=None, strict=True, follow_sources=False)
        for source in sources:
            units[source["source_id"]] = list(scaffold_source_strings(source["immutable_source"]))
    if identifiers - units.keys():
        raise IntegrityError("Scaffold evidence does not resolve: " + ", ".join(sorted(identifiers - units.keys())))
    return units


def scaffold_predecessor_receipt(run_dir, architecture, slot):
    owner = next(plan["packet_slot_id"] for plan in architecture["packet_plans"]
        if slot in plan["scene_slot_ids"] + plan["ending_slot_ids"])
    record = next((record for record in packet_records(run_dir, [owner], verify=True)
        if any(item["technical_slot_id"] == slot for item in record["scenes"] + record["endings"])), None)
    if record is None:
        raise IntegrityError(f"Scaffold predecessor is not committed: {slot}")
    with index_connection(run_dir) as db:
        row = db.execute("SELECT path FROM records WHERE commit_id=?", (record["commit_id"],)).fetchone()
    directory = run_dir / row[0]
    meta = read_json(directory / "commit-meta.json")
    digest = meta.get("supplemental_hashes", {}).get("scaffold-evidence.json")
    if digest is None:
        raise IntegrityError(f"Scaffold predecessor evidence is missing: {slot}")
    path = directory / "scaffold-evidence.json"
    verify_immutable_file(path, digest)
    return read_json(path)


def scaffold_inherited_evidence(run_dir, architecture, local):
    by_id = {node["node_id"]: node for node in architecture["causal_scaffold"]["nodes"]}
    units, proofs, identifiers = {}, [], set()
    for transition in local["incoming"]:
        parent = by_id[transition["from_node_id"]]
        needed = {identifier for support in transition["supports"] for identifier in support["guarantee_ids"]}
        identifiers.update(identifier for support in transition["supports"] for identifier in support["genesis_source_ids"])
        if not needed:
            continue
        receipt = scaffold_predecessor_receipt(run_dir, architecture, transition["from_slot_id"])
        if receipt["contract_hash"] != sha256_bytes(canonical_json(parent)):
            raise IntegrityError("Scaffold predecessor contract differs from its evidence audit")
        parent_units = scaffold_source_units(run_dir, architecture, [transition["from_slot_id"]])
        if receipt["own_text_hash"] != sha256_bytes(canonical_json(parent_units[transition["from_slot_id"]])):
            raise IntegrityError("Scaffold predecessor prose differs from its evidence audit")
        digest = sha256_bytes(canonical_json(receipt["audit"]))
        if not any(entry["commit_status"] == "COMMITTED" and entry["output_hash"] == digest
                   for entry in step_entries(run_dir, receipt["step_id"])):
            raise IntegrityError("Scaffold predecessor audit does not match its ledger")
        verified = copy.deepcopy(receipt["verified_checks"])
        for proof in verified:
            for quote in proof["evidence_quotes"]:
                quote.pop("source_hash", None)
        if verified != receipt["audit"]["checks"]:
            raise IntegrityError("Scaffold evidence differs from its ledgered audit")
        selected = [proof for proof in receipt["verified_checks"] if proof["check_id"] in needed]
        expected = {(requirement, case, entry) for requirement in needed for case, entry in scaffold_entry_routes(architecture, parent)}
        if {(proof["check_id"], proof["case_id"], proof["entry_from_slot"]) for proof in selected} != expected:
            raise IntegrityError("Scaffold predecessor audit lacks a required guarantee or entry case")
        proofs.extend({"from_slot_id": transition["from_slot_id"], **proof} for proof in selected)
        identifiers.update(quote["source_id"] for proof in selected for quote in proof["evidence_quotes"])
    identifiers.update(identifier for support in local["opening_support"] for identifier in support["genesis_source_ids"])
    if identifiers:
        units = scaffold_source_units(run_dir, architecture, identifiers)
    for proof in proofs:
        for quote in proof["evidence_quotes"]:
            if quote["source_hash"] != sha256_bytes(canonical_json(units[quote["source_id"]])) or not any(
                    quote["quote"] in value for value in units[quote["source_id"]]):
                raise IntegrityError("Scaffold supporting quotation differs from its immutable source")
    return {"inherited_guarantee_evidence": proofs, "immutable_source_units": units}


def scaffold_packet_context(run_dir, architecture, plan):
    local = scaffold_local_contract(architecture, plan)
    return local | scaffold_inherited_evidence(run_dir, architecture, local) if local else {}


def scaffold_audit_task_schema(tasks):
    fields = {}
    for identifier, task in tasks.items():
        fields[identifier] = {"type": "object", "additionalProperties": False,
            "required": ["supported", "reason", "evidence_quotes"], "properties": {
                "supported": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1},
                "evidence_quotes": {"type": "array", "maxItems": 24, "items": {"type": "object", "additionalProperties": False,
                    "required": ["source_id", "quote"], "properties": {"source_id": {"enum": task["source_ids"]},
                        "quote": {"type": "string", "minLength": 1}}}}},
            "if": {"properties": {"supported": {"const": True}}},
            "then": {"properties": {"evidence_quotes": {"minItems": 1}}}}
    return {"type": "object", "additionalProperties": False, "required": ["tasks"], "properties": {
        "tasks": {"type": "object", "additionalProperties": False, "required": list(fields), "properties": fields}}}


def request_scaffold_audit_tasks(run_dir, step_id, query, node, local, checks, entry_routes, allowed_sources, units, transport):
    tasks = {}
    for check_id, description in checks:
        for case_id, entry in entry_routes:
            identifier = deterministic_id("scaffold_audit_task", check_id, case_id, entry)
            tasks[identifier] = {"check_id": check_id, "description": description, "case_id": case_id,
                "entry_from_slot": entry, "source_ids": sorted(allowed_sources[(case_id, entry)])}
    ordered, verified = sorted(tasks), []
    for offset in range(0, len(ordered), 8):
        page = {identifier: tasks[identifier] for identifier in ordered[offset:offset + 8]}
        entries = {task["entry_from_slot"] for task in page.values()}
        cases = {task["case_id"] for task in page.values()}
        source_ids = {identifier for task in page.values() for identifier in task["source_ids"]}
        context = {"contract": {key: value for key, value in node.items() if key not in {"successors", "entry_cases"}} | {
            "entry_cases": [case for case in node["entry_cases"] if case["case_id"] in cases]}, "tasks": page,
            "incoming": [edge for edge in local["incoming"] if edge["from_slot_id"] in entries],
            "inherited_guarantee_evidence": [proof for proof in local["inherited_guarantee_evidence"] if proof["from_slot_id"] in entries],
            "opening_support": local["opening_support"] if "genesis" in entries else [],
            "immutable_source_units": {identifier: units[identifier] for identifier in sorted(source_ids)}}
        prompt = render_prompt(run_dir, "generation-scaffold-audit.md", {"SCAFFOLD_CONTEXT": canonical_json(context).decode()})
        schema = scaffold_audit_task_schema(page)
        def validate(result):
            for identifier, answer in result["tasks"].items():
                task = page[identifier]
                for quote in answer["evidence_quotes"]:
                    if quote["source_id"] not in task["source_ids"] or not any(quote["quote"] in text for text in units[quote["source_id"]]):
                        raise SchemaError(f"Scaffold audit task {identifier} must quote its permitted immutable evidence exactly")
        page_query = query + "_page_" + sha256_bytes(prompt.encode())[:16]
        result, response = request_architecture_analysis(run_dir, page_query, prompt, schema, transport, validator=validate,
            phase="validation", planning_mode=True, context_purpose="semantic", max_tokens=8192,
            pause_stage="Scaffold evidence", system_prompt="Audit only the supplied task identifiers against immutable prose. Return JSON only.")
        preserve_planning_result(run_dir, step_id, page_query, result, response, kind="scaffold_evidence_tasks", phase="validation")
        verified.extend({"check_id": tasks[identifier]["check_id"], "case_id": tasks[identifier]["case_id"],
            "entry_from_slot": tasks[identifier]["entry_from_slot"], **result["tasks"][identifier]} for identifier in sorted(page))
    digest = sha256_bytes(canonical_json(tasks))
    assembled = {"_cathedrals_request": {"step_id": query, "attempt": 1,
        "parameters": {"assembly": "scaffold_audit_tasks", "seed": step_seed(read_json(run_dir / "generation-brief.json")["generation_seed"], query)},
        "prompt_hash": digest, "context_hash": digest}, "usage": {}}
    return {"checks": verified}, assembled


def audit_scaffold_guarantees(run_dir, step_id, artistic, plan, transport):
    architecture = committed_record(run_dir, "architecture")
    local = scaffold_packet_context(run_dir, architecture, plan)
    content = artistic["scenes"] + artistic["endings"]
    if len(content) != 1 or len(local["nodes"]) != 1:
        raise IntegrityError("Scaffold evidence audit needs exactly one assigned content unit")
    item, node = content[0], local["nodes"][0]
    slot = item["technical_slot_id"]
    own = scaffold_literary_texts(item)
    units = local["immutable_source_units"] | {slot: own}
    checks = [(guarantee["requirement_id"], guarantee["description"]) for guarantee in node["guarantees"]]
    checks += [(f"{node['node_id']}_preserve_{index:03d}", text) for index, text in enumerate(node["preserves"], 1)]
    entry_routes = scaffold_entry_routes(architecture, node)
    expected = {(check, case, entry) for check, _description in checks for case, entry in entry_routes}
    allowed_sources = {(case, entry): {slot} for case, entry in entry_routes}
    for transition in local["incoming"]:
        permitted = allowed_sources[(transition["target_case_id"], transition["from_slot_id"])]
        needed = {identifier for support in transition["supports"] for identifier in support["guarantee_ids"]}
        permitted.update(identifier for support in transition["supports"] for identifier in support["genesis_source_ids"])
        permitted.update(quote["source_id"] for proof in local["inherited_guarantee_evidence"]
            if proof["from_slot_id"] == transition["from_slot_id"] and proof["check_id"] in needed for quote in proof["evidence_quotes"])
    for support in local["opening_support"]:
        allowed_sources[(node["entry_cases"][0]["case_id"], "genesis")].update(support["genesis_source_ids"])
    prompt = ("Audit immutable prose against every hard exit guarantee and preserved condition, separately for every incoming route and its entry case. "
        "Two routes using the same case ID still require separate checks; entry_from_slot identifies the incoming route. "
        "Prior branch-specific evidence is applicable ONLY under the corresponding incoming transition and entry case. "
        "A shared scene must work for each alternative, never assume the reader saw mutually exclusive paths. "
        "Use exact source quotations, distinguish character knowledge from author knowledge, and do not turn plans, "
        "choices or future intentions into completed events. A guarantee can be inherited only from the supplied supported "
        "incoming guarantees or cited Genesis evidence. Intended dramatic/thematic change is advisory, not a required new fact. "
        "Report unsupported promises honestly; do not rewrite prose or repair metadata to pretend the promise occurred.\n" +
        canonical_json({"local_contract": {key: value for key, value in local.items() if key != "immutable_source_units"}, "checks": checks, "allowed_sources_per_entry": [{"case_id": case, "entry_from_slot": entry, "source_ids": sorted(value)} for (case, entry), value in allowed_sources.items()], "immutable_source_units": units}).decode())
    query = f"{step_id}_scaffold_audit_" + sha256_bytes(prompt.encode())[:12]
    path = run_dir / ".staging" / f"scaffold-evidence-{slot}.json"
    def validate(result):
        if {(check["check_id"], check["case_id"], check["entry_from_slot"]) for check in result["checks"]} != expected:
            raise SchemaError("Scaffold audit must cover every check and alternative entry case exactly once")
        for check in result["checks"]:
            if check["supported"] and not check["evidence_quotes"]:
                raise SchemaError("Supported scaffold promises require exact source quotations")
            for quote in check["evidence_quotes"]:
                if quote["source_id"] not in allowed_sources[(check["case_id"], check["entry_from_slot"])]:
                    raise SchemaError("Scaffold audit cites evidence from an inapplicable alternative entry case")
                if not any(quote["quote"] in text for text in units[quote["source_id"]]):
                    raise SchemaError("Scaffold audit quotation is absent from its immutable source")
    result, response = request_scaffold_audit_tasks(run_dir, step_id, query, node, local, checks, entry_routes, allowed_sources, units, transport)
    validate(result)
    preserve_planning_result(run_dir, step_id, query, result, response, kind="scaffold_evidence", phase="validation")
    unsupported = [check for check in result["checks"] if not check["supported"]]
    if unsupported:
        write_json(path.with_suffix(".unsupported.json"), result)
        raise PausedError("Scaffold evidence", f"Immutable {slot} does not establish its frozen promises: " +
            "; ".join(f"{check['check_id']} for {check['case_id']} from {check['entry_from_slot']}: {check['reason']}" for check in unsupported) +
            ". Prose was retained; no facts were invented and no literary bytes were rewritten.")
    # Persist hashes beside quotations while leaving the ledgered response untouched.
    audited = copy.deepcopy(result)
    for check in audited["checks"]:
        for quote in check["evidence_quotes"]:
            quote["source_hash"] = sha256_bytes(canonical_json(units[quote["source_id"]]))
    receipt = {"step_id": query, "contract_hash": sha256_bytes(canonical_json(node)),
        "own_text_hash": sha256_bytes(canonical_json(own)), "audit": result, "verified_checks": audited["checks"]}
    write_json(path, receipt)
    write_json(run_dir / ".staging" / f"{step_id}.scaffold-evidence.json", receipt)


def prepare_core_draft(run_dir: Path, transport) -> dict:
    if committed_record(run_dir, "architecture_core"):
        return committed_record(run_dir, "architecture_core")
    schema = copy.deepcopy(definition_schema("architectureCorePayload", load_protocol(run_dir)))
    schema["$defs"]["obligation"].pop("allOf", None)
    schema["properties"]["topology"] = copy.deepcopy(schema["$defs"]["architectureCore"]["properties"]["topology"])
    schema["properties"]["topology"]["const"] = scaffold_macro_topology()
    path = run_dir / ".staging/architecture_core.planning.json"
    state = read_json(path) if path.exists() else allocate_core_draft(run_dir, schema, transport)
    constrain_planning_ids(schema, state["payload"], run_dir)
    if state.get("ready"):
        return state["record"]
    fill_planning_shape(run_dir, "architecture_core", state, schema, transport)
    repair_planning_references(run_dir, "architecture_core", state, schema, transport)
    payload = state["payload"]
    if not any(item["kind"] == "ending" for item in payload["attractors"]):
        ending = planning_value(run_dir, "architecture_core", state, ["$ending_attractor"],
            {"type": "string", "enum": [item["attractor_id"] for item in payload["attractors"]]},
            "Select the attractor whose transformation will become an ending; at least one ending is required.", transport)
        next(item for item in payload["attractors"] if item["attractor_id"] == ending)["kind"] = "ending"
        save_planning_draft(run_dir, "architecture_core", state)
    cycle = architecture_obligation_cycle(payload)
    while cycle:
        index = next(i for i, item in enumerate(payload["obligation_graph"]) if item["obligation_id"] == cycle[0])
        owner = payload["obligation_graph"][index]
        forbidden = {owner["obligation_id"]}
        while True:
            ancestors = forbidden | {item["obligation_id"] for item in payload["obligation_graph"]
                                     if forbidden.intersection(item["requires"])}
            if ancestors == forbidden:
                break
            forbidden = ancestors
        allowed = [item["obligation_id"] for item in payload["obligation_graph"] if item["obligation_id"] not in forbidden]
        owner["requires"] = planning_value(run_dir, "architecture_core", state, ["obligation_graph", index, "requires"],
            {"type": "array", "items": {"enum": allowed}, "uniqueItems": True},
            f"Remove the dependency cycle {cycle}; preserve meaningful prerequisites without a cycle.", transport) if allowed else []
        save_planning_draft(run_dir, "architecture_core", state)
        cycle = architecture_obligation_cycle(payload)
    validate_json_schema(payload, schema)
    state["record"] = build_architecture_core(run_dir, payload)
    validate_architecture_core_for_run(state["record"], run_dir)
    state["ready"] = True
    save_planning_draft(run_dir, "architecture_core", state)
    return state["record"]


def execute_planning_phases(run_dir: Path, transport=http_json) -> list[dict]:
    core = prepare_core_draft(run_dir, transport)
    core = prepare_causal_scaffold(run_dir, core, transport)
    records = compile_scaffold_batches(run_dir, core)
    batches = plan_batches(core)
    protocol = load_protocol(run_dir)
    for record in [core] + records:
        validate_json_schema(record, protocol["$defs"][RECORD_DEFS[record["record_type"]]], protocol)
        validate_declared_id_uniqueness(record)
    for index, (record, specs) in enumerate(zip(records, batches), 1):
        validate_architecture_plan_batch(record, run_dir, specs, index, len(batches))
    navigation_contract_route(architecture_from_parts(core, records))
    validate_architecture(architecture_from_parts(core, records), read_json(run_dir / "run-manifest.json"), set(_source_index(run_dir)))
    for step, record in [("architecture_core", core)] + [(f"architecture_plan_batch_{index:04d}", record) for index, record in enumerate(records, 1)]:
        if committed_record(run_dir, record["record_type"]) and (step == "architecture_core" or any(
            item["batch_sequence"] == record["batch_sequence"] for item in committed_records(run_dir, "architecture_plan_batch"))):
            continue
        state = read_json(run_dir / ".staging" / f"{step}.planning.json")
        response = {"choices": [{"finish_reason": "stop", "message": {"content": json.dumps(state["payload"], ensure_ascii=False)}}],
                    "usage": {}, "_cathedrals_assembled_from_fields": True}
        attempt = max((item["attempt"] for item in step_entries(run_dir, step)), default=0) + 1
        commit_record(run_dir, record, json.dumps(state["payload"], ensure_ascii=False), response,
            planned_step_id=step, attempt=attempt, step_phase="architecture",
            prompt=state.get("prompt", "Engine assembly of checkpointed planning batches; see planning-draft and repair audit."),
            context=state.get("context", canonical_json(state["payload"]).decode()),
            parameters={"seed": step_seed(read_json(run_dir / 'generation-brief.json')['generation_seed'], step),
                "assembly": "checkpointed_batches"}, branch_relation="macroarchitecture", usage_already_ledgered=True)
    return batches


