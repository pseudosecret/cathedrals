def shared_context_values(values):
    counts, originals = {}, {}
    def collect(value):
        if isinstance(value, (dict, list, str)):
            key = canonical_json(value)
            if len(key) >= 192:
                counts[key] = counts.get(key, 0) + 1
                originals[key] = value
        if isinstance(value, dict):
            for child in value.values():
                collect(child)
        elif isinstance(value, list):
            for child in value:
                collect(child)
    for items in values:
        for item in items:
            collect(item)
    references = {key: f"value_{index:04d}" for index, key in enumerate(sorted(
        key for key, count in counts.items() if count > 1 and (count - 1) * len(key) > count * 48 + 64), 1)}
    def encode(value, own=None):
        key = canonical_json(value) if isinstance(value, (dict, list, str)) else None
        if key in references and key != own:
            return {"$context_ref": references[key]}
        if isinstance(value, dict):
            return {name: encode(child) for name, child in value.items()}
        if isinstance(value, list):
            return [encode(child) for child in value]
        return value
    packed = [[encode(item) for item in items] for items in values]
    table = {reference: encode(originals[key], key) for key, reference in references.items()}
    saved = len(canonical_json(values)) - len(canonical_json(packed)) - len(canonical_json(table)) - 160
    return (packed, table, saved) if saved > 0 else (values, {}, 0)


