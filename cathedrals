def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def canonical_json(value) -> bytes:
    return (json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "_", value.lower()).strip("_")
    slug = slug[:48] or "cathedrals"
    return slug if slug[0].isalpha() else f"cathedrals_{slug}"


def write_atomic(path: Path, data: bytes, *, mode: int = 0o644, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if exclusive and path.exists():
        raise IntegrityError(f"Refusing to overwrite {path}")
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, mode)
    if exclusive and path.exists():
        temporary.unlink()
        raise IntegrityError(f"Refusing to overwrite {path}")
    os.replace(temporary, path)


def write_json(path: Path, value, *, mode: int = 0o644, exclusive: bool = False) -> None:
    write_atomic(path, canonical_json(value), mode=mode, exclusive=exclusive)


def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def make_read_only(path: Path) -> None:
    os.chmod(path, stat.S_IRUSR | stat.S_IRGRP | stat.S_IROTH)


def _resolve_pointer(document, pointer: str):
    value = document
    for part in pointer.removeprefix("#/").split("/"):
        value = value[part.replace("~1", "/").replace("~0", "~")]
    return value


def _matches_type(value, expected: str) -> bool:
    return {
        "object": isinstance(value, dict),
        "array": isinstance(value, list),
        "string": isinstance(value, str),
        "integer": isinstance(value, int) and not isinstance(value, bool),
        "number": isinstance(value, (int, float)) and not isinstance(value, bool),
        "boolean": isinstance(value, bool),
        "null": value is None,
    }[expected]


def _json_type(value) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, int):
        return "integer"
    if isinstance(value, float):
        return "number"
    if isinstance(value, str):
        return "string"
    if isinstance(value, list):
        return "array"
    if isinstance(value, dict):
        return "object"
    return type(value).__name__


def _json_value(value) -> str:
    rendered = json.dumps(value, ensure_ascii=False, sort_keys=True)
    return rendered if len(rendered) <= 160 else rendered[:157] + "..."


def _received_type(value) -> str:
    return f"{_json_type(value)} ({_json_value(value)})"


def _child_path(path: str, key: str) -> str:
    return f"{path}.{key}" if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) else f"{path}[{json.dumps(key)}]"


def _deduplicate_schema_errors(errors: list[tuple[str, str, str, str]]) -> list[tuple[str, str, str, str]]:
    result = []
    seen = set()
    for error in errors:
        key = error[:2]
        if key not in seen:
            seen.add(key)
            result.append(error)
    return result


def _schema_record_type(schema, root):
    while "$ref" in schema:
        schema = _resolve_pointer(root, schema["$ref"])
    return schema.get("properties", {}).get("record_type", {}).get("const")


def _collect_schema_errors(value, schema, root, path: str) -> list[tuple[str, str, str, str]]:
    errors = []
    if "$ref" in schema:
        errors.extend(_collect_schema_errors(value, _resolve_pointer(root, schema["$ref"]), root, path))
    for branch in schema.get("allOf", []):
        errors.extend(_collect_schema_errors(value, branch, root, path))
    for keyword in ("anyOf", "oneOf"):
        if keyword not in schema:
            continue
        branch_errors = [
            _deduplicate_schema_errors(_collect_schema_errors(value, branch, root, path))
            for branch in schema[keyword]
        ]
        matches = sum(not failures for failures in branch_errors)
        candidates = list(range(len(branch_errors)))
        if isinstance(value, dict) and isinstance(value.get("record_type"), str):
            matching = [index for index, branch in enumerate(schema[keyword]) if _schema_record_type(branch, root) == value["record_type"]]
            candidates = matching or candidates
        closest = min(candidates, key=lambda index: len(branch_errors[index]))
        if keyword == "anyOf" and not matches:
            errors.extend(branch_errors[closest])
        elif keyword == "oneOf" and matches == 0:
            errors.extend(branch_errors[closest])
        elif keyword == "oneOf" and matches != 1:
            errors.append((path, "oneOf", "exactly one allowed schema", f"value matching {matches} schemas"))
    if "if" in schema:
        condition_matches = not _collect_schema_errors(value, schema["if"], root, path)
        branch = schema.get("then") if condition_matches else schema.get("else")
        if branch:
            errors.extend(_collect_schema_errors(value, branch, root, path))
    expected = schema.get("type")
    if expected:
        types = expected if isinstance(expected, list) else [expected]
        if not any(_matches_type(value, item) for item in types):
            errors.append((path, "type", " or ".join(types), _received_type(value)))
            return _deduplicate_schema_errors(errors)
    if "const" in schema and value != schema["const"]:
        errors.append((path, "const", _json_value(schema["const"]), _json_value(value)))
    if "enum" in schema and value not in schema["enum"]:
        errors.append((path, "enum", f"one of {_json_value(schema['enum'])}", _json_value(value)))
    if isinstance(value, dict):
        required = schema.get("required", [])
        missing = [key for key in required if key not in value]
        errors.extend((_child_path(path, key), "required", "required field", "missing") for key in missing)
        properties = schema.get("properties", {})
        for key, child in value.items():
            child_path = _child_path(path, key)
            if key in properties:
                errors.extend(_collect_schema_errors(child, properties[key], root, child_path))
            elif schema.get("additionalProperties") is False:
                errors.append((child_path, "additionalProperties", "field not allowed", "present"))
            elif isinstance(schema.get("additionalProperties"), dict):
                errors.extend(_collect_schema_errors(child, schema["additionalProperties"], root, child_path))
        if len(value) < schema.get("minProperties", 0) and not missing:
            errors.append((path, "minProperties", f"at least {schema['minProperties']} properties", f"object with {len(value)} properties"))
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            errors.append((path, "minItems", f"at least {schema['minItems']} items", f"array with {len(value)} items"))
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            errors.append((path, "maxItems", f"at most {schema['maxItems']} items", f"array with {len(value)} items"))
        if "items" in schema:
            for index, child in enumerate(value):
                errors.extend(_collect_schema_errors(child, schema["items"], root, f"{path}[{index}]"))
        if schema.get("uniqueItems") and len({json.dumps(item, sort_keys=True) for item in value}) != len(value):
            errors.append((path, "uniqueItems", "unique items", "array containing duplicates"))
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            errors.append((path, "minLength", f"string length of at least {schema['minLength']}", f"string with length {len(value)}"))
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            errors.append((path, "maxLength", f"string length of at most {schema['maxLength']}", f"string with length {len(value)}"))
        if "pattern" in schema and not re.search(schema["pattern"], value):
            errors.append((path, "pattern", f"string matching {_json_value(schema['pattern'])}", _json_value(value)))
        if schema.get("format") == "date-time":
            try:
                dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
            except ValueError:
                errors.append((path, "format", "ISO date-time", _json_value(value)))
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            errors.append((path, "minimum", f"number greater than or equal to {schema['minimum']}", _json_value(value)))
        if "maximum" in schema and value > schema["maximum"]:
            errors.append((path, "maximum", f"number less than or equal to {schema['maximum']}", _json_value(value)))
    return _deduplicate_schema_errors(errors)


def _validation_subject(value) -> str:
    if isinstance(value, dict):
        name = value.get("step_phase") if value.get("record_type") == "ledger_entry" else value.get("record_type")
        if isinstance(name, str):
            return name.replace("_", " ").capitalize()
    return "Value"


def validate_json_schema(value, schema, root=None, path: str = "$") -> None:
    """Validate the JSON-Schema subset used by the repository protocol."""
    errors = _collect_schema_errors(value, schema, root or schema, path)
    if not errors:
        return
    count = len(errors)
    lines = [f"{_validation_subject(value)} failed schema validation with {count} {'problem' if count == 1 else 'problems'}:", ""]
    for index, (error_path, _keyword, expected, received) in enumerate(errors, 1):
        lines.extend((f"{index}. {error_path}", f"   Expected: {expected}", f"   Received: {received}", ""))
    raise SchemaError("\n".join(lines).rstrip())


def _schema_matches(value, schema, root, path: str) -> bool:
    return not _collect_schema_errors(value, schema, root, path)


