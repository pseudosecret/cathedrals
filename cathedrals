def state_subset(run_dir, name, identifiers):
    identifiers = sorted(set(identifiers))
    result = {}
    with index_connection(run_dir) as db:
        for offset in range(0, len(identifiers), 500):
            batch = identifiers[offset:offset + 500]
            markers = ",".join("?" for _ in batch)
            result.update((key, json.loads(payload)) for key, payload in db.execute(
                "SELECT key,payload FROM projection WHERE map=? AND key IN (" + markers + ") ORDER BY key", (name, *batch)))
            if name == "motifs.json":
                for motif_id, event_id, sources in db.execute("SELECT motif_id,event_id,sources FROM motif_history WHERE motif_id IN (" + markers + ") ORDER BY sequence", batch):
                    result[motif_id]["appearances"].extend(json.loads(sources))
                    result[motif_id]["provenance"].append(event_id)
    return result


def obligation_closure(run_dir, identifiers):
    obligations, pending = {}, set(identifiers)
    while pending:
        found = state_subset(run_dir, "obligations.json", pending)
        missing = pending - found.keys()
        if missing:
            raise IntegrityError("Required obligation does not resolve: " + ", ".join(sorted(missing)))
        obligations.update(found)
        pending = {identifier for event in found.values() for identifier in event["data"]["requires"]} - obligations.keys()
    return obligations


def selected_current_knowledge(run_dir, events, required_fact_ids=(), subject_ids=()):
    sequences = sorted({event["constraint_event_sequence"] for event in events if event["constraint_kind"] == "knowledge_state"})
    rows = []
    with index_connection(run_dir) as db:
        if sequences:
            rows.extend(db.execute("SELECT subject,relation,proposition,payload FROM knowledge WHERE event_sequence IN (" + ",".join("?" for _ in sequences) + ") ORDER BY subject,relation,proposition", sequences))
        if required_fact_ids and subject_ids:
            rows.extend(db.execute("SELECT subject,relation,proposition,payload FROM knowledge WHERE proposition IN (" + ",".join("?" for _ in required_fact_ids) + ") AND subject IN (" + ",".join("?" for _ in subject_ids) + ") ORDER BY subject,relation,proposition", (*required_fact_ids, *subject_ids)))
    result = {}
    for subject, relation, proposition, payload in rows:
        relations = result.setdefault(subject, {key: {} for key in ("believes", "claims", "explicitly_does_not_know", "knows", "suspects")})
        relations[relation][proposition] = json.loads(payload)
    return [{"subject_id": subject, **relations} for subject, relations in sorted(result.items())]


