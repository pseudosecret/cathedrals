class CathedralsError(Exception):
    def __init__(self, stage: str, reason: str, failure_class: str = "mechanical_validation"):
        super().__init__(reason)
        self.stage = stage
        self.reason = reason
        self.failure_class = failure_class


class SchemaError(CathedralsError):
    def __init__(self, reason: str, *, paths=()):
        super().__init__("Structured record validation", reason, "malformed_response")
        self.paths = tuple(paths)


class EpistemicDependencyError(SchemaError):
    def __init__(self, conflicts: list[dict]):
        super().__init__("Scene relies on knowledge explicitly unavailable to its character: " + canonical_json(conflicts).decode().strip())
        self.conflicts = conflicts


class IntegrityError(CathedralsError):
    def __init__(self, reason: str):
        super().__init__("Append-only integrity", reason, "mechanical_validation")


class TruncationError(CathedralsError):
    def __init__(self, reason: str, response: dict | None = None):
        super().__init__("LM Studio response", reason, "provider_truncation")
        self.response = response


class IncompleteResponseError(CathedralsError):
    def __init__(self, reason: str, response: dict | None = None):
        stage = "LM Studio response"
        refusal = (response or {}).get("_cathedrals_provider_error")
        if refusal:
            detail = refusal.get("message", json.dumps(refusal, ensure_ascii=False)) if isinstance(refusal, dict) else str(refusal)
            stage = "LM Studio request rejected"
            reason = f"LM Studio rejected the request. Provider detail: {detail}"
            capacity = re.search(r"request \((\d+) tokens\).*?available context size \((\d+) tokens\)", detail, re.I | re.S)
            if capacity:
                stage = "LM Studio context capacity"
                reason = (f"LM Studio rejected a {int(capacity[1]):,}-token request because the selected instance has only "
                    f"{int(capacity[2]):,} context tokens. Reload the selected model with at least "
                    f"{49152 + BASE_OUTPUT_TOKENS + 4096:,} context tokens, then resume. Provider detail: {detail}")
            if (response or {}).get("_cathedrals_error"):
                reason = response["_cathedrals_error"]
        super().__init__(stage, reason, "provider_incomplete_response")
        self.response = response


class PausedError(CathedralsError):
    def __init__(self, stage: str, reason: str, failure_class: str = "corrective_pause"):
        super().__init__(stage, reason, failure_class)


