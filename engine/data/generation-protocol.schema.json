        "commit_status",
        "canonical_state_hash_after",
        "failure_class",
        "token_accounting"
      ],
      "properties": {
        "record_type": { "const": "ledger_entry" },
        "protocol_version": { "const": "2.0" },
        "generation_id": { "$ref": "#/$defs/id" },
        "ledger_sequence": { "type": "integer", "minimum": 1 },
        "planned_step_id": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1 },
        "step_type": { "enum": ["creative", "analysis_or_index", "deterministic"] },
        "step_phase": {
          "enum": [
            "preflight",
            "engine_freeze",
            "genesis",
            "architecture",
            "literary_packet",
            "ending_packet",
            "index",
            "projection",
            "validation",
            "artistic_acceptance",
            "build",
            "build_validation",
            "finalization"
          ]
        },
        "previous_entry_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "entry_hash": { "$ref": "#/$defs/hash" },
        "parent_canonical_state_hash": { "$ref": "#/$defs/hash" },
        "prompt_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "context_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "parameters": { "type": ["object", "null"] },
        "seed": { "type": ["string", "null"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "output_hash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "generated_artifact_ids": { "$ref": "#/$defs/idList" },
        "canonical_state_delta_ids": { "$ref": "#/$defs/idList" },
        "unresolved_thread_delta_ids": { "$ref": "#/$defs/idList" },
        "motif_delta_ids": { "$ref": "#/$defs/idList" },
        "branch_path_relation": { "type": ["string", "null"] },
        "commit_status": { "enum": ["COMMITTED", "FAILED_BEFORE_COMMIT"] },
        "canonical_state_hash_after": { "$ref": "#/$defs/hash" },
        "failure_class": {
          "enum": [
            "none",
            "transport_before_response",
            "provider_before_creative_output",
            "malformed_response",
            "mechanical_validation",
            "continuity_impossibility",
            "budget_exhaustion",
            "artistic_rejection",
            "build_failure"
          ]
        },
        "token_accounting": { "$ref": "#/$defs/tokenAccounting" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "step_type": { "enum": ["creative", "analysis_or_index"] }
            }
          },
          "then": {
            "properties": {
              "prompt_hash": { "$ref": "#/$defs/hash" },
              "context_hash": { "$ref": "#/$defs/hash" },
              "provider": { "$ref": "#/$defs/nonEmptyString" },
              "model": { "$ref": "#/$defs/nonEmptyString" },
              "parameters": { "type": "object" },
              "seed": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        {
          "if": { "properties": { "commit_status": { "const": "COMMITTED" } } },
          "then": {
            "properties": {
              "output_hash": { "$ref": "#/$defs/hash" },
              "failure_class": { "const": "none" }
            }
          }
        },
        {
          "if": {
            "allOf": [
              { "properties": { "step_type": { "const": "creative" } } },
              { "properties": { "commit_status": { "const": "COMMITTED" } } }
            ]
          },
          "then": {
            "properties": {
              "generated_artifact_ids": { "minItems": 1 },
              "branch_path_relation": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        {
          "if": { "properties": { "commit_status": { "const": "FAILED_BEFORE_COMMIT" } } },
          "then": {
            "properties": {
              "generated_artifact_ids": { "maxItems": 0 },
              "canonical_state_delta_ids": { "maxItems": 0 },
              "unresolved_thread_delta_ids": { "maxItems": 0 },
              "motif_delta_ids": { "maxItems": 0 }
            }
          }
        }
      ]
    },
