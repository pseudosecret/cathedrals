        }
      },
      "allOf": [
        {
          "if": { "properties": { "run_status": { "const": "READY_TO_PLAY" } } },
          "then": {
            "properties": {
              "creative_step_count": { "minimum": 1 },
              "human_intervention_count": { "const": 0 },
              "committed_rewrite_count": { "const": 0 },
              "committed_regeneration_count": { "const": 0 },
              "backtrack_count": { "const": 0 },
              "mechanical_validation": { "properties": { "result": { "const": "PASS" } } },
              "artistic_acceptance": { "properties": { "result": { "const": "PASS" } } },
              "static_build_validation": { "properties": { "result": { "const": "PASS" } } },
              "complete_work_barrier_satisfied": { "const": true },
              "playable": { "const": true },
              "failure_class": { "const": "none" }
            }
          }
        },
        {
          "if": { "properties": { "run_status": { "const": "FAILED_GENERATION" } } },
          "then": {
            "properties": {
              "complete_work_barrier_satisfied": { "const": false },
              "playable": { "const": false },
              "failure_class": {
                "enum": [
                  "transport_before_response",
                  "provider_before_creative_output",
                  "malformed_response",
                  "mechanical_validation",
                  "continuity_impossibility",
                  "budget_exhaustion",
                  "artistic_rejection",
                  "build_failure"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
